@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject Confirm Confirmer
@inject SessionState Session
@inject ApiClient Api
@inject ThemeService Theme
@inject IPlatform Platform
@inject Toasts Toasts
@* WatchlistNudge listens for "watched" to offer taking it off the watchlist; injecting it here starts it. *@
@inject WatchlistNudge WatchlistNudge

<div class="app">
    <header class="topbar">
        <div class="topbar-inner">
            <a href="" class="brand" aria-label="SeenIt home"><Logo /></a>
            <AuthorizeView>
                <Authorized>
                    @* Links that don't fit a narrower window drop out from the right (seenit.navFit measures; data-fit is the
                       order they go in) and reappear in the More menu, which also has the pages that never had a link up here. *@
                    <nav class="topnav" aria-label="Main">
                        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="discover" data-fit="8">Discover</NavLink>
                        <NavLink href="progress" data-fit="7">Progress</NavLink>
                        <NavLink href="calendar" data-fit="6">Calendar</NavLink>
                        <NavLink href="watchlist" data-fit="5">Watchlist</NavLink>
                        <NavLink href="history" data-fit="4">History</NavLink>
                        <NavLink href="lists" data-fit="3">Lists</NavLink>
                        <NavLink href="stats" data-fit="2">Stats</NavLink>
                        <NavLink href="friends" data-fit="1">Friends</NavLink>
                    </nav>
                    <div class="navmore">
                        <button type="button" class="navmore-btn @(moreOpen ? "open" : "")" @onclick="() => moreOpen = !moreOpen" aria-expanded="@moreOpen" aria-haspopup="true">
                            More <Icon Name="chevron-down" Size="14" />
                        </button>
                        @if (moreOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => moreOpen = false"></div>
                            <div class="menu navmore-menu" @onclick="() => moreOpen = false">
                                <a href="discover" data-fit-menu="8"><Icon Name="compass" Size="16" /> Discover</a>
                                <a href="progress" data-fit-menu="7"><Icon Name="progress" Size="16" /> Progress</a>
                                <a href="calendar" data-fit-menu="6"><Icon Name="calendar" Size="16" /> Calendar</a>
                                <a href="watchlist" data-fit-menu="5"><Icon Name="bookmark" Size="16" /> Watchlist</a>
                                <a href="history" data-fit-menu="4"><Icon Name="history" Size="16" /> History</a>
                                <a href="lists" data-fit-menu="3"><Icon Name="list" Size="16" /> Lists</a>
                                <a href="stats" data-fit-menu="2"><Icon Name="chart" Size="16" /> Stats</a>
                                <a href="friends" data-fit-menu="1"><Icon Name="users" Size="16" /> Friends</a>
                                <a href="for-you"><Icon Name="eye" Size="16" /> For you</a>
                                <a href="pick"><Icon Name="shuffle" Size="16" /> Pick for me</a>
                                <a href="@($"review/{DateTime.Today.Year}/{DateTime.Today.Month}")"><Icon Name="clock" Size="16" /> @DateTime.Today.ToString("MMMM") so far</a>
                                <a href="@($"review/{DateTime.Today.Year}")"><Icon Name="chart" Size="16" /> @DateTime.Today.Year so far</a>
                                <a href="goals"><Icon Name="target" Size="16" /> Goals</a>
                                <a href="library"><Icon Name="download" Size="16" /> Library</a>
                                <a href="duplicates"><Icon Name="copy" Size="16" /> Duplicates</a>
                                <a href="more"><Icon Name="menu" Size="16" /> Everything</a>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <nav class="topnav" aria-label="Main">
                        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="discover">Discover</NavLink>
                    </nav>
                </NotAuthorized>
            </AuthorizeView>
            <SearchBox Class="topsearch" IconSize="16" Placeholder="Search titles, people, members" ClearAfter="true" />
            <a href="search" class="icon-btn only-mobile" aria-label="Search"><Icon Name="search" /></a>
            <button type="button" class="icon-btn topbar-share" @onclick="SharePage" aria-label="Share this page" title="Share this page"><Icon Name="share" /></button>
            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                    <div class="usermenu">
                        <button class="avatar @(Session.Me?.Avatar is not null ? "has-picture" : "")" @onclick="() => menuOpen = !menuOpen" aria-label="Account menu" aria-expanded="@menuOpen">
                            @if (Session.Me?.Avatar is { } pic) { <img src="@(new Uri(Api.BaseAddress, pic).ToString())" alt="" /> }
                            else { @Initial(context.User.Identity?.Name) }
                        </button>
                        @if (menuOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => menuOpen = false"></div>
                            <div class="menu" @onclick="() => menuOpen = false">
                                <div class="menu-head">@context.User.Identity?.Name</div>
                                <a href="@Fmt.UserHref(context.User.Identity?.Name ?? "")"><Icon Name="users" Size="16" /> My profile</a>
                                <a href="friends"><Icon Name="users" Size="16" /> Friends</a>
                                <a href="people"><Icon Name="user-plus" Size="16" /> People you follow</a>
                                <a href="recommendations"><Icon Name="send" Size="16" /> Recommendations</a>
                                <a href="favorites"><Icon Name="heart" Size="16" /> Favorites</a>
                                <a href="ratings"><Icon Name="star" Size="16" /> Ratings</a>
                                <a href="settings"><Icon Name="settings" Size="16" /> Settings</a>
                                @if (Session.Me?.IsAdmin == true) { <a href="admin"><Icon Name="shield" Size="16" /> Admin</a> }
                                <button @onclick="Logout"><Icon Name="logout" Size="16" /> Sign out</button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-ghost btn-sm">Sign in</a>
                    @if (features?.OpenRegistration != false) { <a href="register" class="btn btn-primary btn-sm only-desktop">Join</a> }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <OfflineBanner />
    <UpdateBanner />
    <SiteUpdateBanner />
    @* Pull to refresh bumps the key, which rebuilds the current page so it loads everything again. *@
    <main class="main" @key="refreshKey">@Body</main>

    <AuthorizeView>
        <Authorized>
            <LiveConnection />
            @{ var tabs = UiLayout.Tabs(Session.Me); }
            <nav class="tabbar" aria-label="Sections" style="grid-template-columns: repeat(@(tabs.Count + 1), 1fr)">
                @foreach (var t in tabs)
                {
                    <NavLink href="@t.Href" Match="@(t.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @key="t.Key"><Icon Name="@t.Icon" /><span>@t.Label</span></NavLink>
                }
                <NavLink href="more"><Icon Name="menu" /><span>More</span></NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>

    <footer class="footer">
        <span>Metadata and images from</span>
        <a href="https://www.themoviedb.org" target="_blank" rel="noopener">TMDB</a>.
        <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
    </footer>
    <Toaster />
    <ContextMenuHost />
    <ConfirmHost />
    @* Shown by seenit.js once you've scrolled a long way down. *@
    <button type="button" class="to-top" id="seenit-to-top" aria-label="Back to top" tabindex="-1" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
        <Icon Name="arrow-up" Size="20" />
    </button>
</div>

@code {
    private bool menuOpen, moreOpen;
    private ServerFeatures? features;
    private int refreshKey;
    private DotNetObjectReference<MainLayout>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Follow the account's theme once it's known (also after signing in on a new device).
        if (Session.Me is { } me) { await Theme.ApplyAsync(me.Theme); await Theme.ApplyAccentAsync(Fmt.Prefs.Accent); }
        else if (firstRender) await Theme.ApplyDeviceThemeAsync();
        try { await Js.InvokeVoidAsync("seenit.navFit"); } catch (JSException) { }   // the nav may have just appeared (signed in)
        var layout = (Fmt.Prefs.Compact, Fmt.Prefs.PosterSize);
        if (layout != appliedLayout)
        {
            appliedLayout = layout;
            try { await Js.InvokeVoidAsync("seenit.setLayout", layout.Compact, layout.PosterSize.ToString()); } catch (JSException) { }
        }
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("seenit.pullToRefresh", self); } catch (JSException) { }
    }

    private (bool, PosterSize)? appliedLayout;

    [JSInvokable]
    public async Task Refresh()
    {
        try { await Api.SyncAsync(); } catch { /* still offline: the page will show its saved copy */ }
        refreshKey++;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => self?.Dispose();

    /// <summary>The page this launch of the app opened on ("" = home), for the start-page setting.</summary>
    public static string? LaunchPath { get; private set; }

    protected override async Task OnInitializedAsync()
    {
        LaunchPath ??= Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        try { features = await Api.FeaturesAsync(); } catch { /* offline: keep the Join button */ }
    }

    private async Task Logout()
    {
        if (!await Confirmer.AskAsync("Sign out?", "You'll need your password to sign back in on this device.", "Sign out")) return;
        await Session.LogoutAsync();
        Nav.NavigateTo("");
    }

    private static string Initial(string? name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();

    /// <summary>Shares the page you're on: its public link (it opens in the app for people who have it) and its title.</summary>
    private async Task SharePage()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        string title;
        try { title = await Js.InvokeAsync<string>("seenit.pageTitle"); }
        catch { title = "SeenIt"; }
        // Page titles end in "· SeenIt"; the shared text reads better without it.
        if (title.EndsWith(" · SeenIt", StringComparison.Ordinal)) title = title[..^" · SeenIt".Length];
        switch (await Platform.ShareLinkAsync(string.IsNullOrWhiteSpace(title) ? "SeenIt" : title, Platform.PublicUrl(path)))
        {
            case "copied": Toasts.Show("Link copied"); break;
            case "failed": Toasts.Show("Couldn't share this page", error: true); break;
        }
    }
}
