@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject SessionState Session

<div class="app">
    <header class="topbar">
        <div class="topbar-inner">
            <a href="" class="brand" aria-label="SeenIt home"><Logo /></a>
            <AuthorizeView>
                <Authorized>
                    <nav class="topnav" aria-label="Main">
                        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="discover">Discover</NavLink>
                        <NavLink href="progress">Progress</NavLink>
                        <NavLink href="calendar">Calendar</NavLink>
                        <NavLink href="watchlist">Watchlist</NavLink>
                        <NavLink href="history">History</NavLink>
                        <NavLink href="lists">Lists</NavLink>
                        <NavLink href="stats">Stats</NavLink>
                    </nav>
                </Authorized>
                <NotAuthorized>
                    <nav class="topnav" aria-label="Main">
                        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="discover">Discover</NavLink>
                    </nav>
                </NotAuthorized>
            </AuthorizeView>
            <form class="topsearch" @onsubmit="Search" role="search">
                <Icon Name="search" Size="16" />
                <input type="search" placeholder="Search movies & shows" @bind="query" aria-label="Search" />
            </form>
            <a href="search" class="icon-btn only-mobile" aria-label="Search"><Icon Name="search" /></a>
            <AuthorizeView>
                <Authorized>
                    <div class="usermenu">
                        <button class="avatar" @onclick="() => menuOpen = !menuOpen" aria-label="Account menu" aria-expanded="@menuOpen">
                            @Initial(context.User.Identity?.Name)
                        </button>
                        @if (menuOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => menuOpen = false"></div>
                            <div class="menu" @onclick="() => menuOpen = false">
                                <div class="menu-head">@context.User.Identity?.Name</div>
                                <a href="ratings"><Icon Name="star" Size="16" /> Ratings</a>
                                <a href="settings"><Icon Name="settings" Size="16" /> Settings</a>
                                <button @onclick="Logout"><Icon Name="logout" Size="16" /> Sign out</button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-ghost btn-sm">Sign in</a>
                    <a href="register" class="btn btn-primary btn-sm only-desktop">Join</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="main">@Body</main>

    <AuthorizeView>
        <Authorized>
            <nav class="tabbar" aria-label="Sections">
                <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" /><span>Home</span></NavLink>
                <NavLink href="discover"><Icon Name="compass" /><span>Discover</span></NavLink>
                <NavLink href="progress"><Icon Name="progress" /><span>Progress</span></NavLink>
                <NavLink href="calendar"><Icon Name="calendar" /><span>Calendar</span></NavLink>
                <NavLink href="more"><Icon Name="menu" /><span>More</span></NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>

    <footer class="footer">
        <span>Metadata and images from</span>
        <a href="https://www.themoviedb.org" target="_blank" rel="noopener">TMDB</a>.
        <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
    </footer>
    <Toaster />
</div>

@code {
    private string query = "";
    private bool menuOpen;

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        Nav.NavigateTo("search?q=" + Uri.EscapeDataString(query.Trim()));
    }

    private async Task Logout()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("");
    }

    private static string Initial(string? name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
