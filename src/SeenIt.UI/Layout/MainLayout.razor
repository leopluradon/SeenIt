@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject SessionState Session
@inject ApiClient Api
@inject ThemeService Theme
@* WatchlistNudge listens for "watched" to offer taking it off the watchlist; injecting it here starts it. *@
@inject WatchlistNudge WatchlistNudge

<div class="app">
    <header class="topbar">
        <div class="topbar-inner">
            <a href="" class="brand" aria-label="SeenIt home"><Logo /></a>
            <AuthorizeView>
                <Authorized>
                    <nav class="topnav" aria-label="Main">
                        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="discover">Discover</NavLink>
                        <NavLink href="progress">Progress</NavLink>
                        <NavLink href="calendar">Calendar</NavLink>
                        <NavLink href="watchlist">Watchlist</NavLink>
                        <NavLink href="history">History</NavLink>
                        <NavLink href="lists">Lists</NavLink>
                        <NavLink href="stats">Stats</NavLink>
                        <NavLink href="friends">Friends</NavLink>
                    </nav>
                </Authorized>
                <NotAuthorized>
                    <nav class="topnav" aria-label="Main">
                        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="discover">Discover</NavLink>
                    </nav>
                </NotAuthorized>
            </AuthorizeView>
            <form class="topsearch" @onsubmit="Search" role="search">
                <Icon Name="search" Size="16" />
                <input type="search" placeholder="Search titles, people, members" @bind="query" @bind:event="oninput" aria-label="Search"
                       @ref="searchBox" @onfocus="SearchFocused" @onblur="() => searchOpen = false" @onkeydown="SearchKey" autocomplete="off" />
                @if (query.Length > 0)
                {
                    <button type="button" class="search-clear" @onmousedown:preventDefault @onclick="ClearSearch" aria-label="Clear search"><Icon Name="x" Size="14" /></button>
                }
                @if (searchOpen && query.Length == 0 && recent.Count > 0)
                {
                    @* mousedown:preventDefault keeps focus in the box, so blur doesn't close this before the click lands. *@
                    <div class="search-recent" @onmousedown:preventDefault>
                        <div class="search-recent-head"><span>Recent searches</span><button type="button" @onclick="ClearRecent">Clear</button></div>
                        @foreach (var r in recent)
                        {
                            <div class="search-recent-row" @key="r">
                                <button type="button" class="search-recent-go" @onclick="() => SearchFor(r)"><Icon Name="clock" Size="14" /> <span>@r</span></button>
                                <button type="button" class="icon-btn" @onclick="() => RemoveRecent(r)" aria-label="@($"Remove {r}")"><Icon Name="x" Size="12" /></button>
                            </div>
                        }
                    </div>
                }
            </form>
            <a href="search" class="icon-btn only-mobile" aria-label="Search"><Icon Name="search" /></a>
            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                    <div class="usermenu">
                        <button class="avatar @(Session.Me?.Avatar is not null ? "has-picture" : "")" @onclick="() => menuOpen = !menuOpen" aria-label="Account menu" aria-expanded="@menuOpen">
                            @if (Session.Me?.Avatar is { } pic) { <img src="@(new Uri(Api.BaseAddress, pic).ToString())" alt="" /> }
                            else { @Initial(context.User.Identity?.Name) }
                        </button>
                        @if (menuOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => menuOpen = false"></div>
                            <div class="menu" @onclick="() => menuOpen = false">
                                <div class="menu-head">@context.User.Identity?.Name</div>
                                <a href="@Fmt.UserHref(context.User.Identity?.Name ?? "")"><Icon Name="users" Size="16" /> My profile</a>
                                <a href="friends"><Icon Name="users" Size="16" /> Friends</a>
                                <a href="people"><Icon Name="user-plus" Size="16" /> People you follow</a>
                                <a href="recommendations"><Icon Name="send" Size="16" /> Recommendations</a>
                                <a href="favorites"><Icon Name="heart" Size="16" /> Favorites</a>
                                <a href="ratings"><Icon Name="star" Size="16" /> Ratings</a>
                                <a href="settings"><Icon Name="settings" Size="16" /> Settings</a>
                                @if (Session.Me?.IsAdmin == true) { <a href="admin"><Icon Name="shield" Size="16" /> Admin</a> }
                                <button @onclick="Logout"><Icon Name="logout" Size="16" /> Sign out</button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-ghost btn-sm">Sign in</a>
                    @if (features?.OpenRegistration != false) { <a href="register" class="btn btn-primary btn-sm only-desktop">Join</a> }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <OfflineBanner />
    <UpdateBanner />
    <SiteUpdateBanner />
    @* Pull to refresh bumps the key, which rebuilds the current page so it loads everything again. *@
    <main class="main" @key="refreshKey">@Body</main>

    <AuthorizeView>
        <Authorized>
            @{ var tabs = UiLayout.Tabs(Session.Me); }
            <nav class="tabbar" aria-label="Sections" style="grid-template-columns: repeat(@(tabs.Count + 1), 1fr)">
                @foreach (var t in tabs)
                {
                    <NavLink href="@t.Href" Match="@(t.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @key="t.Key"><Icon Name="@t.Icon" /><span>@t.Label</span></NavLink>
                }
                <NavLink href="more"><Icon Name="menu" /><span>More</span></NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>

    <footer class="footer">
        <span>Metadata and images from</span>
        <a href="https://www.themoviedb.org" target="_blank" rel="noopener">TMDB</a>.
        <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
    </footer>
    <Toaster />
    @* Shown by seenit.js once you've scrolled a long way down. *@
    <button type="button" class="to-top" id="seenit-to-top" aria-label="Back to top" tabindex="-1" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
        <Icon Name="arrow-up" Size="20" />
    </button>
</div>

@code {
    private string query = "";
    private bool menuOpen;
    private ServerFeatures? features;
    private int refreshKey;
    private DotNetObjectReference<MainLayout>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Follow the account's theme once it's known (also after signing in on a new device).
        if (Session.Me is { } me) await Theme.ApplyAsync(me.Theme);
        else if (firstRender) await Theme.ApplyDeviceThemeAsync();
        var layout = (Fmt.Prefs.Compact, Fmt.Prefs.PosterSize);
        if (layout != appliedLayout)
        {
            appliedLayout = layout;
            try { await Js.InvokeVoidAsync("seenit.setLayout", layout.Compact, layout.PosterSize.ToString()); } catch (JSException) { }
        }
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("seenit.pullToRefresh", self); } catch (JSException) { }
    }

    private (bool, PosterSize)? appliedLayout;

    [JSInvokable]
    public async Task Refresh()
    {
        try { await Api.SyncAsync(); } catch { /* still offline: the page will show its saved copy */ }
        refreshKey++;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => self?.Dispose();

    /// <summary>The page this launch of the app opened on ("" = home), for the start-page setting.</summary>
    public static string? LaunchPath { get; private set; }

    protected override async Task OnInitializedAsync()
    {
        LaunchPath ??= Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        try { features = await Api.FeaturesAsync(); } catch { /* offline: keep the Join button */ }
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        SearchFor(query);
    }

    private ElementReference searchBox;
    private bool searchOpen;
    private List<string> recent = [];

    private async Task SearchFocused()
    {
        recent = await RecentSearches.GetAsync(Js);
        searchOpen = true;
    }

    private void SearchFor(string q)
    {
        searchOpen = false;
        query = "";
        Nav.NavigateTo("search?q=" + Uri.EscapeDataString(q.Trim()));
    }

    private void SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") searchOpen = false;
    }

    private async Task ClearSearch()
    {
        query = "";
        searchOpen = true;
        recent = await RecentSearches.GetAsync(Js);
        try { await searchBox.FocusAsync(); } catch (JSException) { }
    }

    private async Task RemoveRecent(string q) => recent = await RecentSearches.RemoveAsync(Js, q);

    private async Task ClearRecent()
    {
        await RecentSearches.ClearAsync(Js);
        recent = [];
    }

    private async Task Logout()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("");
    }

    private static string Initial(string? name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
