@page "/u/{Name}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject IPlatform Platform
@inject Toasts Toasts
@inject SessionState Session
@inject IJSRuntime Js
@inject ThemeService Theme
<PageTitle>@(p?.User.Name ?? Name) · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (p is null && error is null) { <Spinner /> }
else if (p is not null)
{
    @* The owner's accent color, for everyone who visits. *@
    <div class="profile-page" style="@UiPrefs.AccentStyle(p.Accent)">
    <div class="profile-head @(p.Banner is not null ? "has-banner" : "")">
        @if (p.Banner is { } banner) { <div class="profile-banner" style="background-image: url('@Img.Backdrop(banner, "w1280")')" aria-hidden="true"></div> }
        <Avatar Name="@p.User.Name" Url="@p.User.Avatar" Class="avatar-lg" />
        <div class="profile-info">
            <h1>@p.User.Name @if (p.Badge is { } badge) { <span class="profile-badge" title="Milestone"><Icon Name="star" Size="12" /> @badge</span> }</h1>
            <div class="muted small">
                @@@p.User.UserName · joined @p.JoinedAt.ToLocalTime().ToString("MMMM yyyy")
                @if (p.User.FollowsYou) { <span> · follows you</span> }
            </div>
            <div class="small profile-counts">
                @{ var lists = p.IsMe || p.Visibility != ProfileVisibility.Private || (p.User.Following && p.User.FollowsYou); }
                <a href="@(p.IsMe ? "friends?tab=followers" : lists ? $"{Fmt.UserHref(p.User.UserName)}/followers" : null)"><b>@p.Followers</b> follower@(p.Followers == 1 ? "" : "s")</a>
                <a href="@(p.IsMe ? "friends?tab=following" : lists ? $"{Fmt.UserHref(p.User.UserName)}/following" : null)"><b>@p.Following</b> following</a>
            </div>
        </div>
        <div class="profile-actions">
            <AuthorizeView>
                <Authorized>
                    @if (!p.IsMe)
                    {
                        <FollowButton User="p.User" UserChanged="u => p = p with { User = u }" />
                        @if (p.CanView && Session.Me is { } viewer) { <a class="btn btn-sm" href="@Fmt.CompareHref(viewer.UserName, p.User.UserName)">Compare</a> }
                    }
                    else if (draft is null)
                    {
                        <button class="btn btn-sm" @onclick="StartEditing"><Icon Name="edit" Size="14" /> Customize</button>
                        <a class="btn btn-sm" href="settings#privacy">Privacy</a>
                    }
                </Authorized>
            </AuthorizeView>
            <button class="btn btn-sm" @onclick="Share"><Icon Name="share" Size="14" /> Share</button>
        </div>
    </div>

    @if (draft is not null)
    {
        <div class="pw-editbar">
            <span class="muted small only-desktop">Drag <Icon Name="grip" Size="12" /> to move, and the corner to resize.</span>
            <span class="muted small only-mobile">Use the arrows to move, and the corner to resize.</span>
            <div class="inline">
                <button class="btn btn-sm btn-primary" @onclick="() => adding = true"><Icon Name="plus" Size="14" /> Add widget</button>
                <button class="btn btn-sm" @onclick="OpenStyle">Banner & color</button>
                <button class="btn btn-sm" @onclick="ResetDraft">Reset</button>
                <button class="btn btn-sm" @onclick="CancelEditing">Cancel</button>
                <button class="btn btn-sm btn-primary" @onclick="Save" disabled="@saving">@(saving ? "Saving…" : "Done")</button>
            </div>
        </div>
    }

    @if (!p.CanView)
    {
        <div class="panel">
            <b>@(p.Visibility == ProfileVisibility.Private ? "This profile is private." : $"Only {p.User.Name}'s friends can see their activity.")</b>
            @if (p.Visibility == ProfileVisibility.Friends) { <p class="muted small">Follow each other to see what they watch.</p> }
        </div>
    }
    else if (p.IsMe && draft is null) { <p class="muted small">Visible to @Friends.VisibilityText(p.Visibility).</p> }

    @{ var shown = Shown(); }
    @if (shown.Count > 0 || draft is not null)
    {
        <div class="pw-grid @(draft is not null ? "editing" : "")" @ref="grid">
            @for (var i = 0; i < shown.Count; i++)
            {
                var w = shown[i];
                var index = i;
                <section class="pw w@(w.W)" style="--h:@w.H" data-id="@w.Id" @key="w.Id">
                    @if (draft is not null)
                    {
                        <div class="pw-tools">
                            <button type="button" class="icon-btn pw-grip only-desktop" aria-label="Drag to move" title="Drag to move"><Icon Name="grip" Size="16" /></button>
                            <button type="button" class="icon-btn" @onclick="() => Shift(index, -1)" disabled="@(index == 0)" aria-label="Move earlier"><Icon Name="arrow-up" Size="14" /></button>
                            <button type="button" class="icon-btn" @onclick="() => Shift(index, 1)" disabled="@(index == shown.Count - 1)" aria-label="Move later"><Icon Name="arrow-down" Size="14" /></button>
                            <span class="pw-size muted small">@ProfileWidgets.WidthName(w.W) × @w.H</span>
                            <button type="button" class="btn btn-sm" @onclick="() => Configure(w)">Edit</button>
                            <button type="button" class="icon-btn" @onclick="() => Remove(w)" aria-label="@($"Remove {ProfileWidgetView.Title(w)}")"><Icon Name="x" Size="14" /></button>
                        </div>
                        <span class="pw-resize" aria-hidden="true"></span>
                    }
                    <ProfileWidgetView Widget="w" P="p" D="data" Editing="draft is not null" />
                </section>
            }
        </div>
        @if (draft is { Count: 0 }) { <p class="muted">No widgets. Add some with <b>Add widget</b>.</p> }
    }

    <Modal Open="adding" OpenChanged="v => adding = v" Title="Add a widget">
        @foreach (var group in ProfileWidgets.Kinds.GroupBy(k => k.Group))
        {
            <h4 class="pw-cat-head">@group.Key</h4>
            <div class="pw-catalog">
                @foreach (var k in group)
                {
                    var used = !k.Multiple && draft?.Any(w => w.Type == k.Type) == true;
                    <button type="button" class="pw-cat-item" disabled="@used" @onclick="() => Add(k)">
                        <b>@k.Name</b>
                        <span class="muted small">@k.Description</span>
                        <span class="muted small">@(used ? "On your profile" : k.Part is { } part ? $"{ProfileWidgets.WidthName(k.W)} × {k.H} · {PartName(part)} privacy" : $"{ProfileWidgets.WidthName(k.W)} × {k.H}")</span>
                    </button>
                }
            </div>
        }
    </Modal>

    <Modal Open="editingWidget is not null" OpenChanged="v => { if (!v) editingWidget = null; }" Title="@(editingWidget is { } ew ? ProfileWidgets.Kind(ew.Type)?.Name ?? "" : "")">
        @if (editingWidget is { } ew)
        {
            var ek = ProfileWidgets.Kind(ew.Type);
            <div class="form-stack">
                <label>Heading
                    <input @bind="configTitle" maxlength="60" placeholder="@(ew.Type == "bio" ? "None" : ek?.Name)" />
                </label>
                @if (ek?.Ranges is { } ranges)
                {
                    <label>Covers
                        <select @bind="configRange">
                            @foreach (var r in ranges) { <option value="@r">@(r switch { "all" => "All time", "year" => "This year", "month" => "This month", _ => "Last year" })</option> }
                        </select>
                    </label>
                }
                @switch (ew.Type)
                {
                    case "bio":
                        <label>About you
                            <textarea rows="5" maxlength="@ProfileWidgets.MaxText" @bind="configText" @bind:event="oninput" placeholder="What you like to watch, what you're into lately…"></textarea>
                        </label>
                        <span class="muted small">@((configText ?? "").Length) / @ProfileWidgets.MaxText</span>
                        break;

                    case "spotlight":
                        <span class="small">Movie or show @if (configMedia is not null && pickedTitle is not null) { <span>: <b>@pickedTitle</b></span> }</span>
                        <TitlePicker Selected="configMedia" OnPick="Pick" />
                        break;

                    case "pinned-list":
                        <label>List
                            <select @bind="configList">
                                <option value="">Pick a list</option>
                                @foreach (var l in p.Lists) { <option value="@l.Id">@l.Name@(l.IsPublic ? "" : " (private)")</option> }
                            </select>
                        </label>
                        @if (p.Lists.FirstOrDefault(l => l.Id.ToString() == configList) is { IsPublic: false }) { <p class="muted small">Private lists only show to you. Make it public on the list's page to share it.</p> }
                        break;
                }
                <div class="inline">
                    <button class="btn btn-primary" @onclick="ApplyConfig">Apply</button>
                    <button class="btn" @onclick="() => editingWidget = null">Cancel</button>
                </div>
            </div>
        }
    </Modal>

    <Modal Open="styleOpen" OpenChanged="v => styleOpen = v" Title="Banner & color">
        <div class="form-stack">
            <h4 class="pw-cat-head">Banner</h4>
            <p class="muted small">A movie or show whose backdrop sits behind your name.@if (styleBannerTitle is not null) { <span> Now: <b>@styleBannerTitle</b>.</span> }</p>
            <TitlePicker Selected="styleBanner" OnPick="PickBanner" />
            @if (styleBanner is not null) { <button type="button" class="btn btn-sm btn-ghost" @onclick="() => { styleBanner = null; styleBannerTitle = null; }">No banner</button> }

            <h4 class="pw-cat-head">Accent color</h4>
            <p class="muted small">Used across SeenIt for you, and on your profile for everyone who visits.</p>
            <div class="accent-grid" role="radiogroup" aria-label="Accent color">
                <button type="button" role="radio" aria-checked="@(styleAccent is null)" class="accent-option @(styleAccent is null ? "on" : "")"
                        style="--sw:@UiPrefs.Theme(Theme.Current).Accent" @onclick="() => styleAccent = null"><span class="accent-dot"></span><span>Theme's</span></button>
                @foreach (var a in UiPrefs.Accents)
                {
                    <button type="button" role="radio" aria-checked="@(styleAccent == a.Key)" class="accent-option @(styleAccent == a.Key ? "on" : "")" @key="a.Key"
                            style="--sw:@a.Hex" @onclick="() => styleAccent = a.Key"><span class="accent-dot"></span><span>@a.Name</span></button>
                }
            </div>

            <h4 class="pw-cat-head">Badge</h4>
            <p class="muted small">A milestone shown next to your name (to people who can see your stats).</p>
            @if (milestones is null) { <Spinner /> }
            else
            {
                <select @bind="styleBadge" aria-label="Badge">
                    <option value="">None</option>
                    @foreach (var m in milestones) { <option value="@m">@m</option> }
                </select>
            }
            <div class="inline">
                <button class="btn btn-primary" @onclick="SaveStyle" disabled="@saving">Save</button>
                <button class="btn" @onclick="() => styleOpen = false">Cancel</button>
            </div>
        </div>
    </Modal>
    </div>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    private ProfileDto? p;
    private ProfileWidgetData? data;
    private string? error;

    // Editing: a working copy of the layout, saved with Done.
    private List<ProfileWidget>? draft;
    private bool adding, saving;
    private ElementReference grid;
    private DotNetObjectReference<Profile>? self;
    private bool gridAttached;

    private ProfileWidget? editingWidget;
    private string? configText, configList, configTitle, configRange, pickedTitle;
    private MediaRef? configMedia;

    // Banner, accent and badge (saved with your settings, not the layout).
    private bool styleOpen;
    private MediaRef? styleBanner;
    private string? styleBannerTitle, styleAccent, styleBadge;
    private List<string>? milestones;

    protected override async Task OnParametersSetAsync()
    {
        if (p is not null && !string.Equals(p.User.UserName, Name, StringComparison.OrdinalIgnoreCase)) { p = null; data = null; draft = null; }
        await Load();
    }

    private async Task Load()
    {
        error = null;
        try { p = await Api.ProfileAsync(Name); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { error = "There's no one with that username."; return; }
        catch (Exception ex) { error = ex.Message; return; }
        await LoadData();
    }

    private static readonly HashSet<string> Basic = ["now", "tiles", "recent", "fav-movies", "fav-shows", "top-rated", "lists", "bio"];

    private async Task LoadData()
    {
        var layout = draft ?? p?.Layout?.ToList() ?? [];
        if (layout.All(w => Basic.Contains(w.Type))) { data = new ProfileWidgetData(); return; }
        StateHasChanged();
        try
        {
            var fresh = await Api.ProfileWidgetsAsync(Name, draft?.Select(w => w.Range is { } r ? $"{w.Type}@{r}" : w.Type).Distinct());
            // Keep spotlights and lists picked while editing (they're only in the draft).
            data = data is null ? fresh : fresh with
            {
                Spotlights = Merge(fresh.Spotlights, data.Spotlights),
                Lists = Merge(fresh.Lists, data.Lists),
                Periods = Merge(fresh.Periods, data.Periods),
            };
        }
        catch { data ??= new ProfileWidgetData(); }
    }

    private static IReadOnlyDictionary<TK, TV>? Merge<TK, TV>(IReadOnlyDictionary<TK, TV>? a, IReadOnlyDictionary<TK, TV>? b) where TK : notnull
    {
        if (b is null) return a;
        var d = new Dictionary<TK, TV>(b);
        foreach (var kv in a ?? new Dictionary<TK, TV>()) d[kv.Key] = kv.Value;
        return d;
    }

    private bool HasData(string type) => data is { } d && (ProfileWidgets.Kind(type)?.DefaultRange is { } r and not "all"
        ? d.Periods?.ContainsKey(r) == true
        : type switch
    {
        "genres" or "months" or "weekdays" or "rating-chart" => d.Stats is not null,
        "release-gap" => d.ReleaseGap is not null,
        "heatmap" => d.Heatmap is not null,
        "weekhour" => d.WeekHour is not null,
        "milestones" => d.Milestones is not null,
        "watching" => d.Watching is not null,
        "finished" => d.Finished is not null,
        _ => true,
    });

    /// <summary>What's on the grid: the draft while editing; otherwise the widgets with something to show.</summary>
    private List<ProfileWidget> Shown() => draft
        ?? (p?.Layout ?? []).Where(w => ProfileWidgetView.HasContent(w, p!, data)).ToList();

    private static string PartName(ProfilePart part) => part switch
    {
        ProfilePart.WatchingNow => "Watching now",
        _ => part.ToString(),
    };

    // ----- Editing -----

    private void StartEditing() => draft = [.. p!.Layout ?? ProfileWidgets.Default];

    private void CancelEditing()
    {
        draft = null;
        gridAttached = false;
    }

    private void ResetDraft() => draft = [.. ProfileWidgets.Default];

    private async Task Save()
    {
        if (draft is null || p is null) return;
        saving = true;
        try
        {
            var saved = await Api.SaveProfileLayoutAsync(draft);
            p = p with { Layout = saved };
            draft = null;
            gridAttached = false;
            Toasts.Show("Profile saved");
            await LoadData();
        }
        catch (Exception ex) { Toasts.Show($"Couldn't save: {ex.Message}", error: true); }
        finally { saving = false; }
    }

    private async Task Add(WidgetKind k)
    {
        if (draft is null) return;
        var w = new ProfileWidget(Guid.NewGuid().ToString("N")[..10], k.Type, k.W, k.H, Range: k.DefaultRange);
        draft.Add(w);
        adding = false;
        if (k.Type is "bio" or "spotlight" or "pinned-list") Configure(w);   // these need setting up first
        StateHasChanged();
        try { await Js.InvokeVoidAsync("seenit.profileGrid.reveal", grid, w.Id); } catch (JSException) { }
        if (!Basic.Contains(k.Type) && !HasData(k.Type)) { await LoadData(); StateHasChanged(); }
    }

    private void Remove(ProfileWidget w) => draft?.Remove(w);

    private void Shift(int index, int by)
    {
        if (draft is null || index + by < 0 || index + by >= draft.Count) return;
        (draft[index], draft[index + by]) = (draft[index + by], draft[index]);
    }

    /// <summary>From seenit.js: a widget was dragged onto another one.</summary>
    [JSInvokable]
    public void Move(string id, string targetId, bool before)
    {
        if (draft is null || id == targetId || draft.FindIndex(w => w.Id == id) is not (>= 0 and var from)) return;
        var w = draft[from];
        draft.RemoveAt(from);
        var to = draft.FindIndex(x => x.Id == targetId);
        if (to < 0) { draft.Insert(from, w); return; }
        draft.Insert(before ? to : to + 1, w);
        StateHasChanged();
    }

    /// <summary>From seenit.js: a widget's corner was dragged to a new size.</summary>
    [JSInvokable]
    public void Resize(string id, int w, int h)
    {
        if (draft is null || draft.FindIndex(x => x.Id == id) is not (>= 0 and var i)) return;
        draft[i] = draft[i] with { W = ProfileWidgets.SnapWidth(w), H = Math.Clamp(h, 1, ProfileWidgets.MaxRows) };
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (draft is not null && !gridAttached && grid.Context is not null)
        {
            gridAttached = true;
            self ??= DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("seenit.profileGrid.attach", grid, self); } catch (JSException) { }
        }
    }

    // ----- Widget settings -----

    private void Configure(ProfileWidget w)
    {
        editingWidget = w;
        configText = w.Text;
        configMedia = w.Media;
        configList = w.ListId?.ToString() ?? "";
        configTitle = w.Title;
        configRange = w.Range ?? ProfileWidgets.Kind(w.Type)?.DefaultRange;
        pickedTitle = w.Media is { } m && data?.Spotlights?.GetValueOrDefault($"{(m.Type == MediaType.Movie ? "movie" : "show")}:{m.TmdbId}") is { } s ? s.Title : null;
    }

    private void Pick(Suggestion s)
    {
        configMedia = new MediaRef(s.Kind == "movie" ? MediaType.Movie : MediaType.Show, s.Id);
        pickedTitle = s.Year is { } y ? $"{s.Title} ({y})" : s.Title;
        if (data is not null)
        {
            // Show it right away, before saving.
            var spot = new Dictionary<string, MediaSummary>(data.Spotlights ?? new Dictionary<string, MediaSummary>())
            {
                [$"{s.Kind}:{s.Id}"] = new MediaSummary(configMedia.Type, s.Id, s.Title, s.Year, s.Image, null, null, null),
            };
            data = data with { Spotlights = spot };
        }
    }

    private async Task ApplyConfig()
    {
        if (draft is null || editingWidget is not { } w || draft.IndexOf(w) is not (>= 0 and var i)) { editingWidget = null; return; }
        var text = string.IsNullOrWhiteSpace(configText) ? null : configText.Trim();
        var title = string.IsNullOrWhiteSpace(configTitle) ? null : configTitle.Trim();
        var range = ProfileWidgets.Kind(w.Type)?.Ranges?.Contains(configRange) == true ? configRange : null;
        draft[i] = (w.Type switch
        {
            "bio" => w with { Text = text },
            "spotlight" => w with { Media = configMedia },
            "pinned-list" => w with { ListId = Guid.TryParse(configList, out var id) ? id : null },
            _ => w,
        }) with { Title = title, Range = range };
        editingWidget = null;
        if (w.Type == "pinned-list" && draft[i].ListId is { } lid && data is not null && data.Lists?.ContainsKey(lid) != true)
            _ = PreviewListAsync(lid);
        // A different period: fetch its numbers.
        if (range is not null and not "all" && data?.Periods?.ContainsKey(range) != true) { StateHasChanged(); await LoadData(); }
    }

    // ----- Banner, accent and badge -----

    private async Task OpenStyle()
    {
        styleOpen = true;
        styleBanner = Fmt.Prefs.ProfileBanner;
        styleBannerTitle = styleBanner is null ? null : "your current pick";
        styleAccent = Fmt.Prefs.Accent;
        styleBadge = Fmt.Prefs.ProfileBadge ?? "";
        if (milestones is null)
        {
            try { milestones = (await Api.MoreStatsAsync()).Milestones.Select(m => m.Label).Distinct().ToList(); }
            catch { milestones = []; }
        }
    }

    private void PickBanner(Suggestion s)
    {
        styleBanner = new MediaRef(s.Kind == "movie" ? MediaType.Movie : MediaType.Show, s.Id);
        styleBannerTitle = s.Year is { } y ? $"{s.Title} ({y})" : s.Title;
    }

    private async Task SaveStyle()
    {
        saving = true;
        try
        {
            var prefs = (Fmt.Prefs with { ProfileBanner = styleBanner, Accent = styleAccent, ProfileBadge = string.IsNullOrEmpty(styleBadge) ? null : styleBadge }).Clean();
            await Api.SavePrefsAsync(prefs);
            Session.Update(me => me with { Prefs = prefs });
            await Theme.ApplyAccentAsync(prefs.Accent);
            styleOpen = false;
            var fresh = await Api.ProfileAsync(Name);
            p = p is null ? fresh : p with { Banner = fresh.Banner, Accent = fresh.Accent, Badge = fresh.Badge };
        }
        catch (Exception ex) { Toasts.Show($"Couldn't save: {ex.Message}", error: true); }
        finally { saving = false; }
    }

    /// <summary>A newly pinned list, shown before saving.</summary>
    private async Task PreviewListAsync(Guid id)
    {
        try
        {
            var l = await Api.ListAsync(id);
            if (l is null || data is null) return;
            var lists = new Dictionary<Guid, ListDetail>(data.Lists ?? new Dictionary<Guid, ListDetail>()) { [id] = l with { Items = l.Items.Take(12).ToList() } };
            data = data with { Lists = lists };
            StateHasChanged();
        }
        catch { }
    }

    private async Task Share()
    {
        if (p is null) return;
        var result = await Platform.ShareLinkAsync($"{p.User.Name} on SeenIt", Platform.PublicUrl(Fmt.UserHref(p.User.UserName)));
        if (result == "copied") Toasts.Show("Profile link copied");
        else if (result == "failed") Toasts.Show("Couldn't share the link.", error: true);
    }

    public ValueTask DisposeAsync()
    {
        self?.Dispose();
        return ValueTask.CompletedTask;
    }
}
