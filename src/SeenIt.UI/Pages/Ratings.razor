@page "/ratings"
@page "/u/{UserName}/ratings"
@* No [Authorize]: someone's shared ratings follow their Ratings privacy; your own need signing in. *@
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
@inject Toasts Toasts
@inject Confirm Confirmer
<PageTitle>@(Other is { } on ? $"{on}'s ratings" : "Ratings") · SeenIt</PageTitle>
@if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }

<div class="page-head">
    <h1>@(Other is { } o ? $"{o}'s ratings" : "Ratings")</h1>
    @if (Mine) { <button class="btn btn-sm @(selecting ? "btn-on" : "")" @onclick="() => { selecting = !selecting; selected.Clear(); }" aria-pressed="@selecting"><Icon Name="check" Size="16" /> @(selecting ? "Done" : "Select")</button> }
    <div class="segmented">
        <button class="@(filter is null ? "on" : "")" @onclick="() => SetFilter(null)">All</button>
        <button class="@(filter == MediaType.Movie ? "on" : "")" @onclick="() => SetFilter(MediaType.Movie)">Movies</button>
        <button class="@(filter == MediaType.Show ? "on" : "")" @onclick="() => SetFilter(MediaType.Show)">Shows</button>
        <button class="@(filter == MediaType.Episode ? "on" : "")" @onclick="() => SetFilter(MediaType.Episode)">Episodes</button>
    </div>
</div>
<div class="chips">
    @if (Fmt.Scale == RatingScale.Thumbs)
    {
        @* Thumbs: 10 stands for liked, 1 for didn't like (the same "score" in links and saved filters). *@
        <button class="chip @(stars == 10 ? "on" : "")" @onclick="() => SetStars(stars == 10 ? null : 10)">👍 Liked</button>
        <button class="chip @(stars == 1 ? "on" : "")" @onclick="() => SetStars(stars == 1 ? null : 1)">👎 Didn't like</button>
    }
    else
    {
        @for (var i = 10; i >= 1; i--)
        {
            var n = i;
            <button class="chip @(stars == n ? "on" : "")" @onclick="() => SetStars(stars == n ? null : n)">@(Fmt.FiveStars ? "★ " + Fmt.Stars(n) : n)</button>
        }
    }
</div>
<div class="chips">
    @foreach (var (key, label) in Sorts)
    {
        <button class="chip @(sort == key ? "on" : "")" @onclick="() => SetSort(key)">@label</button>
    }
    <LayoutToggle Page="ratings" Value="layout" ValueChanged="v => layout = v" />
</div>
<ErrorBox Message="@error" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = Sorted(items.Where(Matches)).ToList();
    @if (shown.Count == 0) { <Empty Title="No ratings here." /> }
    @* Selecting shows rows with a box each, whatever the layout. *@
    @if (layout == ListLayout.Rows || selecting)
    {
        <ol class="list-rows">
            @foreach (var r in shown)
            {
                var key = Key(r);
                <li class="list-row @(selecting && selected.Contains(key) ? "picked" : "")" @key="key"
                    @onclick="() => { if (selecting && !selected.Remove(key)) selected.Add(key); }" @onclick:preventDefault="selecting"
                    data-ctx="@(r.Type == MediaType.Episode && r.SeasonNumber is { } cs && r.EpisodeNumber is { } ce ? Menu.Episode(r.TmdbId, cs, ce, r.Title, null, r.PosterPath) : Menu.Title(r.Type, r.TmdbId, r.Title, r.PosterPath))">
                    @if (selecting) { <span class="pick-box"><input type="checkbox" checked="@selected.Contains(key)" tabindex="-1" aria-label="@($"Select {r.Title}")" /></span> }
                    <a href="@RatedHref(r)" class="list-row-link" @onclick:preventDefault="selecting">
                        <img src="@Img.Poster(r.PosterPath, "w92")" alt="" loading="lazy" />
                        <span class="list-row-main">
                            <b>@r.Title</b>
                            <span class="muted small">@(r.Type == MediaType.Episode ? Fmt.Ep(r.SeasonNumber, r.EpisodeNumber) : r.SeasonNumber is { } rs ? (rs == 0 ? "Specials" : $"Season {rs}") : r.Type == MediaType.Movie ? "Movie" : "TV")<span class="dot-sep">rated @r.RatedAt.ToLocalTime().ToString(Fmt.DateLong)</span></span>
                        </span>
                    </a>
                    <span class="pill">@Fmt.RatingBadge(r.Rating)</span>
                </li>
            }
        </ol>
    }
    else
    {
    <div class="poster-grid">
        @foreach (var r in shown)
        {
            <PosterCard Media="@(new MediaSummary(r.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, r.TmdbId, r.Title, null, r.PosterPath, null, null, null))"
                        Badge="@Fmt.RatingBadge(r.Rating)" ShowScore="false"
                        Href="@RatedHref(r)" TitleHref="@(r.Type == MediaType.Movie || (r.SeasonNumber is null && r.EpisodeNumber is null) ? null : $"show/{r.TmdbId}")"
                        Ctx="@(r.Type == MediaType.Episode && r.SeasonNumber is { } cs && r.EpisodeNumber is { } ce ? Menu.Episode(r.TmdbId, cs, ce, r.Title, null, r.PosterPath) : null)"
                        Sub="@(r.Type == MediaType.Episode ? Fmt.Ep(r.SeasonNumber, r.EpisodeNumber) : r.SeasonNumber is { } rs ? (rs == 0 ? "Specials" : $"Season {rs}") : r.RatedAt.ToLocalTime().ToString(Fmt.DateLong))"
                        @key="(r.Type, r.TmdbId, r.SeasonNumber, r.EpisodeNumber)" />
        }
    </div>
    }
}
@if (selecting && items is not null)
{
    var visible = Sorted(items.Where(Matches)).ToList();
    <div class="bulk-bar" role="toolbar" aria-label="Selected ratings">
        <span><b>@selected.Count</b> selected</span>
        @if (visible.Count > 0)
        {
            @if (visible.All(r => selected.Contains(Key(r)))) { <button class="btn btn-sm btn-ghost" @onclick="() => selected.Clear()">Unselect all</button> }
            else { <button class="btn btn-sm btn-ghost" @onclick="() => { foreach (var r in visible) selected.Add(Key(r)); }">Select all @visible.Count</button> }
        }
        <span class="bulk-actions">
            <button class="btn btn-sm btn-danger" disabled="@(selected.Count == 0 || busy)" @onclick="RemoveSelected"><Icon Name="trash" Size="16" /> Remove ratings</button>
        </span>
    </div>
    <div class="bulk-spacer" aria-hidden="true"></div>
}
<ReloadOnMenu OnChange="Load" />
@code {
    private List<RatingEntry>? items;
    private string? error;
    private MediaType? filter;
    private int? stars;
    private ListLayout layout = Fmt.Prefs.LayoutFor("ratings");
    private static readonly (string Key, string Label)[] Sorts = [("recent", "Recently rated"), ("high", "Highest first"), ("low", "Lowest first"), ("title", "Title")];
    private string sort = Sorts.Any(x => x.Key == Fmt.Prefs.SortFor("ratings")) ? Fmt.Prefs.SortFor("ratings")! : "recent";

    private bool Matches(RatingEntry r) => (filter is null || r.Type == filter)
        && (stars is null || (Fmt.Scale == RatingScale.Thumbs ? RatingThumbs.Liked(r.Rating) == (stars >= 6)
            : (Fmt.FiveStars ? (int)Math.Round(r.Rating, MidpointRounding.AwayFromZero) : (int)Math.Floor(r.Rating + 1e-9)) == stars));

    private bool selecting, busy;
    private readonly HashSet<(MediaType, int, int?, int?)> selected = [];
    /// <summary>Where a rating leads: the episode or season that was rated, not just its show.</summary>
    private static string RatedHref(RatingEntry r) =>
        r.Type == MediaType.Episode ? Fmt.EpisodeHref(r.TmdbId, r.SeasonNumber, r.EpisodeNumber)
        : r.Type != MediaType.Movie && r.SeasonNumber is { } s ? $"show/{r.TmdbId}/season/{s}"
        : Fmt.Href(r.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, r.TmdbId);

    private static (MediaType, int, int?, int?) Key(RatingEntry r) => (r.Type, r.TmdbId, r.SeasonNumber, r.EpisodeNumber);

    /// <summary>Removes every selected rating, with Undo putting each one back as it was.</summary>
    private async Task RemoveSelected()
    {
        var gone = items!.Where(r => selected.Contains(Key(r))).ToList();
        if (gone.Count > 1 && !await Confirmer.AskAsync($"Remove {gone.Count} ratings?", "You can undo it straight after.", "Remove", danger: true)) return;
        busy = true;
        try
        {
            foreach (var r in gone) await Api.UnrateAsync(r.Type == MediaType.Show && r.SeasonNumber is null ? MediaType.Show : r.Type, r.TmdbId, r.SeasonNumber, r.EpisodeNumber);
            selected.Clear();
            Toasts.Show($"Removed {gone.Count} rating{(gone.Count == 1 ? "" : "s")}", undo: async () =>
            {
                foreach (var r in gone) await Api.RateAsync(new RatingRequest(r.Type, r.TmdbId, r.Rating, r.SeasonNumber, r.EpisodeNumber));
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); await Load(); }
        finally { busy = false; }
    }

    private IEnumerable<RatingEntry> Sorted(IEnumerable<RatingEntry> q) => sort switch
    {
        "high" => q.OrderByDescending(r => r.Rating).ThenByDescending(r => r.RatedAt),
        "low" => q.OrderBy(r => r.Rating).ThenByDescending(r => r.RatedAt),
        "title" => q.OrderBy(r => r.Title, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.SeasonNumber).ThenBy(r => r.EpisodeNumber),
        _ => q.OrderByDescending(r => r.RatedAt),
    };

    private Task SetSort(string s)
    {
        sort = s;
        return PagePrefs.SetSortAsync(Session, Api, "ratings", s);
    }

    /// <summary>Someone else's ratings (read-only), shared at u/{name}/ratings.</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    private bool Mine => Other is null;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? loadedFor = "\0";

    protected override async Task OnParametersSetAsync()
    {
        if (Mine && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
            return;
        }
        if (loadedFor != Other) { loadedFor = Other; items = null; selecting = false; selected.Clear(); await Load(); }
    }

    // Type and score go in the address, so Back from a title returns to the same filtered list.
    [SupplyParameterFromQuery(Name = "type")] public string? TypeParam { get; set; }
    [SupplyParameterFromQuery(Name = "score")] public int? ScoreParam { get; set; }
    protected override void OnParametersSet()
    {
        filter = Enum.TryParse<MediaType>(TypeParam, true, out var t) ? t : null;
        stars = ScoreParam is >= 1 and <= 10 ? ScoreParam : null;
    }
    private void SetFilter(MediaType? f) { filter = f; Remember(); }
    private void SetStars(int? n) { stars = n; Remember(); }
    private void Remember() => Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["type"] = filter?.ToString().ToLowerInvariant(),
        ["score"] = stars,
    }), replace: true);

    private async Task Load()
    {
        error = null;
        try { items = await Api.RatingsAsync(user: Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"{Other}'s ratings are private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
    }
}
