@page "/ratings"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
<PageTitle>Ratings · SeenIt</PageTitle>

<div class="page-head">
    <h1>Ratings</h1>
    <div class="segmented">
        <button class="@(filter is null ? "on" : "")" @onclick="() => filter = null">All</button>
        <button class="@(filter == MediaType.Movie ? "on" : "")" @onclick="() => filter = MediaType.Movie">Movies</button>
        <button class="@(filter == MediaType.Show ? "on" : "")" @onclick="() => filter = MediaType.Show">Shows</button>
        <button class="@(filter == MediaType.Episode ? "on" : "")" @onclick="() => filter = MediaType.Episode">Episodes</button>
    </div>
</div>
<div class="chips">
    @for (var i = 10; i >= 1; i--)
    {
        var n = i;
        <button class="chip @(stars == n ? "on" : "")" @onclick="() => stars = stars == n ? null : n">@(Fmt.FiveStars ? "★ " + Fmt.Stars(n) : n)</button>
    }
</div>
<div class="chips">
    @foreach (var (key, label) in Sorts)
    {
        <button class="chip @(sort == key ? "on" : "")" @onclick="() => SetSort(key)">@label</button>
    }
    <LayoutToggle Page="ratings" Value="layout" ValueChanged="v => layout = v" />
</div>
<ErrorBox Message="@error" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = Sorted(items.Where(r => (filter is null || r.Type == filter) && (stars is null || (Fmt.FiveStars ? (int)Math.Round(r.Rating, MidpointRounding.AwayFromZero) : (int)Math.Floor(r.Rating + 1e-9)) == stars))).ToList();
    @if (shown.Count == 0) { <Empty Title="No ratings here." /> }
    @if (layout == ListLayout.Rows)
    {
        <ol class="list-rows">
            @foreach (var r in shown)
            {
                <li class="list-row" @key="(r.Type, r.TmdbId, r.SeasonNumber, r.EpisodeNumber)" data-ctx="@(r.Type == MediaType.Episode && r.SeasonNumber is { } cs && r.EpisodeNumber is { } ce ? Menu.Episode(r.TmdbId, cs, ce, r.Title, null, r.PosterPath) : Menu.Title(r.Type, r.TmdbId, r.Title, r.PosterPath))">
                    <a href="@(r.Type == MediaType.Episode ? Fmt.EpisodeHref(r.TmdbId, r.SeasonNumber, r.EpisodeNumber) : Fmt.Href(r.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, r.TmdbId))" class="list-row-link">
                        <img src="@Img.Poster(r.PosterPath, "w92")" alt="" loading="lazy" />
                        <span class="list-row-main">
                            <b>@r.Title</b>
                            <span class="muted small">@(r.Type == MediaType.Episode ? Fmt.Ep(r.SeasonNumber, r.EpisodeNumber) : r.SeasonNumber is { } rs ? (rs == 0 ? "Specials" : $"Season {rs}") : r.Type == MediaType.Movie ? "Movie" : "TV")<span class="dot-sep">rated @r.RatedAt.ToLocalTime().ToString(Fmt.DateLong)</span></span>
                        </span>
                    </a>
                    <span class="pill">@Fmt.RatingBadge(r.Rating)</span>
                </li>
            }
        </ol>
    }
    else
    {
    <div class="poster-grid">
        @foreach (var r in shown)
        {
            <PosterCard Media="@(new MediaSummary(r.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, r.TmdbId, r.Title, null, r.PosterPath, null, null, null))"
                        Badge="@Fmt.RatingBadge(r.Rating)" ShowScore="false"
                        Sub="@(r.Type == MediaType.Episode ? Fmt.Ep(r.SeasonNumber, r.EpisodeNumber) : r.SeasonNumber is { } rs ? (rs == 0 ? "Specials" : $"Season {rs}") : r.RatedAt.ToLocalTime().ToString(Fmt.DateLong))"
                        @key="(r.Type, r.TmdbId, r.SeasonNumber, r.EpisodeNumber)" />
        }
    </div>
    }
}
<ReloadOnMenu OnChange="Load" />
@code {
    private List<RatingEntry>? items;
    private string? error;
    private MediaType? filter;
    private int? stars;
    private ListLayout layout = Fmt.Prefs.LayoutFor("ratings");
    private static readonly (string Key, string Label)[] Sorts = [("recent", "Recently rated"), ("high", "Highest first"), ("low", "Lowest first"), ("title", "Title")];
    private string sort = Sorts.Any(x => x.Key == Fmt.Prefs.SortFor("ratings")) ? Fmt.Prefs.SortFor("ratings")! : "recent";

    private IEnumerable<RatingEntry> Sorted(IEnumerable<RatingEntry> q) => sort switch
    {
        "high" => q.OrderByDescending(r => r.Rating).ThenByDescending(r => r.RatedAt),
        "low" => q.OrderBy(r => r.Rating).ThenByDescending(r => r.RatedAt),
        "title" => q.OrderBy(r => r.Title, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.SeasonNumber).ThenBy(r => r.EpisodeNumber),
        _ => q.OrderByDescending(r => r.RatedAt),
    };

    private Task SetSort(string s)
    {
        sort = s;
        return PagePrefs.SetSortAsync(Session, Api, "ratings", s);
    }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { items = await Api.RatingsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }
}
