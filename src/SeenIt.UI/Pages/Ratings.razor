@page "/ratings"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Ratings · SeenIt</PageTitle>

<div class="page-head">
    <h1>Ratings</h1>
    <div class="segmented">
        <button class="@(filter is null ? "on" : "")" @onclick="() => filter = null">All</button>
        <button class="@(filter == MediaType.Movie ? "on" : "")" @onclick="() => filter = MediaType.Movie">Movies</button>
        <button class="@(filter == MediaType.Show ? "on" : "")" @onclick="() => filter = MediaType.Show">Shows</button>
        <button class="@(filter == MediaType.Episode ? "on" : "")" @onclick="() => filter = MediaType.Episode">Episodes</button>
    </div>
</div>
<div class="chips">
    @for (var i = 10; i >= 1; i--)
    {
        var n = i;
        <button class="chip @(stars == n ? "on" : "")" @onclick="() => stars = stars == n ? null : n">@n</button>
    }
</div>
<ErrorBox Message="@error" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = items.Where(r => (filter is null || r.Type == filter) && (stars is null || r.Rating == stars)).ToList();
    @if (shown.Count == 0) { <Empty Title="No ratings here." /> }
    <div class="poster-grid">
        @foreach (var r in shown)
        {
            <PosterCard Media="@(new MediaSummary(r.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, r.TmdbId, r.Title, null, r.PosterPath, null, null, null))"
                        Badge="@($"★ {r.Rating}")" ShowScore="false"
                        Sub="@(r.Type == MediaType.Episode ? Fmt.Ep(r.SeasonNumber, r.EpisodeNumber) : r.RatedAt.ToLocalTime().ToString("MMM d, yyyy"))"
                        @key="(r.Type, r.TmdbId, r.SeasonNumber, r.EpisodeNumber)" />
        }
    </div>
}
@code {
    private List<RatingEntry>? items;
    private string? error;
    private MediaType? filter;
    private int? stars;

    protected override async Task OnInitializedAsync()
    {
        try { items = await Api.RatingsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }
}
