@page "/calendar"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime Js
<PageTitle>Calendar · SeenIt</PageTitle>

<div class="page-head">
    <h1>Calendar</h1>
    <div class="segmented">
        <button class="@(month ? "" : "on")" @onclick="() => SetView(false)">List</button>
        <button class="@(month ? "on" : "")" @onclick="() => SetView(true)">Month</button>
    </div>
    <div class="inline">
        <button class="btn btn-sm" @onclick="() => Shift(-1)" aria-label="Earlier"><Icon Name="chevron-left" Size="16" /></button>
        <button class="btn btn-sm" @onclick="Today">Today</button>
        <button class="btn btn-sm" @onclick="() => Shift(1)" aria-label="Later"><Icon Name="chevron-right" Size="16" /></button>
        <input type="date" class="cal-jump" value="@((month ? picked ?? anchor : from.AddDays(3)).ToString("yyyy-MM-dd"))" @onchange="Jump" aria-label="Go to a date" />
    </div>
</div>
<div class="chips">
    <button class="chip @(kind is null ? "on" : "")" @onclick="() => SetFilter(() => kind = null)">All</button>
    <button class="chip @(kind == MediaType.Movie ? "on" : "")" @onclick="() => SetFilter(() => kind = MediaType.Movie)">Movies</button>
    <button class="chip @(kind == MediaType.Episode ? "on" : "")" @onclick="() => SetFilter(() => kind = MediaType.Episode)">Shows</button>
    <button class="chip @(hideWatched ? "on" : "")" @onclick="() => SetFilter(() => hideWatched = !hideWatched)" aria-pressed="@hideWatched">Hide watched</button>
    <button class="chip @(hidePremieres ? "on" : "")" @onclick="() => SetFilter(() => hidePremieres = !hidePremieres)" aria-pressed="@hidePremieres" title="Season premieres of shows that are only on your watchlist">Hide premieres of shows I haven't started</button>
</div>
@* One show, or one channel / streaming service, from what's in the range on screen (not remembered: it changes as you move). *@
@if (items is { Count: > 0 })
{
    var showChoices = items.Where(c => c.Type != MediaType.Movie).GroupBy(c => c.TmdbId).Select(g => (Id: g.Key, g.First().Title)).OrderBy(x => x.Title).ToList();
    var networkChoices = items.Select(c => c.Network).OfType<string>().Distinct().Order().ToList();
    <div class="filter-row">
        @if (showChoices.Count > 1 || onlyShow is not null)
        {
            <label class="sort-pick">
                <span class="muted small">Show</span>
                <select value="@(onlyShow?.ToString() ?? "")" @onchange="e => onlyShow = int.TryParse(e.Value as string, out var id) ? id : null">
                    <option value="">All shows</option>
                    @foreach (var (id, title) in showChoices) { <option value="@id">@title</option> }
                </select>
            </label>
        }
        @if (networkChoices.Count > 1 || network is not null)
        {
            <label class="sort-pick">
                <span class="muted small">On</span>
                <select value="@(network ?? "")" @onchange="e => network = e.Value as string is { Length: > 0 } n ? n : null">
                    <option value="">Any channel or service</option>
                    @foreach (var n in networkChoices) { <option value="@n">@n</option> }
                </select>
            </label>
        }
    </div>
}
<p class="muted small">@(month ? anchor.ToString("MMMM yyyy") : $"{(from).ToString(Fmt.DateShort)} – {(from.AddDays(Days - 1)).ToString(Fmt.DateLong)}")</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = items.Where(Keep).ToList();
    var today = DateOnly.FromDateTime(DateTime.Today);
    @if (month)
    {
        var first = new DateOnly(anchor.Year, anchor.Month, 1);
        var start = first.AddDays(-(((int)first.DayOfWeek - (int)Fmt.WeekStart + 7) % 7));
        var byDay = shown.GroupBy(i => i.Date).ToDictionary(g => g.Key, g => g.ToList());
        <div class="cal-month" role="grid" aria-label="@anchor.ToString("MMMM yyyy")">
            @foreach (var wd in WeekDays) { <div class="cal-dow" role="columnheader">@wd</div> }
            @for (var d = start; d < start.AddDays(42); d = d.AddDays(1))
            {
                var day = d;
                if (day > first.AddMonths(1).AddDays(-1) && day.DayOfWeek == Fmt.WeekStart) break;
                var list = byDay.GetValueOrDefault(day) ?? [];
                <button class="cal-cell @(day.Month != anchor.Month ? "other" : "") @(day == today ? "today" : "") @(day == picked ? "picked" : "") @(list.Count > 0 ? "busy" : "")"
                        @onclick="() => picked = day" role="gridcell" aria-label="@($"{(day).ToString(Fmt.DayLong)}: {list.Count} release{(list.Count == 1 ? "" : "s")}")" @key="day">
                    <span class="cal-num">@day.Day</span>
                    @foreach (var c in list.Take(3)) { <span class="cal-pill @(c.Watched ? "watched" : "")">@c.Title</span> }
                    @if (list.Count > 3) { <span class="cal-more">+@(list.Count - 3) more</span> }
                </button>
            }
        </div>
        @if (picked is { } p)
        {
            <section class="cal-day">
                <h3 class="day-head">@Fmt.Day(p) @if (Fmt.DayNote(p) is { } pn) { <span class="muted small">@pn</span> }</h3>
                @if (byDay.GetValueOrDefault(p) is { Count: > 0 } dayItems) { <div class="mini-list">@foreach (var c in dayItems) { @Entry(c) }</div> }
                else { <p class="muted small">Nothing that day.</p> }
            </section>
        }
    }
    else
    {
        @if (shown.Count == 0) { <Empty Title="Nothing airing in this window." /> }
        @foreach (var day in shown.GroupBy(i => i.Date))
        {
            <section class="cal-day @(day.Key == today ? "today" : "") @(day.Key >= today ? "from-today" : "")">
                <h3 class="day-head">@Fmt.Day(day.Key) @if (Fmt.DayNote(day.Key) is { } dn) { <span class="muted small">@dn</span> }@if (day.Key > today.AddDays(1) && Fmt.Countdown(day.Key) is { } cd) { <span class="countdown small"> · @cd</span> }</h3>
                <div class="mini-list">@foreach (var c in day) { @Entry(c) }</div>
            </section>
        }
    }
}
<ReloadOnMenu OnChange="Load" />
@code {
    private const int Days = 28;
    private static IEnumerable<string> WeekDays => Enumerable.Range(0, 7).Select(i => ((DayOfWeek)(((int)Fmt.WeekStart + i) % 7)).ToString()[..3]);
    private bool month, hideWatched, hidePremieres;
    private MediaType? kind;
    private DateOnly anchor = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today).AddDays(-3);
    private DateOnly? picked = DateOnly.FromDateTime(DateTime.Today);
    private List<CalendarEntry>? items;
    private string? error;

    private RenderFragment Entry(CalendarEntry c) => __builder =>
    {
        <a class="mini-item @(c.Watched ? "watched" : "")" href="@Fmt.CalHref(c)" data-ctx="@Menu.Cal(c)" @key="(c.Type, c.TmdbId, c.SeasonNumber, c.EpisodeNumber)">
            <img src="@Img.Poster(c.PosterPath, "w92")" alt="" loading="lazy" />
            <div>
                <div class="mini-title"><TitleLink Href="@(c.Type == MediaType.Episode ? $"show/{c.TmdbId}" : null)">@c.Title</TitleLink></div>
                <div class="muted small">
                    @if (c.Type == MediaType.Episode) { @Fmt.Ep(c.SeasonNumber, c.EpisodeNumber)<span class="dot-sep"></span><Spoiler Watched="c.Watched">@c.EpisodeTitle</Spoiler> <EpisodeBadge Mark="c.Mark" /> } else { <span>@Fmt.CalKind(c)</span> }
                </div>
                @if (Fmt.AirTime(c.AirsAt, c.Network) is { } when)
                {
                    <div class="small">@when@if (!c.Watched && c.AirsAt is { } at && Fmt.Countdown(at) is { } left && at - DateTimeOffset.Now < TimeSpan.FromHours(36)) { <span class="countdown"> · @left</span> }</div>
                }
            </div>
            @if (c.Watched) { <span class="ok"><Icon Name="check" Size="18" /></span> }
        </a>
    };

    private int? onlyShow;
    private string? network;

    private bool Keep(CalendarEntry c) =>
        (kind is null || c.Type == kind || (kind == MediaType.Episode && c.Type == MediaType.Show))
        && (onlyShow is null || (c.Type != MediaType.Movie && c.TmdbId == onlyShow))
        && (network is null || c.Network == network)
        && (!hideWatched || !c.Watched)
        && (!hidePremieres || c.Type != MediaType.Episode || c.Started || c.EpisodeNumber != 1);

    /// <summary>Where you were this session (Back from an episode, or another tab, comes back to it), and the view and
    /// filters, which this device remembers.</summary>
    private static (DateOnly Anchor, DateOnly From, DateOnly? Picked, DateOnly Day)? Was;
    private const string PrefsKey = "seenit.calendar";
    private bool scrolled;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Js.InvokeAsync<string?>("localStorage.getItem", PrefsKey) is { } saved && saved.Split('|') is [var v, var k, var w, var p])
            {
                month = v == "month";
                kind = Enum.TryParse<MediaType>(k, out var mk) ? mk : null;
                hideWatched = w == "1";
                hidePremieres = p == "1";
            }
        }
        catch (JSException) { }
        if (Was is { } was && was.Day == DateOnly.FromDateTime(DateTime.Today)) (anchor, from, picked) = (was.Anchor, was.From, was.Picked);
        await Load();
    }

    private async Task SetFilter(Action change)
    {
        change();
        try { await Js.InvokeVoidAsync("localStorage.setItem", PrefsKey, $"{(month ? "month" : "list")}|{kind}|{(hideWatched ? 1 : 0)}|{(hidePremieres ? 1 : 0)}"); }
        catch (JSException) { }
    }

    /// <summary>The list starts a few days back (did I catch that?); bring today to the top once it's drawn.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Was = (anchor, from, picked, DateOnly.FromDateTime(DateTime.Today));
        if (scrolled || month || items is null) return;
        scrolled = true;
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (from > today || from.AddDays(Days) <= today) return;
        try { await Js.InvokeVoidAsync("seenit.scrollToFirst", ".cal-day.from-today"); } catch (JSException) { }
    }

    private async Task Load()
    {
        error = null;
        items = null;
        try
        {
            if (month)
            {
                var first = new DateOnly(anchor.Year, anchor.Month, 1);
                var start = first.AddDays(-(((int)first.DayOfWeek - (int)Fmt.WeekStart + 7) % 7));
                items = await Api.CalendarAsync(start, 42);
            }
            else items = await Api.CalendarAsync(from, Days);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private Task SetView(bool m)
    {
        if (m == month) return Task.CompletedTask;
        month = m;
        _ = SetFilter(() => { });
        anchor = month ? new DateOnly(from.AddDays(3).Year, from.AddDays(3).Month, 1) : anchor;
        if (!month) from = anchor.AddDays(-3);
        return Load();
    }

    private Task Shift(int step)
    {
        if (month) { anchor = new DateOnly(anchor.Year, anchor.Month, 1).AddMonths(step); picked = null; }
        else from = from.AddDays(14 * step);
        return Load();
    }

    private Task Today()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        anchor = today; picked = today;
        from = today.AddDays(-3);
        scrolled = false;   // and bring today into view again
        return Load();
    }

    private Task Jump(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var d)) return Task.CompletedTask;
        anchor = d; picked = d;
        from = d.AddDays(-1);
        return Load();
    }
}
