@page "/calendar"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Calendar · SeenIt</PageTitle>

<div class="page-head">
    <h1>Calendar</h1>
    <div class="segmented">
        <button class="@(month ? "" : "on")" @onclick="() => SetView(false)">List</button>
        <button class="@(month ? "on" : "")" @onclick="() => SetView(true)">Month</button>
    </div>
    <div class="inline">
        <button class="btn btn-sm" @onclick="() => Shift(-1)" aria-label="Earlier"><Icon Name="chevron-left" Size="16" /></button>
        <button class="btn btn-sm" @onclick="Today">Today</button>
        <button class="btn btn-sm" @onclick="() => Shift(1)" aria-label="Later"><Icon Name="chevron-right" Size="16" /></button>
        <input type="date" class="cal-jump" value="@((month ? picked ?? anchor : from.AddDays(3)).ToString("yyyy-MM-dd"))" @onchange="Jump" aria-label="Go to a date" />
    </div>
</div>
<div class="chips">
    <button class="chip @(kind is null ? "on" : "")" @onclick="() => kind = null">All</button>
    <button class="chip @(kind == MediaType.Movie ? "on" : "")" @onclick="() => kind = MediaType.Movie">Movies</button>
    <button class="chip @(kind == MediaType.Episode ? "on" : "")" @onclick="() => kind = MediaType.Episode">Shows</button>
    <button class="chip @(hideWatched ? "on" : "")" @onclick="() => hideWatched = !hideWatched" aria-pressed="@hideWatched">Hide watched</button>
    <button class="chip @(hidePremieres ? "on" : "")" @onclick="() => hidePremieres = !hidePremieres" aria-pressed="@hidePremieres" title="Season premieres of shows that are only on your watchlist">Hide premieres of shows I haven't started</button>
</div>
<p class="muted small">@(month ? anchor.ToString("MMMM yyyy") : $"{(from).ToString(Fmt.DateShort)} – {(from.AddDays(Days - 1)).ToString(Fmt.DateLong)}")</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = items.Where(Keep).ToList();
    var today = DateOnly.FromDateTime(DateTime.Today);
    @if (month)
    {
        var first = new DateOnly(anchor.Year, anchor.Month, 1);
        var start = first.AddDays(-(((int)first.DayOfWeek - (int)Fmt.WeekStart + 7) % 7));
        var byDay = shown.GroupBy(i => i.Date).ToDictionary(g => g.Key, g => g.ToList());
        <div class="cal-month" role="grid" aria-label="@anchor.ToString("MMMM yyyy")">
            @foreach (var wd in WeekDays) { <div class="cal-dow" role="columnheader">@wd</div> }
            @for (var d = start; d < start.AddDays(42); d = d.AddDays(1))
            {
                var day = d;
                if (day > first.AddMonths(1).AddDays(-1) && day.DayOfWeek == Fmt.WeekStart) break;
                var list = byDay.GetValueOrDefault(day) ?? [];
                <button class="cal-cell @(day.Month != anchor.Month ? "other" : "") @(day == today ? "today" : "") @(day == picked ? "picked" : "") @(list.Count > 0 ? "busy" : "")"
                        @onclick="() => picked = day" role="gridcell" aria-label="@($"{(day).ToString(Fmt.DayLong)}: {list.Count} release{(list.Count == 1 ? "" : "s")}")" @key="day">
                    <span class="cal-num">@day.Day</span>
                    @foreach (var c in list.Take(3)) { <span class="cal-pill @(c.Watched ? "watched" : "")">@c.Title</span> }
                    @if (list.Count > 3) { <span class="cal-more">+@(list.Count - 3) more</span> }
                </button>
            }
        </div>
        @if (picked is { } p)
        {
            <section class="cal-day">
                <h3 class="day-head">@Fmt.Day(p) <span class="muted small">@p.ToString(Fmt.DateShort)</span></h3>
                @if (byDay.GetValueOrDefault(p) is { Count: > 0 } dayItems) { <div class="mini-list">@foreach (var c in dayItems) { @Entry(c) }</div> }
                else { <p class="muted small">Nothing that day.</p> }
            </section>
        }
    }
    else
    {
        @if (shown.Count == 0) { <Empty Title="Nothing airing in this window." /> }
        @foreach (var day in shown.GroupBy(i => i.Date))
        {
            <section class="cal-day @(day.Key == today ? "today" : "")">
                <h3 class="day-head">@Fmt.Day(day.Key) <span class="muted small">@day.Key.ToString(Fmt.DateShort)</span>@if (day.Key > today.AddDays(1) && Fmt.Countdown(day.Key) is { } cd) { <span class="countdown small"> · @cd</span> }</h3>
                <div class="mini-list">@foreach (var c in day) { @Entry(c) }</div>
            </section>
        }
    }
}
@code {
    private const int Days = 28;
    private static IEnumerable<string> WeekDays => Enumerable.Range(0, 7).Select(i => ((DayOfWeek)(((int)Fmt.WeekStart + i) % 7)).ToString()[..3]);
    private bool month, hideWatched, hidePremieres;
    private MediaType? kind;
    private DateOnly anchor = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today).AddDays(-3);
    private DateOnly? picked = DateOnly.FromDateTime(DateTime.Today);
    private List<CalendarEntry>? items;
    private string? error;

    private RenderFragment Entry(CalendarEntry c) => __builder =>
    {
        <a class="mini-item @(c.Watched ? "watched" : "")" href="@Fmt.CalHref(c)" @key="(c.Type, c.TmdbId, c.SeasonNumber, c.EpisodeNumber)">
            <img src="@Img.Poster(c.PosterPath, "w92")" alt="" loading="lazy" />
            <div>
                <div class="mini-title">@c.Title</div>
                <div class="muted small">
                    @if (c.Type == MediaType.Episode) { @Fmt.Ep(c.SeasonNumber, c.EpisodeNumber)<span class="dot-sep"></span><Spoiler Watched="c.Watched">@c.EpisodeTitle</Spoiler> } else { <span>@Fmt.CalKind(c)</span> }
                </div>
                @if (Fmt.AirTime(c.AirsAt, c.Network) is { } when)
                {
                    <div class="small">@when@if (!c.Watched && c.AirsAt is { } at && Fmt.Countdown(at) is { } left && at - DateTimeOffset.Now < TimeSpan.FromHours(36)) { <span class="countdown"> · @left</span> }</div>
                }
            </div>
            @if (c.Watched) { <span class="ok"><Icon Name="check" Size="18" /></span> }
        </a>
    };

    private bool Keep(CalendarEntry c) =>
        (kind is null || c.Type == kind || (kind == MediaType.Episode && c.Type == MediaType.Show))
        && (!hideWatched || !c.Watched)
        && (!hidePremieres || c.Type != MediaType.Episode || c.Started || c.EpisodeNumber != 1);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        items = null;
        try
        {
            if (month)
            {
                var first = new DateOnly(anchor.Year, anchor.Month, 1);
                var start = first.AddDays(-(((int)first.DayOfWeek - (int)Fmt.WeekStart + 7) % 7));
                items = await Api.CalendarAsync(start, 42);
            }
            else items = await Api.CalendarAsync(from, Days);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private Task SetView(bool m)
    {
        if (m == month) return Task.CompletedTask;
        month = m;
        anchor = month ? new DateOnly(from.AddDays(3).Year, from.AddDays(3).Month, 1) : anchor;
        if (!month) from = anchor.AddDays(-3);
        return Load();
    }

    private Task Shift(int step)
    {
        if (month) { anchor = new DateOnly(anchor.Year, anchor.Month, 1).AddMonths(step); picked = null; }
        else from = from.AddDays(14 * step);
        return Load();
    }

    private Task Today()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        anchor = today; picked = today;
        from = today.AddDays(-3);
        return Load();
    }

    private Task Jump(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var d)) return Task.CompletedTask;
        anchor = d; picked = d;
        from = d.AddDays(-1);
        return Load();
    }
}
