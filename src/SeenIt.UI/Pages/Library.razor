@page "/library"
@page "/u/{UserName}/library"
@* No [Authorize]: someone's shared library follows their Library privacy; your own needs signing in. *@
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>@(Other is { } on ? $"{on}'s library" : "My library") · SeenIt</PageTitle>
@if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }

<div class="page-head">
    <h1>@(Other is { } o ? $"{o}'s library" : "My library")</h1>
    <div class="segmented">
        <button class="@(type is null ? "on" : "")" @onclick="() => type = null">All</button>
        <button class="@(type == MediaType.Movie ? "on" : "")" @onclick="() => type = MediaType.Movie">Movies</button>
        <button class="@(type == MediaType.Show ? "on" : "")" @onclick="() => type = MediaType.Show">Shows</button>
    </div>
</div>
<p class="muted small">What you own, separate from what you've watched, in as many formats as you have it (and for shows, which seasons). Add things with <b>Own it</b> on any movie or show; Plex and Jellyfin add what lands on your server (Settings → Media servers), and you can import what's already there (Settings → Import).</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is { Count: 0 }) { <Empty Title="Your library is empty." /> }
else if (items is not null)
{
    <div class="searchbar">
        <Icon Name="search" Size="18" />
        <input type="search" @bind="find" @bind:event="oninput" placeholder="Filter your library" aria-label="Filter your library" />
    </div>
    <div class="chips">
        <button class="chip @(format is null ? "on" : "")" @onclick="() => format = null">Any format</button>
        @foreach (var f in items.SelectMany(Formats).Distinct().Order())
        {
            <button class="chip @(format == f ? "on" : "")" @onclick="() => format = format == f ? null : f" @key="f">@OwnedFormats.Label(f) · @items.Count(i => Formats(i).Contains(f))</button>
        }
        <button class="chip @(unwatched ? "on" : "")" @onclick="() => unwatched = !unwatched">Not watched yet</button>
    </div>
    var shown = items.Where(i => (type is null || i.Media.Type == type) && (format is null || Formats(i).Contains(format.Value)) && (!unwatched || !i.Watched)
        && TextMatch.Contains(i.Media.Title, find)).ToList();
    <p class="muted small">@shown.Count of @items.Count</p>
    <div class="poster-grid">
        @foreach (var i in shown)
        {
            var copies = Copies(i);
            var kinds = copies.Select(c => c.Format).Distinct().ToList();
            <PosterCard Media="i.Media" Badge="@(kinds.Count == 1 ? OwnedFormats.Label(kinds[0]) : $"{OwnedFormats.Label(kinds[0])} +{kinds.Count - 1}")"
                        Detail="@(kinds.Count > 1 || copies.Any(c => c.SeasonNumber is not null) ? OwnedFormats.Describe(copies) : null)"
                        Sub="@(i.Watched ? "Watched" : "Not watched yet")"
                        SubTitle="@($"{OwnedFormats.Describe(copies)} · added {(i.AddedAt.ToLocalTime()).ToString(Fmt.DateLong)}{(i.Source == WatchSource.Manual ? "" : $" by {WatchSources.Name(i.Source)}")}")" @key="(i.Media.Type, i.Media.TmdbId)" />
        }
    </div>
}
@code {
    private List<LibraryEntry>? items;
    private string? error;
    private MediaType? type;
    private OwnedFormat? format;
    private bool unwatched;
    private string find = "";

    /// <summary>Every copy; an older server sends only the one format.</summary>
    private static IReadOnlyList<OwnedCopy> Copies(LibraryEntry i) => i.Copies is { Count: > 0 } c ? c : [new OwnedCopy(i.Format, null, i.Source, i.AddedAt)];
    private static IEnumerable<OwnedFormat> Formats(LibraryEntry i) => Copies(i).Select(c => c.Format).Distinct();

    /// <summary>Someone else's library (read-only), shared at u/{name}/….</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    private bool Mine => Other is null;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? loadedFor = "\0";

    protected override async Task OnParametersSetAsync()
    {
        if (Mine && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
            return;
        }
        if (loadedFor != Other) { loadedFor = Other; items = null; await Load(); }
    }

    private async Task Load()
    {
        error = null;
        try { items = await Api.LibraryAsync(Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"{Other}'s library is private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
    }
}
