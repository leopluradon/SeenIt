@page "/person/{Id:int}"
@inject ApiClient Api
@inject SessionState Session
@inject Toasts Toasts
<PageTitle>@(p?.Name ?? "Person") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" NotFound="notFound" />
@if (p is null && error is null) { <Spinner Shape="title" /> }
else if (p is not null)
{
    <div class="person-head">
        <div class="person-photo">
            @if (Img.Poster(p.ProfilePath, "w342") is { } src) { <img src="@src" alt="" /> }
            else { <div class="cast-fallback">@p.Name[..1]</div> }
        </div>
        <div class="person-info">
            <div class="person-title">
                <h1>@p.Name</h1>
                @if (Session.Me is not null)
                {
                    <button class="btn btn-sm @(p.Following ? "btn-on" : "btn-primary")" disabled="@following" @onclick="ToggleFollow" aria-pressed="@p.Following"
                            title="@(p.Following ? "Stop following" : "Their new movies and shows go on your calendar and release alerts")">
                        <Icon Name="@(p.Following ? "check" : "user-plus")" Size="16" /> @(p.Following ? "Following" : "Follow")
                    </button>
                }
            </div>
            @if (seenLoading) { <p class="person-seen" aria-label="Checking what you've seen them in"><span class="skeleton skel-text"></span></p> }
            else if (p.Watched is not null && SeenLine(p) is { } seenLine) { <p class="person-seen">@seenLine</p> }
            <DetailStats Items="@([
                ("Known for", p.KnownFor),
                ("Born", p.Birthday is { } b ? $"{(b).ToString(Fmt.DateFull)}" + (p.Deathday is null ? $" (age {Age(b, DateOnly.FromDateTime(DateTime.Today))})" : "") : null),
                ("Died", p.Deathday is { } d ? $"{(d).ToString(Fmt.DateFull)}" + (p.Birthday is { } b2 ? $" (aged {Age(b2, d)})" : "") : null),
                ("From", p.PlaceOfBirth),
                ("Credits", string.Join(" · ", Groups.Select(g => $"{GroupCount(g):N0} {g.ToLowerInvariant()}"))),
            ])" />
            @if (p.Biography is { } bio)
            {
                <div class="bio @(bioOpen ? "open" : "")">
                    @foreach (var para in bio.Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <p>@para</p> }
                </div>
                @if (bio.Length > 420) { <button class="btn btn-sm btn-ghost" @onclick="() => bioOpen = !bioOpen">@(bioOpen ? "Show less" : "Read more")</button> }
            }
            <div class="links">
                @if (p.ImdbId is not null) { <a href="@($"https://www.imdb.com/name/{p.ImdbId}")" target="_blank" rel="noopener">IMDb</a> }
                <a href="@($"https://www.themoviedb.org/person/{p.Id}")" target="_blank" rel="noopener">TMDB</a>
                @* Wikidata sends this to their English Wikipedia article (or the Wikidata page when there isn't one). *@
                @if (p.WikidataId is { Length: > 0 } wd) { <a href="@($"https://www.wikidata.org/wiki/Special:GoToLinkedPage/enwiki/{Uri.EscapeDataString(wd)}")" target="_blank" rel="noopener">Wikipedia</a> }
            </div>
            @if (Session.Me is not null && Completion().ToList() is { Count: > 0 } progress)
            {
                @* How much of their movies you've seen, per role (Filmography.Counts: released, not obscure unless seen). *@
                <div class="completion">
                    @foreach (var (role, mine, all) in progress)
                    {
                        <div class="completion-row" @key="role">
                            <span class="small">@(mine >= all ? "✓ Every movie they " + role : $"{mine} of {all} movies they {role}")</span>
                            <ProgressBar Value="mine" Max="all" />
                        </div>
                    }
                    <a class="small" href="completionist">Completionist <Icon Name="chevron-right" Size="12" /></a>
                </div>
            }
            @* What they made with someone else, and which of it you've seen (person/{id}/with/{other}). *@
            <PersonPicker PersonId="p.Id" Placeholder="@($"What has {p.Name} worked on with…")" />
        </div>
    </div>

    @if (seenLoading)
    {
        @* Still checking which of their episodes you've seen (a TMDB lookup per show): placeholders meanwhile. *@
        <section class="row-section" aria-busy="true">
            <div class="section-head"><h2>You've watched them in</h2></div>
            <p class="muted small"><span class="skeleton skel-text"></span></p>
            <div class="watched-with">
                @for (var i = 0; i < Math.Min(4, p.PendingShows?.Count ?? 2); i++) { <div class="ww-item"><span class="skeleton ww-skel-poster"></span><div class="ww-body skel-lines"><span class="skeleton"></span><span class="skeleton"></span></div></div> }
            </div>
        </section>
    }
    else if (p.Watched is { } watched)
    {
        <section class="row-section">
            <div class="section-head"><h2>You've watched them in</h2></div>
            @if (watched.Count == 0)
            {
                <p class="muted">Nothing yet.</p>
            }
            else
            {
                <p class="muted small" title="@Fmt.HoursTip(p.WatchedMinutes)">@WatchedSummary(p)</p>
                <div class="watched-with">
                    @foreach (var w in watched)
                    {
                        <div class="ww-item" @key="(w.Type, w.TmdbId)">
                            <a href="@Fmt.Href(w.Type, w.TmdbId)"><img src="@Img.Poster(w.PosterPath, "w154")" alt="" loading="lazy" /></a>
                            <div class="ww-body">
                                <a href="@Fmt.Href(w.Type, w.TmdbId)" class="mini-title">@w.Title</a>
                                @if (w.Jobs is not null) { <div class="small">@w.Jobs</div> }
                                @if (w.Character is not null) { <div class="small">as @w.Character</div> }
                                <div class="muted small" title="@Fmt.HoursTip(w.Minutes)">
                                    @(w.Type == MediaType.Movie
                                        ? (w.Plays > 1 ? $"Watched {w.Plays}× · " : "Watched · ") + Fmt.Duration(w.Minutes)
                                        : (w.GuestRole ? $"{Plural(w.Episodes.Count, "episode")} you watched" : $"{Plural(w.Plays, "episode")} watched") + " · " + Fmt.Duration(w.Minutes))
                                </div>
                                @if (w.GuestRole && w.Episodes.Count > 0)
                                {
                                    <div class="ww-episodes">
                                        @foreach (var ep in w.Episodes)
                                        {
                                            <a class="chip" href="@Fmt.EpisodeHref(w.TmdbId, ep.SeasonNumber, ep.EpisodeNumber)" title="@ep.Name">@Fmt.Ep(ep.SeasonNumber, ep.EpisodeNumber)</a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }

    @if (Upcoming.Count > 0)
    {
        <section class="row-section">
            <div class="section-head">
                <h2>Coming up</h2>
                @if (p.Following) { <a class="section-more" href="calendar">On your calendar <Icon Name="chevron-right" Size="16" /></a> }
            </div>
            <div class="poster-scroller">
                @foreach (var c in Upcoming)
                {
                    <PosterCard Media="@(new MediaSummary(c.Type, c.TmdbId, c.Title, c.Date?.Year, c.PosterPath, null, null, null))"
                                Badge="@(c.Date is { } due ? due.ToString(Fmt.DateLong) : "Announced")" ShowScore="false" Sub="@c.Role" @key="(c.Type, c.TmdbId)" />
                }
            </div>
        </section>
    }

    @if (KnownFor.Count > 0)
    {
        <section class="row-section">
            <div class="section-head"><h2>Known for</h2></div>
            <div class="poster-scroller">
                @foreach (var c in KnownFor)
                {
                    <PosterCard Media="@(new MediaSummary(c.Type, c.TmdbId, c.Title, c.Date?.Year, c.PosterPath, null, null, null))"
                                Badge="@(c.Watched ? "✓ Seen" : c.PartlySeen ? "◐ Partly" : null)" ShowScore="false" Sub="@c.Role" @key="(c.Type, c.TmdbId)" />
                }
            </div>
        </section>
    }

    <section class="row-section">
        <div class="section-head">
            <h2>Filmography</h2>
            <div class="segmented">
                <button class="@(tab == "all" ? "on" : "")" @onclick='() => SetTab("all")'>All</button>
                <button class="@(tab == "movies" ? "on" : "")" @onclick='() => SetTab("movies")'>Movies</button>
                <button class="@(tab == "tv" ? "on" : "")" @onclick='() => SetTab("tv")'>TV</button>
            </div>
        </div>
        @if (Groups.Count > 1)
        {
            <div class="chips role-chips" role="group" aria-label="Roles">
                @foreach (var g in Groups)
                {
                    <button type="button" class="chip @(shown.Contains(g) ? "on" : "")" aria-pressed="@shown.Contains(g)" @onclick="() => ToggleGroup(g)" @key="g">
                        @g <span class="chip-count">@GroupCount(g)</span>
                    </button>
                }
            </div>
        }
        @{ var years = AllRows.Select(c => c.Date?.Year).OfType<int>().Distinct().OrderDescending().ToList(); }
        <FilterBar Query="@find" QueryChanged="q => { find = q; Remember(); }" Placeholder="Find a title or character" Label="Find in their filmography"
                   Active="ActiveFilters" Chips="Chips" OnClear="ClearFilters"
                   ViewPage="person" ViewPath="@($"person/{Id}")" ViewQuery="@UrlState.Query(State)">
            @if (Session.Me is not null)
            {
                <div class="field">
                    <label for="pf-seen">What I've seen</label>
                    <select id="pf-seen" value="@seen" @onchange='e => { seen = e.Value as string ?? ""; Remember(); }'>
                        <option value="">Show it</option>
                        <option value="fade">Fade it</option>
                        <option value="hide">Hide it</option>
                        <option value="only">Show only that</option>
                    </select>
                </div>
            }
            @if (years.Count > 1)
            {
                <div class="field">
                    <label for="pf-from">From</label>
                    <select id="pf-from" value="@(fromYear?.ToString() ?? "")" @onchange="e => { fromYear = int.TryParse(e.Value as string, out var y) ? y : null; Remember(); }">
                        <option value="">Any year</option>
                        @foreach (var y in years.AsEnumerable().Reverse()) { <option value="@y">@y</option> }
                    </select>
                </div>
                <div class="field">
                    <label for="pf-to">To</label>
                    <select id="pf-to" value="@(toYear?.ToString() ?? "")" @onchange="e => { toYear = int.TryParse(e.Value as string, out var y) ? y : null; Remember(); }">
                        <option value="">Any year</option>
                        @foreach (var y in years) { <option value="@y">@y</option> }
                    </select>
                </div>
            }
            <div class="field">
                <label for="pf-order">Order</label>
                <select id="pf-order" value="@order" @onchange='e => { order = e.Value as string ?? ""; Remember(); }'>
                    <option value="">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="popular">Best known first</option>
                    <option value="episodes">Most episodes</option>
                    <option value="title">Title</option>
                </select>
            </div>
            <label class="field inline check-field" title="Titles few people on TMDB have voted on: shorts, early bit parts, obscure TV">
                <input type="checkbox" checked="@majorOnly" @onchange="e => { majorOnly = e.Value is true; Remember(); }" /> Skip little-known titles
            </label>
            @if (p.Cast.Concat(p.Crew).Any(c => c.InLibrary))
            {
                <label class="field inline check-field"><input type="checkbox" checked="@libraryOnly" @onchange="e => { libraryOnly = e.Value is true; Remember(); }" /> Only what's in my library</label>
            }
        </FilterBar>
        @{
            var rows = Filtered(Rows(shown).Where(c => tab switch { "movies" => c.Type == MediaType.Movie, "tv" => c.Type == MediaType.Show, _ => true })).ToList();
        }
        @if (rows.Count == 0)
        {
            <Empty Title="Nothing here.">@if (ActiveFilters > 0 || find.Length > 0) { <button class="btn btn-sm" @onclick="ClearFilters">Clear filters</button> }</Empty>
        }
        <ol class="filmography">
            @foreach (var c in rows)
            {
                <li @key="(c.Type, c.TmdbId)">
                    <a class="film-row @(c.Watched ? "watched" : c.PartlySeen ? "partly" : "") @(seen == "fade" && c.Watched ? "seen-faded" : "")" href="@Fmt.Href(c.Type, c.TmdbId)">
                        <span class="film-year">@(c.Date?.Year.ToString() ?? "—")</span>
                        <span class="film-main">
                            <b>@c.Title</b>
                            <span class="muted small">@(c.Type == MediaType.Movie ? "Movie" : "TV")@(c.Role is { Length: > 0 } r ? " · " + r : "")@if (c.EpisodeCount is > 0) { <text> · </text><Spoiler Force="HideCount(c)">@Plural(c.EpisodeCount.Value, "episode")</Spoiler> }</span>
                        </span>
                        @if (c.InLibrary) { <span class="ep-owned" title="In your library" aria-label="In your library"><Icon Name="download" Size="15" /></span> }
                        @if (seenLoading && c.Type == MediaType.Show && p.PendingShows?.Contains(c.TmdbId) == true) { <span class="ep-pending skeleton" title="Checking which of their episodes you've seen"></span> }
                        else if (c.Watched) { <span class="ep-check" title="You've watched this"><Icon Name="check" Size="16" /></span> }
                        else if (c.PartlySeen) { <span class="ep-partly" title="@($"You've watched some of {c.Title}, but not the episodes {p.Name} is in")" aria-label="Partly seen: not their episodes">◐</span> }
                    </a>
                </li>
            }
        </ol>
        @{ var appearances = Filtered(p.Cast.Where(c => c.Appearance)).ToList(); }
        @if (shown.Contains(Acting) && tab != "movies" && appearances.Count > 0)
        {
            <details class="appearances">
                <summary>@Plural(appearances.Count, "talk show or TV appearance") as themself</summary>
                <ol class="filmography">
                    @foreach (var c in appearances)
                    {
                        <li @key="(c.Type, c.TmdbId)">
                            <a class="film-row" href="@Fmt.Href(c.Type, c.TmdbId)">
                                <span class="film-year">@(c.Date?.Year.ToString() ?? "—")</span>
                                <span class="film-main"><b>@c.Title</b><span class="muted small">@c.Role@if (c.EpisodeCount is > 0) { <text> · </text><Spoiler Force="HideCount(c)">@Plural(c.EpisodeCount.Value, "episode")</Spoiler> }</span></span>
                            </a>
                        </li>
                    }
                </ol>
            </details>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private PersonDetail? p;
    private string? error;
    private bool notFound;
    private bool bioOpen, libraryOnly, majorOnly, following;
    // Filmography filters: search, what you've seen (show, fade, hide, only), years, order, little-known titles, library.
    private string find = "", seen = "", order = "";
    private int? fromYear, toYear;
    /// <summary>Below this many TMDB votes a title counts as little-known.</summary>
    private const int MinVotes = 30;

    private int ActiveFilters => (seen == "" ? 0 : 1) + (fromYear is null ? 0 : 1) + (toYear is null ? 0 : 1) + (order == "" ? 0 : 1)
        + (majorOnly ? 1 : 0) + (libraryOnly ? 1 : 0);

    private List<FilterChip> Chips
    {
        get
        {
            var chips = new List<FilterChip>();
            if (seen != "") chips.Add(new(seen switch { "fade" => "Fading seen", "hide" => "Hiding seen", _ => "Only seen" }, () => { seen = ""; Remember(); }));
            if (fromYear is { } f) chips.Add(new($"From {f}", () => { fromYear = null; Remember(); }));
            if (toYear is { } t) chips.Add(new($"To {t}", () => { toYear = null; Remember(); }));
            if (order != "") chips.Add(new(order switch { "oldest" => "Oldest first", "popular" => "Best known first", "episodes" => "Most episodes", _ => "By title" }, () => { order = ""; Remember(); }));
            if (majorOnly) chips.Add(new("Well-known only", () => { majorOnly = false; Remember(); }));
            if (libraryOnly) chips.Add(new("In my library", () => { libraryOnly = false; Remember(); }));
            return chips;
        }
    }

    private void ClearFilters()
    {
        find = ""; seen = ""; order = ""; fromYear = null; toYear = null; majorOnly = false; libraryOnly = false;
        Remember();
    }

    /// <summary>Every credit, for the year choices.</summary>
    private IEnumerable<PersonCreditDto> AllRows => p is null ? [] : p.Cast.Concat(p.Crew);

    private IEnumerable<PersonCreditDto> Filtered(IEnumerable<PersonCreditDto> rows)
    {
        var q = rows.Where(c => (seen != "only" || c.Watched) && (seen != "hide" || !c.Watched)
            && (!libraryOnly || c.InLibrary)
            && (!majorOnly || c.VoteCount >= MinVotes || c.Watched || c.Date is null || c.Date > Today)
            && (fromYear is null || c.Date?.Year >= fromYear) && (toYear is null || c.Date?.Year <= toYear)
            && (find.Trim() is not { Length: > 0 } f || c.Title.Contains(f, StringComparison.OrdinalIgnoreCase) || (c.Role?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)));
        return order switch
        {
            "oldest" => q.OrderBy(c => c.Date is null).ThenBy(c => c.Date),
            "popular" => q.OrderByDescending(c => c.VoteCount),
            "episodes" => q.OrderByDescending(c => c.EpisodeCount ?? 0).ThenByDescending(c => c.Date),
            "title" => q.OrderBy(c => c.Title, StringComparer.OrdinalIgnoreCase),
            _ => q,
        };
    }
    private string tab = "all";
    private HashSet<string> shown = [];

    private const string Acting = "Acting", Directing = "Directing", Writing = "Writing", OtherCrew = "Other crew";

    /// <summary>Which filmography group a crew job belongs to. Only directing itself counts as Directing (assistant directors are other crew).</summary>
    private static string GroupOf(CrewJob j) =>
        j.Job is "Director" or "Co-Director" ? Directing : j.Department == "Writing" ? Writing : OtherCrew;

    private static IEnumerable<CrewJob> JobsOf(PersonCreditDto c) =>
        c.Jobs ?? (c.Role ?? "").Split(", ", StringSplitOptions.RemoveEmptyEntries).Select(j => new CrewJob(j, null));

    /// <summary>The group TMDB says they're known for: an editor or producer lands on Other crew.</summary>
    private string Primary => p?.KnownFor switch { null or "Acting" => Acting, "Directing" => Directing, "Writing" => Writing, _ => OtherCrew };

    /// <summary>The groups they have credits in, what they're known for first.</summary>
    private List<string> Groups => p is null ? [] : new[] { Primary, Acting, Directing, Writing, OtherCrew }.Distinct().Where(g => GroupCount(g) > 0).ToList();

    private int GroupCount(string g) => g == Acting ? p!.Cast.Count(c => !c.Appearance)
        : p!.Crew.Count(c => JobsOf(c).Any(j => GroupOf(j) == g));

    private void ToggleGroup(string g)
    {
        if (!shown.Remove(g)) shown.Add(g);
        else if (shown.Count == 0) shown.Add(g);   // always keep one on
        Remember();
    }

    private void SetTab(string t) { tab = t; Remember(); }

    // What you picked on each person's page this session, so Back (or coming back later) shows the same
    // list, at the same length, and the scroll position can be restored.
    private sealed record PickedView(string[] Shown, string Tab, bool LibraryOnly, string Find, string Seen, string Order, int? From, int? To, bool MajorOnly);
    private static readonly Dictionary<int, PickedView> Picked = [];
    private void Remember()
    {
        if (p is null) return;
        Picked[p.Id] = new([.. shown], tab, libraryOnly, find, seen, order, fromYear, toYear, majorOnly);
        UrlState.Write(Nav, State);
    }

    /// <summary>One row per title across the chosen groups: "Director, Screenplay" and, when acting is shown with crew, "as Kambei".</summary>
    private List<PersonCreditDto> Rows(IReadOnlySet<string> groups)
    {
        if (p is null) return [];
        var acting = groups.Contains(Acting) ? p.Cast.Where(c => !c.Appearance).ToList() : [];
        var crew = p.Crew.Select(c => (Credit: c, Jobs: JobsOf(c).Where(j => groups.Contains(GroupOf(j))).Select(j => j.Job).Distinct().ToList()))
            .Where(x => x.Jobs.Count > 0).ToList();
        var crewOnly = groups.All(g => g != Acting);
        var rows = new Dictionary<(MediaType, int), PersonCreditDto>();
        foreach (var (c, jobs) in crew)
            rows[(c.Type, c.TmdbId)] = c with { Role = string.Join(", ", jobs) };
        foreach (var c in acting)
        {
            var key = (c.Type, c.TmdbId);
            if (rows.TryGetValue(key, out var made))
                rows[key] = made with { Role = c.Role is { Length: > 0 } r ? $"{made.Role} · as {r}" : made.Role,
                                        EpisodeCount = Math.Max(made.EpisodeCount ?? 0, c.EpisodeCount ?? 0) is > 0 and var n ? n : null };
            else rows[key] = groups.Count > 1 && c.Role is { Length: > 0 } r ? c with { Role = "as " + r } : c;
        }
        return rows.Values.OrderByDescending(x => x.Date is null).ThenByDescending(x => x.Date).ToList();
    }

    /// <summary>How many episodes someone is in gives away who sticks around: blurred until tapped for a show you're partway through
    /// when that spoiler setting is on (Settings → Spoilers).</summary>
    // Finished: you've started it (seen them in it, or other episodes) and nothing aired is left (not Watching).
    /// <summary>Per role, how many of their movies you've seen (roles with at least 3 that count and one of them seen).</summary>
    private IEnumerable<(string Role, int Seen, int Total)> Completion()
    {
        if (p is null) yield break;
        var today = DateOnly.FromDateTime(DateTime.Today);
        bool Counts(PersonCreditDto c) => c.Type == MediaType.Movie && Filmography.Counts(c.Date, c.VoteCount, c.Watched, today);
        foreach (var (role, credits) in new (string, IEnumerable<PersonCreditDto>)[]
                 {
                     ("directed", p.Crew.Where(c => JobsOf(c).Any(j => GroupOf(j) == Directing))),
                     ("acted in", p.Cast.Where(c => !c.Appearance)),
                     ("wrote", p.Crew.Where(c => JobsOf(c).Any(j => GroupOf(j) == Writing))),
                 })
        {
            var movies = credits.Where(Counts).DistinctBy(c => c.TmdbId).ToList();
            var seen = movies.Count(c => c.Watched);
            if (movies.Count >= 3 && seen > 0) yield return (role, seen, movies.Count);
        }
    }

    private static bool HideCount(PersonCreditDto c) => c.Type == MediaType.Show && Fmt.BlurCounts(c.Watching, (c.Watched || c.PartlySeen) && !c.Watching);

    /// <summary>Their most popular work on TMDB in what they're known for (a director's films before their cameos), then the rest.</summary>
    private List<PersonCreditDto> KnownFor
    {
        get
        {
            if (p is null) return [];
            var main = Rows(new HashSet<string> { Primary }).Where(c => c.PosterPath is not null).OrderByDescending(c => c.VoteCount).ToList();
            var rest = Rows(new HashSet<string>(Groups)).Where(c => c.PosterPath is not null).OrderByDescending(c => c.VoteCount);
            return main.Concat(rest).DistinctBy(c => (c.Type, c.TmdbId)).Take(12).ToList();
        }
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Their work that hasn't come out yet, soonest first (announced-only at the end).</summary>
    private List<PersonCreditDto> Upcoming => p?.Cast.Where(c => !c.Appearance).Concat(p.Crew)
        .Where(c => c.Date is null ? c.PosterPath is not null : c.Date > Today)
        .DistinctBy(c => (c.Type, c.TmdbId)).OrderBy(c => c.Date is null).ThenBy(c => c.Date).Take(20).ToList() ?? [];

    /// <summary>"Seen 14 of 32 movies and 3 of 10 shows · your average 7.8 (12 rated)": released work they acted in or made.</summary>
    private static string? SeenLine(PersonDetail p)
    {
        var released = p.Cast.Where(c => !c.Appearance).Concat(p.Crew).Where(c => c.Date is { } d && d <= Today)
            .DistinctBy(c => (c.Type, c.TmdbId)).ToList();
        var parts = new List<string>();
        foreach (var (type, word) in new[] { (MediaType.Movie, "movie"), (MediaType.Show, "show") })
        {
            var all = released.Where(c => c.Type == type).ToList();
            if (all.Count > 0) parts.Add($"{all.Count(c => c.Watched):N0} of {all.Count:N0} {word}{(all.Count == 1 ? "" : "s")}");
        }
        if (parts.Count == 0) return null;
        var line = "Seen " + string.Join(" and ", parts);
        var partly = released.Count(c => c.PartlySeen);
        if (partly > 0) line += $" · {partly} more show{(partly == 1 ? "" : "s")} partly (not their episodes)";
        if (p.AvgRating is { } avg) line += $" · your average {Fmt.Avg(avg)} ({p.Rated:N0} rated)";
        return line;
    }

    private async Task ToggleFollow()
    {
        if (p is null) return;
        following = true;
        try
        {
            await Api.FollowPersonAsync(p.Id, !p.Following);
            p = p with { Following = !p.Following };
            Toasts.Show(p.Following ? $"Following {p.Name}. Their new work goes on your calendar." : $"Stopped following {p.Name}");
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { following = false; }
    }

    private int loadedId;

    // The filmography filters (not the roles, which are this person's own) go in the address too: Back returns to
    // them, and they can be saved as a view for every person's page.
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "q")] public string? QParam { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeParam { get; set; }
    [SupplyParameterFromQuery(Name = "seen")] public string? SeenParam { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public int? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public int? ToParam { get; set; }
    [SupplyParameterFromQuery(Name = "order")] public string? OrderParam { get; set; }
    [SupplyParameterFromQuery(Name = "major")] public string? MajorParam { get; set; }
    [SupplyParameterFromQuery(Name = "library")] public string? LibraryParam { get; set; }
    private (string, string?)[] State => [("q", find.Trim()), ("type", tab == "all" ? null : tab), ("seen", seen), ("from", fromYear?.ToString()),
        ("to", toYear?.ToString()), ("order", order), ("major", majorOnly ? "1" : null), ("library", libraryOnly ? "1" : null)];
    private bool AddressSaysAnything => new[] { QParam, TypeParam, SeenParam, OrderParam, MajorParam, LibraryParam }.Any(v => v is not null) || FromParam is not null || ToParam is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId != Id)
        {
            loadedId = Id;
            p = null; tab = "all"; bioOpen = false; shown = []; find = ""; seen = ""; order = ""; fromYear = null; toYear = null; majorOnly = false; libraryOnly = false;
            await Load();
            Restore();
        }
        // The address wins over what was picked earlier this session (a saved view, a link, Back).
        if (AddressSaysAnything)
        {
            find = UrlState.Find(QParam, find);
            tab = TypeParam is "movies" or "tv" ? TypeParam : "all";
            seen = SeenParam is "fade" or "hide" or "only" ? SeenParam : "";
            order = OrderParam is "oldest" or "popular" or "episodes" or "title" ? OrderParam : "";
            (fromYear, toYear, majorOnly, libraryOnly) = (FromParam, ToParam, MajorParam == "1", LibraryParam == "1");
        }
    }

    private void Restore()
    {
        if (p is not null && shown.Count == 0)
        {
            if (Picked.TryGetValue(p.Id, out var was) && was.Shown.Any(g => Groups.Contains(g)))
            {
                shown = [.. was.Shown.Where(g => Groups.Contains(g))];
                (tab, libraryOnly, find, seen, order, fromYear, toYear, majorOnly) =
                    (was.Tab, was.LibraryOnly, was.Find, was.Seen, was.Order, was.From, was.To, was.MajorOnly);
            }
            else shown = Groups.Count > 0 ? [Groups[0]] : [Acting];
        }
    }

    /// <summary>The quick part of the page arrived; which of their episodes you've seen is still being worked out.</summary>
    private bool seenLoading;

    private async Task Load()
    {
        error = null;
        notFound = false;
        try
        {
            p = await Api.PersonAsync(Id, quick: true);
            if (p.PendingShows is { Count: > 0 }) _ = LoadSeen(p.Id);
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { error = "There's no one at this address on TMDB."; notFound = true; }
        catch (Exception ex) { error = ex.Message; }
    }

    /// <summary>Fills in what you've seen them in once it's worked out, without holding up the rest of the page.</summary>
    private async Task LoadSeen(int personId)
    {
        seenLoading = true;
        try
        {
            var seen = await Api.PersonSeenAsync(personId);
            if (p?.Id != personId) return;   // moved on to someone else
            var mine = seen.SeenShows.ToHashSet();
            var partly = seen.PartlyShows.ToHashSet();
            PersonCreditDto Fill(PersonCreditDto c) => c.Type == MediaType.Show && p.PendingShows?.Contains(c.TmdbId) == true
                ? c with { Watched = mine.Contains(c.TmdbId), PartlySeen = partly.Contains(c.TmdbId) } : c;
            p = p with
            {
                Watched = seen.Watched, WatchedMovies = seen.WatchedMovies, WatchedEpisodes = seen.WatchedEpisodes,
                WatchedShows = seen.WatchedShows, WatchedMinutes = seen.WatchedMinutes,
                Cast = p.Cast.Select(Fill).ToList(), Crew = p.Crew.Select(Fill).ToList(), PendingShows = null,
            };
        }
        catch (Exception) { /* the page works without it; those shows just aren't marked */ }
        finally
        {
            if (p?.Id == personId) { seenLoading = false; StateHasChanged(); }
        }
    }

    private static int Age(DateOnly born, DateOnly at) => at.Year - born.Year - (at < born.AddYears(at.Year - born.Year) ? 1 : 0);
    private static string Plural(int n, string word) => $"{n:N0} {word}{(n == 1 ? "" : "s")}";

    private static string WatchedSummary(PersonDetail p)
    {
        var parts = new List<string>();
        if (p.WatchedMovies > 0) parts.Add(Plural(p.WatchedMovies, "movie"));
        if (p.WatchedEpisodes > 0) parts.Add($"{Plural(p.WatchedEpisodes, "episode")} across {Plural(p.WatchedShows, "show")}");
        return $"{string.Join(" and ", parts)} · {Fmt.Duration(p.WatchedMinutes)} together";
    }
}
