@page "/person/{Id:int}"
@inject ApiClient Api
@inject SessionState Session
@inject Toasts Toasts
<PageTitle>@(p?.Name ?? "Person") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (p is null && error is null) { <Spinner /> }
else if (p is not null)
{
    <div class="person-head">
        <div class="person-photo">
            @if (Img.Poster(p.ProfilePath, "w342") is { } src) { <img src="@src" alt="" /> }
            else { <div class="cast-fallback">@p.Name[..1]</div> }
        </div>
        <div class="person-info">
            <div class="person-title">
                <h1>@p.Name</h1>
                @if (Session.Me is not null)
                {
                    <button class="btn btn-sm @(p.Following ? "btn-on" : "btn-primary")" disabled="@following" @onclick="ToggleFollow" aria-pressed="@p.Following"
                            title="@(p.Following ? "Stop following" : "Their new movies and shows go on your calendar and release alerts")">
                        <Icon Name="@(p.Following ? "check" : "user-plus")" Size="16" /> @(p.Following ? "Following" : "Follow")
                    </button>
                }
            </div>
            @if (p.Watched is not null && SeenLine(p) is { } seen) { <p class="person-seen">@seen</p> }
            <DetailStats Items="@([
                ("Known for", p.KnownFor),
                ("Born", p.Birthday is { } b ? $"{(b).ToString(Fmt.DateFull)}" + (p.Deathday is null ? $" (age {Age(b, DateOnly.FromDateTime(DateTime.Today))})" : "") : null),
                ("Died", p.Deathday is { } d ? $"{(d).ToString(Fmt.DateFull)}" + (p.Birthday is { } b2 ? $" (aged {Age(b2, d)})" : "") : null),
                ("From", p.PlaceOfBirth),
                ("Credits", string.Join(" · ", Groups.Select(g => $"{GroupCount(g):N0} {g.ToLowerInvariant()}"))),
            ])" />
            @if (p.Biography is { } bio)
            {
                <div class="bio @(bioOpen ? "open" : "")">
                    @foreach (var para in bio.Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <p>@para</p> }
                </div>
                @if (bio.Length > 420) { <button class="btn btn-sm btn-ghost" @onclick="() => bioOpen = !bioOpen">@(bioOpen ? "Show less" : "Read more")</button> }
            }
            <div class="links">
                @if (p.ImdbId is not null) { <a href="@($"https://www.imdb.com/name/{p.ImdbId}")" target="_blank" rel="noopener">IMDb</a> }
                <a href="@($"https://www.themoviedb.org/person/{p.Id}")" target="_blank" rel="noopener">TMDB</a>
            </div>
        </div>
    </div>

    @if (p.Watched is { } watched)
    {
        <section class="row-section">
            <div class="section-head"><h2>You've watched them in</h2></div>
            @if (watched.Count == 0)
            {
                <p class="muted">Nothing yet.</p>
            }
            else
            {
                <p class="muted small" title="@Fmt.HoursTip(p.WatchedMinutes)">@WatchedSummary(p)</p>
                <div class="watched-with">
                    @foreach (var w in watched)
                    {
                        <div class="ww-item" @key="(w.Type, w.TmdbId)">
                            <a href="@Fmt.Href(w.Type, w.TmdbId)"><img src="@Img.Poster(w.PosterPath, "w154")" alt="" loading="lazy" /></a>
                            <div class="ww-body">
                                <a href="@Fmt.Href(w.Type, w.TmdbId)" class="mini-title">@w.Title</a>
                                @if (w.Jobs is not null) { <div class="small">@w.Jobs</div> }
                                @if (w.Character is not null) { <div class="small">as @w.Character</div> }
                                <div class="muted small" title="@Fmt.HoursTip(w.Minutes)">
                                    @(w.Type == MediaType.Movie
                                        ? (w.Plays > 1 ? $"Watched {w.Plays}× · " : "Watched · ") + Fmt.Duration(w.Minutes)
                                        : (w.GuestRole ? $"{Plural(w.Episodes.Count, "episode")} you watched" : $"{Plural(w.Plays, "episode")} watched") + " · " + Fmt.Duration(w.Minutes))
                                </div>
                                @if (w.GuestRole && w.Episodes.Count > 0)
                                {
                                    <div class="ww-episodes">
                                        @foreach (var ep in w.Episodes)
                                        {
                                            <a class="chip" href="@Fmt.EpisodeHref(w.TmdbId, ep.SeasonNumber, ep.EpisodeNumber)" title="@ep.Name">@Fmt.Ep(ep.SeasonNumber, ep.EpisodeNumber)</a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }

    @if (Upcoming.Count > 0)
    {
        <section class="row-section">
            <div class="section-head">
                <h2>Coming up</h2>
                @if (p.Following) { <a class="section-more" href="calendar">On your calendar <Icon Name="chevron-right" Size="16" /></a> }
            </div>
            <div class="poster-scroller">
                @foreach (var c in Upcoming)
                {
                    <PosterCard Media="@(new MediaSummary(c.Type, c.TmdbId, c.Title, c.Date?.Year, c.PosterPath, null, null, null))"
                                Badge="@(c.Date is { } due ? due.ToString(Fmt.DateLong) : "Announced")" ShowScore="false" Sub="@c.Role" @key="(c.Type, c.TmdbId)" />
                }
            </div>
        </section>
    }

    @if (KnownFor.Count > 0)
    {
        <section class="row-section">
            <div class="section-head"><h2>Known for</h2></div>
            <div class="poster-scroller">
                @foreach (var c in KnownFor)
                {
                    <PosterCard Media="@(new MediaSummary(c.Type, c.TmdbId, c.Title, c.Date?.Year, c.PosterPath, null, null, null))"
                                Badge="@(c.Watched ? "✓ Seen" : c.PartlySeen ? "◐ Partly" : null)" ShowScore="false" Sub="@c.Role" @key="(c.Type, c.TmdbId)" />
                }
            </div>
        </section>
    }

    <section class="row-section">
        <div class="section-head">
            <h2>Filmography</h2>
            <div class="segmented">
                <button class="@(tab == "all" ? "on" : "")" @onclick='() => SetTab("all")'>All</button>
                <button class="@(tab == "movies" ? "on" : "")" @onclick='() => SetTab("movies")'>Movies</button>
                <button class="@(tab == "tv" ? "on" : "")" @onclick='() => SetTab("tv")'>TV</button>
            </div>
        </div>
        @if (Groups.Count > 1)
        {
            <div class="chips role-chips" role="group" aria-label="Roles">
                @foreach (var g in Groups)
                {
                    <button type="button" class="chip @(shown.Contains(g) ? "on" : "")" aria-pressed="@shown.Contains(g)" @onclick="() => ToggleGroup(g)" @key="g">
                        @g <span class="chip-count">@GroupCount(g)</span>
                    </button>
                }
            </div>
        }
        <label class="check small seen-only"><input type="checkbox" @bind="seenOnly" @bind:after="Remember" /> Only show what I've watched</label>
        @{
            var rows = Rows(shown)
                .Where(c => tab switch { "movies" => c.Type == MediaType.Movie, "tv" => c.Type == MediaType.Show, _ => true })
                .Where(c => !seenOnly || c.Watched).ToList();
        }
        @if (rows.Count == 0) { <p class="muted">Nothing here.</p> }
        <ol class="filmography">
            @foreach (var c in rows)
            {
                <li @key="(c.Type, c.TmdbId)">
                    <a class="film-row @(c.Watched ? "watched" : c.PartlySeen ? "partly" : "")" href="@Fmt.Href(c.Type, c.TmdbId)">
                        <span class="film-year">@(c.Date?.Year.ToString() ?? "—")</span>
                        <span class="film-main">
                            <b>@c.Title</b>
                            <span class="muted small">@(c.Type == MediaType.Movie ? "Movie" : "TV")@(c.Role is { Length: > 0 } r ? " · " + r : "")@(c.EpisodeCount is > 0 ? $" · {Plural(c.EpisodeCount.Value, "episode")}" : "")</span>
                        </span>
                        @if (c.Watched) { <span class="ep-check" title="You've watched this"><Icon Name="check" Size="16" /></span> }
                        else if (c.PartlySeen) { <span class="ep-partly" title="@($"You've watched some of {c.Title}, but not the episodes {p.Name} is in")" aria-label="Partly seen: not their episodes">◐</span> }
                    </a>
                </li>
            }
        </ol>
        @{ var appearances = p.Cast.Where(c => c.Appearance && (!seenOnly || c.Watched)).ToList(); }
        @if (shown.Contains(Acting) && tab != "movies" && appearances.Count > 0)
        {
            <details class="appearances">
                <summary>@Plural(appearances.Count, "talk show or TV appearance") as themself</summary>
                <ol class="filmography">
                    @foreach (var c in appearances)
                    {
                        <li @key="(c.Type, c.TmdbId)">
                            <a class="film-row" href="@Fmt.Href(c.Type, c.TmdbId)">
                                <span class="film-year">@(c.Date?.Year.ToString() ?? "—")</span>
                                <span class="film-main"><b>@c.Title</b><span class="muted small">@c.Role@(c.EpisodeCount is > 0 ? $" · {Plural(c.EpisodeCount.Value, "episode")}" : "")</span></span>
                            </a>
                        </li>
                    }
                </ol>
            </details>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private PersonDetail? p;
    private string? error;
    private bool bioOpen, seenOnly, following;
    private string tab = "all";
    private HashSet<string> shown = [];

    private const string Acting = "Acting", Directing = "Directing", Writing = "Writing", OtherCrew = "Other crew";

    /// <summary>Which filmography group a crew job belongs to. Only directing itself counts as Directing (assistant directors are other crew).</summary>
    private static string GroupOf(CrewJob j) =>
        j.Job is "Director" or "Co-Director" ? Directing : j.Department == "Writing" ? Writing : OtherCrew;

    private static IEnumerable<CrewJob> JobsOf(PersonCreditDto c) =>
        c.Jobs ?? (c.Role ?? "").Split(", ", StringSplitOptions.RemoveEmptyEntries).Select(j => new CrewJob(j, null));

    /// <summary>The group TMDB says they're known for: an editor or producer lands on Other crew.</summary>
    private string Primary => p?.KnownFor switch { null or "Acting" => Acting, "Directing" => Directing, "Writing" => Writing, _ => OtherCrew };

    /// <summary>The groups they have credits in, what they're known for first.</summary>
    private List<string> Groups => p is null ? [] : new[] { Primary, Acting, Directing, Writing, OtherCrew }.Distinct().Where(g => GroupCount(g) > 0).ToList();

    private int GroupCount(string g) => g == Acting ? p!.Cast.Count(c => !c.Appearance)
        : p!.Crew.Count(c => JobsOf(c).Any(j => GroupOf(j) == g));

    private void ToggleGroup(string g)
    {
        if (!shown.Remove(g)) shown.Add(g);
        else if (shown.Count == 0) shown.Add(g);   // always keep one on
        Remember();
    }

    private void SetTab(string t) { tab = t; Remember(); }

    // What you picked on each person's page this session, so Back (or coming back later) shows the same
    // list, at the same length, and the scroll position can be restored.
    private static readonly Dictionary<int, (string[] Shown, string Tab, bool SeenOnly)> Picked = [];
    private void Remember() { if (p is not null) Picked[p.Id] = ([.. shown], tab, seenOnly); }

    /// <summary>One row per title across the chosen groups: "Director, Screenplay" and, when acting is shown with crew, "as Kambei".</summary>
    private List<PersonCreditDto> Rows(IReadOnlySet<string> groups)
    {
        if (p is null) return [];
        var acting = groups.Contains(Acting) ? p.Cast.Where(c => !c.Appearance).ToList() : [];
        var crew = p.Crew.Select(c => (Credit: c, Jobs: JobsOf(c).Where(j => groups.Contains(GroupOf(j))).Select(j => j.Job).Distinct().ToList()))
            .Where(x => x.Jobs.Count > 0).ToList();
        var crewOnly = groups.All(g => g != Acting);
        var rows = new Dictionary<(MediaType, int), PersonCreditDto>();
        foreach (var (c, jobs) in crew)
            rows[(c.Type, c.TmdbId)] = c with { Role = string.Join(", ", jobs) };
        foreach (var c in acting)
        {
            var key = (c.Type, c.TmdbId);
            if (rows.TryGetValue(key, out var made))
                rows[key] = made with { Role = c.Role is { Length: > 0 } r ? $"{made.Role} · as {r}" : made.Role,
                                        EpisodeCount = Math.Max(made.EpisodeCount ?? 0, c.EpisodeCount ?? 0) is > 0 and var n ? n : null };
            else rows[key] = groups.Count > 1 && c.Role is { Length: > 0 } r ? c with { Role = "as " + r } : c;
        }
        return rows.Values.OrderByDescending(x => x.Date is null).ThenByDescending(x => x.Date).ToList();
    }

    /// <summary>Their most popular work on TMDB in what they're known for (a director's films before their cameos), then the rest.</summary>
    private List<PersonCreditDto> KnownFor
    {
        get
        {
            if (p is null) return [];
            var main = Rows(new HashSet<string> { Primary }).Where(c => c.PosterPath is not null).OrderByDescending(c => c.VoteCount).ToList();
            var rest = Rows(new HashSet<string>(Groups)).Where(c => c.PosterPath is not null).OrderByDescending(c => c.VoteCount);
            return main.Concat(rest).DistinctBy(c => (c.Type, c.TmdbId)).Take(12).ToList();
        }
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Their work that hasn't come out yet, soonest first (announced-only at the end).</summary>
    private List<PersonCreditDto> Upcoming => p?.Cast.Where(c => !c.Appearance).Concat(p.Crew)
        .Where(c => c.Date is null ? c.PosterPath is not null : c.Date > Today)
        .DistinctBy(c => (c.Type, c.TmdbId)).OrderBy(c => c.Date is null).ThenBy(c => c.Date).Take(20).ToList() ?? [];

    /// <summary>"Seen 14 of 32 movies and 3 of 10 shows · your average 7.8 (12 rated)": released work they acted in or made.</summary>
    private static string? SeenLine(PersonDetail p)
    {
        var released = p.Cast.Where(c => !c.Appearance).Concat(p.Crew).Where(c => c.Date is { } d && d <= Today)
            .DistinctBy(c => (c.Type, c.TmdbId)).ToList();
        var parts = new List<string>();
        foreach (var (type, word) in new[] { (MediaType.Movie, "movie"), (MediaType.Show, "show") })
        {
            var all = released.Where(c => c.Type == type).ToList();
            if (all.Count > 0) parts.Add($"{all.Count(c => c.Watched):N0} of {all.Count:N0} {word}{(all.Count == 1 ? "" : "s")}");
        }
        if (parts.Count == 0) return null;
        var line = "Seen " + string.Join(" and ", parts);
        var partly = released.Count(c => c.PartlySeen);
        if (partly > 0) line += $" · {partly} more show{(partly == 1 ? "" : "s")} partly (not their episodes)";
        if (p.AvgRating is { } avg) line += $" · your average {Fmt.Avg(avg)} ({p.Rated:N0} rated)";
        return line;
    }

    private async Task ToggleFollow()
    {
        if (p is null) return;
        following = true;
        try
        {
            await Api.FollowPersonAsync(p.Id, !p.Following);
            p = p with { Following = !p.Following };
            Toasts.Show(p.Following ? $"Following {p.Name}. Their new work goes on your calendar." : $"Stopped following {p.Name}");
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { following = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (p?.Id != Id) { p = null; tab = "all"; bioOpen = false; seenOnly = false; shown = []; }
        await Load();
        if (p is not null && shown.Count == 0)
        {
            if (Picked.TryGetValue(p.Id, out var was) && was.Shown.Any(g => Groups.Contains(g)))
            {
                shown = [.. was.Shown.Where(g => Groups.Contains(g))];
                tab = was.Tab;
                seenOnly = was.SeenOnly;
            }
            else shown = Groups.Count > 0 ? [Groups[0]] : [Acting];
        }
    }

    private async Task Load()
    {
        error = null;
        try { p = await Api.PersonAsync(Id); }
        catch (Exception ex) { error = ex.Message; }
    }

    private static int Age(DateOnly born, DateOnly at) => at.Year - born.Year - (at < born.AddYears(at.Year - born.Year) ? 1 : 0);
    private static string Plural(int n, string word) => $"{n:N0} {word}{(n == 1 ? "" : "s")}";

    private static string WatchedSummary(PersonDetail p)
    {
        var parts = new List<string>();
        if (p.WatchedMovies > 0) parts.Add(Plural(p.WatchedMovies, "movie"));
        if (p.WatchedEpisodes > 0) parts.Add($"{Plural(p.WatchedEpisodes, "episode")} across {Plural(p.WatchedShows, "show")}");
        return $"{string.Join(" and ", parts)} · {Fmt.Duration(p.WatchedMinutes)} together";
    }
}
