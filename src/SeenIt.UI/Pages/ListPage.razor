@page "/lists/{Id:guid}"
@inject ApiClient Api
@inject Toasts Toasts
@inject NavigationManager Nav
@inject IPlatform Platform
<PageTitle>@(list?.Name ?? "List") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (list is null && error is null) { <Spinner /> }
else if (list is not null)
{
    <nav class="crumbs">@if (list.IsOwner) { <a href="lists"><Icon Name="chevron-left" Size="16" /> Lists</a> }</nav>
    <div class="page-head">
        <div>
            <h1>@list.Name</h1>
            <p class="muted small">by <a href="@Fmt.UserHref(list.OwnerUserName)">@list.OwnerUserName</a> · @list.Items.Count items@(list.Rules is not null ? " · Smart list" : list.Ranked ? " · Ranked" : "") · @(list.IsPublic ? "Public" : "Private")@(list.IsOwner && list.Saves > 0 ? $" · saved by {list.Saves}" : "")</p>
        </div>
        @if (list.IsPublic && !list.IsOwner)
        {
            <div class="inline">
                <AuthorizeView>
                    <button class="btn btn-sm @(list.Saved ? "btn-on" : "")" disabled="@saving" @onclick="ToggleSave" aria-pressed="@list.Saved">
                        <Icon Name="bookmark" Size="16" /> @(list.Saved ? "Saved" : "Save")@(list.Saves > 0 ? $" · {list.Saves}" : "")
                    </button>
                </AuthorizeView>
                <button class="btn btn-sm" @onclick="Share"><Icon Name="share" Size="16" /> Share</button>
                <button class="btn btn-sm btn-ghost" @onclick="ShowFeeds">RSS</button>
            </div>
        }
        @if (list.IsOwner)
        {
            <div class="inline">
                @if (list.IsPublic) { <button class="btn btn-sm" @onclick="Share"><Icon Name="share" Size="16" /> Share</button> }
                else { <span class="muted small" title="Make the list public in Edit to share it">Private: only you can see it</span> }
                @if (list.Items.Count > 1 && list.Rules is null) { <button class="btn btn-sm @(arranging ? "btn-on" : "")" @onclick="ToggleArranging">@(arranging ? "Done" : "Reorder & notes")</button> }
                <button class="btn btn-sm btn-ghost" @onclick="ShowFeeds">RSS</button>
                <button class="btn btn-sm" @onclick="() => editOpen = true">Edit</button>
                <button class="btn btn-sm btn-danger" @onclick="Delete">Delete</button>
            </div>
        }
    </div>
    @if (list.Description is not null) { <p class="overview">@list.Description</p> }
    <Modal Open="feeds is not null" OpenChanged="o => { if (!o) feeds = null; }" Title="Feeds for this list">
        @if (feeds is { } f)
        {
            <div class="stack">
                <p class="muted small">Follow this list in a feed reader, or use it in automations. @(list.IsPublic ? "" : "The links include your private key, so keep them to yourself.")</p>
                @foreach (var (label, url) in new[] { ("RSS", f.Rss), ("JSON Feed", f.Json) })
                {
                    <div class="cal-link">
                        <span class="feed-label">@label</span>
                        <input readonly value="@url" aria-label="@($"{label} link")" onfocus="this.select()" />
                        <button class="btn btn-sm" @onclick="() => CopyLink(url)"><Icon Name="copy" Size="14" /> Copy</button>
                    </div>
                }
            </div>
        }
    </Modal>
    @if (list.Rules is { } rules)
    {
        <div class="rule-summary">@foreach (var r in RuleText(rules)) { <span class="pill pill-sm">@r</span> }</div>
        @if (list.Items.Count == 0) { <Empty Title="Nothing matches these rules right now.">@(list.IsOwner ? "Edit the rules to widen them." : "")</Empty> }
    }
    else if (list.Items.Count == 0) { <Empty Title="This list is empty.">Add movies and shows from their pages with the “Lists” button.</Empty> }
    @if (arranging && order is not null)
    {
        <p class="muted small">Drag entries (or use the arrows) to put them in order, and add a note to any of them. Notes save when you leave the box.</p>
        <ol class="arrange-list">
            @for (var n = 0; n < order.Count; n++)
            {
                var i = order[n];
                var index = n;
                <li class="arrange-item @(dragging == i.Id ? "dragging" : "")" @key="i.Id" draggable="true"
                    @ondragstart="() => dragging = i.Id" @ondragend="() => dragging = null"
                    @ondragover="() => DragOver(index)" @ondragover:preventDefault="true" @ondrop:preventDefault="true">
                    <span class="arrange-handle" aria-hidden="true"><Icon Name="menu" Size="16" /></span>
                    <span class="arrange-rank">@(index + 1)</span>
                    <img src="@Img.Poster(i.Media.PosterPath, "w92")" alt="" loading="lazy" />
                    <div class="arrange-main">
                        <b>@i.Media.Title</b> <span class="muted small">@i.Media.Year</span>
                        <textarea rows="1" maxlength="500" placeholder="Add a note" aria-label="Note for @i.Media.Title"
                                  value="@i.Note" @onchange="e => SaveNote(i, e.Value?.ToString())"></textarea>
                    </div>
                    <div class="arrange-moves">
                        <button class="icon-btn" disabled="@(index == 0)" @onclick="() => Move(index, 0)" aria-label="Move to the top" title="Move to the top"><Icon Name="chevron-up" Size="14" /><Icon Name="chevron-up" Size="14" /></button>
                        <button class="icon-btn" disabled="@(index == 0)" @onclick="() => Move(index, index - 1)" aria-label="Move up"><Icon Name="chevron-up" Size="16" /></button>
                        <button class="icon-btn" disabled="@(index == order.Count - 1)" @onclick="() => Move(index, index + 1)" aria-label="Move down"><Icon Name="chevron-down" Size="16" /></button>
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
    @if (list.Items.Count > 8)
    {
        <div class="searchbar">
            <Icon Name="search" Size="18" />
            <input type="search" @bind="find" @bind:event="oninput" placeholder="Filter this list" aria-label="Filter this list" />
            @if (list.IsOwner) { <a class="btn btn-sm btn-ghost" href="lists">Search all lists</a> }
        </div>
    }
    @if (list.Items.Count > 0)
    {
        <div class="segmented list-layout" role="radiogroup" aria-label="Show as">
            <button role="radio" aria-checked="@(Layout == ListLayout.Posters)" class="@(Layout == ListLayout.Posters ? "on" : "")" @onclick="() => layout = ListLayout.Posters"><Icon Name="grid" Size="14" /> Posters</button>
            <button role="radio" aria-checked="@(Layout == ListLayout.Rows)" class="@(Layout == ListLayout.Rows ? "on" : "")" @onclick="() => layout = ListLayout.Rows"><Icon Name="list" Size="14" /> Rows</button>
        </div>
    }
    @if (Layout == ListLayout.Rows)
    {
        <ol class="list-rows">
            @foreach (var (i, rank) in list.Items.Select((x, n) => (x, n + 1)).Where(x => TextMatch.Contains(x.x.Media.Title, find)))
            {
                <li class="list-row" @key="i.Id">
                    @if (list.Ranked) { <span class="list-rank">@rank</span> }
                    <a href="@Fmt.Href(i.Media.Type, i.Media.TmdbId)" class="list-row-link">
                        <img src="@Img.Poster(i.Media.PosterPath, "w92")" alt="" loading="lazy" />
                        <span class="list-row-main">
                            <b>@i.Media.Title</b>
                            <span class="muted small">@(i.Media.Year?.ToString() ?? "")<span class="dot-sep">@(i.Media.Type == MediaType.Movie ? "Movie" : "TV")</span></span>
                            @if (i.Note is { Length: > 0 } note) { <span class="list-note">@note</span> }
                        </span>
                    </a>
                    @if (list.IsOwner && list.Rules is null)
                    {
                        <button class="icon-btn" @onclick="() => Remove(i)" aria-label="Remove @i.Media.Title"><Icon Name="x" Size="16" /></button>
                    }
                </li>
            }
        </ol>
    }
    else
    {
    <div class="poster-grid">
        @foreach (var (i, rank) in list.Items.Select((x, n) => (x, n + 1)).Where(x => TextMatch.Contains(x.x.Media.Title, find)))
        {
            <div class="poster-wrap" @key="i.Id">
                <PosterCard Media="i.Media" Badge="@(list.Ranked ? $"#{rank}" : null)" />
                @if (i.Note is { Length: > 0 } note) { <p class="list-note">@note</p> }
                @if (list.IsOwner && list.Rules is null)
                {
                    <button class="poster-remove" @onclick="() => Remove(i)" aria-label="Remove @i.Media.Title"><Icon Name="x" Size="14" /></button>
                }
            </div>
        }
    </div>
    }

    }

    <Modal @bind-Open="editOpen" Title="Edit list">
        <ListForm Name="@list.Name" Description="@list.Description" IsPublic="list.IsPublic" Ranked="list.Ranked" Rules="list.Rules" OnSave="Save" />
    </Modal>
}
@code {
    /// <summary>Posters or rows: the default from Settings → Display, switchable here.</summary>
    private ListLayout? layout;
    private ListLayout Layout => layout ?? Fmt.Prefs.ListLayout;

    /// <summary>A smart list's rules in words, e.g. "From your watchlist", "Movies", "1980–1989", "Not seen yet".</summary>
    private static IEnumerable<string> RuleText(SmartRules r)
    {
        yield return r.Source switch { SmartSource.History => "From what's been watched", SmartSource.Watchlist => "From the watchlist", SmartSource.Library => "From the library", _ => "From all of TMDB" };
        if (r.Type is { } t) yield return t == MediaType.Movie ? "Movies" : "Shows";
        if (r.Genres is { Count: > 0 } g) yield return string.Join(" or ", g);
        if (r.YearFrom is not null || r.YearTo is not null) yield return r.YearFrom == r.YearTo ? $"{r.YearFrom}" : $"{r.YearFrom?.ToString() ?? "…"}–{r.YearTo?.ToString() ?? "now"}";
        if (r.MinScore is { } ms) yield return $"TMDB {ms:0.#}+";
        if (r.MinMyRating is { } mr) yield return $"Rated {Fmt.Stars(mr)}+";
        if (r.Language is { } l) yield return $"Language: {l}";
        if (r.Watched is { } w) yield return w ? "Already seen" : "Not seen yet";
        yield return r.Sort switch
        {
            SmartSort.Score => "Highest scored first", SmartSort.Newest => "Newest first", SmartSort.Oldest => "Oldest first",
            SmartSort.RecentlyWatched => "Recently watched first", SmartSort.Title => "A–Z", _ => r.Source == SmartSource.Tmdb ? "Most popular first" : "Most played first",
        };
        yield return $"Up to {r.Limit}";
    }

    private ListFeedsDto? feeds;

    private async Task ShowFeeds()
    {
        if (list is null) return;
        try { feeds = await Api.ListFeedsAsync(list.Id); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task CopyLink(string url)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", url); Toasts.Show("Link copied"); }
        catch { Toasts.Show("Couldn't copy; select the link and copy it.", error: true); }
    }

    private bool saving;

    private async Task ToggleSave()
    {
        if (list is null) return;
        saving = true;
        var save = !list.Saved;
        try
        {
            await Api.SaveListAsync(list.Id, save);
            list = list with { Saved = save, Saves = list.Saves + (save ? 1 : -1) };
            Toasts.Show(save ? "Saved to your lists (Lists → Saved)" : "Removed from your saved lists");
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { saving = false; }
    }

    [Parameter] public Guid Id { get; set; }
    [Inject] private IJSRuntime Js { get; set; } = default!;
    private ListDetail? list;
    private string? error;
    private bool editOpen;
    private string find = "";
    private bool arranging, orderChanged;
    private List<ListItemDto>? order;
    private Guid? dragging;

    private async Task ToggleArranging()
    {
        if (!arranging)
        {
            order = [.. list!.Items];
            orderChanged = false;
            arranging = true;
            return;
        }
        arranging = false;
        if (orderChanged && order is not null)
        {
            try { await Api.ReorderListAsync(Id, order.Select(i => i.Id).ToList()); Toasts.Show("Order saved"); }
            catch (Exception ex) { Toasts.Error(ex); }
        }
        await Load();
    }

    private void Move(int from, int to)
    {
        if (order is null || from == to || to < 0 || to >= order.Count) return;
        var item = order[from];
        order.RemoveAt(from);
        order.Insert(to, item);
        orderChanged = true;
    }

    /// <summary>While dragging, the dragged entry moves to wherever the pointer is.</summary>
    private void DragOver(int index)
    {
        if (order is null || dragging is not { } id) return;
        var from = order.FindIndex(i => i.Id == id);
        if (from >= 0 && from != index) Move(from, index);
    }

    private async Task SaveNote(ListItemDto item, string? note)
    {
        note = string.IsNullOrWhiteSpace(note) ? null : note.Trim();
        if (note == item.Note) return;
        try
        {
            await Api.SetListNoteAsync(Id, item.Id, note);
            var updated = item with { Note = note };
            if (order is not null) order[order.IndexOf(item)] = updated;
            Toasts.Show(note is null ? "Note removed" : "Note saved");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { list = await Api.ListAsync(Id); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Save(CreateListRequest req)
    {
        try { await Api.UpdateListAsync(Id, req); editOpen = false; await Load(); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Remove(ListItemDto i)
    {
        try
        {
            await Api.RemoveFromListAsync(Id, i.Media.Type, i.Media.TmdbId);
            Toasts.Show($"Removed {i.Media.Title}", undo: async () =>
            {
                await Api.AddToListAsync(Id, i.Media.Type, i.Media.TmdbId);
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Delete()
    {
        var (id, name) = (Id, list!.Name);
        try
        {
            await Api.DeleteListAsync(id);
            Toasts.Show($"Deleted “{name}”", undo: async () =>
            {
                await Api.RestoreListAsync(id);
                await InvokeAsync(() => Nav.NavigateTo($"lists/{id}"));
            });
            Nav.NavigateTo("lists");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Share()
    {
        var url = Platform.PublicUrl($"lists/{Id}");
        switch (await Platform.ShareLinkAsync(list?.Name ?? "SeenIt list", url))
        {
            case "copied": Toasts.Show("Link copied"); break;
            case "failed": Toasts.Show(url); break;
        }
    }
}
