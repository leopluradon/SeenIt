@page "/lists"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
@inject Toasts Toasts
@inject NavigationManager Nav
<PageTitle>Lists · SeenIt</PageTitle>

<div class="page-head">
    <h1>Lists</h1>
    <div class="segmented">
        <button class="@(Tab == "mine" ? "on" : "")" @onclick='() => Go("mine")'>Mine</button>
        <button class="@(Tab == "saved" ? "on" : "")" @onclick='() => Go("saved")'>Saved</button>
        <button class="@(Tab == "browse" ? "on" : "")" @onclick='() => Go("browse")'>Browse</button>
    </div>
    @if (Tab == "mine") { <button class="btn btn-primary btn-sm" @onclick="() => createOpen = true"><Icon Name="plus" Size="16" /> New list</button> }
</div>
@if (Tab == "saved")
{
    <p class="muted small">Other people's public lists you saved.</p>
    @if (saved is null) { <Spinner /> }
    else if (saved.Count == 0) { <Empty Title="No saved lists yet.">Open someone's public list and tap <b>Save</b>, or find some under <a href="lists?tab=browse">Browse</a>.</Empty> }
    else { <div class="list-grid">@foreach (var l in saved) { <ListCard List="l" @key="l.Id" /> }</div> }
}
else if (Tab == "browse")
{
    <form class="searchbar" @onsubmit="LoadBrowse" @onsubmit:preventDefault role="search">
        <Icon Name="search" Size="18" />
        <input type="search" @bind="browseQuery" @bind:event="oninput" @bind:after="BrowseDebounce" placeholder="Search everyone's public lists" aria-label="Search public lists" />
    </form>
    <div class="chips">
        <button class="chip @(recent ? "" : "on")" @onclick="() => SetSort(false)">Most saved</button>
        <button class="chip @(recent ? "on" : "")" @onclick="() => SetSort(true)">Recently updated</button>
    </div>
    @if (browse is null) { <Spinner /> }
    else if (browse.Count == 0) { <Empty Title="No public lists found." /> }
    else { <div class="list-grid">@foreach (var l in browse) { <ListCard List="l" @key="l.Id" /> }</div> }
}
else
{
<form class="searchbar" @onsubmit="Search" role="search">
    <Icon Name="search" Size="18" />
    <input type="search" @bind="query" @bind:event="oninput" @bind:after="Debounce" placeholder="Search your watchlist and all your lists" aria-label="Search your watchlist and lists" />
</form>
<ErrorBox Message="@error" OnRetry="Load" />
@if (!string.IsNullOrWhiteSpace(query))
{
    @if (hits is null) { <Spinner /> }
    else if (hits.Count == 0) { <Empty Title="@($"Nothing called “{query.Trim()}”.")">It isn't on your watchlist or in any of your lists.</Empty> }
    else
    {
        <p class="muted small">@hits.Count @(hits.Count == 1 ? "title" : "titles") on your watchlist or lists</p>
        <div class="search-hits">
            @foreach (var h in hits)
            {
                <div class="search-hit" @key="(h.Media.Type, h.Media.TmdbId)">
                    <PosterCard Media="h.Media" />
                    <div class="hit-where">
                        @if (h.OnWatchlist) { <a class="pill pill-sm" href="watchlist"><Icon Name="bookmark" Size="12" /> Watchlist</a> }
                        @foreach (var l in h.Lists) { <a class="pill pill-sm" href="@($"lists/{l.Id}")" @key="l.Id">@l.Name</a> }
                    </div>
                </div>
            }
        </div>
    }
}
else if (lists is null && error is null) { <Spinner /> }
else if (lists is not null)
{
    @if (lists.Count == 0) { <Empty Title="No lists yet.">Make lists like “Best of 2025” or “Comfort rewatches”, and share them publicly if you like.</Empty> }
    <div class="list-grid">
        @foreach (var l in lists) { <ListCard List="l" @key="l.Id" /> }
    </div>
}
}

<Modal @bind-Open="createOpen" Title="New list">
    <ListForm OnSave="Create" AllowSmart="true" />
</Modal>

@code {
    private List<ListSummary>? lists;
    private string? error;
    private bool createOpen;
    private string query = "";
    private List<ListSearchHit>? hits;
    private CancellationTokenSource? debounce;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    private string Tab => TabParam is "saved" or "browse" ? TabParam : "mine";
    private List<ListSummary>? saved, browse;
    private string browseQuery = "";
    private bool recent = Fmt.Prefs.SortFor("lists-browse") == "recent";
    private CancellationTokenSource? browseDebounce;

    protected override async Task OnParametersSetAsync()
    {
        switch (Tab)
        {
            case "saved": try { saved = await Api.SavedListsAsync(); } catch (Exception ex) { saved = []; error = ex.Message; } break;
            case "browse": await LoadBrowse(); break;
            default: if (lists is null) await Load(); break;
        }
    }

    private void Go(string tab) => Nav.NavigateTo(tab == "mine" ? "lists" : $"lists?tab={tab}");

    private async Task LoadBrowse()
    {
        var q = browseQuery;
        try
        {
            var result = await Api.BrowseListsAsync(q, recent);
            if (q == browseQuery) browse = result;
        }
        catch (Exception ex) { browse = []; error = ex.Message; }
    }

    private Task SetSort(bool r)
    {
        recent = r; browse = null;
        _ = PagePrefs.SetSortAsync(Session, Api, "lists-browse", r ? "recent" : "saved");
        return LoadBrowse();
    }

    private async Task BrowseDebounce()
    {
        browseDebounce?.Cancel();
        browseDebounce = new CancellationTokenSource();
        try { await Task.Delay(300, browseDebounce.Token); }
        catch (TaskCanceledException) { return; }
        await LoadBrowse();
    }

    private async Task Load()
    {
        error = null;
        try { lists = await Api.ListsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Debounce()
    {
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        hits = null;
        try { await Task.Delay(250, debounce.Token); }
        catch (TaskCanceledException) { return; }
        await Search();
    }

    private async Task Search()
    {
        var q = query.Trim();
        if (q.Length == 0) { hits = null; return; }
        try
        {
            var result = await Api.SearchListsAsync(q);
            if (q == query.Trim()) hits = result;   // a slow answer to an older query doesn't win
        }
        catch (Exception ex) { hits = []; Toasts.Error(ex); }
    }

    private async Task Create(CreateListRequest req)
    {
        try
        {
            var id = await Api.CreateListAsync(req);
            createOpen = false;
            Nav.NavigateTo($"lists/{id}");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
