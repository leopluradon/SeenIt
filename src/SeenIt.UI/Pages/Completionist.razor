@page "/completionist"
@page "/u/{UserName}/completionist"
@* Whose movies you're closest to having seen every one of: directors, actors and writers from what you've watched.
   No [Authorize]: someone's shared page follows their Stats privacy; your own needs signing in. *@
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>@(Other is { } on ? $"{on}'s completionist" : "Completionist") · SeenIt</PageTitle>
@if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }

<div class="page-head"><h1>@(Other is { } o ? $"{o}'s completionist" : "Completionist")</h1></div>
<p class="muted small">Directors, actors and writers whose movies @(Mine ? "you watch" : "they watch") most, and how many of each one's @(Mine ? "you've" : "they've") seen. Released movies count, apart from obscure ones (under @Filmography.MinVotes votes on TMDB) not seen; talk shows and appearances as themselves don't. Finishing someone earns the Completionist badge.</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> <p class="muted small center">Looking up filmographies… the first time takes a little while.</p> }
else if (items is { Count: 0 }) { <Empty Title="Nobody yet.">@if (Mine) { <text>Watch a few movies by the same director or with the same actors and they'll show up here.</text> }</Empty> }
else if (items is not null)
{
    var done = items.Where(i => i.Seen >= i.Total).ToList();
    var going = items.Where(i => i.Seen < i.Total).ToList();
    <div class="chips">
        @foreach (var r in new[] { "", "Directing", "Acting", "Writing" }.Where(r => r == "" || items.Any(i => i.Role == r)))
        {
            <button class="chip @(role == r ? "on" : "")" @onclick="() => role = r">@(r == "" ? "Everyone" : r)</button>
        }
    </div>
    @if (going.Any(Shown))
    {
        <h2 class="progress-group">Closest to finishing</h2>
        <div class="completion-list">
            @foreach (var c in going.Where(Shown)) { @Card(c) }
        </div>
    }
    @if (done.Any(Shown))
    {
        <h2 class="progress-group">Done <span class="muted small">@done.Count(Shown)</span></h2>
        <div class="completion-list">
            @foreach (var c in done.Where(Shown)) { @Card(c) }
        </div>
    }
}
@code {
    private List<CompletionDto>? items;
    private string? error;
    private string role = "";

    /// <summary>Someone else's (read-only), shared at u/{name}/completionist.</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    private bool Mine => Other is null;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? loadedFor = "\0";

    protected override async Task OnParametersSetAsync()
    {
        if (Mine && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
            return;
        }
        if (loadedFor != Other) { loadedFor = Other; items = null; await Load(); }
    }

    private async Task Load()
    {
        error = null;
        try { items = await Api.CompletionistAsync(Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"{Other}'s completionist page is private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
    }

    private bool Shown(CompletionDto c) => role == "" || c.Role == role;

    private static string Verb(string role) => role switch { "Directing" => "directed", "Writing" => "wrote", _ => "acted in" };

    private RenderFragment Card(CompletionDto c) => __builder =>
    {
        <div class="completion-card" @key="(c.PersonId, c.Role)">
            <a href="@($"person/{c.PersonId}")" class="completion-photo">
                @if (Img.Profile(c.ProfilePath) is { } src) { <img src="@src" alt="" loading="lazy" /> } else { <span class="cast-fallback">@c.Name[..1]</span> }
            </a>
            <div class="completion-body">
                <a href="@($"person/{c.PersonId}")" class="mini-title">@c.Name</a>
                <span class="muted small">@(c.Seen >= c.Total ? $"✓ Seen all {c.Total} movies they {Verb(c.Role)}" + (c.CompletedAt is { } at ? $" · {at.ToLocalTime().ToString(Fmt.DateLong)}" : "") : $"{c.Seen} of {c.Total} movies they {Verb(c.Role)} · {c.Total - c.Seen} to go")</span>
                <ProgressBar Value="c.Seen" Max="c.Total" />
                @if (c.Unseen.Count > 0)
                {
                    <span class="small">Next: @for (var i = 0; i < c.Unseen.Count; i++) { var m = c.Unseen[i]; <a href="@Fmt.Href(MediaType.Movie, m.TmdbId)">@m.Title</a>@(m.Year is { } y ? $" ({y})" : "")@(i < c.Unseen.Count - 1 ? ", " : "") }</span>
                }
            </div>
        </div>
    };
}
