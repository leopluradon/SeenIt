@page "/u/{Name}/compare"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>You vs @(c?.Them.Name ?? Name) · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (c is null && error is null) { <Spinner /> }
else if (c is not null)
{
    <div class="compare-head">
        <h1>You vs <a href="@Fmt.UserHref(c.Them.UserName)">@c.Them.Name</a></h1>
        @if (c.Compatibility is { } pct)
        {
            <div class="compat">
                <span class="compat-value">@pct%</span>
                <span class="muted small">taste match, from @c.RatedBoth.Count title@(c.RatedBoth.Count == 1 ? "" : "s") you've both rated</span>
            </div>
        }
        else
        {
            <p class="muted small">Rate a few of the same movies or shows to see how well your tastes match.</p>
        }
    </div>

    <div class="compare-table panel">
        <div></div><b>You</b><b>@c.Them.Name</b>
        @foreach (var (label, you, them) in Rows())
        {
            <span class="muted">@label</span>
            <span class="@(you.Value > them.Value ? "lead" : "")">@you.Text</span>
            <span class="@(them.Value > you.Value ? "lead" : "")">@them.Text</span>
        }
        <span class="muted">In common</span>
        <span class="span2">@c.SharedMovies movie@(c.SharedMovies == 1 ? "" : "s") · @c.SharedShows show@(c.SharedShows == 1 ? "" : "s")</span>
    </div>

    @if (c.RatedBoth.Count > 0)
    {
        <section class="row-section">
            <div class="section-head"><h2>Rated by both</h2></div>
            <div class="poster-scroller">
                @foreach (var r in c.RatedBoth)
                {
                    <PosterCard Media="r.Media" ShowScore="false" Sub="@($"You ★{r.You} · {c.Them.Name} ★{r.Them}")"
                                Badge="@(r.You == r.Them ? "Agree" : Math.Abs(r.You - r.Them) >= 4 ? "Disagree" : null)" @key="(r.Media.Type, r.Media.TmdbId)" />
                }
            </div>
        </section>
    }
    @if (c.TheyLoved.Count > 0) { <PosterRow Title="@($"{c.Them.Name} loved, you haven't seen")" Items="c.TheyLoved" /> }
    @if (c.BothMovies.Count > 0) { <PosterRow Title="Movies you've both watched" Items="c.BothMovies" /> }
    @if (c.BothShows.Count > 0) { <PosterRow Title="Shows you've both watched" Items="c.BothShows" /> }
}

@code {
    [Parameter] public string Name { get; set; } = "";
    private CompareDto? c;
    private string? error;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { c = await Api.CompareAsync(Name); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { error = "You can't compare with this person: their profile isn't visible to you."; }
        catch (Exception ex) { error = ex.Message; }
    }

    private IEnumerable<(string, (long Value, string Text), (long Value, string Text))> Rows()
    {
        var (y, t) = (c!.You, c.TheirStats);
        yield return ("Time watched", (y.Minutes, Fmt.Duration(y.Minutes)), (t.Minutes, Fmt.Duration(t.Minutes)));
        yield return ("Movies", (y.Movies, y.Movies.ToString("N0")), (t.Movies, t.Movies.ToString("N0")));
        yield return ("Shows", (y.Shows, y.Shows.ToString("N0")), (t.Shows, t.Shows.ToString("N0")));
        yield return ("Episodes", (y.Episodes, y.Episodes.ToString("N0")), (t.Episodes, t.Episodes.ToString("N0")));
        yield return ("Ratings", (y.Ratings, y.Ratings.ToString("N0")), (t.Ratings, t.Ratings.ToString("N0")));
    }
}
