@page "/compare/{A}/{B}"
@page "/u/{B}/compare"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>@(c is null ? "Compare" : $"{c.A.Name} vs {c.B.Name}") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (c is null && error is null) { <Spinner /> }
else if (c is not null)
{
    <div class="compare-head">
        <h1><a href="@Fmt.UserHref(c.A.UserName)">@c.A.Name</a> vs <a href="@Fmt.UserHref(c.B.UserName)">@c.B.Name</a></h1>
        <button class="btn btn-sm" @onclick="() => shareOpen = true"><Icon Name="share" Size="16" /> Share image</button>
        @if (c.Compatibility is { } pct)
        {
            <div class="compat">
                <span class="compat-value">@pct%</span>
                <span class="muted small">taste match, from @c.RatedBoth.Count title@(c.RatedBoth.Count == 1 ? "" : "s") both rated</span>
            </div>
        }
    </div>

    <div class="compare-table panel">
        <div></div><b>@c.A.Name</b><b>@c.B.Name</b>
        @foreach (var (label, a, b) in Rows())
        {
            <span class="muted">@label</span>
            <span class="@(a.Value > b.Value ? "lead" : "")" title="@Fmt.HoursTip(a.Text)">@a.Text</span>
            <span class="@(b.Value > a.Value ? "lead" : "")" title="@Fmt.HoursTip(b.Text)">@b.Text</span>
        }
        <span class="muted">In common</span>
        <span class="span2">@c.SharedMovies movie@(c.SharedMovies == 1 ? "" : "s") · @c.SharedShows show@(c.SharedShows == 1 ? "" : "s")</span>
    </div>

    <ShareCardDialog @bind-Open="shareOpen" Title="@($"{c.A.Name} vs {c.B.Name}")" FileName="@($"seenit-{c.A.UserName}-{c.B.UserName}.png")"
                     Load="() => Api.CompareCardAsync(c.A.UserName, c.B.UserName)" />

    @foreach (var (key, title, items) in Sections())
    {
        if (items.Count == 0) continue;
        var kind = Kind(key);
        var find = finds.GetValueOrDefault(key, "");
        var searching = !string.IsNullOrWhiteSpace(find);
        var shown = items.Where(i => (kind == "all" || i.Media.Type == (kind == "movie" ? MediaType.Movie : MediaType.Show)) && TextMatch.Contains(i.Media.Title, find)).ToList();
        var expanded = open.Contains(key) || searching;   // matches show in full
        <section class="row-section compare-section" @key="key">
            <div class="section-head">
                <h2>@title <span class="muted small">@shown.Count</span></h2>
                <div class="section-tools">
                    <div class="segmented segmented-sm">
                        <button class="@(kind == "all" ? "on" : "")" @onclick='() => kinds[key] = "all"'>All</button>
                        <button class="@(kind == "movie" ? "on" : "")" @onclick='() => kinds[key] = "movie"'>Movies</button>
                        <button class="@(kind == "show" ? "on" : "")" @onclick='() => kinds[key] = "show"'>TV</button>
                    </div>
                    @if (!searching && (shown.Count > RowSize || expanded))
                    {
                        <button class="section-more link-btn" @onclick="() => Toggle(key)">@(expanded ? "Show less" : $"See all {shown.Count}") <Icon Name="@(expanded ? "chevron-up" : "chevron-down")" Size="16" /></button>
                    }
                </div>
            </div>
            @if (items.Count > 1)
            {
                <div class="searchbar searchbar-sm compare-find">
                    <Icon Name="search" Size="16" />
                    <input type="search" value="@find" @oninput="e => finds[key] = e.Value?.ToString() ?? string.Empty" placeholder="Search this section" aria-label="@($"Search {title}")" />
                </div>
            }
            @if (shown.Count == 0) { <p class="muted small">@(searching ? $"Nothing called “{find.Trim()}” here." : "None.")</p> }
            else
            {
                <div class="@(expanded ? "poster-grid" : "poster-scroller")">
                    @foreach (var i in expanded ? shown : shown.Take(RowSize))
                    {
                        <PosterCard Media="i.Media" ShowScore="false" Sub="@Ratings(i)" SubTitle="@RatingsLong(i)"
                                    Badge="@(key == "rated" ? (i.A == i.B ? "Agree" : Math.Abs(i.A!.Value - i.B!.Value) >= 4 ? "Disagree" : null) : null)"
                                    @key="(i.Media.Type, i.Media.TmdbId)" />
                    }
                </div>
            }
        </section>
    }
}

@code {
    [Parameter] public string? A { get; set; }
    [Parameter] public string B { get; set; } = "";
    private const int RowSize = 20;
    private CompareDto? c;
    private string? error;
    private bool shareOpen;
    private readonly Dictionary<string, string> finds = [];
    private readonly Dictionary<string, string> kinds = [];
    private readonly HashSet<string> open = [];

    protected override async Task OnParametersSetAsync()
    {
        // Old links (/u/{name}/compare) compared against whoever was signed in: make that explicit.
        if (A is null)
        {
            if (Session.Me is { } me) { Nav.NavigateTo(Fmt.CompareHref(me.UserName, B), replace: true); return; }
            error = "Sign in to compare.";
            return;
        }
        c = null;
        kinds.Clear();
        open.Clear();
        finds.Clear();
        await Load();
    }

    private async Task Load()
    {
        error = null;
        try { c = await Api.CompareAsync(A!, B); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { error = "These two can't be compared: one of the profiles isn't visible to you (or doesn't exist)."; }
        catch (Exception ex) { error = ex.Message; }
    }

    private string Kind(string key) => kinds.GetValueOrDefault(key, "all");
    private void Toggle(string key) { if (!open.Remove(key)) open.Add(key); }

    private IEnumerable<(string Key, string Title, IReadOnlyList<CompareItem> Items)> Sections()
    {
        yield return ("rated", "Rated by both", c!.RatedBoth);
        yield return ("watched", "Watched by both", c.WatchedBoth);
        yield return ("b-loved", $"{c.B.Name} loved, {c.A.Name} hasn't seen", c.BLovedANot);
        yield return ("a-loved", $"{c.A.Name} loved, {c.B.Name} hasn't seen", c.ALovedBNot);
    }

    /// <summary>"★8 · ★7": first person's rating, then the second's ("–" if unrated); names are in the legend and the hover.</summary>
    private static string? Ratings(CompareItem i) =>
        i.A is null && i.B is null ? i.Media.Year?.ToString() : $"{Star(i.A)} · {Star(i.B)}";

    private static string Star(double? r) => r is { } v ? $"★{Fmt.Stars(v)}" : "–";

    private string? RatingsLong(CompareItem i) =>
        i.A is null && i.B is null ? null
        : $"{c!.A.Name}: {(i.A is { } a ? Fmt.Rating(a) : "not rated")} · {c.B.Name}: {(i.B is { } b ? Fmt.Rating(b) : "not rated")}";


    private IEnumerable<(string, (long Value, string Text), (long Value, string Text))> Rows()
    {
        var (a, b) = (c!.AStats, c.BStats);
        yield return ("Time watched", (a.Minutes, Fmt.Duration(a.Minutes)), (b.Minutes, Fmt.Duration(b.Minutes)));
        yield return ("Movies", (a.Movies, a.Movies.ToString("N0")), (b.Movies, b.Movies.ToString("N0")));
        yield return ("Shows", (a.Shows, a.Shows.ToString("N0")), (b.Shows, b.Shows.ToString("N0")));
        yield return ("Episodes", (a.Episodes, a.Episodes.ToString("N0")), (b.Episodes, b.Episodes.ToString("N0")));
        yield return ("Ratings", (a.Ratings, a.Ratings.ToString("N0")), (b.Ratings, b.Ratings.ToString("N0")));
    }
}
