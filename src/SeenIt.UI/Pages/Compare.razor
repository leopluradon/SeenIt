@page "/compare/{A}/{B}"
@page "/u/{B}/compare"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>@(c is null ? "Compare" : $"{c.A.Name} vs {c.B.Name}") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (c is null && error is null) { <Spinner /> }
else if (c is not null)
{
    <div class="compare-head">
        <h1><a href="@Fmt.UserHref(c.A.UserName)">@c.A.Name</a> vs <a href="@Fmt.UserHref(c.B.UserName)">@c.B.Name</a></h1>
        <button class="btn btn-sm" @onclick="() => shareOpen = true"><Icon Name="share" Size="16" /> Share image</button>
        @if (c.Compatibility is { } pct)
        {
            <div class="compat">
                <span class="compat-value">@pct%</span>
                <span class="muted small">taste match, from @c.RatedBoth.Count title@(c.RatedBoth.Count == 1 ? "" : "s") both rated</span>
            </div>
        }
    </div>

    <div class="compare-table panel">
        <div></div><b>@c.A.Name</b><b>@c.B.Name</b>
        @foreach (var (label, a, b) in Rows())
        {
            <span class="muted">@label</span>
            <span class="@(a.Value > b.Value ? "lead" : "")" title="@Fmt.HoursTip(a.Text)">@a.Text</span>
            <span class="@(b.Value > a.Value ? "lead" : "")" title="@Fmt.HoursTip(b.Text)">@b.Text</span>
        }
        <span class="muted">In common</span>
        <span class="span2">@c.SharedMovies movie@(c.SharedMovies == 1 ? "" : "s") · @c.SharedShows show@(c.SharedShows == 1 ? "" : "s")</span>
    </div>

    <ShareCardDialog @bind-Open="shareOpen" Title="@($"{c.A.Name} vs {c.B.Name}")" FileName="@($"seenit-{c.A.UserName}-{c.B.UserName}.png")"
                     Load="() => Api.CompareCardAsync(c.A.UserName, c.B.UserName)" />

    @foreach (var (key, title, items) in Sections())
    {
        if (items.Count == 0) continue;
        var kind = Kind(key);
        var find = finds.GetValueOrDefault(key, "");
        var searching = !string.IsNullOrWhiteSpace(find);
        var shown = Sorted(key, items.Where(i => (kind == "all" || i.Media.Type == (kind == "movie" ? MediaType.Movie : MediaType.Show)) && TextMatch.Contains(i.Media.Title, find)
            && InDecade(key, i) && RatedMatch(key, i) && MoreMatch(key, i))).ToList();
        var recommendTo = RecommendTo(key);
        var expanded = open.Contains(key) || searching;   // matches show in full
        <section class="row-section compare-section" @key="key">
            <div class="section-head">
                <h2>@title <span class="muted small">@shown.Count</span></h2>
                <div class="section-tools">
                    <div class="segmented segmented-sm">
                        <button class="@(kind == "all" ? "on" : "")" @onclick='() => kinds[key] = "all"'>All</button>
                        <button class="@(kind == "movie" ? "on" : "")" @onclick='() => kinds[key] = "movie"'>Movies</button>
                        <button class="@(kind == "show" ? "on" : "")" @onclick='() => kinds[key] = "show"'>TV</button>
                    </div>
                    @if (!searching && (shown.Count > RowSize || expanded))
                    {
                        <button class="section-more link-btn" @onclick="() => Toggle(key)">@(expanded ? "Show less" : $"See all {shown.Count}") <Icon Name="@(expanded ? "chevron-up" : "chevron-down")" Size="16" /></button>
                    }
                </div>
            </div>
            @if (items.Count > 1)
            {
                var active = ActiveFilters(key);
                var panelOpen = filtersOpen.Contains(key);
                <div class="searchbar searchbar-sm compare-find">
                    <Icon Name="search" Size="16" />
                    <input type="search" value="@find" @oninput="e => finds[key] = e.Value?.ToString() ?? string.Empty" placeholder="Search this section" aria-label="@($"Search {title}")" />
                    <button type="button" class="btn btn-sm filter-toggle @(active > 0 ? "btn-on" : "")" aria-expanded="@panelOpen" @onclick="() => { if (!filtersOpen.Remove(key)) filtersOpen.Add(key); }">
                        <Icon Name="sliders" Size="14" /> Filters@(active > 0 ? $" · {active}" : "")
                    </button>
                </div>
                @if (panelOpen)
                {
                    <div class="filter-row compare-filters">
                        <label class="sort-pick">
                            <span class="muted small">Sort</span>
                            <select value="@sorts.GetValueOrDefault(key, "default")" @onchange='e => sorts[key] = e.Value as string ?? "default"' aria-label="@($"Sort {title}")">
                                @foreach (var (sk, sl) in SortChoices(key, items)) { <option value="@sk">@sl</option> }
                            </select>
                        </label>
                        @{ var genreChoices = items.SelectMany(i => i.Genres ?? []).Distinct().Order().ToList(); }
                        @if (genreChoices.Count > 1)
                        {
                            <label class="sort-pick">
                                <span class="muted small">Genre</span>
                                <select value="@(genres.GetValueOrDefault(key) ?? "")" @onchange="e => genres[key] = e.Value as string is { Length: > 0 } g ? g : null">
                                    <option value="">Any</option>
                                    @foreach (var g in genreChoices) { <option value="@g">@g</option> }
                                </select>
                            </label>
                        }
                        @{ var decadeChoices = items.Select(i => i.Media.Year).OfType<int>().Select(y => y / 10 * 10).Distinct().OrderByDescending(d => d).ToList(); }
                        @if (decadeChoices.Count > 1)
                        {
                            <label class="sort-pick">
                                <span class="muted small">Decade</span>
                                <select value="@(decades.GetValueOrDefault(key)?.ToString() ?? "")" @onchange="e => decades[key] = int.TryParse(e.Value as string, out var d) ? d : null">
                                    <option value="">Any</option>
                                    @foreach (var d in decadeChoices) { <option value="@d">@(d)s</option> }
                                </select>
                            </label>
                        }
                        @if (items.Any(i => i.Media.VoteAverage is > 0))
                        {
                            <label class="sort-pick">
                                <span class="muted small">TMDB score</span>
                                <select value="@(minTmdb.GetValueOrDefault(key)?.ToString() ?? "")" @onchange="e => minTmdb[key] = int.TryParse(e.Value as string, out var v) ? v : null">
                                    <option value="">Any</option>
                                    @for (var v = 8; v >= 5; v--) { <option value="@v">@v+</option> }
                                </select>
                            </label>
                        }
                        @foreach (var (side, name) in new[] { ("a", c.A.Name), ("b", c.B.Name) })
                        {
                            @if (items.Any(i => (side == "a" ? i.A : i.B) is not null))
                            {
                                var mk = $"{key}:{side}";
                                <label class="sort-pick" @key="mk">
                                    <span class="muted small">@name rated</span>
                                    <select value="@(minRating.GetValueOrDefault(mk)?.ToString() ?? "")" @onchange="e => minRating[mk] = int.TryParse(e.Value as string, out var v) ? v : null">
                                        <option value="">Anything</option>
                                        @if (Fmt.Scale == RatingScale.Thumbs) { <option value="6">👍 Liked</option> }
                                        else { @foreach (var v in new[] { 9, 8, 7, 6, 5 }) { <option value="@v">@(Fmt.FiveStars ? $"★{Fmt.Stars(v)}" : v.ToString())+</option> } }
                                    </select>
                                </label>
                            }
                        }
                        @if (key == "rated")
                        {
                            <label class="sort-pick">
                                <span class="muted small">Agreement</span>
                                <select value="@agreement.GetValueOrDefault(key, "any")" @onchange='e => agreement[key] = e.Value as string ?? "any"'>
                                    <option value="any">Any</option>
                                    <option value="agree">Same rating</option>
                                    <option value="close">Within a point</option>
                                    <option value="apart">Disagree (4+ apart)</option>
                                </select>
                            </label>
                        }
                        @* Only where both have seen everything: elsewhere one of them hasn't, or one rating is why it's there. *@
                        @if (key == "watched" && items.Any(i => i.A is not null || i.B is not null))
                        {
                            <label class="sort-pick">
                                <span class="muted small">Ratings</span>
                                <select value="@rated.GetValueOrDefault(key, "any")" @onchange='e => rated[key] = e.Value as string ?? "any"' aria-label="@($"Ratings in {title}")">
                                    <option value="any">Any</option>
                                    <option value="a">Rated by @c.A.Name</option>
                                    <option value="b">Rated by @c.B.Name</option>
                                    <option value="both">Rated by both</option>
                                    <option value="none">Not rated</option>
                                </select>
                            </label>
                        }
                        @if (active > 0) { <button class="btn btn-sm btn-ghost" @onclick="() => ClearFilters(key)">Clear</button> }
                    </div>
                }
            }
            @if (shown.Count == 0) { <p class="muted small">@(searching ? $"Nothing called “{find.Trim()}” here." : "None.")</p> }
            else
            {
                <div class="@(expanded ? "poster-grid" : "poster-scroller")">
                    @foreach (var i in expanded ? shown : shown.Take(RowSize))
                    {
                        <div class="compare-card" @key="(i.Media.Type, i.Media.TmdbId)">
                            <PosterCard Media="i.Media" ShowScore="false" Sub="@Ratings(i)" SubTitle="@RatingsLong(i)"
                                        Badge="@(key == "rated" ? (i.A == i.B ? "Agree" : Math.Abs(i.A!.Value - i.B!.Value) >= 4 ? "Disagree" : null) : null)" />
                            @if (recommendTo is { } other)
                            {
                                <button class="btn btn-sm btn-block compare-rec" @onclick="() => recommending = i.Media" title="@($"Recommend {i.Media.Title} to {other.Name}")"><Icon Name="send" Size="14" /> Recommend</button>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    }
}

@if (recommending is { } rm && c is not null && Other is { } them)
{
    <RecommendDialog Open="true" OpenChanged="o => { if (!o) recommending = null; }" Type="rm.Type" TmdbId="rm.TmdbId" Title="@rm.Title" To="@them.UserName" />
}

@code {
    [Parameter] public string? A { get; set; }
    [Parameter] public string B { get; set; } = "";
    private const int RowSize = 20;
    private CompareDto? c;
    private string? error;
    private bool shareOpen;
    private readonly Dictionary<string, string> finds = [];
    private readonly Dictionary<string, string> kinds = [];
    private readonly HashSet<string> open = [];
    // Per section: order, decade and who rated it (Search and Movies/TV are above).
    private readonly Dictionary<string, string> sorts = [];
    private readonly Dictionary<string, int?> decades = [];
    private readonly Dictionary<string, string> rated = [];
    private MediaSummary? recommending;
    private readonly HashSet<string> filtersOpen = [];
    private readonly Dictionary<string, string?> genres = [];
    private readonly Dictionary<string, int?> minTmdb = [];
    private readonly Dictionary<string, int?> minRating = [];   // "{section}:a" / "{section}:b"
    private readonly Dictionary<string, string> agreement = [];

    private bool MoreMatch(string key, CompareItem i) =>
        (genres.GetValueOrDefault(key) is not { } g || i.Genres?.Contains(g) == true)
        && (minTmdb.GetValueOrDefault(key) is not { } t || i.Media.VoteAverage >= t)
        && (minRating.GetValueOrDefault($"{key}:a") is not { } ma || i.A >= ma)
        && (minRating.GetValueOrDefault($"{key}:b") is not { } mb || i.B >= mb)
        && agreement.GetValueOrDefault(key, "any") switch
        {
            "agree" => i.A == i.B,
            "close" => i.A is { } x && i.B is { } y && Math.Abs(x - y) <= 1,
            "apart" => i.A is { } x2 && i.B is { } y2 && Math.Abs(x2 - y2) >= 4,
            _ => true,
        };

    /// <summary>How many of a section's filters are on (sort counts when it isn't the section's own order).</summary>
    private int ActiveFilters(string key) => new[]
    {
        sorts.GetValueOrDefault(key, "default") != "default", genres.GetValueOrDefault(key) is not null, decades.GetValueOrDefault(key) is not null,
        minTmdb.GetValueOrDefault(key) is not null, minRating.GetValueOrDefault($"{key}:a") is not null, minRating.GetValueOrDefault($"{key}:b") is not null,
        agreement.GetValueOrDefault(key, "any") != "any", rated.GetValueOrDefault(key, "any") != "any",
    }.Count(on => on);

    private void ClearFilters(string key)
    {
        sorts.Remove(key); genres.Remove(key); decades.Remove(key); minTmdb.Remove(key);
        minRating.Remove($"{key}:a"); minRating.Remove($"{key}:b"); agreement.Remove(key); rated.Remove(key);
    }

    /// <summary>When you're one of the two: the other one.</summary>
    private UserCard? Other => c is null || Session.Me is not { } me ? null
        : string.Equals(c.A.UserName, me.UserName, StringComparison.OrdinalIgnoreCase) ? c.B
        : string.Equals(c.B.UserName, me.UserName, StringComparison.OrdinalIgnoreCase) ? c.A : null;

    /// <summary>Sections of what you've seen and they haven't get a Recommend button (to them).</summary>
    private UserCard? RecommendTo(string key)
    {
        if (Other is not { } them || c is null) return null;
        var meIsA = ReferenceEquals(them, c.B);
        return (meIsA ? key is "a-only" or "a-loved" : key is "b-only" or "b-loved") ? them : null;
    }

    private IEnumerable<(string Key, string Label)> SortChoices(string key, IReadOnlyList<CompareItem> items)
    {
        yield return ("default", key switch { "rated" => "Closest agreement", "watched" or "a-only" or "b-only" => "Recently watched", _ => "Highest rated" });
        if (key == "rated") yield return ("diff", "Biggest disagreement");
        yield return ("title", "Title");
        yield return ("newest", "Newest");
        yield return ("oldest", "Oldest");
        if (items.Any(i => i.A is not null)) yield return ("a", $"{c!.A.Name}'s rating");
        if (items.Any(i => i.B is not null)) yield return ("b", $"{c!.B.Name}'s rating");
        if (items.Any(i => i.Media.VoteAverage is > 0)) yield return ("tmdb", "TMDB score");
    }

    private IEnumerable<CompareItem> Sorted(string key, IEnumerable<CompareItem> items) => sorts.GetValueOrDefault(key, "default") switch
    {
        "diff" => items.OrderByDescending(i => Math.Abs((i.A ?? 0) - (i.B ?? 0))),
        "title" => items.OrderBy(i => i.Media.Title, StringComparer.OrdinalIgnoreCase),
        "newest" => items.OrderByDescending(i => i.Media.Year ?? 0),
        "oldest" => items.OrderBy(i => i.Media.Year ?? int.MaxValue),
        "a" => items.OrderByDescending(i => i.A ?? -1),
        "b" => items.OrderByDescending(i => i.B ?? -1),
        "tmdb" => items.OrderByDescending(i => i.Media.VoteAverage ?? -1),
        _ => items,
    };

    private bool InDecade(string key, CompareItem i) => decades.GetValueOrDefault(key) is not { } d || i.Media.Year is { } y && y / 10 * 10 == d;

    private bool RatedMatch(string key, CompareItem i) => rated.GetValueOrDefault(key, "any") switch
    {
        "a" => i.A is not null,
        "b" => i.B is not null,
        "both" => i.A is not null && i.B is not null,
        "none" => i.A is null && i.B is null,
        _ => true,
    };

    protected override async Task OnParametersSetAsync()
    {
        // Old links (/u/{name}/compare) compared against whoever was signed in: make that explicit.
        if (A is null)
        {
            if (Session.Me is { } me) { Nav.NavigateTo(Fmt.CompareHref(me.UserName, B), replace: true); return; }
            error = "Sign in to compare.";
            return;
        }
        c = null;
        kinds.Clear();
        open.Clear();
        finds.Clear();
        sorts.Clear();
        decades.Clear();
        rated.Clear();
        filtersOpen.Clear(); genres.Clear(); minTmdb.Clear(); minRating.Clear(); agreement.Clear();
        await Load();
    }

    private async Task Load()
    {
        error = null;
        try { c = await Api.CompareAsync(A!, B); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { error = "These two can't be compared: one of the profiles isn't visible to you (or doesn't exist)."; }
        catch (Exception ex) { error = ex.Message; }
    }

    private string Kind(string key) => kinds.GetValueOrDefault(key, "all");
    private void Toggle(string key) { if (!open.Remove(key)) open.Add(key); }

    private IEnumerable<(string Key, string Title, IReadOnlyList<CompareItem> Items)> Sections()
    {
        yield return ("rated", "Rated by both", c!.RatedBoth);
        yield return ("watched", "Watched by both", c.WatchedBoth);
        yield return ("a-only", $"Only {c.A.Name} has seen", c.AOnly ?? []);
        yield return ("b-only", $"Only {c.B.Name} has seen", c.BOnly ?? []);
        yield return ("b-loved", $"{c.B.Name} loved, {c.A.Name} hasn't seen", c.BLovedANot);
        yield return ("a-loved", $"{c.A.Name} loved, {c.B.Name} hasn't seen", c.ALovedBNot);
    }

    /// <summary>"★8 · ★7": first person's rating, then the second's ("–" if unrated); names are in the legend and the hover.</summary>
    private static string? Ratings(CompareItem i) =>
        i.A is null && i.B is null ? i.Media.Year?.ToString() : $"{Star(i.A)} · {Star(i.B)}";

    private static string Star(double? r) => r is { } v ? Fmt.Thumb(v) ? Fmt.Stars(v) : $"★{Fmt.Stars(v)}" : "–";

    private string? RatingsLong(CompareItem i) =>
        i.A is null && i.B is null ? null
        : $"{c!.A.Name}: {(i.A is { } a ? Fmt.Rating(a) : "not rated")} · {c.B.Name}: {(i.B is { } b ? Fmt.Rating(b) : "not rated")}";


    private IEnumerable<(string, (long Value, string Text), (long Value, string Text))> Rows()
    {
        var (a, b) = (c!.AStats, c.BStats);
        yield return ("Time watched", (a.Minutes, Fmt.Duration(a.Minutes)), (b.Minutes, Fmt.Duration(b.Minutes)));
        yield return ("Movies", (a.Movies, a.Movies.ToString("N0")), (b.Movies, b.Movies.ToString("N0")));
        yield return ("Shows", (a.Shows, a.Shows.ToString("N0")), (b.Shows, b.Shows.ToString("N0")));
        yield return ("Episodes", (a.Episodes, a.Episodes.ToString("N0")), (b.Episodes, b.Episodes.ToString("N0")));
        yield return ("Ratings", (a.Ratings, a.Ratings.ToString("N0")), (b.Ratings, b.Ratings.ToString("N0")));
    }
}
