@page "/show/{Id:int}/season/{Season:int}/episode/{Number:int}"
@inject ApiClient Api
@inject Toasts Toasts
@inject NavigationManager Nav
<PageTitle>@(e is null ? "Episode" : $"{e.ShowName} {Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)}") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (e is null && error is null) { <Spinner /> }
else if (e is not null)
{
    var aired = e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today);
    <nav class="crumbs">
        <a href="@($"show/{Id}")"><Icon Name="chevron-left" Size="16" /> @e.ShowName</a>
        <span class="muted">/</span>
        <a href="@($"show/{Id}/season/{Season}")">@(Season == 0 ? "Specials" : $"Season {Season}")</a>
    </nav>

    <div class="episode-hero">
        <div class="episode-hero-art">
            <Spoiler Watched="Seen" Image="true">
                <div class="episode-hero-img bg-responsive" style="@Img.BackdropStyle(e.StillPath ?? e.ShowBackdropPath)"></div>
            </Spoiler>
            @if (e.Plays is { Count: > 0 }) { <span class="poster-badge done"><Icon Name="check" Size="14" /></span> }
        </div>
        <div class="episode-hero-info">
            <div class="muted">@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)</div>
            <h1><Spoiler Watched="Seen">@(e.Name ?? $"Episode {e.EpisodeNumber}")</Spoiler></h1>
            <div class="facts">
                @if (e.AirDate is { } ad) { <span>@(aired ? "Aired" : "Airs") @ad.ToString(Fmt.DateLong)</span> }
                @if (e.Runtime is > 0) { <span>@Fmt.Runtime(e.Runtime)</span> }
                @if (!aired) { <span class="pill">Not aired yet</span> }
            </div>
            <ScoreSpoiler Watched="Seen" Block="true">
            @if (e.VoteAverage is > 0 && Fmt.ShowsScore("tmdb", MediaType.Episode))
            {
                <div class="score"><Icon Name="star" Size="16" /> <b>@e.VoteAverage.Value.ToString("0.0")</b> <span class="muted small">TMDB · @e.VoteCount?.ToString("N0") votes</span></div>
            }
            <ExternalScores Type="MediaType.Episode" TmdbId="Id" Season="Season" Episode="Number" />
            </ScoreSpoiler>
            <div class="actions">
                @if (e.Plays is { } plays)
                {
                    <button class="btn @(plays.Count > 0 ? "btn-watched" : "btn-primary")" disabled="@(busy || !aired)" @onclick="() => { through = false; askWhen = false; watchOpen = true; }">
                        <Icon Name="check" Size="18" /> @(plays.Count switch { 0 => "Mark watched", 1 => "Watched · watch again", var n => $"Watched {n}× · watch again" })
                    </button>
                    <WhenButton Disabled="@(busy || !aired)" What="@Fmt.Ep(Season, Number)" OnClick="() => { through = false; askWhen = true; watchOpen = true; }" />
                    @if (plays.Count == 0 && aired && e.Next is { } nx)
                    {
                        <button class="btn" disabled="@busy" @onclick="WatchAndNext" title="@($"Mark watched now and go to {Fmt.Ep(nx.SeasonNumber, nx.EpisodeNumber)}")">Watched, next episode <Icon Name="chevron-right" Size="16" /></button>
                    }
                    @if (plays.Count == 0 && aired && Fmt.CanThrough(Season, Number))
                    {
                        <button class="btn" disabled="@busy" @onclick="() => { through = true; watchOpen = true; }" title="Mark this and every earlier episode watched">Mark up to here</button>
                    }
                    @if (aired) { <CheckInButton Request="@(new CheckInRequest(MediaType.Episode, Id, Season, Number))" /> }
                }
                else
                {
                    <a class="btn btn-primary" href="@($"login?returnUrl={Fmt.EpisodeHref(Id, Season, Number)}")">Sign in to track</a>
                }
            </div>
        </div>
    </div>

    <div class="detail-body">
        @if (e.Plays is { } myPlays)
        {
            <div class="you-split">
            <div class="panel you-panel">
            <div class="rate-panel">
                <span>Your rating</span>
                <RatingPicker Value="e.Rating" ValueChanged="Rate" />
            </div>
            @if (myPlays.Count > 0)
            {
                <div class="you-plays">
                    <div class="panel-head"><h2>Your plays</h2></div>
                    <div class="plays">
                        @foreach (var p in myPlays)
                        {
                            <div class="play" @key="p.Id">
                                <Icon Name="check" Size="16" Class="ok" />
                                <span>@Fmt.PlayedAt(p.WatchedAt)</span>
                                @if (p.Source != WatchSource.Manual) { <span class="pill pill-sm">@Fmt.Source(p.Source)</span> }
                                <button class="icon-btn" @onclick="() => editing = p" aria-label="Change this play's date"><Icon Name="edit" Size="16" /></button>
                                <button class="icon-btn" @onclick="() => RemovePlay(p)" aria-label="Remove this play"><Icon Name="trash" Size="16" /></button>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
            <FriendsSeen Type="MediaType.Episode" TmdbId="Id" Season="Season" Episode="Number" Watched="Seen" />
            </div>
        }
        @if (e.Overview is not null) { <Spoiler Watched="Seen" Block="true"><p class="overview">@e.Overview</p></Spoiler> }
        @if (e.Crew.Count > 0)
        {
            <dl class="crew">
                @foreach (var g in e.Crew.GroupBy(c => c.Job))
                {
                    <div><dt>@g.Key</dt><dd>@{ var first = true; foreach (var c in g.DistinctBy(c => c.Id)) { if (!first) { <span>, </span> } first = false; <a href="@($"person/{c.Id}")">@c.Name</a> } }</dd></div>
                }
            </dl>
        }
    </div>

    <nav class="episode-nav">
        @if (e.Previous is { } prev)
        {
            <a class="episode-nav-link" href="@Fmt.EpisodeHref(Id, prev.SeasonNumber, prev.EpisodeNumber)">
                <Icon Name="chevron-left" Size="18" />
                <span><span class="muted small">Previous · @Fmt.Ep(prev.SeasonNumber, prev.EpisodeNumber)</span><br /><Spoiler Watched="prev.Watched">@prev.Name</Spoiler></span>
            </a>
        }
        else { <span></span> }
        @if (e.Next is { } next)
        {
            <a class="episode-nav-link next" href="@Fmt.EpisodeHref(Id, next.SeasonNumber, next.EpisodeNumber)">
                <span><span class="muted small">Next · @Fmt.Ep(next.SeasonNumber, next.EpisodeNumber)</span><br /><Spoiler Watched="next.Watched">@next.Name</Spoiler></span>
                <Icon Name="chevron-right" Size="18" />
            </a>
        }
    </nav>

    <SeasonEpisodes ShowId="Id" ShowName="@e.ShowName" ShowPoster="@e.ShowPosterPath" CurrentSeason="Season" CurrentEpisode="Number" Seasons="@(e.Seasons ?? [])" OnChanged="Reload" CanWatch="e.Plays is not null" />

    <CastRow Cast="@(e.Cast ?? [])" Title="Cast" />
    @if (Fmt.Prefs.HideGuestStars && !Seen && !showGuests && e.GuestStars.Count > 0)
    {
        <section class="row-section">
            <div class="section-head"><h2>Guest stars <span class="muted small">@e.GuestStars.Count</span></h2></div>
            <button class="btn btn-sm hidden-guests" @onclick="() => showGuests = true"><Icon Name="eye" Size="14" /> Hidden to avoid spoilers. Show guest stars</button>
        </section>
    }
    else { <CastRow Cast="e.GuestStars" Title="Guest stars" /> }

    <RatePrompt @bind-Open="ratePrompt" Title="@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)" OnRate="Rate" />
    <WatchDialog @bind-Open="watchOpen" What="@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)" ReleaseDate="e.AirDate" OnPick="Watch" AskWhen="askWhen"
                 Through="through" ThroughNote="@(Season == 0 ? " (specials only)" : ", in season order")" ScopeSeason="@(Season > 1 && Number > 1 ? Season : null)" />
    <EditPlayDialog @bind-Play="editing" What="@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)" ReleaseDate="e.AirDate" OnSaved="Reload" />
}

<ReloadOnMenu OnChange="Reload" />
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Season { get; set; }
    [Parameter] public int Number { get; set; }
    private EpisodeDetail? e;
    private string? error;
    private bool busy, watchOpen, through, ratePrompt, askWhen;
    private PlayDto? editing;

    private async Task Reload() { e = await Api.EpisodeAsync(Id, Season, Number); StateHasChanged(); }
    private bool Seen => e?.Plays is { Count: > 0 };
    private bool showGuests;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        if (e is not null && (e.ShowTmdbId != Id || e.SeasonNumber != Season || e.EpisodeNumber != Number)) e = null;
        try { e = await Api.EpisodeAsync(Id, Season, Number); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Act(Func<Task> action, string? done = null)
    {
        busy = true;
        try
        {
            await action();
            if (done is not null) Toasts.Show(done, undo: TakeUndo());
            e = await Api.EpisodeAsync(Id, Season, Number);
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }

    private async Task Watch(WatchChoice c)
    {
        if (c.Through)
        {
            await Act(async () => Toasts.Show(Fmt.Through(await Api.WatchThroughAsync(Id, new WatchThroughRequest(Season, Number, c.When, c.At, SeasonOnly: c.SeasonOnly)), c)));
            return;
        }
        var unrated = e?.Rating is null;
        await Act(() => Api.WatchAsync(Fmt.Watch(MediaType.Episode, Id, c, Season, Number)), $"Watched {Fmt.Ep(Season, Number)}{Fmt.When(c)}");
        if (unrated && e is { Rating: null, Plays.Count: > 0 }) ratePrompt = true;   // offer a rating while it's fresh
    }

    /// <summary>One tap: mark this watched now and go to the next episode.</summary>
    private async Task WatchAndNext()
    {
        if (e?.Next is not { } next) return;
        busy = true;
        try
        {
            await Api.WatchAsync(Fmt.Watch(MediaType.Episode, Id, new WatchChoice(WatchTime.Now), Season, Number));
            Toasts.Show($"Watched {Fmt.Ep(Season, Number)}");
            Nav.NavigateTo(Fmt.EpisodeHref(Id, next.SeasonNumber, next.EpisodeNumber));
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private Task RemovePlay(PlayDto p) => Act(async () =>
    {
        var removed = await Api.DeleteHistoryAsync(p.Id);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Play removed");

    private Task Rate(double? value) => value is { } v
        ? Act(() => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, v, Season, Number)), $"Rated {Fmt.Rating(v)}")
        : Act(async () =>
        {
            var old = e!.Rating;
            await Api.UnrateAsync(MediaType.Episode, Id, Season, Number);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, o, Season, Number));
        }, "Rating removed");

    // Set by an action that can be undone; the toast it shows gets an Undo button.
    private Func<Task>? undo;
    private Func<Task>? TakeUndo()
    {
        if (undo is not { } u) return null;
        undo = null;
        return async () => { await u(); await InvokeAsync(async () => { await Load(); StateHasChanged(); }); };
    }

}
