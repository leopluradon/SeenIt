@page "/reset-password"
@inject ApiClient Api
<PageTitle>Choose a new password · SeenIt</PageTitle>

<div class="auth-card">
    <Logo />
    <h1>Choose a new password</h1>
    @if (done)
    {
        <p class="muted center">Your password has been changed and every device has been signed out.</p>
        <a class="btn btn-primary btn-block" href="login">Sign in</a>
    }
    else if (UserId is null || string.IsNullOrEmpty(Token))
    {
        <p class="muted center">This link is incomplete. Open the whole link from the email, or ask for a new one.</p>
        <a class="btn btn-block" href="forgot-password">Send a new link</a>
    }
    else
    {
        <form @onsubmit="Submit">
            <div class="field">
                <label for="reset-pass">New password</label>
                <input id="reset-pass" type="password" @bind="password" autocomplete="new-password" minlength="8" required />
            </div>
            <div class="field">
                <label for="reset-pass2">Confirm new password</label>
                <input id="reset-pass2" type="password" @bind="confirm" autocomplete="new-password" minlength="8" required />
            </div>
            <ErrorBox Message="@error" />
            <button class="btn btn-primary btn-block" type="submit" disabled="@busy">@(busy ? "Saving…" : "Change password")</button>
        </form>
        <p class="muted center"><a href="forgot-password">Send a new link</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "user")] public Guid? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private string? password, confirm, error;
    private bool busy, done;

    private async Task Submit()
    {
        error = null;
        if ((password ?? "").Length < 8) { error = "Passwords need at least 8 characters."; return; }
        if (password != confirm) { error = "The two passwords don't match."; return; }
        busy = true;
        try
        {
            await Api.ResetPasswordAsync(new ResetPasswordRequest(UserId!.Value, Token!, password!));
            done = true;
        }
        catch (Exception ex) { error = ex.Message; }
        busy = false;
    }
}
