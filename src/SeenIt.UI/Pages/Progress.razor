@page "/progress"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Progress · SeenIt</PageTitle>

<div class="page-head">
    <h1>Progress</h1>
    <div class="segmented">
        <button class="@(tab == "watching" ? "on" : "")" @onclick='() => tab = "watching"'>Watching</button>
        <button class="@(tab == "waiting" ? "on" : "")" @onclick='() => tab = "waiting"'>Caught up</button>
        <button class="@(tab == "paused" ? "on" : "")" @onclick='() => tab = "paused"'>Paused@(Count(ShowTrackStatus.Paused))</button>
        <button class="@(tab == "dropped" ? "on" : "")" @onclick='() => tab = "dropped"'>Dropped@(Count(ShowTrackStatus.Dropped))</button>
        <button class="@(tab == "all" ? "on" : "")" @onclick='() => tab = "all"'>All</button>
    </div>
</div>
<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = items.Where(p => tab switch
    {
        "watching" => p.NextEpisode is not null && p.Status == ShowTrackStatus.Watching,
        "waiting" => p.NextEpisode is null && p.Status != ShowTrackStatus.Dropped,
        "paused" => p.Status == ShowTrackStatus.Paused,
        "dropped" => p.Status == ShowTrackStatus.Dropped,
        _ => true,
    }).ToList();
    @if (shown.Count == 0)
    {
        <Empty Title="@(tab == "watching" ? "Nothing in progress." : "Nothing here.")">
            @(tab switch
            {
                "paused" => "Pause a show from its page or the ⋯ menu here to keep it out of Up next for a while.",
                "dropped" => "Shows you give up on can be dropped so they stop showing up in Up next and the calendar.",
                _ => "Mark episodes of a show watched to start tracking your progress.",
            })
        </Empty>
    }
    else
    {
        <div class="progress-list">
            @foreach (var p in shown)
            {
                <div class="progress-item" @key="p.ShowTmdbId">
                    <a href="@($"show/{p.ShowTmdbId}")"><img src="@Img.Poster(p.PosterPath, "w154")" alt="" loading="lazy" /></a>
                    <div class="progress-body">
                        <a href="@($"show/{p.ShowTmdbId}")" class="mini-title">@p.Name</a>
                        <div class="inline">
                            <ProgressBar Value="p.Watched" Max="p.Aired" />
                            <span class="muted small nowrap">@p.Watched/@p.Aired</span>
                        </div>
                        @if (p.NextEpisode is { } n)
                        {
                            <div class="small">Next: <a href="@Fmt.EpisodeHref(p.ShowTmdbId, n.SeasonNumber, n.EpisodeNumber)"><b>@Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)</b> <Spoiler>@n.Name</Spoiler></a></div>
                        }
                        else if (p.Completed) { <div class="small ok">All caught up</div> }
                        @if (p.LastWatchedAt is { } lw) { <div class="muted small">Last watched @Fmt.Relative(lw)@(p.Status != ShowTrackStatus.Watching ? $" · {p.Status}" : "")</div> }
                        @if (menuFor == p.ShowTmdbId)
                        {
                            <div class="chips progress-menu">
                                @if (p.Status != ShowTrackStatus.Watching) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Watching)">Resume</button> }
                                @if (p.Status != ShowTrackStatus.Paused) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Paused)"><Icon Name="pause" Size="12" /> Pause</button> }
                                @if (p.Status != ShowTrackStatus.Dropped) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Dropped)"><Icon Name="x" Size="12" /> Drop</button> }
                            </div>
                        }
                    </div>
                    <div class="progress-actions">
                        @if (p.NextEpisode is { } next && p.Status != ShowTrackStatus.Dropped)
                        {
                            <button class="btn btn-sm btn-check" @onclick="() => pending = (p, next)" aria-label="Mark next episode watched"><Icon Name="check" Size="16" /></button>
                        }
                        <button class="icon-btn" @onclick="() => menuFor = menuFor == p.ShowTmdbId ? null : p.ShowTmdbId" aria-label="More options for @p.Name" aria-expanded="@(menuFor == p.ShowTmdbId)"><Icon Name="more" Size="18" /></button>
                    </div>
                </div>
            }
        </div>
    }
}
@if (pending is var (ps, pe))
{
    <WatchDialog Open="true" OpenChanged="o => { if (!o) pending = null; }" What="@($"{ps.Name} {Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber)}")"
                 ReleaseDate="pe.AirDate" OnPick="Watch" />
}
@code {
    [Inject] private Toasts Toasts { get; set; } = default!;
    private (ShowProgressDto Show, EpisodeRef Episode)? pending;
    private List<ShowProgressDto>? items;
    private string? error;
    private string tab = "watching";
    private int? menuFor;

    private string Count(ShowTrackStatus st) => items?.Count(p => p.Status == st) is > 0 and var n ? $" {n}" : "";

    private async Task SetStatus(ShowProgressDto p, ShowTrackStatus st)
    {
        menuFor = null;
        try
        {
            await Api.SetShowStatusAsync(p.ShowTmdbId, st);
            var i = items!.IndexOf(p);
            if (i >= 0) items[i] = p with { Status = st };
            Toasts.Show(st switch { ShowTrackStatus.Paused => $"Paused {p.Name}", ShowTrackStatus.Dropped => $"Dropped {p.Name}", _ => $"Resumed {p.Name}" });
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { items = await Api.ProgressAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Watch(WatchChoice c)
    {
        if (pending is not var (p, n)) return;
        pending = null;
        try
        {
            await Api.WatchAsync(Fmt.Watch(MediaType.Episode, p.ShowTmdbId, c, n.SeasonNumber, n.EpisodeNumber));
            Toasts.Show($"Watched {p.Name} {Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)}{Fmt.When(c)}");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
