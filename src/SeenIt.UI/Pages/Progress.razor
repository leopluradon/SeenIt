@page "/progress"
@page "/u/{UserName}/progress"
@* No [Authorize]: someone's shared progress (u/{name}/progress) is open as far as their History privacy allows; your own needs signing in. *@
@inject ApiClient Api
@inject SessionState Session
<PageTitle>@(Other is { } on ? $"{on}'s progress" : "Progress") · SeenIt</PageTitle>
@if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }

<div class="page-head">
    <h1>@(Other is { } o ? $"{o}'s progress" : "Progress")</h1>
    <div class="segmented" role="tablist" aria-label="What to show">
        <button role="tab" aria-selected="@(!Franchises)" class="@(Franchises ? "" : "on")" @onclick='() => Nav.NavigateTo(BasePath)'><Icon Name="tv" Size="16" /> TV shows</button>
        <button role="tab" aria-selected="@Franchises" class="@(Franchises ? "on" : "")" @onclick='() => Nav.NavigateTo(BasePath + "?view=franchises")'><Icon Name="film" Size="16" /> Movie franchises</button>
    </div>
</div>
@if (Franchises)
{
    <div class="chips">
        <button class="chip @(ftab == "progress" ? "on" : "")" @onclick='() => ftab = "progress"'>In progress</button>
        <button class="chip @(ftab == "done" ? "on" : "")" @onclick='() => ftab = "done"'>Completed</button>
        <button class="chip @(ftab == "all" ? "on" : "")" @onclick='() => ftab = "all"'>All</button>
    </div>
<FilterBar Query="@find" QueryChanged="SetFind" Placeholder="Find a franchise" />
    <ErrorBox Message="@ferror" OnRetry="LoadFranchises" />
    @if (franchises is null && ferror is null) { <Spinner Shape="list" /> }
    else if (franchises is not null)
    {
        var fshown = franchises.Where(f => ftab switch { "progress" => f.Seen < f.Released, "done" => f.Seen >= f.Released, _ => true } && Found(f.Name)).ToList();
        @if (fshown.Count == 0)
        {
            <Empty Title="@(ftab == "done" ? "No finished franchises yet." : "No franchises in progress.")">Watch a movie that's part of a series (Star Wars, Harry Potter, the MCU…) and it shows up here.</Empty>
        }
        <div class="progress-list">
            @foreach (var f in fshown)
            {
                var link = f.Next is { } nx ? $"movie/{nx.TmdbId}" : null;
                <div class="progress-item" @key="f.Id">
                    <a href="@link"><img src="@Img.Poster(f.PosterPath ?? f.Next?.PosterPath, "w154")" alt="" loading="lazy" /></a>
                    <div class="progress-body">
                        <span class="mini-title">@f.Name</span>
                        <div class="inline">
                            <ProgressBar Value="f.Seen" Max="f.Released" />
                            <span class="muted small nowrap">@f.Seen/@f.Released</span>
                        </div>
                        @if (f.Next is { } n) { <div class="small">Next: <a href="@($"movie/{n.TmdbId}")"><b>@n.Title</b>@(n.Year is { } y ? $" ({y})" : "")</a></div> }
                        else { <div class="small ok">Seen them all@(f.Upcoming > 0 ? $" · {f.Upcoming} more coming" : "")</div> }
                        @if (f.LastWatchedAt is { } lw) { <div class="muted small">Last watched <RelTime At="lw" /></div> }
                    </div>
                    <div class="progress-actions">
                        @if (Mine && f.Next is { } next)
                        {
                            <WhenButton Small="true" What="@next.Title" OnClick="() => { askWhen = true; pendingMovie = next; }" />
                            <button class="btn btn-sm btn-check" @onclick="() => { askWhen = false; pendingMovie = next; return Fmt.InstantWatch(null) is { } c ? WatchMovie(c) : Task.CompletedTask; }" aria-label="@($"Mark {next.Title} watched")"><Icon Name="check" Size="16" /></button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    @if (pendingMovie is { } pm)
    {
        <WatchDialog Open="true" OpenChanged="o => { if (!o) pendingMovie = null; }" What="@pm.Title" OnPick="WatchMovie" AskWhen="askWhen" />
    }
}
else
{
<div class="page-head">
    <div class="segmented">
        <button class="@(tab == "watching" ? "on" : "")" @onclick='() => SetTab("watching")'>Watching</button>
        <button class="@(tab == "waiting" ? "on" : "")" @onclick='() => SetTab("waiting")'>Caught up</button>
        <button class="@(tab == "paused" ? "on" : "")" @onclick='() => SetTab("paused")'>Paused@(Count(ShowTrackStatus.Paused))</button>
        <button class="@(tab == "dropped" ? "on" : "")" @onclick='() => SetTab("dropped")'>Dropped@(Count(ShowTrackStatus.Dropped))</button>
        <button class="@(tab == "all" ? "on" : "")" @onclick='() => SetTab("all")'>All</button>
    </div>
    @if (Mine) { <button class="btn btn-sm @(selecting ? "btn-on" : "")" @onclick="() => { selecting = !selecting; selected.Clear(); }" aria-pressed="@selecting"><Icon Name="check" Size="16" /> @(selecting ? "Done" : "Select")</button> }
</div>
<FilterBar Query="@find" QueryChanged="SetFind" Placeholder="Find a show" Active="@(Sort == UpNextSort.LastWatched ? 0 : 1)"
           Chips="SortChips" OnClear="ClearFilters" ViewPage="@(Mine ? "progress" : null)" ViewQuery="@ViewQuery" ViewKeep="@(["view"])">
    <div class="field">
        <label for="pf-sort">Order</label>
        <select id="pf-sort" value="@Sort" @onchange="SetSort">
            @foreach (var s in Enum.GetValues<UpNextSort>()) { <option value="@s">@UpNextSorts.Label(s)</option> }
        </select>
    </div>
</FilterBar>
<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner Shape="list" /> }
else if (items is not null)
{
    var shown = UpNextSorts.Apply(items, Sort).Where(InTab).ToList();
    @if (shown.Count == 0 && !Mine) { <Empty Title="Nothing here." /> }
    else if (shown.Count == 0)
    {
        <Empty Title="@(tab == "watching" ? "Nothing in progress." : "Nothing here.")">
            @(tab switch
            {
                "paused" => "Pause a show from its page or the ⋯ menu here to keep it out of Up next for a while.",
                "dropped" => "Shows you give up on can be dropped so they stop showing up in Up next and the calendar.",
                _ => "Mark episodes of a show watched to start tracking your progress.",
            })
            @if (tab == "watching") { <div><a class="btn btn-sm btn-primary" href="discover?type=Show">Find a show</a></div> }
        </Empty>
    }
    else
    {
        @foreach (var (heading, hint, group) in Groups(shown))
        {
        @if (heading is not null) { <h2 class="progress-group">@heading <span class="muted small">@group.Count</span></h2> }
        @if (hint is not null) { <p class="muted small progress-hint">@hint</p> }
        <div class="progress-list">
            @foreach (var p in group)
            {
                <div class="progress-item @(selecting && selected.Contains(p.ShowTmdbId) ? "picked" : "")" @key="p.ShowTmdbId" data-ctx="@(selecting ? null : Menu.Title(MediaType.Show, p.ShowTmdbId, p.Name, p.PosterPath))">
                    @if (selecting)
                    {
                        <label class="pick-box" aria-label="@($"Select {p.Name}")">
                            <input type="checkbox" checked="@selected.Contains(p.ShowTmdbId)" @onchange="() => { if (!selected.Remove(p.ShowTmdbId)) selected.Add(p.ShowTmdbId); }" />
                        </label>
                    }
                    <a href="@($"show/{p.ShowTmdbId}")"><img src="@Img.Poster(p.PosterPath, "w154")" alt="" loading="lazy" /></a>
                    <div class="progress-body">
                        <a href="@($"show/{p.ShowTmdbId}")" class="mini-title">@p.Name</a>
                        @if (p.Rewatch is { } rw) { <span class="pill rewatch-pill small"><Icon Name="repeat" Size="12" /> @Show.RewatchLabel(rw)</span> }
                        <div class="inline">
                            <ProgressBar Value="p.Watched" Max="p.Aired" />
                            <span class="muted small nowrap">@p.Watched/@p.Aired</span>
                        </div>
                        @if (p.NextEpisode is { } n)
                        {
                            <div class="small">Next: <a href="@Fmt.EpisodeHref(p.ShowTmdbId, n.SeasonNumber, n.EpisodeNumber)"><b>@Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)</b> <Spoiler>@n.Name</Spoiler></a> <EpisodeBadge Mark="n.Mark" /></div>
                        }
                        else if (p.Completed || p.ShowStatus is not null) { <div class="small @(p.Returning is not null ? "ok" : p.ShowStatus is "Ended" or "Canceled" ? "muted" : "ok")">@WaitLine(p)</div> }
                        @if (p.LastWatchedAt is { } lw) { <div class="muted small">Last watched <RelTime At="lw" />@(p.Status != ShowTrackStatus.Watching ? $" · {p.Status}" : "")</div> }
                        @if (menuFor == p.ShowTmdbId)
                        {
                            <div class="chips progress-menu">
                                @if (p.Status != ShowTrackStatus.Watching) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Watching)">Resume</button> }
                                @if (p.Status != ShowTrackStatus.Paused) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Paused)"><Icon Name="pause" Size="12" /> Pause</button> }
                                @if (p.Status != ShowTrackStatus.Dropped) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Dropped)"><Icon Name="x" Size="12" /> Drop</button> }
                            </div>
                        }
                    </div>
                    @if (Mine)
                    {
                    <div class="progress-actions">
                        @if (p.NextEpisode is { } next && p.Status != ShowTrackStatus.Dropped)
                        {
                            <WhenButton Small="true" What="@($"{p.Name} {Fmt.Ep(next.SeasonNumber, next.EpisodeNumber)}")" OnClick="() => { askWhen = true; pending = (p, next); }" />
                            <button class="btn btn-sm btn-check" @onclick="() => { askWhen = false; pending = (p, next); return Fmt.InstantWatch(next.AirDate) is { } c ? Watch(c) : Task.CompletedTask; }" aria-label="Mark next episode watched"><Icon Name="check" Size="16" /></button>
                        }
                        <button class="icon-btn" @onclick="() => menuFor = menuFor == p.ShowTmdbId ? null : p.ShowTmdbId" aria-label="More options for @p.Name" aria-expanded="@(menuFor == p.ShowTmdbId)"><Icon Name="more" Size="18" /></button>
                    </div>
                    }
                </div>
            }
        </div>
        }
    }
}
@if (selecting && !Franchises)
{
    var visible = ShownNow;
    <div class="bulk-bar" role="toolbar" aria-label="Selected shows">
        <span><b>@selected.Count</b> selected</span>
        @if (visible.Count > 0)
        {
            @if (visible.All(p => selected.Contains(p.ShowTmdbId))) { <button class="btn btn-sm btn-ghost" @onclick="() => selected.Clear()">Unselect all</button> }
            else { <button class="btn btn-sm btn-ghost" @onclick="() => { foreach (var p in visible) selected.Add(p.ShowTmdbId); }">Select all @visible.Count</button> }
        }
        <span class="bulk-actions">
            <button class="btn btn-sm" disabled="@(selected.Count == 0 || bulkBusy)" @onclick="() => SetMany(ShowTrackStatus.Watching)"><Icon Name="play" Size="16" /> Resume</button>
            <button class="btn btn-sm" disabled="@(selected.Count == 0 || bulkBusy)" @onclick="() => SetMany(ShowTrackStatus.Paused)"><Icon Name="pause" Size="16" /> Pause</button>
            <button class="btn btn-sm btn-danger" disabled="@(selected.Count == 0 || bulkBusy)" @onclick="() => SetMany(ShowTrackStatus.Dropped)"><Icon Name="x" Size="16" /> Drop</button>
        </span>
    </div>
    <div class="bulk-spacer" aria-hidden="true"></div>
}
@if (pending is var (ps, pe))
{
    <WatchDialog Open="true" OpenChanged="o => { if (!o) pending = null; }" What="@($"{ps.Name} {Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber)}")"
                 ReleaseDate="pe.AirDate" OnPick="Watch"  AskWhen="askWhen" />
}
}
<ReloadOnMenu OnChange="Load" />
@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    /// <summary>Someone else's progress (read-only), shared at u/{name}/progress.</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    private bool Mine => Other is null;
    private string BasePath => Other is { } n ? $"u/{Uri.EscapeDataString(n)}/progress" : "progress";
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? loadedFor = "\0";
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    /// <summary>TV shows are the default; franchises only when asked for.</summary>
    private bool Franchises => View == "franchises";
    private List<FranchiseProgress>? franchises;
    private string? ferror;
    private string ftab = "progress";
    private MediaSummary? pendingMovie;
    private bool askWhen;

    // A saved view (or a link) picks the tab and, for that visit, the order.
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    private static readonly string[] Tabs = ["watching", "waiting", "paused", "dropped", "all"];
    private UpNextSort? sortOverride;
    private (string?, string?)? applied;

    protected override async Task OnParametersSetAsync()
    {
        if (Mine && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
            return;
        }
        // Someone else's (or back to yours): start over.
        if (loadedFor != Other)
        {
            loadedFor = Other;
            items = null; franchises = null; selecting = false; selected.Clear();
            await Load();
        }
        // Only when the address changes, so a re-render doesn't undo tabs picked on the page.
        if (QParam is not null && QParam != find.Trim()) find = QParam;
        if ((TabParam, SortParam) != applied)
        {
            applied = (TabParam, SortParam);
            tab = Tabs.Contains(TabParam) ? TabParam! : "watching";
            sortOverride = Enum.TryParse<UpNextSort>(SortParam, true, out var s) ? s : null;
        }
        if (Franchises && franchises is null) await LoadFranchises();
    }

    private string ViewQuery => string.Join('&', new (string Key, string? Value)[]
        {
            ("tab", tab == "watching" ? null : tab),
            ("sort", Sort == UpNextSort.LastWatched ? null : Sort.ToString()),
            ("q", find.Trim() is { Length: > 0 } q ? q : null),
        }.Where(p => p.Value is not null).Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value!)}"));

    /// <summary>The tab goes in the address, so Back from a show returns to it.</summary>
    private void SetTab(string t)
    {
        tab = t;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", t == "watching" ? null : t), replace: true);
    }

    private async Task LoadFranchises()
    {
        ferror = null;
        try { franchises = await Api.FranchiseProgressAsync(Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { ferror = $"{Other}'s progress is private, or there's no such member."; }
        catch (Exception ex) { ferror = ex.Message; }
    }

    private async Task WatchMovie(WatchChoice c)
    {
        if (pendingMovie is not { } m) return;
        pendingMovie = null;
        try
        {
            var r = await Api.WatchAsync(Fmt.Watch(MediaType.Movie, m.TmdbId, c));
            var undo = Api.UndoFor(r, MediaType.Movie, m.TmdbId);
            Toasts.Show($"Watched {m.Title}{Fmt.When(c)}", undo: undo is null ? null : async () => { await undo(); await InvokeAsync(async () => { await LoadFranchises(); StateHasChanged(); }); });
            await LoadFranchises();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private UpNextSort Sort => sortOverride ?? Session.Me?.UpNextSort ?? UpNextSort.LastWatched;

    /// <summary>Saved to your account: Home's Up next uses the same order.</summary>
    private List<FilterChip>? SortChips => Sort == UpNextSort.LastWatched ? null
        : [new FilterChip("By " + UpNextSorts.Label(Sort).ToLowerInvariant(), () => SetSortTo(UpNextSort.LastWatched))];

    private async Task ClearFilters()
    {
        SetFind("");
        await SetSortTo(UpNextSort.LastWatched);
    }

    private Task SetSort(ChangeEventArgs e) => Enum.TryParse<UpNextSort>(e.Value?.ToString(), out var s) ? SetSortTo(s) : Task.CompletedTask;

    private async Task SetSortTo(UpNextSort s)
    {
        if (s == Sort) return;
        if (!Mine) { sortOverride = s; return; }   // someone else's: just this view, not your setting
        sortOverride = null;
        Session.Update(me => me with { UpNextSort = s });
        try { await Api.SetPreferencesAsync(new PreferencesRequest(UpNextSort: s)); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    [Inject] private Toasts Toasts { get; set; } = default!;
    private (ShowProgressDto Show, EpisodeRef Episode)? pending;
    private List<ShowProgressDto>? items;
    private string? error;
    private string tab = "watching";
    private int? menuFor;

    private static bool Ongoing(string? status) => status is "Returning Series" or "In Production" or "Planned" or "Pilot";

    /// <summary>Caught up: airing now and coming back (soonest first), returning with no date yet, then ended or canceled. Other tabs: one plain list.</summary>
    private IEnumerable<(string? Heading, string? Hint, List<ShowProgressDto> Shows)> Groups(List<ShowProgressDto> shown)
    {
        if (tab == "watching")
        {
            var now = DateTimeOffset.UtcNow;
            yield return (null, null, shown.Where(p => !UpNextSorts.Stalled(p, now)).ToList());
            var stalled = shown.Where(p => UpNextSorts.Stalled(p, now)).ToList();
            if (stalled.Count > 0)
                yield return ("Not watched in 6 months", "Kept out of Up next until you watch another episode. Tap Select to pause or drop the ones you're done with.", stalled);
            yield break;
        }
        if (tab != "waiting") { yield return (null, null, shown); yield break; }
        var airing = shown.Where(Airing).OrderBy(p => p.Returning!.AirDate).ToList();
        var dated = shown.Where(p => p.Returning is not null && !Airing(p)).OrderBy(p => p.Returning!.AirDate).ToList();
        var undated = shown.Where(p => p.Returning is null && (Ongoing(p.ShowStatus) || p.ShowStatus is null)).ToList();
        var over = shown.Where(p => p.Returning is null && !Ongoing(p.ShowStatus) && p.ShowStatus is not null).ToList();
        if (airing.Count > 0) yield return ("Airing now", "Mid-season: you've seen every episode out so far.", airing);
        if (dated.Count > 0) yield return ("Coming back", null, dated);
        if (undated.Count > 0) yield return ("Waiting for news", "Still running on TMDB, with no date for new episodes yet.", undated);
        if (over.Count > 0) yield return ("Ended or canceled", null, over);
    }

    /// <summary>Mid-season with episodes still coming regularly: the next one isn't a premiere and comes
    /// within three weeks of the last one (longer gaps are a mid-season break, which counts as coming back).</summary>
    private static bool Airing(ShowProgressDto p) =>
        p.Returning is { EpisodeNumber: > 1, AirDate: { } next } && p.LatestAired is { } last && next.DayNumber - last.DayNumber <= 21;

    /// <summary>"Season 3 premieres Mar 4, 2027 · in 4 months", "Returns Jan 8 with S02E07", "Ended".</summary>
    private static string WaitLine(ShowProgressDto p)
    {
        if (p.Returning is { AirDate: { } day } r)
        {
            var when = day.ToString(Fmt.DateLong) + (Fmt.Countdown(day) is { } left ? $" · {left}" : "");
            if (Airing(p)) return $"{Fmt.Ep(r.SeasonNumber, r.EpisodeNumber)} airs {when}";
            return r.EpisodeNumber == 1 ? $"Season {r.SeasonNumber} premieres {when}" : $"Returns {when} with {Fmt.Ep(r.SeasonNumber, r.EpisodeNumber)}";
        }
        return p.ShowStatus switch
        {
            "Ended" => "All caught up · ended",
            "Canceled" => "All caught up · canceled",
            "In Production" => "All caught up · new season in production",
            "Planned" => "All caught up · new season planned",
            "Returning Series" or "Pilot" => "All caught up · no date for new episodes yet",
            _ => "All caught up",
        };
    }

    private string Count(ShowTrackStatus st) => items?.Count(p => p.Status == st) is > 0 and var n ? $" {n}" : "";

    /// <summary>The "Find a show / franchise" box: a name containing what's typed.</summary>
    private string find = "";
    [SupplyParameterFromQuery(Name = "q")] public string? QParam { get; set; }
    /// <summary>What you typed goes in the address too, so Back from a show finds the same list.</summary>
    private void SetFind(string q)
    {
        find = q;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("q", q.Trim() is { Length: > 0 } t ? t : null), replace: true);
    }
    private bool Found(string name) => find.Trim() is not { Length: > 0 } f || name.Contains(f, StringComparison.OrdinalIgnoreCase);

    private bool InTab(ShowProgressDto p) => Found(p.Name) && tab switch
    {
        "watching" => p.NextEpisode is not null && p.Status == ShowTrackStatus.Watching,
        "waiting" => p.NextEpisode is null && p.Status != ShowTrackStatus.Dropped,
        "paused" => p.Status == ShowTrackStatus.Paused,
        "dropped" => p.Status == ShowTrackStatus.Dropped,
        _ => true,
    };

    private bool selecting, bulkBusy;
    private readonly HashSet<int> selected = [];

    /// <summary>The shows on the current tab (what "Select all" takes).</summary>
    private List<ShowProgressDto> ShownNow => items is null ? [] : Groups(UpNextSorts.Apply(items, Sort).Where(InTab).ToList()).SelectMany(g => g.Shows).ToList();

    /// <summary>Pause, drop or resume every selected show at once, with Undo back to each one's own status.</summary>
    private async Task SetMany(ShowTrackStatus st)
    {
        var shows = items!.Where(p => selected.Contains(p.ShowTmdbId)).ToList();
        bulkBusy = true;
        try
        {
            foreach (var p in shows) await Api.SetShowStatusAsync(p.ShowTmdbId, st);
            selected.Clear();
            var verb = st switch { ShowTrackStatus.Paused => "Paused", ShowTrackStatus.Dropped => "Dropped", _ => "Resumed" };
            Toasts.Show($"{verb} {shows.Count} show{(shows.Count == 1 ? "" : "s")}", undo: async () =>
            {
                foreach (var p in shows) await Api.SetShowStatusAsync(p.ShowTmdbId, p.Status);
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); await Load(); }
        finally { bulkBusy = false; }
    }

    private async Task SetStatus(ShowProgressDto p, ShowTrackStatus st)
    {
        menuFor = null;
        try
        {
            await Api.SetShowStatusAsync(p.ShowTmdbId, st);
            var i = items!.IndexOf(p);
            if (i >= 0) items[i] = p with { Status = st };
            Toasts.Show(st switch { ShowTrackStatus.Paused => $"Paused {p.Name}", ShowTrackStatus.Dropped => $"Dropped {p.Name}", _ => $"Resumed {p.Name}" });
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Load()
    {
        error = null;
        try { items = await Api.ProgressAsync(Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"{Other}'s progress is private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Watch(WatchChoice c)
    {
        if (pending is not var (p, n)) return;
        pending = null;
        try
        {
            var r = await Api.WatchAsync(Fmt.Watch(MediaType.Episode, p.ShowTmdbId, c, n.SeasonNumber, n.EpisodeNumber));
            var undo = Api.UndoFor(r, MediaType.Show, p.ShowTmdbId);
            Toasts.Show($"Watched {p.Name} {Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)}{Fmt.When(c)}", undo: undo is null ? null : async () => { await undo(); await InvokeAsync(async () => { await Load(); StateHasChanged(); }); });
            // Its row updates straight away; the rest reloads behind it.
            if (r?.Progress is { } fresh && items is not null)
            {
                items = items.Select(x => x.ShowTmdbId == fresh.ShowTmdbId ? fresh : x).ToList();
                StateHasChanged();
            }
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
