@page "/progress"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
<PageTitle>Progress · SeenIt</PageTitle>

<div class="page-head">
    <h1>Progress</h1>
    <div class="segmented" role="tablist" aria-label="What to show">
        <button role="tab" aria-selected="@(!Franchises)" class="@(Franchises ? "" : "on")" @onclick='() => Nav.NavigateTo("progress")'><Icon Name="tv" Size="16" /> TV shows</button>
        <button role="tab" aria-selected="@Franchises" class="@(Franchises ? "on" : "")" @onclick='() => Nav.NavigateTo("progress?view=franchises")'><Icon Name="film" Size="16" /> Movie franchises</button>
    </div>
</div>
@if (Franchises)
{
    <div class="chips">
        <button class="chip @(ftab == "progress" ? "on" : "")" @onclick='() => ftab = "progress"'>In progress</button>
        <button class="chip @(ftab == "done" ? "on" : "")" @onclick='() => ftab = "done"'>Completed</button>
        <button class="chip @(ftab == "all" ? "on" : "")" @onclick='() => ftab = "all"'>All</button>
    </div>
    <ErrorBox Message="@ferror" OnRetry="LoadFranchises" />
    @if (franchises is null && ferror is null) { <Spinner /> }
    else if (franchises is not null)
    {
        var fshown = franchises.Where(f => ftab switch { "progress" => f.Seen < f.Released, "done" => f.Seen >= f.Released, _ => true }).ToList();
        @if (fshown.Count == 0)
        {
            <Empty Title="@(ftab == "done" ? "No finished franchises yet." : "No franchises in progress.")">Watch a movie that's part of a series (Star Wars, Harry Potter, the MCU…) and it shows up here.</Empty>
        }
        <div class="progress-list">
            @foreach (var f in fshown)
            {
                var link = f.Next is { } nx ? $"movie/{nx.TmdbId}" : null;
                <div class="progress-item" @key="f.Id">
                    <a href="@link"><img src="@Img.Poster(f.PosterPath ?? f.Next?.PosterPath, "w154")" alt="" loading="lazy" /></a>
                    <div class="progress-body">
                        <span class="mini-title">@f.Name</span>
                        <div class="inline">
                            <ProgressBar Value="f.Seen" Max="f.Released" />
                            <span class="muted small nowrap">@f.Seen/@f.Released</span>
                        </div>
                        @if (f.Next is { } n) { <div class="small">Next: <a href="@($"movie/{n.TmdbId}")"><b>@n.Title</b>@(n.Year is { } y ? $" ({y})" : "")</a></div> }
                        else { <div class="small ok">Seen them all@(f.Upcoming > 0 ? $" · {f.Upcoming} more coming" : "")</div> }
                        @if (f.LastWatchedAt is { } lw) { <div class="muted small">Last watched <RelTime At="lw" /></div> }
                    </div>
                    <div class="progress-actions">
                        @if (f.Next is { } next)
                        {
                            <WhenButton Small="true" What="@next.Title" OnClick="() => { askWhen = true; pendingMovie = next; }" />
                            <button class="btn btn-sm btn-check" @onclick="() => { askWhen = false; pendingMovie = next; }" aria-label="@($"Mark {next.Title} watched")"><Icon Name="check" Size="16" /></button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    @if (pendingMovie is { } pm)
    {
        <WatchDialog Open="true" OpenChanged="o => { if (!o) pendingMovie = null; }" What="@pm.Title" OnPick="WatchMovie" AskWhen="askWhen" />
    }
}
else
{
<div class="page-head">
    <SavedViews Page="progress" Current="@ViewQuery" />
    <div class="segmented">
        <button class="@(tab == "watching" ? "on" : "")" @onclick='() => tab = "watching"'>Watching</button>
        <button class="@(tab == "waiting" ? "on" : "")" @onclick='() => tab = "waiting"'>Caught up</button>
        <button class="@(tab == "paused" ? "on" : "")" @onclick='() => tab = "paused"'>Paused@(Count(ShowTrackStatus.Paused))</button>
        <button class="@(tab == "dropped" ? "on" : "")" @onclick='() => tab = "dropped"'>Dropped@(Count(ShowTrackStatus.Dropped))</button>
        <button class="@(tab == "all" ? "on" : "")" @onclick='() => tab = "all"'>All</button>
    </div>
    <label class="sort-pick">
        <span class="muted small">Sort</span>
        <select value="@Sort" @onchange="SetSort" aria-label="Sort shows">
            @foreach (var s in Enum.GetValues<UpNextSort>()) { <option value="@s">@UpNextSorts.Label(s)</option> }
        </select>
    </label>
</div>
<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = UpNextSorts.Apply(items, Sort).Where(p => tab switch
    {
        "watching" => p.NextEpisode is not null && p.Status == ShowTrackStatus.Watching,
        "waiting" => p.NextEpisode is null && p.Status != ShowTrackStatus.Dropped,
        "paused" => p.Status == ShowTrackStatus.Paused,
        "dropped" => p.Status == ShowTrackStatus.Dropped,
        _ => true,
    }).ToList();
    @if (shown.Count == 0)
    {
        <Empty Title="@(tab == "watching" ? "Nothing in progress." : "Nothing here.")">
            @(tab switch
            {
                "paused" => "Pause a show from its page or the ⋯ menu here to keep it out of Up next for a while.",
                "dropped" => "Shows you give up on can be dropped so they stop showing up in Up next and the calendar.",
                _ => "Mark episodes of a show watched to start tracking your progress.",
            })
        </Empty>
    }
    else
    {
        @foreach (var (heading, hint, group) in Groups(shown))
        {
        @if (heading is not null) { <h2 class="progress-group">@heading <span class="muted small">@group.Count</span></h2> }
        @if (hint is not null) { <p class="muted small progress-hint">@hint</p> }
        <div class="progress-list">
            @foreach (var p in group)
            {
                <div class="progress-item" @key="p.ShowTmdbId">
                    <a href="@($"show/{p.ShowTmdbId}")"><img src="@Img.Poster(p.PosterPath, "w154")" alt="" loading="lazy" /></a>
                    <div class="progress-body">
                        <a href="@($"show/{p.ShowTmdbId}")" class="mini-title">@p.Name</a>
                        @if (p.Rewatch is { } rw) { <span class="pill rewatch-pill small"><Icon Name="repeat" Size="12" /> @Show.RewatchLabel(rw)</span> }
                        <div class="inline">
                            <ProgressBar Value="p.Watched" Max="p.Aired" />
                            <span class="muted small nowrap">@p.Watched/@p.Aired</span>
                        </div>
                        @if (p.NextEpisode is { } n)
                        {
                            <div class="small">Next: <a href="@Fmt.EpisodeHref(p.ShowTmdbId, n.SeasonNumber, n.EpisodeNumber)"><b>@Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)</b> <Spoiler>@n.Name</Spoiler></a></div>
                        }
                        else if (p.Completed || p.ShowStatus is not null) { <div class="small @(p.Returning is not null ? "ok" : p.ShowStatus is "Ended" or "Canceled" ? "muted" : "ok")">@WaitLine(p)</div> }
                        @if (p.LastWatchedAt is { } lw) { <div class="muted small">Last watched <RelTime At="lw" />@(p.Status != ShowTrackStatus.Watching ? $" · {p.Status}" : "")</div> }
                        @if (menuFor == p.ShowTmdbId)
                        {
                            <div class="chips progress-menu">
                                @if (p.Status != ShowTrackStatus.Watching) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Watching)">Resume</button> }
                                @if (p.Status != ShowTrackStatus.Paused) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Paused)"><Icon Name="pause" Size="12" /> Pause</button> }
                                @if (p.Status != ShowTrackStatus.Dropped) { <button class="chip" @onclick="() => SetStatus(p, ShowTrackStatus.Dropped)"><Icon Name="x" Size="12" /> Drop</button> }
                            </div>
                        }
                    </div>
                    <div class="progress-actions">
                        @if (p.NextEpisode is { } next && p.Status != ShowTrackStatus.Dropped)
                        {
                            <WhenButton Small="true" What="@($"{p.Name} {Fmt.Ep(next.SeasonNumber, next.EpisodeNumber)}")" OnClick="() => { askWhen = true; pending = (p, next); }" />
                            <button class="btn btn-sm btn-check" @onclick="() => { askWhen = false; pending = (p, next); }" aria-label="Mark next episode watched"><Icon Name="check" Size="16" /></button>
                        }
                        <button class="icon-btn" @onclick="() => menuFor = menuFor == p.ShowTmdbId ? null : p.ShowTmdbId" aria-label="More options for @p.Name" aria-expanded="@(menuFor == p.ShowTmdbId)"><Icon Name="more" Size="18" /></button>
                    </div>
                </div>
            }
        </div>
        }
    }
}
@if (pending is var (ps, pe))
{
    <WatchDialog Open="true" OpenChanged="o => { if (!o) pending = null; }" What="@($"{ps.Name} {Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber)}")"
                 ReleaseDate="pe.AirDate" OnPick="Watch"  AskWhen="askWhen" />
}
}
@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    /// <summary>TV shows are the default; franchises only when asked for.</summary>
    private bool Franchises => View == "franchises";
    private List<FranchiseProgress>? franchises;
    private string? ferror;
    private string ftab = "progress";
    private MediaSummary? pendingMovie;
    private bool askWhen;

    // A saved view (or a link) picks the tab and, for that visit, the order.
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    private static readonly string[] Tabs = ["watching", "waiting", "paused", "dropped", "all"];
    private UpNextSort? sortOverride;
    private (string?, string?)? applied;

    protected override async Task OnParametersSetAsync()
    {
        // Only when the address changes, so a re-render doesn't undo tabs picked on the page.
        if ((TabParam, SortParam) != applied)
        {
            applied = (TabParam, SortParam);
            tab = Tabs.Contains(TabParam) ? TabParam! : "watching";
            sortOverride = Enum.TryParse<UpNextSort>(SortParam, true, out var s) ? s : null;
        }
        if (Franchises && franchises is null) await LoadFranchises();
    }

    private string ViewQuery => string.Join('&', new (string Key, string? Value)[]
        {
            ("tab", tab == "watching" ? null : tab),
            ("sort", Sort == UpNextSort.LastWatched ? null : Sort.ToString()),
        }.Where(p => p.Value is not null).Select(p => $"{p.Key}={p.Value}"));

    private async Task LoadFranchises()
    {
        ferror = null;
        try { franchises = await Api.FranchiseProgressAsync(); }
        catch (Exception ex) { ferror = ex.Message; }
    }

    private async Task WatchMovie(WatchChoice c)
    {
        if (pendingMovie is not { } m) return;
        pendingMovie = null;
        try
        {
            await Api.WatchAsync(Fmt.Watch(MediaType.Movie, m.TmdbId, c));
            Toasts.Show($"Watched {m.Title}{Fmt.When(c)}");
            await LoadFranchises();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private UpNextSort Sort => sortOverride ?? Session.Me?.UpNextSort ?? UpNextSort.LastWatched;

    /// <summary>Saved to your account: Home's Up next uses the same order.</summary>
    private async Task SetSort(ChangeEventArgs e)
    {
        if (!Enum.TryParse<UpNextSort>(e.Value?.ToString(), out var s) || s == Sort) return;
        sortOverride = null;
        Session.Update(me => me with { UpNextSort = s });
        try { await Api.SetPreferencesAsync(new PreferencesRequest(UpNextSort: s)); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    [Inject] private Toasts Toasts { get; set; } = default!;
    private (ShowProgressDto Show, EpisodeRef Episode)? pending;
    private List<ShowProgressDto>? items;
    private string? error;
    private string tab = "watching";
    private int? menuFor;

    private static bool Ongoing(string? status) => status is "Returning Series" or "In Production" or "Planned" or "Pilot";

    /// <summary>Caught up: airing now and coming back (soonest first), returning with no date yet, then ended or canceled. Other tabs: one plain list.</summary>
    private IEnumerable<(string? Heading, string? Hint, List<ShowProgressDto> Shows)> Groups(List<ShowProgressDto> shown)
    {
        if (tab != "waiting") { yield return (null, null, shown); yield break; }
        var airing = shown.Where(Airing).OrderBy(p => p.Returning!.AirDate).ToList();
        var dated = shown.Where(p => p.Returning is not null && !Airing(p)).OrderBy(p => p.Returning!.AirDate).ToList();
        var undated = shown.Where(p => p.Returning is null && (Ongoing(p.ShowStatus) || p.ShowStatus is null)).ToList();
        var over = shown.Where(p => p.Returning is null && !Ongoing(p.ShowStatus) && p.ShowStatus is not null).ToList();
        if (airing.Count > 0) yield return ("Airing now", "Mid-season: you've seen every episode out so far.", airing);
        if (dated.Count > 0) yield return ("Coming back", null, dated);
        if (undated.Count > 0) yield return ("Waiting for news", "Still running on TMDB, with no date for new episodes yet.", undated);
        if (over.Count > 0) yield return ("Ended or canceled", null, over);
    }

    /// <summary>Mid-season with episodes still coming regularly: the next one isn't a premiere and comes
    /// within three weeks of the last one (longer gaps are a mid-season break, which counts as coming back).</summary>
    private static bool Airing(ShowProgressDto p) =>
        p.Returning is { EpisodeNumber: > 1, AirDate: { } next } && p.LatestAired is { } last && next.DayNumber - last.DayNumber <= 21;

    /// <summary>"Season 3 premieres Mar 4, 2027 · in 4 months", "Returns Jan 8 with S02E07", "Ended".</summary>
    private static string WaitLine(ShowProgressDto p)
    {
        if (p.Returning is { AirDate: { } day } r)
        {
            var when = day.ToString(Fmt.DateLong) + (Fmt.Countdown(day) is { } left ? $" · {left}" : "");
            if (Airing(p)) return $"{Fmt.Ep(r.SeasonNumber, r.EpisodeNumber)} airs {when}";
            return r.EpisodeNumber == 1 ? $"Season {r.SeasonNumber} premieres {when}" : $"Returns {when} with {Fmt.Ep(r.SeasonNumber, r.EpisodeNumber)}";
        }
        return p.ShowStatus switch
        {
            "Ended" => "All caught up · ended",
            "Canceled" => "All caught up · canceled",
            "In Production" => "All caught up · new season in production",
            "Planned" => "All caught up · new season planned",
            "Returning Series" or "Pilot" => "All caught up · no date for new episodes yet",
            _ => "All caught up",
        };
    }

    private string Count(ShowTrackStatus st) => items?.Count(p => p.Status == st) is > 0 and var n ? $" {n}" : "";

    private async Task SetStatus(ShowProgressDto p, ShowTrackStatus st)
    {
        menuFor = null;
        try
        {
            await Api.SetShowStatusAsync(p.ShowTmdbId, st);
            var i = items!.IndexOf(p);
            if (i >= 0) items[i] = p with { Status = st };
            Toasts.Show(st switch { ShowTrackStatus.Paused => $"Paused {p.Name}", ShowTrackStatus.Dropped => $"Dropped {p.Name}", _ => $"Resumed {p.Name}" });
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { items = await Api.ProgressAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Watch(WatchChoice c)
    {
        if (pending is not var (p, n)) return;
        pending = null;
        try
        {
            await Api.WatchAsync(Fmt.Watch(MediaType.Episode, p.ShowTmdbId, c, n.SeasonNumber, n.EpisodeNumber));
            Toasts.Show($"Watched {p.Name} {Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)}{Fmt.When(c)}");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
