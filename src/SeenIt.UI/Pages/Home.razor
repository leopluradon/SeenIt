@page "/"
@inject ApiClient Api
@inject NavigationManager Nav
@inject SessionState Session
@inject Toasts Toasts
<PageTitle>SeenIt</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1 class="visually-hidden">Home</h1>
        <ErrorBox Message="@error" OnRetry="LoadDashboard" />

        @* Sections in the order the user chose (Customize home); one spinner while the dashboard loads. *@
        @{ var waiting = false; }
        @foreach (var key in UiPrefs.HomeOrder(Session.Me?.HomeOrder).Where(Visible))
        {
            @switch (key)
            {
                case "now":
                    @if (now is not null)
                    {
                        <section class="row-section">
                            <NowWatchingCard Item="now" OnCancel="CancelCheckIn" />
                        </section>
                    }
                    break;
                case "onthisday":
                    @if (onThisDay is { Count: > 0 })
                    {
                        <section class="row-section">
                            <div class="section-head">
                                <h2>On this day</h2>
                                <div class="section-tools"><HideButton OnHide='() => Hide("onthisday")' /></div>
                            </div>
                            <div class="otd-list">
                                @foreach (var o in onThisDay)
                                {
                                    <a class="otd-item" href="@Fmt.Href(o.Type, o.TmdbId)" @key="(o.Type, o.TmdbId, o.YearsAgo)">
                                        @if (Img.Poster(o.PosterPath, "w154") is { } src) { <img src="@src" alt="" loading="lazy" /> }
                                        <span class="otd-text">
                                            <span class="otd-when">@(o.YearsAgo == 1 ? "A year ago" : $"{o.YearsAgo} years ago") · @o.Date.Year</span>
                                            <b>@o.Title</b>
                                            <span class="muted small">@o.Text</span>
                                        </span>
                                    </a>
                                }
                            </div>
                        </section>
                    }
                    break;
                case "review":
                    @if (reviewLinks.Count > 0)
                    {
                        <section class="review-banner">
                            <Icon Name="chart" Size="22" />
                            <div class="review-banner-links">
                                @foreach (var (href, text) in reviewLinks) { <a href="@href">@text <Icon Name="chevron-right" Size="16" /></a> }
                            </div>
                            <HideButton OnHide='() => Hide("review")' />
                        </section>
                    }
                    break;
                case "goals":
                    @if (goals is { Count: > 0 })
                    {
                        <section class="row-section">
                            <div class="section-head">
                                <h2>@DateTime.Today.Year goals</h2>
                                <div class="section-tools"><a href="goals" class="section-more">Goals <Icon Name="chevron-right" Size="16" /></a><HideButton OnHide='() => Hide("goals")' /></div>
                            </div>
                            <div class="home-goals">
                                @foreach (var g in goals) { <GoalCard Goal="g" @key="g.Id" /> }
                            </div>
                        </section>
                    }
                    break;
                case "upnext":
                    @if (dash is null && error is null) { if (!waiting) { waiting = true; <Spinner /> } }
                    else if (dash is not null)
                    {
                        <section class="row-section">
                            <div class="section-head">
                                <h2>Up next</h2>
                                <div class="section-tools"><a href="progress" class="section-more">All progress <Icon Name="chevron-right" Size="16" /></a><HideButton OnHide='() => Hide("upnext")' /></div>
                            </div>
                            @if (dash.UpNext.Count == 0)
                            {
                                <p class="muted">Start watching a show and your next episode shows up here. <a href="discover">Find something to watch</a>.</p>
                            }
                            else
                            {
                                <div class="card-scroller">
                                    @foreach (var p in dash.UpNext) { <UpNextCard Progress="p" OnWatched="LoadDashboard" @key="p.ShowTmdbId" /> }
                                </div>
                            }
                        </section>
                    }
                    break;
                case "upcoming":
                    @if (dash is null && error is null) { if (!waiting) { waiting = true; <Spinner /> } }
                    else if (dash is not null)
                    {
                        @if (dash.Upcoming.Count > 0)
                        {
                            <section class="row-section">
                                <div class="section-head">
                                    <h2>Coming up</h2>
                                    <div class="section-tools"><a href="calendar" class="section-more">Calendar <Icon Name="chevron-right" Size="16" /></a><HideButton OnHide='() => Hide("upcoming")' /></div>
                                </div>
                                <div class="mini-list">
                                    @foreach (var c in dash.Upcoming)
                                    {
                                        <a class="mini-item" href="@Fmt.CalHref(c)">
                                            <img src="@Img.Poster(c.PosterPath, "w92")" alt="" loading="lazy" />
                                            <div>
                                                <div class="mini-title">@c.Title</div>
                                                <div class="muted small">@if (c.Type == MediaType.Episode) { @Fmt.Ep(c.SeasonNumber, c.EpisodeNumber)<span class="dot-sep"></span><Spoiler Watched="c.Watched">@c.EpisodeTitle</Spoiler> } else { <span>@Fmt.CalKind(c)</span> }</div>
                                            </div>
                                            <span class="mini-date">@Fmt.Day(c.Date)@if (c.AirsAt is { } cat) { <span> · @cat.ToLocalTime().ToString(Fmt.TimeOnly)</span> }@if (Soon(c) is { } cd) { <span class="countdown"> · @cd</span> }</span>
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    }
                    break;
                case "friends":
                    @if (feed is { } f && (f.Activity.Count > 0 || f.WatchingNow.Count > 0))
                    {
                        <section class="row-section">
                            <div class="section-head">
                                <h2>Friends' activity</h2>
                                <div class="section-tools"><a href="friends?tab=feed" class="section-more">Friends <Icon Name="chevron-right" Size="16" /></a><HideButton OnHide='() => Hide("friends")' /></div>
                            </div>
                            @foreach (var w in f.WatchingNow) { <NowWatchingCard Item="w.Item" Who="@w.User.Name" @key="w.User.UserName" /> }
                            <div class="poster-scroller">
                                @foreach (var a in f.Activity)
                                {
                                    var h = a.Entry;
                                    <PosterCard Media="@(new MediaSummary(h.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, h.TmdbId, h.Title, null, h.PosterPath, null, null, null))"
                                                Href="@(h.Type == MediaType.Episode ? Fmt.EpisodeHref(h.TmdbId, h.SeasonNumber, h.EpisodeNumber) : null)" Detail="@h.EpisodeTitle"
                                                Sub="@($"{a.User.Name} · " + (h.Type == MediaType.Episode ? $"{Fmt.Ep(h.SeasonNumber, h.EpisodeNumber)} · " : "") + Fmt.Relative(h.WatchedAt))" SubTitle="@Fmt.Exact(h.WatchedAt)"
                                                ShowScore="false" @key="h.Id" />
                                }
                            </div>
                        </section>
                    }
                    break;
                case "recent":
                    @if (dash is null && error is null) { if (!waiting) { waiting = true; <Spinner /> } }
                    else if (dash is not null)
                    {
                        <section class="row-section">
                            <div class="section-head">
                                <h2>Recently watched</h2>
                                <div class="section-tools"><a href="history" class="section-more">Full history <Icon Name="chevron-right" Size="16" /></a><HideButton OnHide='() => Hide("recent")' /></div>
                            </div>
                            @if (dash.RecentHistory.Count == 0)
                            {
                                <p class="muted">Nothing yet. Mark something watched, connect Jellyfin, or import from Trakt or Letterboxd in <a href="settings">Settings</a>.</p>
                            }
                            else
                            {
                                <div class="poster-scroller">
                                    @foreach (var h in dash.RecentHistory)
                                    {
                                        <PosterCard Media="@(new MediaSummary(h.Type == MediaType.Movie ? MediaType.Movie : MediaType.Show, h.TmdbId, h.Title, null, h.PosterPath, null, null, null))"
                                                    Href="@(h.Type == MediaType.Episode ? Fmt.EpisodeHref(h.TmdbId, h.SeasonNumber, h.EpisodeNumber) : null)" Detail="@h.EpisodeTitle"
                                                    Sub="@(h.Type == MediaType.Episode ? $"{Fmt.Ep(h.SeasonNumber, h.EpisodeNumber)} · {Fmt.Relative(h.WatchedAt)}" : Fmt.Relative(h.WatchedAt))" SubTitle="@Fmt.Exact(h.WatchedAt)"
                                                    ShowScore="false" @key="h.Id" />
                                    }
                                </div>
                            }
                        </section>
                    }
                    break;
                case "foryou":
                    @if (forYou is not { Count: 0 })
                    {
                        <PosterRow Title="Picked for you" Items="forYou" MoreHref="for-you" OnHide='EventCallback.Factory.Create(this, () => Hide("foryou"))' OnDismiss="Dismiss" />
                    }
                    break;
                case "trending-movies":
                    <PosterRow Title="Trending movies" Items="trendingMovies" MoreHref="discover?type=Movie" OnHide='EventCallback.Factory.Create(this, () => Hide("trending-movies"))' OnDismiss="Dismiss" />
                    break;
                case "trending-shows":
                    <PosterRow Title="Trending shows" Items="trendingShows" MoreHref="discover?type=Show" OnHide='EventCallback.Factory.Create(this, () => Hide("trending-shows"))' OnDismiss="Dismiss" />
                    break;
                case "w-month" or "w-heatmap" or "w-genres" or "w-records" when Session.Me is not null:
                    @* The same widgets as on profiles. *@
                    <section class="pw home-pw" @key="key">
                        <div class="home-pw-hide"><HideButton OnHide="() => Hide(key)" /></div>
                        <ProfileWidgetView Widget="HomeWidgets[key]" P="Me" D="widgetData" />
                    </section>
                    break;
            }
        }
    </Authorized>
    <NotAuthorized>
        <section class="hero">
            <h1>Remember everything you watch.</h1>
            <p>Track movies and TV, see what's next in every show, follow what's airing, and scrobble automatically from Jellyfin.</p>
            <div class="inline">
                @if (features?.OpenRegistration != false) { <a href="register" class="btn btn-primary">Create a free account</a> }
                <a href="login" class="btn @(features?.OpenRegistration == false ? "btn-primary" : "")">Sign in</a>
            </div>
            @if (features?.OpenRegistration == false) { <p class="muted small">SeenIt is invite-only. Got an invite link? Open it to create your account.</p> }
        </section>
    </NotAuthorized>
</AuthorizeView>

@if (!signedIn)
{
    <PosterRow Title="Trending movies" Items="trendingMovies" MoreHref="discover?type=Movie" />
    <PosterRow Title="Trending shows" Items="trendingShows" MoreHref="discover?type=Show" />
}

@if (signedIn)
{
    <div class="center">
        <button class="btn btn-ghost btn-sm" @onclick="() => customizeOpen = true"><Icon Name="settings" Size="16" /> Customize home</button>
    </div>
    <Modal @bind-Open="customizeOpen" Title="Customize home">
        <div class="stack">
            <p class="muted small">Choose what shows on your home page and in what order. This is saved to your account.</p>
            <HomeSectionsEditor OnChanged="SectionsChanged" />
            <a href="settings#layout" class="small">Change the tabs at the bottom of the app</a>
        </div>
    </Modal>
}

@code {
    /// <summary>Once per app launch, not every time Home is opened.</summary>
    private static bool startChecked;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private DashboardDto? dash;
    private NowWatchingDto? now;
    private FeedDto? feed;
    private string? error;
    private IReadOnlyList<MediaSummary>? trendingMovies, trendingShows, forYou;

    /// <summary>"in 5 hours" close to an exact air time; "in 3 days" further out; nothing for today/tomorrow.</summary>
    private static string? Soon(CalendarEntry c) =>
        c.AirsAt is { } at && at - DateTimeOffset.Now < TimeSpan.FromHours(36) ? Fmt.Countdown(at)
        : c.Date > DateOnly.FromDateTime(DateTime.Today).AddDays(1) ? Fmt.Countdown(c.Date) : null;

    private async Task LoadForYou()
    {
        if (hidden.Contains("foryou")) return;
        try { forYou = (await Api.ForYouAsync()).Top.Take(Fmt.Prefs.Count("foryou")).Select(i => i.Media).ToList(); }
        catch { forYou = []; }
    }
    private bool signedIn, customizeOpen;
    private HashSet<string> hidden = [];
    private List<(string Href, string Text)> reviewLinks = [];
    private ServerFeatures? features;
    private List<OnThisDayItem>? onThisDay;
    private List<GoalDto>? goals;

    private bool Visible(string key) => !signedIn || !hidden.Contains(key);

    protected override async Task OnInitializedAsync()
    {
        signedIn = AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true;
        // Settings → Display → Start page: the first page you see when SeenIt opens (tapping Home later stays here).
        if (!startChecked)
        {
            startChecked = true;
            if (signedIn && SeenIt.UI.Layout.MainLayout.LaunchPath is "" && Fmt.Prefs.StartPage is { } start && start != "home" && UserPrefs.StartPages.Contains(start))
            {
                Nav.NavigateTo(start, replace: true);
                return;
            }
        }
        hidden = Session.Me?.HiddenHomeSections?.ToHashSet() ?? [];
        var trendingTask = LoadTrending();
        if (!signedIn) { try { features = await Api.FeaturesAsync(); } catch { } }
        if (signedIn)
        {
            var reviewTask = LoadReviewLinks();
            var extrasTask = LoadExtras();
            var forYouTask = LoadForYou();
            var widgetsTask = LoadWidgets();
            await LoadDashboard();
            await widgetsTask;
            await forYouTask;
            await reviewTask;
            await extrasTask;
        }
        await trendingTask;
    }

    private async Task LoadDashboard()
    {
        error = null;
        try { dash = await Api.DashboardAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    // Stats widgets on Home: which profile widget each section is, and the data for the ones shown.
    private static readonly Dictionary<string, ProfileWidget> HomeWidgets = new()
    {
        ["w-month"] = new("w-month", "tiles", 12, 1, Range: "month"),
        ["w-heatmap"] = new("w-heatmap", "heatmap", 12, 1),
        ["w-genres"] = new("w-genres", "genres", 12, 2, Range: "year"),
        ["w-records"] = new("w-records", "year-records", 12, 2, Range: "year"),
    };
    private ProfileWidgetData? widgetData;

    /// <summary>A stand-in profile (yours) for the widgets; they only use it for links.</summary>
    private ProfileDto Me => me ??= new ProfileDto(new UserCard(Session.Me!.UserName, null, false, false), DateTimeOffset.Now, true,
        ProfileVisibility.Public, true, 0, 0, null, null, [], [], []);
    private ProfileDto? me;

    private async Task LoadWidgets()
    {
        var keys = HomeWidgets.Keys.Where(k => !hidden.Contains(k)).ToList();
        if (keys.Count == 0 || Session.Me is not { } user) return;
        try
        {
            widgetData = await Api.ProfileWidgetsAsync(user.UserName,
                keys.Select(k => HomeWidgets[k]).Select(w => w.Range is { } r ? $"{w.Type}@{r}" : w.Type));
        }
        catch { widgetData = new ProfileWidgetData(); }
    }

    private async Task LoadExtras()
    {
        try { if (!hidden.Contains("now")) now = await Api.CheckInAsync(); } catch { }
        try { if (!hidden.Contains("friends")) feed = await Api.FeedAsync(Fmt.Prefs.Count("friends")); } catch { }
        try { if (!hidden.Contains("onthisday")) onThisDay = await Api.OnThisDayAsync(); } catch { }
        try { if (!hidden.Contains("goals")) goals = await Api.GoalsAsync(DateTime.Today.Year); } catch { }
    }

    private async Task CancelCheckIn()
    {
        try
        {
            await Api.CancelCheckInAsync();
            now = null;
            Toasts.Show("Check-in canceled");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    /// <summary>"Not interested" from a home row: drop it there (and from For you), with undo.</summary>
    private async Task Dismiss(MediaSummary m)
    {
        var (movies, shows, picks) = (trendingMovies, trendingShows, forYou);
        trendingMovies = trendingMovies?.Where(x => x != m).ToList();
        trendingShows = trendingShows?.Where(x => x != m).ToList();
        forYou = forYou?.Where(x => x != m).ToList();
        try
        {
            await Api.MarkNotInterestedAsync(m.Type, m.TmdbId);
            Toasts.Show($"You won't see {m.Title} suggested", undo: async () =>
            {
                await Api.UndoNotInterestedAsync(m.Type, m.TmdbId);
                await InvokeAsync(() => { (trendingMovies, trendingShows, forYou) = (movies, shows, picks); StateHasChanged(); });
            });
        }
        catch (Exception ex) { (trendingMovies, trendingShows, forYou) = (movies, shows, picks); Toasts.Error(ex); }
    }

    private async Task LoadTrending()
    {
        if (signedIn && hidden.Contains("trending-movies") && hidden.Contains("trending-shows")) return;
        try
        {
            var m = Api.BrowseAsync(MediaType.Movie, "trending/week");
            var s = Api.BrowseAsync(MediaType.Show, "trending/week");
            trendingMovies = (await m).Items.Take(Fmt.Prefs.Count("trending-movies")).ToList();
            trendingShows = (await s).Items.Take(Fmt.Prefs.Count("trending-shows")).ToList();
        }
        catch { trendingMovies ??= []; trendingShows ??= []; }
    }

    /// <summary>Early in a month, point at last month's review (and in January, last year's); otherwise this month so far.</summary>
    private async Task LoadReviewLinks()
    {
        if (hidden.Contains("review")) return;
        List<ReviewYear> periods;
        try { periods = await Api.ReviewPeriodsAsync(); } catch { return; }
        bool Has(int y, int m) => periods.Any(p => p.Year == y && p.Months.Any(x => x.Month == m && x.Plays > 0));

        var today = DateTime.Today;
        var last = today.AddMonths(-1);
        if (today.Day <= 10 && Has(last.Year, last.Month))
            reviewLinks.Add(($"review/{last.Year}/{last.Month}", $"Your {last:MMMM} in review is ready"));
        else if (Has(today.Year, today.Month))
            reviewLinks.Add(($"review/{today.Year}/{today.Month}", $"Your {today:MMMM} so far"));
        if (today.Month == 1 && periods.Any(p => p.Year == today.Year - 1))
            reviewLinks.Add(($"review/{today.Year - 1}", $"Your {today.Year - 1} in review"));
        else if (today.Month == 12 && periods.Any(p => p.Year == today.Year))
            reviewLinks.Add(($"review/{today.Year}", $"Your {today.Year} so far"));
    }

    private Task Hide(string key) => Toggle(key, false);

    /// <summary>After the editor changes things: load whatever has just been switched on.</summary>
    private async Task SectionsChanged()
    {
        var before = hidden;
        hidden = Session.Me?.HiddenHomeSections?.ToHashSet() ?? [];
        var shown = before.Except(hidden).ToList();
        if (shown.Any(k => k.StartsWith("trending")) && trendingMovies is null) await LoadTrending();
        if (shown.Contains("foryou") && forYou is null) await LoadForYou();
        if (shown.Contains("review") && reviewLinks.Count == 0) await LoadReviewLinks();
        if (shown.Any(k => k is "now" or "friends" or "onthisday" or "goals")) await LoadExtras();
        if (shown.Any(k => k.StartsWith("w-"))) await LoadWidgets();
    }

    private async Task Toggle(string key, bool visible)
    {
        if (visible) hidden.Remove(key); else hidden.Add(key);
        try
        {
            var saved = hidden.ToList();
            await Api.SetPreferencesAsync(new PreferencesRequest(HiddenHomeSections: saved));
            Session.Update(me => me with { HiddenHomeSections = saved });
            if (!visible) Toasts.Show("Section hidden. Bring it back with “Customize home”.");
            if (visible && key.StartsWith("trending") && trendingMovies is null) await LoadTrending();
            if (visible && key == "foryou" && forYou is null) await LoadForYou();
            if (visible && key == "review" && reviewLinks.Count == 0) await LoadReviewLinks();
            if (visible && key is "now" or "friends" or "goals") await LoadExtras();
            if (visible && key.StartsWith("w-")) await LoadWidgets();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
