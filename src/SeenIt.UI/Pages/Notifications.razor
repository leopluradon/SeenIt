@page "/notifications"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Alerts · SeenIt</PageTitle>

<div class="page-head">
    <h1>Alerts</h1>
    <a class="btn btn-sm btn-ghost" href="settings#alerts"><Icon Name="settings" Size="16" /> Alert settings</a>
</div>
<p class="muted small">New episodes of shows you watch or have on your watchlist, watchlist movies and new work from <a href="people">people you follow</a>, on the day they come out. Also titles friends <a href="recommendations">recommend to you</a>.</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (data is null && error is null) { <Spinner /> }
else if (data is { Items.Count: 0 })
{
    <Empty Title="Nothing yet.">
        <span>When something you follow comes out, it shows up here. You can also get an email, or subscribe to your calendar, in <a href="settings#alerts">Settings → Alerts</a>.</span>
    </Empty>
}
else if (data is not null)
{
    @foreach (var day in data.Items.GroupBy(n => n.Day))
    {
        <section class="cal-day">
            <h3 class="day-head">@Fmt.Day(day.Key) <span class="muted small">@day.Key.ToString(Fmt.DateShort)</span></h3>
            <div class="mini-list">
                @foreach (var n in day)
                {
                    <a class="mini-item @(n.Read ? "" : "unread")" href="@(n.Recommendation ? "recommendations" : n.Type == MediaType.Episode ? Fmt.EpisodeHref(n.TmdbId, n.SeasonNumber, n.EpisodeNumber) : Fmt.Href(n.Type, n.TmdbId))" @key="n.Id">
                        <img src="@Img.Poster(n.PosterPath, "w92")" alt="" loading="lazy" />
                        <div>
                            <div class="mini-title">@n.Title</div>
                            <div class="muted small">@if (n.Recommendation) { <span>@(n.Detail is { } note ? $"“{note}”" : "Recommended to you")</span> } else if (n.Type == MediaType.Episode) { <Spoiler>@n.Detail</Spoiler> } else { <span>@(n.Detail is { Length: > 0 } d && d != "Out today" ? d : "Movie release")</span> }</div>
                        </div>
                        @if (!n.Read) { <span class="pill pill-sm">New</span> }
                    </a>
                }
            </div>
        </section>
    }
}
@code {
    private NotificationsDto? data;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try
        {
            data = await Api.NotificationsAsync();
            if (data.Unread > 0) await Api.MarkNotificationsReadAsync();   // seen now; "New" stays until you leave
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
