@page "/notifications"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Alerts · SeenIt</PageTitle>

<div class="page-head">
    <h1>Alerts</h1>
    <a class="btn btn-sm btn-ghost" href="settings#alerts"><Icon Name="settings" Size="16" /> Alert settings</a>
</div>
<p class="muted small">New episodes of shows you watch or have on your watchlist, watchlist movies and new work from <a href="people">people you follow</a>, on the day they come out. Also titles friends <a href="recommendations">recommend to you</a>, and when someone watches one you recommended them.</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (data is null && error is null) { <Spinner /> }
else if (data is { Items.Count: 0 })
{
    <Empty Title="Nothing yet.">
        <span>When something you follow comes out, it shows up here. You can also get an email, or subscribe to your calendar, in <a href="settings#alerts">Settings → Alerts</a>.</span>
    </Empty>
}
else if (data is not null)
{
    <div class="filter-row">
        <div class="searchbar">
            <Icon Name="search" Size="16" />
            <input type="search" @bind="find" @bind:event="oninput" placeholder="Find a title" aria-label="Find an alert" />
        </div>
        <div class="chips">
            @foreach (var (key, label) in Kinds)
            {
                @if (key == "" || data.Items.Any(n => KindOf(n) == key))
                {
                    <button class="chip @(kind == key ? "on" : "")" @onclick="() => kind = key" @key="key">@label</button>
                }
            }
            <button class="chip @(newOnly ? "on" : "")" aria-pressed="@newOnly" @onclick="() => newOnly = !newOnly">New only</button>
        </div>
    </div>
    var items = data.Items.Where(Matches).ToList();
    @if (items.Count == 0) { <p class="muted">Nothing matches.</p> }
    @foreach (var day in items.GroupBy(n => n.Day))
    {
        <section class="cal-day">
            <h3 class="day-head">@Fmt.Day(day.Key) @if (Fmt.DayNote(day.Key) is { } dn) { <span class="muted small">@dn</span> }</h3>
            <div class="mini-list">
                @foreach (var n in day)
                {
                    <a class="mini-item @(n.Read ? "" : "unread")" href="@(n.Recommendation ? "recommendations" : n.Type == MediaType.Episode ? Fmt.EpisodeHref(n.TmdbId, n.SeasonNumber, n.EpisodeNumber) : Fmt.Href(n.Type, n.TmdbId))" @key="n.Id">
                        <img src="@Img.Poster(n.PosterPath, "w92")" alt="" loading="lazy" />
                        <div>
                            <div class="mini-title"><TitleLink Href="@(n.Type == MediaType.Episode && !n.Recommendation ? $"show/{n.TmdbId}" : null)">@n.Title</TitleLink></div>
                            <div class="muted small">@if (n.RecommendationWatched) { <span>@n.Detail</span> } else if (n.Recommendation) { <span>@(n.Detail is { } note ? $"“{note}”" : "Recommended to you")</span> } else if (n.Type == MediaType.Episode) { <Spoiler>@n.Detail</Spoiler> <EpisodeBadge Mark="n.Mark" /> } else { <span>@(n.Detail is { Length: > 0 } d && d != "Out today" ? d : "Movie release")</span> }</div>
                        </div>
                        @if (!n.Read) { <span class="pill pill-sm">New</span> }
                    </a>
                }
            </div>
        </section>
    }
}
@code {
    private NotificationsDto? data;
    private string? error;

    // Filters: a kind of alert, only new ones, a title.
    private static readonly (string Key, string Label)[] Kinds =
        [("", "All"), ("episode", "Episodes"), ("movie", "Movies"), ("show", "New series"), ("rec", "Recommended to me"), ("recwatched", "Friends watched my picks")];
    private string kind = "";
    private bool newOnly;
    private string find = "";
    private static string KindOf(NotificationDto n) => n.RecommendationWatched ? "recwatched" : n.Recommendation ? "rec"
        : n.Type switch { MediaType.Episode => "episode", MediaType.Movie => "movie", _ => "show" };
    private bool Matches(NotificationDto n) => (kind == "" || KindOf(n) == kind) && (!newOnly || !n.Read)
        && (find.Trim() is not { Length: > 0 } f || n.Title.Contains(f, StringComparison.OrdinalIgnoreCase) || n.Detail?.Contains(f, StringComparison.OrdinalIgnoreCase) == true);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try
        {
            data = await Api.NotificationsAsync();
            if (data.Unread > 0) await Api.MarkNotificationsReadAsync();   // seen now; "New" stays until you leave
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
