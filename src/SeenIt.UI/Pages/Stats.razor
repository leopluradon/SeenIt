@page "/stats"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Stats · SeenIt</PageTitle>

<div class="page-head">
    <h1>Stats</h1>
    <div class="inline">
        <a class="btn btn-sm btn-primary" href="@($"review/{DateTime.Today.Year}/{DateTime.Today.Month}")"><Icon Name="chart" Size="16" /> Month in review</a>
        <a class="btn btn-sm" href="@($"review/{DateTime.Today.Year}")">Year in review</a>
    </div>
</div>
<ErrorBox Message="@error" />
@if (s is null && error is null) { <Spinner /> }
else if (s is not null)
{
    <div class="stat-tiles">
        <div class="stat"><span class="stat-value">@Fmt.Duration(s.MinutesMovies + s.MinutesEpisodes)</span><span class="stat-label">Total time watched</span></div>
        <div class="stat"><span class="stat-value">@s.MoviesWatched.ToString("N0")</span><span class="stat-label">Movies (@s.MoviePlays.ToString("N0") plays · @Fmt.Duration(s.MinutesMovies))</span></div>
        <div class="stat"><span class="stat-value">@s.EpisodesWatched.ToString("N0")</span><span class="stat-label">Episodes (@s.EpisodePlays.ToString("N0") plays · @Fmt.Duration(s.MinutesEpisodes))</span></div>
        <div class="stat"><span class="stat-value">@s.ShowsWatched.ToString("N0")</span><span class="stat-label">Shows</span></div>
        <div class="stat"><span class="stat-value">@s.Ratings.ToString("N0")</span><span class="stat-label">Ratings @if (s.AverageRating is { } avg) { <span>· avg @avg.ToString("0.0")</span> }</span></div>
    </div>

    <div class="stat-panels">
        <section class="panel">
            <h2>Plays per month</h2>
            <BarChart Data="s.PlaysByMonth" Vertical="true" Label="Plays per month, last 12 months" />
            <TrackingNote />
        </section>
        <section class="panel">
            <h2>Top genres</h2>
            @if (s.Genres.Count == 0) { <p class="muted">Watch something first.</p> }
            <BarChart Data="s.Genres" Label="Plays by genre" />
        </section>
        <section class="panel">
            <h2>Ratings</h2>
            <BarChart Data="s.RatingDistribution" Vertical="true" Label="Number of ratings at each score" />
        </section>
        <section class="panel">
            <h2>Day of week</h2>
            <BarChart Data="s.PlaysByWeekday" Vertical="true" Label="Plays by day of week" />
            <TrackingNote />
        </section>
    </div>

    @if (periods is { Count: > 0 })
    {
        <section class="panel review-periods">
            <h2>Reviews</h2>
            <PeriodLinks Periods="periods" />
        </section>
    }
}
@code {
    private List<ReviewYear>? periods;
    private StatsDto? s;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { periods = await Api.ReviewPeriodsAsync(); } catch { periods = []; }
        try { s = await Api.StatsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }
}
