@page "/forgot-password"
@inject ApiClient Api
<PageTitle>Forgot password · SeenIt</PageTitle>

<div class="auth-card">
    <Logo />
    <h1>Forgot your password?</h1>
    @if (sent)
    {
        <p class="muted center">If <b>@email</b> belongs to a SeenIt account, a reset link is on its way. It works for 2 hours. Check your spam folder if it doesn't turn up.</p>
        <a class="btn btn-block" href="login">Back to sign in</a>
    }
    else
    {
        <p class="muted center">Enter your account's email and we'll send you a link to choose a new password.</p>
        <form @onsubmit="Submit">
            <div class="field">
                <label for="forgot-email">Email</label>
                <input id="forgot-email" type="email" @bind="email" autocomplete="email" required />
            </div>
            <ErrorBox Message="@error" />
            <button class="btn btn-primary btn-block" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(email))">@(busy ? "Sending…" : "Send reset link")</button>
        </form>
        <p class="muted center"><a href="login">Back to sign in</a></p>
    }
</div>

@code {
    private string? email, error;
    private bool busy, sent;

    private async Task Submit()
    {
        busy = true;
        error = null;
        try
        {
            await Api.ForgotPasswordAsync(new ForgotPasswordRequest(email!.Trim()));
            sent = true;
        }
        catch (Exception ex) { error = ex.Message; }
        busy = false;
    }
}
