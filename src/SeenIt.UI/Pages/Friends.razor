@page "/friends"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
@inject Toasts Toasts
<PageTitle>Friends · SeenIt</PageTitle>

<div class="page-head">
    <h1>Friends</h1>
    <div class="segmented">
        <button class="@(tab == "feed" ? "on" : "")" @onclick='() => Show("feed")'>Activity</button>
        <button class="@(tab == "following" ? "on" : "")" @onclick='() => Show("following")'>Following</button>
        <button class="@(tab == "followers" ? "on" : "")" @onclick='() => Show("followers")'><span>Followers</span>@if (requests is { Count: > 0 } pendingRequests) { <span class="tab-count" title="Follow requests">@pendingRequests.Count</span> }</button>
        <button class="@(tab == "find" ? "on" : "")" @onclick='() => Show("find")'>Find</button>
    </div>
</div>
@if (Session.Me is { } me)
{
    <p class="muted small">
        Your profile: <a href="@Fmt.UserHref(me.UserName)">@@@me.UserName</a> · visible to <b>@VisibilityText(me.Visibility)</b> (<a href="settings#privacy">change</a>)
    </p>
}
<ErrorBox Message="@error" OnRetry="Load" />

@switch (tab)
{
    case "feed":
        @if (watching is { Count: > 0 })
        {
            <div class="friends-watching">
                @foreach (var w in watching) { <NowWatchingCard Item="w.Item" Who="@w.User.Name" @key="w.User.UserName" /> }
            </div>
        }
        <History Friends="true" />
        break;

    case "following":
    case "followers":
        @if (tab == "followers" && requests is { Count: > 0 } waiting)
        {
            <section class="panel follow-requests">
                <h2>Follow requests <span class="muted small">@waiting.Count</span></h2>
                <p class="muted small">You approve followers first (<a href="settings?tab=account">change</a>). Until you approve, they see only what you share with everyone.</p>
                <div class="user-list">
                    @foreach (var r in waiting)
                    {
                        <div class="request-row" @key="r.UserName">
                            <UserRow User="r" ShowFollow="false" />
                            <span class="inline">
                                <button class="btn btn-sm btn-primary" disabled="@answering" @onclick="() => Answer(r, true)"><Icon Name="check" Size="14" /> Approve</button>
                                <button class="btn btn-sm btn-ghost" disabled="@answering" @onclick="() => Answer(r, false)">Decline</button>
                            </span>
                        </div>
                    }
                </div>
            </section>
        }
        @if (people is null && error is null) { <Spinner /> }
        else if (people is { Count: 0 })
        {
            <Empty Title="@(tab == "following" ? "You're not following anyone yet." : "No followers yet.")">
                @if (tab == "following") { <a href="" @onclick='() => Show("find")' @onclick:preventDefault>Find people to follow</a> }
                else { <span>Share your profile link so friends can find you.</span> }
            </Empty>
        }
        else if (people is not null)
        {
            <div class="user-list">
                @for (var i = 0; i < people.Count; i++)
                {
                    var idx = i;
                    <UserRow User="people[idx]" UserChanged="u => people[idx] = u" @key="people[idx].UserName" />
                }
            </div>
        }
        break;

    case "find":
        <form class="inline find-form" @onsubmit="Search" role="search">
            <input type="search" placeholder="Username or display name" @bind="query" @bind:event="oninput" aria-label="Find people" />
            <button class="btn" type="submit">Search</button>
        </form>
        @if (results is { Count: 0 }) { <p class="muted">No one found.</p> }
        else if (results is not null)
        {
            <div class="user-list">
                @for (var i = 0; i < results.Count; i++)
                {
                    var idx = i;
                    <UserRow User="results[idx]" UserChanged="u => results[idx] = u" @key="results[idx].UserName" />
                }
            </div>
        }
        break;
}

<ReloadOnMenu OnChange="Load" />
@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private string tab = "", loaded = "";
    private List<FriendWatching>? watching;
    private List<UserCard>? requests;
    private bool answering;
    private List<UserCard>? people, results;
    private string? error, query;

    // The tab lives in the URL (?tab=), so Activity's filters, back and forward all work.
    protected override async Task OnParametersSetAsync()
    {
        var next = Tab is "feed" or "followers" or "find" ? Tab : "following";
        if (next == loaded) return;   // only a filter changed: the history view reloads itself
        if (requests is null) { try { requests = await Api.FollowRequestsAsync(); } catch { requests = []; } }
        loaded = next;
        // Switch on the next tick: the Activity tab's history view reads the query string, and adding
        // it while Blazor is still telling query readers about this navigation throws.
        await Task.Yield();
        tab = next;
        await Load();
    }

    private async Task Answer(UserCard who, bool approve)
    {
        answering = true;
        try
        {
            await Api.AnswerFollowRequestAsync(who.UserName, approve);
            requests?.Remove(who);
            Toasts.Show(approve ? $"{who.Name} now follows you" : "Request declined");
            if (approve && tab == "followers") { people = null; people = await Api.FollowersAsync(); }
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { answering = false; }
    }

    private void Show(string t) => Nav.NavigateTo(t == "following" ? "friends" : $"friends?tab={t}");

    private async Task Load()
    {
        error = null;
        try
        {
            switch (tab)
            {
                case "feed": watching = (await Api.FeedAsync(1)).WatchingNow.ToList(); break;
                case "following": people = null; people = await Api.FollowingAsync(); break;
                case "followers": people = null; people = await Api.FollowersAsync(); break;
            }
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(query) || query.Trim().Length < 2) return;
        error = null;
        try { results = await Api.SearchUsersAsync(query); }
        catch (Exception ex) { error = ex.Message; }
    }

    public static string VisibilityText(ProfileVisibility v) => v switch
    {
        ProfileVisibility.Public => "everyone",
        ProfileVisibility.Friends => "friends (people you follow who follow you back)",
        _ => "only you",
    };
}
