@page "/history"
@attribute [Authorize]
@inject ApiClient Api
@inject Toasts Toasts
@inject NavigationManager Nav
<PageTitle>History · SeenIt</PageTitle>

<div class="page-head">
    <h1>History</h1>
    <div class="segmented">
        <button class="@(Type is null ? "on" : "")" @onclick='() => Go(null, 1)'>All</button>
        <button class="@(Type == MediaType.Movie ? "on" : "")" @onclick='() => Go(MediaType.Movie, 1)'>Movies</button>
        <button class="@(Type == MediaType.Episode ? "on" : "")" @onclick='() => Go(MediaType.Episode, 1)'>Episodes</button>
    </div>
</div>
<ErrorBox Message="@error" OnRetry="Load" />
@if (data is null && error is null) { <Spinner /> }
else if (data is not null)
{
    @if (data.Items.Count == 0) { <Empty Title="Nothing watched yet.">Mark something watched, connect Jellyfin, or import from Trakt or Letterboxd in <a href="settings">Settings</a>.</Empty> }
    else
    {
        <p class="muted small">@data.TotalResults.ToString("N0") plays</p>
        <div class="history">
            @foreach (var day in data.Items.GroupBy(h => WatchDates.IsUnknown(h.WatchedAt) ? (DateOnly?)null : DateOnly.FromDateTime(h.WatchedAt.ToLocalTime().Date)))
            {
                <h3 class="day-head">@(day.Key is { } dk ? Fmt.Day(dk) : "Date unknown")</h3>
                @foreach (var h in day)
                {
                    <div class="history-item" @key="h.Id">
                        <a href="@(h.Type == MediaType.Movie ? $"movie/{h.TmdbId}" : Fmt.EpisodeHref(h.TmdbId, h.SeasonNumber, h.EpisodeNumber))" class="history-link">
                            <img src="@Img.Poster(h.PosterPath, "w92")" alt="" loading="lazy" />
                            <div>
                                <div class="mini-title">@h.Title</div>
                                @if (h.Type == MediaType.Episode) { <div class="small">@Fmt.Ep(h.SeasonNumber, h.EpisodeNumber) · @h.EpisodeTitle</div> }
                                <div class="muted small">
                                    @(WatchDates.IsUnknown(h.WatchedAt) ? "" : h.WatchedAt.ToLocalTime().ToString("HH:mm"))
                                    @if (h.Source != WatchSource.Manual) { <span class="pill pill-sm">@SourceLabel(h.Source)</span> }
                                </div>
                            </div>
                        </a>
                        <button class="icon-btn" @onclick="() => Delete(h)" aria-label="Remove this play"><Icon Name="trash" Size="16" /></button>
                    </div>
                }
            }
        </div>
        <Pager Page="data.Page" TotalPages="data.TotalPages" OnPage="p => Go(Type, p)" />
    }
}

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? TypeParam { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageParam { get; set; }
    private MediaType? Type => Enum.TryParse<MediaType>(TypeParam, out var t) ? t : null;
    private PagedResult<HistoryEntry>? data;
    private string? error;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { data = await Api.HistoryAsync(Type, PageParam ?? 1); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Go(MediaType? type, int page) =>
        Nav.NavigateTo($"history?page={page}" + (type is null ? "" : $"&type={type}"));

    private async Task Delete(HistoryEntry h)
    {
        try
        {
            await Api.DeleteHistoryAsync(h.Id);
            Toasts.Show("Play removed");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private static string SourceLabel(WatchSource s) => s switch
    {
        WatchSource.Jellyfin => "Jellyfin",
        WatchSource.TraktImport => "Trakt",
        WatchSource.LetterboxdImport => "Letterboxd",
        _ => "",
    };
}
