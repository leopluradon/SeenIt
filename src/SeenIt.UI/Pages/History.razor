@page "/history"
@page "/u/{UserName}/history"
@* No [Authorize]: a public profile's history is open to anyone; your own needs signing in (below). *@
@inject ApiClient Api
@inject SessionState Session
@inject Toasts Toasts
@inject NavigationManager Nav
@inject IJSRuntime Js
@if (!Friends)
{
    <PageTitle>@(Other is { } on ? $"{on}'s history" : "History") · SeenIt</PageTitle>
    @if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }
}
<div class="@(Friends ? "history-toolbar" : "page-head")">
    @if (!Friends) { <h1>@(Other is { } o ? $"{o}'s history" : "History")</h1> }
    @if (Mine && Type != MediaType.Show) { <button class="btn btn-sm @(selecting ? "btn-on" : "")" @onclick="ToggleSelecting" aria-pressed="@selecting"><Icon Name="check" Size="16" /> @(selecting ? "Done" : "Select")</button> }
    <div class="segmented">
        <button class="@(Type is null ? "on" : "")" @onclick='() => Go(type: "")'>All</button>
        <button class="@(Type == MediaType.Movie ? "on" : "")" @onclick='() => Go(type: "Movie")'>Movies</button>
        <button class="@(Type == MediaType.Episode ? "on" : "")" @onclick='() => Go(type: "Episode")'>Episodes</button>
        <button class="@(Type == MediaType.Show ? "on" : "")" @onclick='() => Go(type: "Show")' title="Episodes grouped into one row per show per day">Shows</button>
    </div>
</div>

<form class="searchbar" @onsubmit="Submit" role="search">
    <Icon Name="search" Size="18" />
    <input type="search" @bind="search" @bind:event="oninput" @bind:after="Debounce" placeholder="@(Friends ? "Search friends' history" : Other is null ? "Search your history" : "Search their history")" aria-label="Search history" />
    <button type="button" class="btn btn-sm filter-toggle @(ActiveFilters > 0 ? "btn-on" : "")" @onclick="() => filtersOpen = !filtersOpen" aria-expanded="@filtersOpen">
        Filters@(ActiveFilters > 0 ? $" · {ActiveFilters}" : "")
    </button>
</form>

<div class="history-filters @(filtersOpen ? "open" : "")">
    @if (Friends && data?.People is { Count: > 1 } everyone)
    {
        <div class="field">
            <label for="hf-who">Who</label>
            <select id="hf-who" value="@(UserParam ?? "")" @onchange='e => Go(user: e.Value?.ToString() ?? "")'>
                <option value="">Everyone</option>
                @foreach (var u in everyone) { <option value="@u.UserName">@u.Name</option> }
            </select>
        </div>
    }
    <div class="field">
        <label for="hf-when">When</label>
        <select id="hf-when" value="@(Period ?? "")" @onchange='e => Go(period: e.Value?.ToString() ?? "")'>
            <option value="">Any time</option>
            <option value="today">Today</option>
            <option value="week">Last 7 days</option>
            <option value="month">This month</option>
            <option value="lastmonth">Last month</option>
            <option value="year">This year</option>
            <option value="lastyear">Last year</option>
            <option value="custom">Custom dates…</option>
        </select>
    </div>
    @if (Period == "custom")
    {
        <div class="field">
            <label for="hf-from">From</label>
            <input id="hf-from" type="date" value="@FromParam" @onchange='e => Go(from: e.Value?.ToString() ?? "")' />
        </div>
        <div class="field">
            <label for="hf-to">To</label>
            <input id="hf-to" type="date" value="@ToParam" @onchange='e => Go(to: e.Value?.ToString() ?? "")' />
        </div>
    }
    <div class="field">
        <label for="hf-genre">Genre</label>
        <select id="hf-genre" value="@(Genre ?? "")" @onchange='e => Go(genre: e.Value?.ToString() ?? "")'>
            <option value="">All genres</option>
            @foreach (var g in genres) { <option value="@g">@g</option> }
        </select>
    </div>
    <div class="field">
        <label for="hf-source">Tracked by</label>
        <select id="hf-source" value="@(SourceParam ?? "")" @onchange='e => Go(source: e.Value?.ToString() ?? "")'>
            <option value="">Anything</option>
            <option value="Manual">Marked in SeenIt</option>
            @foreach (var s in Enum.GetValues<WatchSource>().Where(s => s != WatchSource.Manual))
            {
                <option value="@s">@WatchSources.Name(s)@(WatchSources.IsScrobbler(s) ? "" : " import")</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="hf-sort">Order</label>
        <select id="hf-sort" value="@(Sort ?? "")" @onchange='e => Go(sort: e.Value?.ToString() ?? "")'>
            <option value="">Newest first</option>
            <option value="oldest">Oldest first</option>
        </select>
    </div>
    @if (ActiveFilters > 0 || !string.IsNullOrEmpty(Q))
    {
        <button class="btn btn-sm btn-ghost clear-filters" @onclick="Clear"><Icon Name="x" Size="14" /> Clear all</button>
    }
</div>

<ErrorBox Message="@error" OnRetry="Load" />
@if (data is null && error is null) { <Spinner /> }
else if (data is not null)
{
    @if (data.Items.Count == 0)
    {
        @if (ActiveFilters > 0 || !string.IsNullOrEmpty(Q) || Type is not null)
        {
            <Empty Title="No plays match these filters."><button class="btn btn-sm" @onclick="Clear">Clear filters</button></Empty>
        }
        else if (Friends)
        {
            <Empty Title="Nothing from friends yet.">Follow people to see what they're watching. Only people whose history is visible to you show up here.</Empty>
        }
        else
        {
            <Empty Title="Nothing watched yet.">Mark something watched, connect Jellyfin, or import from Trakt or Letterboxd in <a href="settings">Settings</a>.</Empty>
        }
    }
    else
    {
        <p class="muted small" title="@Fmt.HoursTip(data.TotalMinutes)">@(Type == MediaType.Show ? "Episodes grouped by show and day" : $"{data.TotalResults:N0} play{(data.TotalResults == 1 ? "" : "s")}")@(data.TotalMinutes > 0 ? $" · {Fmt.Duration(data.TotalMinutes)}" : "")@(Summary is { } sm ? $" · {sm}" : "")</p>
        <div class="history">
            @foreach (var day in data.Items.GroupBy(h => WatchDates.IsUnknown(h.WatchedAt) ? (DateOnly?)null : DateOnly.FromDateTime(h.WatchedAt.ToLocalTime().Date)))
            {
                var totals = data.Days?.FirstOrDefault(d => d.Date == day.Key)
                             ?? new HistoryDay(day.Key, day.Count(), day.Sum(e => (long)(e.Runtime ?? 0)));
                <div class="day-divider">
                    <h3>@(day.Key is { } dk ? Fmt.Day(dk) : "Date unknown")</h3>
                    <span class="day-line" aria-hidden="true"></span>
                    <span class="day-total" title="@Fmt.HoursTip(totals.Minutes)">@totals.Plays play@(totals.Plays == 1 ? "" : "s")@(totals.Minutes > 0 ? " · " + Fmt.Duration(totals.Minutes) : "")</span>
                </div>
                @foreach (var h in day)
                {
                    <div class="history-item @(selecting && selected.Contains(h.Id) ? "picked" : "")" @key="h.Id">
                        @if (selecting)
                        {
                            <label class="pick-box" aria-label="Select this play">
                                <input type="checkbox" checked="@selected.Contains(h.Id)" @onchange="() => TogglePick(h.Id)" />
                            </label>
                        }
                        <a href="@(h.Type switch { MediaType.Movie => $"movie/{h.TmdbId}", MediaType.Show => $"show/{h.TmdbId}", _ => Fmt.EpisodeHref(h.TmdbId, h.SeasonNumber, h.EpisodeNumber) })" class="history-link"
                           @onclick="() => { if (selecting) TogglePick(h.Id); }" @onclick:preventDefault="selecting">
                            <img src="@Img.Poster(h.PosterPath, "w92")" alt="" loading="lazy" />
                            <div>
                                @if (h.Who is { } who && People.GetValueOrDefault(who) is { } person)
                                {
                                    <div class="history-who small"><Avatar Name="@person.Name" Url="@person.Avatar" Class="avatar-xs" /> <b>@person.Name</b></div>
                                }
                                <div class="mini-title">@h.Title</div>
                                @if (h.Type == MediaType.Episode) { <div class="small">@Fmt.Ep(h.SeasonNumber, h.EpisodeNumber) · @h.EpisodeTitle</div> }
                                @if (h.Type == MediaType.Show) { <div class="small">@(h.Episodes == 1 ? "1 episode" : $"{h.Episodes} episodes") · @h.Range</div> }
                                <div class="muted small">
                                    @(WatchDates.IsUnknown(h.WatchedAt) ? "" : h.WatchedAt.ToLocalTime().ToString(Fmt.TimeOnly))@(h.Runtime is > 0 ? (WatchDates.IsUnknown(h.WatchedAt) ? "" : " · ") + Fmt.Runtime(h.Runtime) : "")
                                    @if (h.Source != WatchSource.Manual) { <span class="pill pill-sm">@SourceLabel(h.Source)</span> }
                                </div>
                            </div>
                        </a>
                        @if (!selecting && Mine && h.Type != MediaType.Show)
                        {
                            <button class="icon-btn" @onclick="() => editing = h" aria-label="Change this play's date"><Icon Name="edit" Size="16" /></button>
                            <button class="icon-btn" @onclick="() => Delete(h)" aria-label="Remove this play"><Icon Name="trash" Size="16" /></button>
                        }
                    </div>
                }
            }
        </div>
        <Pager Page="data.Page" TotalPages="data.TotalPages" OnPage="p => Go(page: p)" />
    }
}

@if (selecting)
{
    <div class="bulk-bar" role="toolbar" aria-label="Selected plays">
        <span><b>@selected.Count</b> selected</span>
        @if (data is { Items.Count: > 0 } d)
        {
            @if (d.Items.All(i => selected.Contains(i.Id))) { <button class="btn btn-sm btn-ghost" @onclick="() => { foreach (var i in d.Items) selected.Remove(i.Id); }">Unselect page</button> }
            else { <button class="btn btn-sm btn-ghost" @onclick="() => { foreach (var i in d.Items) selected.Add(i.Id); }">Select page</button> }
        }
        <span class="bulk-actions">
            <button class="btn btn-sm" disabled="@(selected.Count == 0 || bulkBusy)" @onclick="() => bulkDateOpen = true"><Icon Name="calendar" Size="16" /> Change date</button>
            <button class="btn btn-sm btn-danger" disabled="@(selected.Count == 0 || bulkBusy)" @onclick="DeleteSelected"><Icon Name="trash" Size="16" /> Delete</button>
        </span>
    </div>
}
@if (selecting) { <div class="bulk-spacer" aria-hidden="true"></div> }
<WatchDialog @bind-Open="bulkDateOpen" Bulk="true" Heading="@($"When did you watch these {selected.Count}?")" What="these" OnPick="RedateSelected" />

<EditPlayDialog Play="@(editing is { } eh ? new PlayDto(eh.Id, eh.WatchedAt, eh.Source) : null)" PlayChanged="p => { if (p is null) editing = null; }"
                What="@(editing is null ? "this" : editing.Type == MediaType.Episode ? $"{editing.Title} {Fmt.Ep(editing.SeasonNumber, editing.EpisodeNumber)}" : editing.Title)"
                OnSaved="async () => { editing = null; await Load(); StateHasChanged(); }" />

@code {
    private HistoryEntry? editing;
    /// <summary>Viewing someone else's history (read-only).</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => Friends ? null : UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    /// <summary>Embedded in the Friends page: everyone you follow, read-only, with a "who" filter.</summary>
    [Parameter] public bool Friends { get; set; }
    [SupplyParameterFromQuery(Name = "user")] public string? UserParam { get; set; }
    private bool Mine => !Friends && Other is null;
    private string BasePath => Friends ? "friends" : Other is { } n ? $"u/{Uri.EscapeDataString(n)}/history" : "history";
    private Dictionary<string, UserCard> People => data?.People?.ToDictionary(u => u.UserName, StringComparer.OrdinalIgnoreCase) ?? [];
    [SupplyParameterFromQuery(Name = "type")] public string? TypeParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? SourceParam { get; set; }
    [SupplyParameterFromQuery(Name = "genre")] public string? Genre { get; set; }
    [SupplyParameterFromQuery(Name = "period")] public string? Period { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToParam { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageParam { get; set; }

    private MediaType? Type => Enum.TryParse<MediaType>(TypeParam, out var t) ? t : null;
    private WatchSource? Source => Enum.TryParse<WatchSource>(SourceParam, out var s) ? s : null;
    private int ActiveFilters => new[] { Period, Genre, SourceParam, Sort, Friends ? UserParam : null }.Count(v => !string.IsNullOrEmpty(v));

    private HistoryPage? data;
    private List<string> genres = [];
    private string? error;
    private string search = "";
    private bool filtersOpen;
    private CancellationTokenSource? debounce;

    private string? genresFor = "\0";

    protected override void OnInitialized() => filtersOpen = ActiveFilters > 0;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!Friends && string.IsNullOrEmpty(UserName) && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            var back = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(back), replace: true);
            return;
        }
        search = Q ?? "";
        if (Type == MediaType.Show && selecting) { selecting = false; selected.Clear(); }   // rows there are groups, not plays
        var whose = Friends ? "\u0001friends" : Other;
        if (genresFor != whose)
        {
            // Same page for your history and a friend's: reset when switching between them.
            genresFor = whose;
            selecting = false;
            selected.Clear();
            data = null;
            try { genres = await Api.HistoryGenresAsync(Other, Friends); } catch { genres = []; /* the filter just stays empty */ }
        }
        await Load();
    }

    private async Task Load()
    {
        error = null;
        var (from, to) = Range();
        try { data = await Api.HistoryAsync(new HistoryQuery(Type, Q, Source, Genre, from, to, Sort == "oldest", PageParam ?? 1), Other, Friends, UserParam); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"{Other}'s history is private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
    }

    /// <summary>Turns the "when" choice into local-time bounds (from inclusive, to exclusive).</summary>
    private (DateTimeOffset? From, DateTimeOffset? To) Range()
    {
        var today = DateTime.Today;
        DateTimeOffset At(DateTime d) => new(d, TimeZoneInfo.Local.GetUtcOffset(d));
        var month = new DateTime(today.Year, today.Month, 1);
        return Period switch
        {
            "today" => (At(today), At(today.AddDays(1))),
            "week" => (At(today.AddDays(-6)), At(today.AddDays(1))),
            "month" => (At(month), At(month.AddMonths(1))),
            "lastmonth" => (At(month.AddMonths(-1)), At(month)),
            "year" => (At(new DateTime(today.Year, 1, 1)), At(new DateTime(today.Year + 1, 1, 1))),
            "lastyear" => (At(new DateTime(today.Year - 1, 1, 1)), At(new DateTime(today.Year, 1, 1))),
            "custom" => (DateTime.TryParse(FromParam, out var f) ? At(f.Date) : null,
                         DateTime.TryParse(ToParam, out var t) ? At(t.Date.AddDays(1)) : null),
            _ => (null, null),
        };
    }

    private string? Summary => Period switch
    {
        "custom" when FromParam is not null || ToParam is not null => $"{FromParam ?? "start"} to {ToParam ?? "now"}",
        _ => null,
    };

    /// <summary>Updates one or more filters in the URL; any change goes back to page 1.</summary>
    private void Go(string? type = null, string? q = null, string? source = null, string? genre = null,
        string? period = null, string? from = null, string? to = null, string? sort = null, int? page = null, string? user = null)
    {
        var p = new Dictionary<string, object?>
        {
            ["tab"] = Friends ? "feed" : null,
            ["user"] = Friends ? Blank(user ?? UserParam) : null,
            ["type"] = Blank(type ?? TypeParam),
            ["q"] = Blank(q ?? Q),
            ["source"] = Blank(source ?? SourceParam),
            ["genre"] = Blank(genre ?? Genre),
            ["period"] = Blank(period ?? Period),
            ["from"] = Blank(from ?? FromParam),
            ["to"] = Blank(to ?? ToParam),
            ["sort"] = Blank(sort ?? Sort),
            ["page"] = page is > 1 ? page : null,
        };
        if (p["period"] as string != "custom") { p["from"] = null; p["to"] = null; }
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri(BasePath).ToString(), p));
    }

    private static string? Blank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private void Submit() => Go(q: search.Trim() is { Length: > 0 } t ? t : "");

    private async Task Debounce()
    {
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        try { await Task.Delay(400, debounce.Token); }
        catch (TaskCanceledException) { return; }
        if ((search.Trim()) != (Q ?? "")) Submit();
    }

    private void Clear()
    {
        search = "";
        var path = Friends ? $"{BasePath}?tab=feed" : BasePath;
        Nav.NavigateTo(Type is null ? path : $"{path}{(Friends ? "&" : "?")}type={Type}");
    }

    private bool selecting, bulkBusy, bulkDateOpen;
    private readonly HashSet<Guid> selected = [];

    private void ToggleSelecting()
    {
        selecting = !selecting;
        selected.Clear();
    }

    private void TogglePick(Guid id)
    {
        if (!selected.Remove(id)) selected.Add(id);
    }

    private async Task DeleteSelected()
    {
        var ids = selected.ToList();
        if (ids.Count > 1 && !await Js.InvokeAsync<bool>("confirm", $"Delete {ids.Count} plays?")) return;
        bulkBusy = true;
        try
        {
            var removed = await Api.DeleteHistoryAsync(ids);
            selected.Clear();
            Toasts.Show($"Removed {removed.Removed} play{(removed.Removed == 1 ? "" : "s")}", undo: async () =>
            {
                await Api.RestorePlaysAsync(removed.Plays);
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { bulkBusy = false; }
    }

    private async Task RedateSelected(WatchChoice c)
    {
        bulkDateOpen = false;
        var ids = selected.ToList();
        bulkBusy = true;
        try
        {
            var before = await Api.EditPlaysAsync(new BulkEditPlaysRequest(ids, c.When, c.At)) ?? [];
            selected.Clear();
            var label = c.When switch
            {
                WatchTime.Unknown => "to an unknown date", WatchTime.ReleaseDate => "to their release dates",
                WatchTime.Now => "to now", _ => $"to {Fmt.PlayedAt(c.At!.Value)}",
            };
            Toasts.Show($"Moved {before.Count} play{(before.Count == 1 ? "" : "s")} {label}", undo: async () =>
            {
                await Api.SetPlayDatesAsync(before);
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { bulkBusy = false; }
    }

    private async Task Delete(HistoryEntry h)
    {
        try
        {
            var removed = await Api.DeleteHistoryAsync(h.Id);
            Toasts.Show("Play removed", undo: async () =>
            {
                await Api.RestorePlaysAsync(removed.Plays);
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private static string SourceLabel(WatchSource s) => WatchSources.Name(s);
}
