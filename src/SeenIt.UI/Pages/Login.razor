@page "/login"
@inject SessionState Session
@inject NavigationManager Nav
@inject ApiClient Api
@inject IJSRuntime JS
<PageTitle>Sign in · SeenIt</PageTitle>

<div class="auth-card">
    <Logo />
    <h1>Sign in</h1>
    <EditForm Model="model" OnValidSubmit="Submit" FormName="login">
        <div class="field">
            <label for="login-user">Username or email</label>
            <InputText id="login-user" @bind-Value="model.User" autocomplete="username" required />
        </div>
        <div class="field">
            <label for="login-pass">Password</label>
            <InputText id="login-pass" type="password" @bind-Value="model.Password" autocomplete="current-password" required />
        </div>
        @if (features?.Email == true) { <p class="small forgot-link"><a href="forgot-password">Forgot password?</a></p> }
        <ErrorBox Message="@error" />
        <button class="btn btn-primary btn-block" type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
    </EditForm>
    @if (features?.OpenRegistration != false)
    {
        <p class="muted center">New here? <a href="@("register" + (ReturnUrl is null ? "" : "?returnUrl=" + Uri.EscapeDataString(ReturnUrl)))">Create an account</a></p>
    }
    else
    {
        <p class="muted center small">SeenIt is invite-only. Ask a member for an invite link.</p>
    }
    <ServerPicker />
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private readonly Model model = new();
    private string? error;
    private bool busy;
    private ServerFeatures? features;

    protected override async Task OnInitializedAsync()
    {
        try { features = await Api.FeaturesAsync(); } catch { /* offline or older server: just hide the link */ }
    }

    private class Model { public string User { get; set; } = ""; public string Password { get; set; } = ""; }

    private async Task Submit()
    {
        busy = true;
        error = null;
        try
        {
            // An autofilled box may never have reported its value, so trust what's on screen.
            try
            {
                if (await JS.InvokeAsync<string?>("seenit.fieldValue", "login-user") is { Length: > 0 } u) model.User = u;
                if (await JS.InvokeAsync<string?>("seenit.fieldValue", "login-pass") is { Length: > 0 } pw) model.Password = pw;
            }
            catch (JSException) { /* older cached script: use the bound values */ }
            await Session.LoginAsync(model.User.Trim(), model.Password);
            Nav.NavigateTo(SafeReturn(ReturnUrl));
        }
        catch (Exception ex) { error = ex.Message; }
        busy = false;
    }

    /// <summary>Only allow local, relative return paths.</summary>
    public static string SafeReturn(string? url) =>
        string.IsNullOrEmpty(url) || url.Contains("://") || url.StartsWith("//") || url.StartsWith("login") || url.StartsWith("register") || url.StartsWith("invite") ? "" : url.TrimStart('/');
}
