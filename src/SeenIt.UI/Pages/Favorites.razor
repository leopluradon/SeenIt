@page "/favorites"
@attribute [Authorize]
@inject ApiClient Api
@inject Toasts Toasts
<PageTitle>Favorites · SeenIt</PageTitle>

<div class="page-head">
    <h1>Favorites</h1>
</div>
<p class="muted small">Your four favorite movies and four favorite shows, in your order. They're shown on your profile. Add one with the heart on any movie or show.</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    @foreach (var (type, label) in new[] { (MediaType.Movie, "Movies"), (MediaType.Show, "Shows") })
    {
        var group = items.Where(f => f.Media.Type == type).ToList();
        <section class="row-section">
            <div class="section-head"><h2>@label</h2><span class="muted small">@group.Count of @FavoriteLimits.PerType</span></div>
            <div class="poster-grid fav-grid">
                @for (var i = 0; i < group.Count; i++)
                {
                    var index = i;
                    var f = group[index];
                    <div @key="(f.Media.Type, f.Media.TmdbId)">
                        <PosterCard Media="f.Media" ShowScore="false" Badge="@($"#{index + 1}")" />
                        <div class="fav-tools">
                            <button class="icon-btn" disabled="@(busy || index == 0)" @onclick="() => Move(type, index, -1)" aria-label="Move @f.Media.Title earlier"><Icon Name="chevron-left" Size="16" /></button>
                            <button class="icon-btn" disabled="@(busy || index == group.Count - 1)" @onclick="() => Move(type, index, 1)" aria-label="Move @f.Media.Title later"><Icon Name="chevron-right" Size="16" /></button>
                            <button class="icon-btn" disabled="@busy" @onclick="() => Remove(f)" aria-label="Remove @f.Media.Title from favorites"><Icon Name="x" Size="16" /></button>
                        </div>
                    </div>
                }
                @for (var i = group.Count; i < FavoriteLimits.PerType; i++)
                {
                    <a class="fav-empty" href="@(type == MediaType.Movie ? "discover" : "discover?type=Show")" @key="(type, i)">
                        <Icon Name="heart" Size="20" />
                        <span class="small">Add a favorite @(type == MediaType.Movie ? "movie" : "show")</span>
                    </a>
                }
            </div>
        </section>
    }
}

<ReloadOnMenu OnChange="Load" />
@code {
    private List<FavoriteEntry>? items;
    private string? error;
    private bool busy;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { items = await Api.FavoritesAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Move(MediaType type, int index, int step)
    {
        busy = true;
        // Swap within the type; the saved order is movies then shows.
        var group = items!.Where(f => f.Media.Type == type).ToList();
        (group[index], group[index + step]) = (group[index + step], group[index]);
        items = type == MediaType.Movie
            ? [.. group, .. items.Where(f => f.Media.Type != type)]
            : [.. items.Where(f => f.Media.Type != type), .. group];
        try { await Api.ReorderFavoritesAsync(items.Select(f => new FavoriteRequest(f.Media.Type, f.Media.TmdbId)).ToList()); }
        catch (Exception ex) { Toasts.Error(ex); await Load(); }
        busy = false;
    }

    private async Task Remove(FavoriteEntry f)
    {
        busy = true;
        var order = items!.Select(x => new FavoriteRequest(x.Media.Type, x.Media.TmdbId)).ToList();
        try
        {
            await Api.RemoveFavoriteAsync(f.Media.Type, f.Media.TmdbId);
            Toasts.Show($"Removed {f.Media.Title}", undo: async () =>
            {
                await Api.AddFavoriteAsync(f.Media.Type, f.Media.TmdbId);
                await Api.ReorderFavoritesAsync(order);   // back in its old place
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            });
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }
}
