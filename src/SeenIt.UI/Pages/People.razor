@page "/people"
@page "/u/{UserName}/people"
@* No [Authorize]: someone's shared page follows their "People you follow" privacy; your own needs signing in. *@
@inject ApiClient Api
@inject Toasts Toasts
@inject SessionState Session
<PageTitle>@(Other is { } on ? $"People {on} follows" : "People you follow") · SeenIt</PageTitle>
@if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }

<div class="page-head">
    <h1>@(Other is { } o ? $"People {o} follows" : "People you follow")</h1>
</div>
@if (Mine)
{
    <p class="muted small">Actors, directors and writers you follow. Their new movies and shows go on your <a href="calendar">calendar</a> and, on release day, your <a href="notifications">alerts</a>.</p>
}

<ErrorBox Message="@error" OnRetry="Load" />
@if (people is null && error is null) { <Spinner Shape="list" /> }
else if (people is { Count: 0 })
{
    <Empty Title="@(Mine ? "You're not following anyone yet." : "Not following anyone yet.")">
        @if (Mine) { <span>Open someone's page from a movie's or show's cast and tap <b>Follow</b>.</span> }
    </Empty>
}
else if (people is not null)
{
    var soon = people.SelectMany(p => p.Upcoming.Where(u => u.Date is not null).Select(u => (Person: p, Work: u)))
        .GroupBy(x => (x.Work.Type, x.Work.TmdbId)).Select(g => (g.First().Work, Who: string.Join(", ", g.Select(x => x.Person.Name).Distinct())))
        .OrderBy(x => x.Work.Date).Take(30).ToList();
    @if (soon.Count > 0)
    {
        <section class="row-section">
            <div class="section-head"><h2>Coming up</h2></div>
            <div class="poster-scroller">
                @foreach (var (w, who) in soon)
                {
                    <PosterCard Media="@(new MediaSummary(w.Type, w.TmdbId, w.Title, w.Date?.Year, w.PosterPath, null, null, null))"
                                Badge="@w.Date!.Value.ToString(Fmt.DateLong)" ShowScore="false" Sub="@who" @key="(w.Type, w.TmdbId)" />
                }
            </div>
        </section>
    }

    <section class="row-section">
        <div class="section-head"><h2>Following <span class="muted small">@people.Count</span></h2></div>
        @{ var departments = people.Select(x => x.Department).OfType<string>().Distinct().Order().ToList(); }
        <FilterBar Query="@find" QueryChanged="q => Set(() => find = q)" Placeholder="Find someone" Label="Find someone you follow"
                   Active="@(department is null ? 0 : 1)" Chips="@(department is { } dep ? [new FilterChip(dep, () => Set(() => department = null))] : null)" OnClear='() => Set(() => { find = ""; department = null; })'
                   ViewPage="@(Mine ? "people" : null)" ViewQuery="@UrlState.Query(State)">
            @if (departments.Count > 1)
            {
                <div class="field">
                    <label for="ppl-dept">Known for</label>
                    <select id="ppl-dept" value="@(department ?? "")" @onchange="e => Set(() => department = e.Value as string is { Length: > 0 } d ? d : null)">
                        <option value="">Anything</option>
                        @foreach (var d in departments) { <option value="@d">@d</option> }
                    </select>
                </div>
            }
        </FilterBar>
        @{ var shownPeople = people.Where(x => (department is null || x.Department == department)
               && (find.Trim() is not { Length: > 0 } f || x.Name.Contains(f, StringComparison.OrdinalIgnoreCase))).ToList(); }
        @if (shownPeople.Count == 0) { <p class="muted">Nobody matches.</p> }
        <div class="people-list">
            @foreach (var p in shownPeople)
            {
                <div class="people-row" @key="p.Id">
                    <a href="@($"person/{p.Id}")" class="people-photo">
                        @if (Img.Profile(p.ProfilePath) is { } src) { <img src="@src" alt="" loading="lazy" /> }
                        else { <span class="cast-fallback">@p.Name[..1]</span> }
                    </a>
                    <div class="people-body">
                        <a href="@($"person/{p.Id}")" class="mini-title">@p.Name</a>
                        <div class="muted small">@(p.Department ?? "")@(p.Department is null ? "" : " · ")Following since @p.Since.ToLocalTime().ToString(Fmt.DateLong)</div>
                        <div class="small">
                            @if (p.Upcoming.FirstOrDefault(u => u.Date is not null) is { } next)
                            {
                                <span>Next: <a href="@Fmt.Href(next.Type, next.TmdbId)"><b>@next.Title</b></a> · @next.Date!.Value.ToString(Fmt.DateLong)</span>
                                @if (p.Upcoming.Count > 1) { <span class="muted"> · @(p.Upcoming.Count - 1) more coming</span> }
                            }
                            else if (p.Upcoming.Count > 0) { <span class="muted">@p.Upcoming.Count announced, no dates yet</span> }
                            else { <span class="muted">Nothing announced</span> }
                        </div>
                    </div>
                    @if (Mine) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Unfollow(p)">Unfollow</button> }
                </div>
            }
        </div>
    </section>
}

@code {
    private List<FollowedPerson>? people;
    private string? error;
    private bool busy;
    private string find = "";
    private string? department;

    // Filters live in the address (Back returns to them; they can be saved as a view).
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "q")] public string? QParam { get; set; }
    [SupplyParameterFromQuery(Name = "dept")] public string? DeptParam { get; set; }
    private (string, string?)[] State => [("q", find.Trim()), ("dept", department)];
    private void Set(Action change) { change(); UrlState.Write(Nav, State); }
    protected override void OnParametersSet() { find = UrlState.Find(QParam, find); department = DeptParam; }

    /// <summary>Someone else's (read-only), shared at u/{name}/people.</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    private bool Mine => Other is null;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? loadedFor = "\0";

    protected override async Task OnParametersSetAsync()
    {
        if (Mine && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
            return;
        }
        if (loadedFor != Other) { loadedFor = Other; people = null; await Load(); }
    }

    private async Task Load()
    {
        error = null;
        try { people = await Api.FollowedPeopleAsync(Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"Who {Other} follows is private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Unfollow(FollowedPerson p)
    {
        busy = true;
        try
        {
            await Api.FollowPersonAsync(p.Id, false);
            people?.Remove(p);
            Toasts.Offer($"Stopped following {p.Name}", "Undo", async () =>
            {
                await Api.FollowPersonAsync(p.Id, true);
                await Load();
                StateHasChanged();
            });
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }
}
