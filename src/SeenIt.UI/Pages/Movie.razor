@page "/movie/{Id:int}"
@inject ApiClient Api
@inject Toasts Toasts
@inject NavigationManager Nav
<PageTitle>@(m?.Title ?? "Movie") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (m is null && error is null) { <Spinner /> }
else if (m is not null)
{
    <MediaHero Title="@m.Title" Year="m.ReleaseDate?.Year" Tagline="@m.Tagline" Poster="@m.PosterPath" Backdrop="@m.BackdropPath" Score="m.VoteAverage" Votes="m.VoteCount" ScoresFor="(MediaType.Movie, Id)">
        <Facts>
            @if (m.ReleaseDate is { } d) { <span>@d.ToString("MMM d, yyyy")</span> }
            @if (m.Runtime is > 0) { <span>@Fmt.Runtime(m.Runtime)</span> }
            @if (m.Genres.Count > 0) { <span>@string.Join(", ", m.Genres)</span> }
            @if (m.Status is not null and not "Released") { <span class="pill">@m.Status</span> }
            @if (m.ReleaseDate is { } rel && rel > DateOnly.FromDateTime(DateTime.Today) && Fmt.Countdown(rel) is { } cdm) { <span class="countdown">Out @cdm</span> }
        </Facts>
        <Actions>
            @if (m.User is { } u)
            {
                <button class="btn @(u.Plays > 0 ? "btn-watched" : "btn-primary")" disabled="@busy" @onclick="() => watchOpen = true">
                    <Icon Name="check" Size="18" /> @(u.Plays switch { 0 => "Mark watched", 1 => "Watched", var n => $"Watched {n}×" })
                </button>
                <button class="btn @(u.InWatchlist ? "btn-on" : "")" disabled="@busy" @onclick="ToggleWatchlist">
                    <Icon Name="bookmark" Size="18" /> @(u.InWatchlist ? "On watchlist" : "Watchlist")
                </button>
                <button class="btn @(u.IsFavorite ? "btn-on fav-on" : "")" disabled="@busy" @onclick="ToggleFavorite" aria-pressed="@u.IsFavorite">
                    <Icon Name="heart" Size="18" Class="@(u.IsFavorite ? "filled" : null)" /> Favorite
                </button>
                <button class="btn" @onclick="() => listOpen = true"><Icon Name="list" Size="18" /> Lists</button>
                @if (m.ReleaseDate is null || m.ReleaseDate <= DateOnly.FromDateTime(DateTime.Today))
                {
                    <CheckInButton Request="@(new CheckInRequest(MediaType.Movie, Id))" />
                }
            }
            else
            {
                <a class="btn btn-primary" href="@($"login?returnUrl=movie/{Id}")">Sign in to track</a>
            }
        </Actions>
    </MediaHero>

    <div class="detail-body">
        <div class="detail-main">
            @if (m.User is { } u)
            {
                <div class="panel rate-panel">
                    <span>Your rating</span>
                    <RatingPicker Value="u.Rating" ValueChanged="Rate" />
                </div>
                @if (u.History is { Count: > 0 } plays)
                {
                    <div class="panel">
                        <div class="panel-head">
                            <h2>Your plays <span class="muted small">@plays.Count@if (m.Runtime is > 0) { <span> · <Dur Minutes="(long)m.Runtime.Value * plays.Count" /></span> }</span></h2>
                            @if (plays.Count > 1) { <button class="btn btn-sm btn-ghost" @onclick="UnwatchAll"><Icon Name="trash" Size="14" /> Remove all</button> }
                        </div>
                        <div class="plays">
                            @foreach (var p in plays)
                            {
                                <div class="play" @key="p.Id">
                                    <Icon Name="check" Size="16" Class="ok" />
                                    <span>@Fmt.PlayedAt(p.WatchedAt)</span>
                                    @if (p.WatchedAt > DateTimeOffset.Now) { <span class="pill pill-sm">Upcoming</span> }
                                    @if (p.Source != WatchSource.Manual) { <span class="pill pill-sm">@Fmt.Source(p.Source)</span> }
                                    <button class="icon-btn" disabled="@busy" @onclick="() => editing = p" aria-label="Change this play's date"><Icon Name="edit" Size="16" /></button>
                                    <button class="icon-btn" disabled="@busy" @onclick="() => RemovePlay(p)" aria-label="Remove this play"><Icon Name="trash" Size="16" /></button>
                                </div>
                            }
                        </div>
                    </div>
                }
                <FriendsSeen Type="MediaType.Movie" TmdbId="Id" />
            }
            @if (m.Overview is not null) { <p class="overview">@m.Overview</p> }
            <WhereToWatch Type="MediaType.Movie" TmdbId="Id" />
            @if (m.Crew.Count > 0)
            {
                <dl class="crew">
                    @foreach (var g in m.Crew.GroupBy(c => c.Job))
                    {
                        <div><dt>@g.Key</dt><dd>@{ var first = true; foreach (var c in g.DistinctBy(c => c.Id)) { if (!first) { <span>, </span> } first = false; <a href="@($"person/{c.Id}")">@c.Name</a> } }</dd></div>
                    }
                </dl>
            }
            <div class="links">
                @if (m.ImdbId is not null) { <a href="@($"https://www.imdb.com/title/{m.ImdbId}")" target="_blank" rel="noopener">IMDb</a> }
                <a href="@($"https://www.themoviedb.org/movie/{m.TmdbId}")" target="_blank" rel="noopener">TMDB</a>
                @if (m.User is { } mine && (mine.Plays > 0 || mine.Rating is not null || mine.InWatchlist || mine.ListIds.Count > 0))
                {
                    <button class="link-btn" @onclick="() => fixOpen = true">Wrong title?</button>
                }
            </div>
        </div>
    </div>

    @if (m.Collection is { } col)
    {
        var signedIn = m.User is not null;
        var missing = col.Parts.Where(x => x.Released && !x.Watched).ToList();
        <section class="row-section collection">
            <div class="section-head">
                <h2>@col.Name</h2>
                @if (signedIn) { <span class="muted small">You've seen @col.Seen of @col.Released</span> }
                else { <span class="muted small">@col.Parts.Count movies</span> }
            </div>
            @if (signedIn)
            {
                <ProgressBar Value="col.Seen" Max="col.Released" />
                @if (missing.Count is > 0 and <= 3 && col.Seen > 0)
                {
                    <p class="muted small collection-missing">Still to see:
                        @for (var i = 0; i < missing.Count; i++)
                        {
                            var x = missing[i];
                            <a href="@Fmt.Href(MediaType.Movie, x.Media.TmdbId)" @key="x.Media.TmdbId">@x.Media.Title</a>@(i < missing.Count - 1 ? ", " : "")
                        }
                    </p>
                }
                else if (missing.Count == 0 && col.Released > 0) { <p class="small ok collection-missing">You've seen every one.</p> }
            }
            <div class="poster-scroller">
                @foreach (var part in col.Parts)
                {
                    <div class="collection-part @(signedIn && part.Released && !part.Watched ? "unseen" : "") @(part.Media.TmdbId == Id ? "current" : "")" @key="part.Media.TmdbId">
                        <PosterCard Media="part.Media" ShowScore="false"
                                    Badge="@(!part.Released ? "Coming" : signedIn && part.Watched ? "✓ Seen" : null)"
                                    Sub="@(part.ReleaseDate is { } rd ? (part.Released ? rd.Year.ToString() : $"{Fmt.Day(rd)} · {Fmt.Countdown(rd)}") : "TBA")" />
                    </div>
                }
            </div>
        </section>
    }
    <CastRow Cast="m.Cast" />
    <Trailers Videos="m.Videos" />
    <PosterRow Title="You might also like" Items="m.Recommendations" EmptyText="No recommendations yet." />

    @if (m.User is { } user)
    {
        <WatchDialog @bind-Open="watchOpen" What="@m.Title" ReleaseDate="m.ReleaseDate" OnPick="Watch" />
        <EditPlayDialog @bind-Play="editing" What="@m.Title" ReleaseDate="m.ReleaseDate" OnSaved="Reload" />
        <AddToListDialog @bind-Open="listOpen" Type="MediaType.Movie" TmdbId="m.TmdbId" Selected="user.ListIds.ToList()" />
        <FixMatchDialog @bind-Open="fixOpen" Type="MediaType.Movie" TmdbId="m.TmdbId" Title="@m.Title" />
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private MovieDetail? m;
    private string? error;
    private bool busy, watchOpen, listOpen, fixOpen;
    private PlayDto? editing;

    private async Task Reload() { m = await Api.MovieAsync(Id); StateHasChanged(); }

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        if (m?.TmdbId != Id) m = null;
        try { m = await Api.MovieAsync(Id); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Act(Func<Task> action, string? done = null)
    {
        busy = true;
        try
        {
            await action();
            if (done is not null) Toasts.Show(done, undo: TakeUndo());
            m = await Api.MovieAsync(Id);
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }

    private Task Watch(WatchChoice c) =>
        Act(() => Api.WatchAsync(Fmt.Watch(MediaType.Movie, Id, c)), $"Watched {m!.Title}{Fmt.When(c)}");

    private Task RemovePlay(PlayDto p) => Act(async () =>
    {
        var removed = await Api.DeleteHistoryAsync(p.Id);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Play removed");

    private Task UnwatchAll() => Act(async () =>
    {
        var removed = await Api.UnwatchAsync(MediaType.Movie, Id);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Removed from history");

    private Task ToggleFavorite() => m!.User!.IsFavorite
        ? Act(async () =>
        {
            await Api.RemoveFavoriteAsync(MediaType.Movie, Id);
            undo = () => Api.AddFavoriteAsync(MediaType.Movie, Id);
        }, "Removed from favorites")
        : Act(() => Api.AddFavoriteAsync(MediaType.Movie, Id), "Added to favorites");

    private Task ToggleWatchlist() => m!.User!.InWatchlist
        ? Act(async () =>
        {
            await Api.RemoveFromWatchlistAsync(MediaType.Movie, Id);
            undo = () => Api.AddToWatchlistAsync(MediaType.Movie, Id);
        }, "Removed from watchlist")
        : Act(() => Api.AddToWatchlistAsync(MediaType.Movie, Id), "Added to watchlist");

    private Task Rate(double? value) => value is { } v
        ? Act(() => Api.RateAsync(new RatingRequest(MediaType.Movie, Id, v)), $"Rated {Fmt.Rating(v)}")
        : Act(async () =>
        {
            var old = m!.User!.Rating;
            await Api.UnrateAsync(MediaType.Movie, Id);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Movie, Id, o));
        }, "Rating removed");

    // Set by an action that can be undone; the toast it shows gets an Undo button.
    private Func<Task>? undo;
    private Func<Task>? TakeUndo()
    {
        if (undo is not { } u) return null;
        undo = null;
        return async () => { await u(); await InvokeAsync(async () => { await Load(); StateHasChanged(); }); };
    }

}
