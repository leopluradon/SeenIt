@page "/watchlist"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
<PageTitle>Watchlist · SeenIt</PageTitle>

<div class="page-head">
    <h1>Watchlist</h1>
    <a class="btn btn-sm" href="pick"><Icon Name="shuffle" Size="16" /> Pick for me</a>
    <div class="segmented">
        <button class="@(filter is null ? "on" : "")" @onclick="() => filter = null">All</button>
        <button class="@(filter == MediaType.Movie ? "on" : "")" @onclick="() => filter = MediaType.Movie">Movies</button>
        <button class="@(filter == MediaType.Show ? "on" : "")" @onclick="() => filter = MediaType.Show">Shows</button>
    </div>
</div>
<SavedViews Page="watchlist" Current="@ViewQuery" />
<div class="chips">
    <button class="chip @(sort == "added" ? "on" : "")" @onclick='() => SetSort("added")'>Recently added</button>
    <button class="chip @(sort == "release" ? "on" : "")" @onclick='() => SetSort("release")'>Release date</button>
    <button class="chip @(sort == "title" ? "on" : "")" @onclick='() => SetSort("title")'>Title</button>
    <LayoutToggle Page="watchlist" Value="layout" ValueChanged="v => layout = v" />
</div>
@if (items is { Count: > 8 })
{
    <div class="searchbar">
        <Icon Name="search" Size="18" />
        <input type="search" @bind="find" @bind:event="oninput" placeholder="Filter your watchlist" aria-label="Filter your watchlist" />
        <a class="btn btn-sm btn-ghost" href="lists">Search all lists</a>
    </div>
}
<ErrorBox Message="@error" OnRetry="Load" />
@if (items is null && error is null) { <Spinner /> }
else if (items is not null)
{
    var shown = Sorted().ToList();
    @if (shown.Count == 0 && !string.IsNullOrWhiteSpace(find)) { <Empty Title="@($"Nothing called “{find.Trim()}” here.")" /> }
    else if (shown.Count == 0) { <Empty Title="Your watchlist is empty.">Add movies and shows you want to watch from their pages.</Empty> }
    else
    {
        @if (layout == ListLayout.Rows)
        {
            <ol class="list-rows">
                @foreach (var w in shown)
                {
                    var upcoming = w.ReleaseDate is { } rd && rd > DateOnly.FromDateTime(DateTime.Today);
                    <li class="list-row" @key="(w.Media.Type, w.Media.TmdbId)" data-ctx="@Menu.Title(w.Media)">
                        <a href="@Fmt.Href(w.Media.Type, w.Media.TmdbId)" class="list-row-link">
                            <img src="@Img.Poster(w.Media.PosterPath, "w92")" alt="" loading="lazy" />
                            <span class="list-row-main">
                                <b>@w.Media.Title</b>
                                <span class="muted small">@(w.Media.Year?.ToString() ?? "")<span class="dot-sep">@(w.Media.Type == MediaType.Movie ? "Movie" : "TV")</span>@if (upcoming) { <span class="dot-sep">@(w.ReleaseDate!.Value.ToString(Fmt.DateShort))</span> }<span class="dot-sep">added @Fmt.Relative(w.AddedAt)</span></span>
                            </span>
                        </a>
                    </li>
                }
            </ol>
        }
        else
        {
            <div class="poster-grid">
                @foreach (var w in shown)
                {
                    var upcoming = w.ReleaseDate is { } rd && rd > DateOnly.FromDateTime(DateTime.Today);
                    <PosterCard Media="w.Media" Badge="@(upcoming ? Fmt.Countdown(w.ReleaseDate!.Value) is { } wcd ? $"{(w.ReleaseDate!.Value).ToString(Fmt.DateShort)} · {wcd}" : null : null)" @key="(w.Media.Type, w.Media.TmdbId)" />
                }
            </div>
        }
    }
}
<ReloadOnMenu OnChange="Load" />
@code {
    private List<WatchlistEntry>? items;
    private string? error;
    private MediaType? filter;
    private string sort = "added";
    private string find = "";
    private ListLayout layout = Fmt.Prefs.LayoutFor("watchlist");

    // A saved view (or a link) sets these; otherwise the page opens with the last sort you picked.
    [SupplyParameterFromQuery(Name = "type")] public string? TypeParam { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QParam { get; set; }
    private static readonly string[] Sorts = ["added", "release", "title"];

    private (string?, string?, string?)? applied;

    protected override void OnParametersSet()
    {
        // Only when the address changes, so a re-render doesn't undo what's been picked on the page.
        if ((TypeParam, SortParam, QParam) == applied) return;
        applied = (TypeParam, SortParam, QParam);
        filter = TypeParam switch { "movie" => MediaType.Movie, "show" => MediaType.Show, _ => null };
        sort = Sorts.Contains(SortParam) ? SortParam! : Fmt.Prefs.SortFor("watchlist") is { } s && Sorts.Contains(s) ? s : "added";
        find = QParam ?? "";
    }

    protected override Task OnInitializedAsync() => Load();

    private Task SetSort(string s)
    {
        sort = s;
        return PagePrefs.SetSortAsync(Session, Api, "watchlist", s);
    }

    private string ViewQuery => string.Join('&', new (string Key, string? Value)[]
        {
            ("type", filter switch { MediaType.Movie => "movie", MediaType.Show => "show", _ => null }),
            ("sort", sort == "added" ? null : sort),
            ("q", find.Trim()),
        }.Where(p => !string.IsNullOrWhiteSpace(p.Value)).Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value!)}"));

    private async Task Load()
    {
        error = null;
        try { items = await Api.WatchlistAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private IEnumerable<WatchlistEntry> Sorted()
    {
        var q = items!.Where(i => (filter is null || i.Media.Type == filter) && TextMatch.Contains(i.Media.Title, find));
        return sort switch
        {
            "release" => q.OrderBy(i => i.ReleaseDate ?? DateOnly.MaxValue),
            "title" => q.OrderBy(i => i.Media.Title, StringComparer.OrdinalIgnoreCase),
            _ => q.OrderByDescending(i => i.AddedAt),
        };
    }
}
