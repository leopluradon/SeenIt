@page "/search"
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject SessionState Session
<PageTitle>Search · SeenIt</PageTitle>

<h1>Search</h1>
<form class="searchbar" @onsubmit="Submit" role="search">
    <Icon Name="search" Size="18" />
    <input type="search" @ref="box" @bind="input" @bind:event="oninput" placeholder="@(Session.Me is null ? "Movies, shows and people" : "Movies, shows, people and members")" aria-label="Search" enterkeyhint="search" />
    @if (input.Length > 0) { <button type="button" class="search-clear" @onclick="Clear" aria-label="Clear search"><Icon Name="x" Size="16" /></button> }
    <button class="btn btn-primary" type="submit">Search</button>
</form>
<div class="chips">
    <button class="chip @(Type is null ? "on" : "")" @onclick='() => Go(Q, null)'>All</button>
    <button class="chip @(Type == "movie" ? "on" : "")" @onclick='() => Go(Q, "movie")'>Movies</button>
    <button class="chip @(Type == "show" ? "on" : "")" @onclick='() => Go(Q, "show")'>Shows</button>
    <button class="chip @(Type == "people" ? "on" : "")" @onclick='() => Go(Q, "people")'>People</button>
    @if (Session.Me is not null) { <button class="chip @(Type == "members" ? "on" : "")" @onclick='() => Go(Q, "members")'>Members</button> }
    <button class="chip chip-toggle @(Exact ? "on" : "")" aria-pressed="@Exact" @onclick="() => Go(Q, Type, !Exact)" title="Only results named exactly what you typed">
        @if (Exact) { <Icon Name="check" Size="14" /> } Exact match
    </button>
</div>
<p class="muted small search-hint">Also takes an IMDb or TMDB id or link, like tt0133093 or themoviedb.org/tv/1400.</p>

<ErrorBox Message="@error" />
@if (string.IsNullOrWhiteSpace(Q) && recent.Count > 0)
{
    <section class="recent-searches">
        <div class="section-head">
            <h2>Recent searches</h2>
            <button class="btn btn-sm btn-ghost" @onclick="ClearRecent">Clear</button>
        </div>
        <ul>
            @foreach (var r in recent)
            {
                <li @key="r">
                    <a href="@($"search?q={Uri.EscapeDataString(r)}")"><Icon Name="clock" Size="16" /> <span>@r</span></a>
                    <button class="icon-btn" @onclick="() => RemoveRecent(r)" aria-label="@($"Remove {r}")"><Icon Name="x" Size="14" /></button>
                </li>
            }
        </ul>
    </section>
}
@if (loading) { <Spinner /> }
else if (!string.IsNullOrWhiteSpace(Q))
{
    var all = Type is null;
    var titleItems = titles?.Items.Where(m => !Exact || TextMatch.Same(m.Title, Q)).ToList() ?? [];
    var peopleItems = people?.Items.Where(p => !Exact || TextMatch.Same(p.Name, Q)).ToList() ?? [];
    var memberItems = members?.Where(u => !Exact || TextMatch.Same(u.UserName, Q) || TextMatch.Same(u.Name, Q)).ToList() ?? [];
    var nothing = titleItems.Count == 0 && peopleItems.Count == 0 && memberItems.Count == 0 && lookup is not { Titles.Count: > 0 } && lookup is not { People.Count: > 0 };
    @if (nothing && error is null) { <Empty Title="@(Exact ? $"Nothing called exactly “{Q}”" : $"No results for “{Q}”")" /> }

    @if (lookup is { } lk && (lk.Titles.Count > 0 || lk.People.Count > 0))
    {
        <section class="row-section">
            <div class="section-head"><h2>@lk.Label</h2></div>
            <div class="poster-grid">
                @foreach (var m in lk.Titles) { <PosterCard Media="m" @key="(m.Type, m.TmdbId)" /> }
                @foreach (var p in lk.People)
                {
                    <a class="cast" href="@($"person/{p.Id}")" @key="p.Id">
                        @if (Img.Profile(p.ProfilePath) is { } src) { <img src="@src" alt="" loading="lazy" /> }
                        else { <div class="cast-fallback">@p.Name[..1]</div> }
                        <div class="cast-name">@p.Name</div>
                    </a>
                }
            </div>
        </section>
    }
    else if (lookup is { } none && none.Titles.Count == 0 && none.People.Count == 0 && !none.Label.StartsWith("TMDB id"))
    {
        <Empty Title="@($"Nothing on TMDB for {none.Label}")" />
    }

    @if (memberItems.Count > 0)
    {
        <section class="row-section">
            @if (all)
            {
                <div class="section-head">
                    <h2>Members</h2>
                    @if (memberItems.Count > MembersShown) { <button class="btn btn-sm btn-ghost" @onclick='() => Go(Q, "members")'>All @memberItems.Count</button> }
                </div>
            }
            <div class="stack search-members">
                @foreach (var u in all ? memberItems.Take(MembersShown) : memberItems)
                {
                    <UserRow User="u" UserChanged="Changed" @key="u.UserName" />
                }
            </div>
        </section>
    }

    @if (people is not null && peopleItems.Count > 0)
    {
        <section class="row-section">
            @if (all)
            {
                <div class="section-head">
                    <h2>People</h2>
                    @if (people.TotalResults > people.Items.Count || peopleItems.Count > PeopleShown) { <button class="btn btn-sm btn-ghost" @onclick='() => Go(Q, "people")'>More people</button> }
                </div>
            }
            <div class="@(all ? "cast-scroller" : "people-grid")">
                @foreach (var p in all ? peopleItems.Take(PeopleShown) : peopleItems)
                {
                    <a class="cast" href="@($"person/{p.Id}")" @key="p.Id">
                        @if (Img.Profile(p.ProfilePath) is { } src) { <img src="@src" alt="" loading="lazy" /> }
                        else { <div class="cast-fallback">@p.Name[..1]</div> }
                        <div class="cast-name">@p.Name</div>
                        <div class="cast-role muted small">@PersonSub(p)</div>
                    </a>
                }
            </div>
            @if (!all && people.Page < people.TotalPages)
            {
                <button class="btn btn-block" disabled="@more" @onclick="MorePeople">@(more ? "Loading…" : "Show more")</button>
            }
        </section>
    }

    @if (titleItems.Count > 0)
    {
        <section class="row-section">
            @if (all && (peopleItems.Count > 0 || memberItems.Count > 0 || lookup is { Titles.Count: > 0 })) { <div class="section-head"><h2>Movies & shows</h2></div> }
            <div class="poster-grid">
                @foreach (var m in titleItems) { <PosterCard Media="m" @key="(m.Type, m.TmdbId)" /> }
            </div>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "exact")] public string? ExactParam { get; set; }
    private bool Exact => ExactParam == "1";
    private LookupResult? lookup;
    private const int PeopleShown = 12, MembersShown = 4;
    private string input = "";
    private ElementReference box;
    private PagedResult<MediaSummary>? titles;
    private PagedResult<PersonHit>? people;
    private List<UserCard>? members;
    private bool loading, more;
    private string? error;
    private List<string> recent = [];

    // "autofocus" only works on a full page load, not when Blazor swaps pages, so focus it here.
    // Skipped when coming back to results, so the keyboard doesn't cover them.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !string.IsNullOrEmpty(Q)) return;
        try { await Js.InvokeVoidAsync("seenit.focusInput", box); }
        catch (JSException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        input = Q ?? "";
        titles = null;
        people = null;
        members = null;
        lookup = null;
        error = null;
        if (string.IsNullOrWhiteSpace(Q)) { recent = await RecentSearches.GetAsync(Js); return; }
        loading = true;
        var q = Q.Trim();
        await RecentSearches.AddAsync(Js, q);
        // An IMDb/TMDB id or link: open it straight away when it's one thing, or list what it matches.
        try { lookup = await Api.LookupAsync(q); } catch { lookup = null; }
        if (lookup?.Go is { } go) { Nav.NavigateTo(go, replace: true); return; }
        if (lookup is not null && !lookup.Label.StartsWith("TMDB id")) { loading = false; return; }   // a link isn't a title to search for
        var signedIn = Session.Me is not null;
        // Each kind loads on its own, so one failing (or being slow) doesn't hide the others.
        var titleTask = Type is null or "movie" or "show" ? Api.SearchAsync(q, Type) : null;
        var peopleTask = Type is null or "people" ? Api.SearchPeopleAsync(q) : null;
        var memberTask = signedIn && Type is null or "members" && q.Length >= 2 ? Api.SearchUsersAsync(q) : null;
        try { if (titleTask is not null) titles = await titleTask; }
        catch (Exception ex) { error = ex.Message; }
        try { if (peopleTask is not null) people = await peopleTask; }
        catch (Exception ex) { error ??= ex.Message; }
        try { if (memberTask is not null) members = await memberTask; }
        catch (Exception ex) { if (Type == "members") error ??= ex.Message; }
        loading = false;
    }

    private static string PersonSub(PersonHit p) =>
        string.Join(" · ", new[] { Dept(p.Department), p.KnownFor.FirstOrDefault() }.Where(x => !string.IsNullOrEmpty(x)));

    private static string? Dept(string? d) => d switch
    {
        "Acting" => "Actor",
        "Directing" => "Director",
        "Writing" => "Writer",
        "Production" => "Producer",
        null or "" => null,
        _ => d,
    };

    private async Task MorePeople()
    {
        if (people is null || string.IsNullOrWhiteSpace(Q)) return;
        more = true;
        try
        {
            var next = await Api.SearchPeopleAsync(Q.Trim(), people.Page + 1);
            people = next with { Items = [.. people.Items, .. next.Items.Where(n => people.Items.All(p => p.Id != n.Id))] };
        }
        catch (Exception ex) { error = ex.Message; }
        more = false;
    }

    private void Changed(UserCard u)
    {
        if (members is null) return;
        var i = members.FindIndex(m => m.UserName == u.UserName);
        if (i >= 0) members[i] = u;
    }

    private async Task Clear()
    {
        input = "";   // results stay until a new search, like other search boxes
        try { await Js.InvokeVoidAsync("seenit.focusInput", box); } catch (JSException) { }
    }

    private async Task RemoveRecent(string q) => recent = await RecentSearches.RemoveAsync(Js, q);

    private async Task ClearRecent()
    {
        await RecentSearches.ClearAsync(Js);
        recent = [];
    }

    private void Submit() => Go(input, Type, Exact);

    private void Go(string? q, string? type) => Go(q, type, Exact);

    private void Go(string? q, string? type, bool exact)
    {
        if (string.IsNullOrWhiteSpace(q)) return;
        Nav.NavigateTo($"search?q={Uri.EscapeDataString(q.Trim())}" + (type is null ? "" : $"&type={type}") + (exact ? "&exact=1" : ""));
    }
}
