@page "/search"
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js
<PageTitle>Search · SeenIt</PageTitle>

<h1>Search</h1>
<form class="searchbar" @onsubmit="Submit" role="search">
    <Icon Name="search" Size="18" />
    <input type="search" @ref="box" @bind="input" placeholder="Movies and TV shows" aria-label="Search" enterkeyhint="search" />
    <button class="btn btn-primary" type="submit">Search</button>
</form>
<div class="chips">
    <button class="chip @(Type is null ? "on" : "")" @onclick='() => Go(Q, null)'>All</button>
    <button class="chip @(Type == "movie" ? "on" : "")" @onclick='() => Go(Q, "movie")'>Movies</button>
    <button class="chip @(Type == "show" ? "on" : "")" @onclick='() => Go(Q, "show")'>Shows</button>
</div>

<ErrorBox Message="@error" />
@if (loading) { <Spinner /> }
else if (result is not null)
{
    @if (result.Items.Count == 0) { <Empty Title="@($"No results for “{Q}”")" /> }
    else
    {
        <div class="poster-grid">
            @foreach (var m in result.Items) { <PosterCard Media="m" @key="(m.Type, m.TmdbId)" /> }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    private string input = "";
    private ElementReference box;
    private PagedResult<MediaSummary>? result;
    private bool loading;
    private string? error;

    // "autofocus" only works on a full page load, not when Blazor swaps pages, so focus it here.
    // Skipped when coming back to results, so the keyboard doesn't cover them.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !string.IsNullOrEmpty(Q)) return;
        try { await Js.InvokeVoidAsync("seenit.focusInput", box); }
        catch (JSException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        input = Q ?? "";
        result = null;
        error = null;
        if (string.IsNullOrWhiteSpace(Q)) return;
        loading = true;
        try { result = await Api.SearchAsync(Q, Type); }
        catch (Exception ex) { error = ex.Message; }
        loading = false;
    }

    private void Submit() => Go(input, Type);

    private void Go(string? q, string? type)
    {
        if (string.IsNullOrWhiteSpace(q)) return;
        Nav.NavigateTo($"search?q={Uri.EscapeDataString(q.Trim())}" + (type is null ? "" : $"&type={type}"));
    }
}
