@page "/recommendations"
@attribute [Authorize]
@inject ApiClient Api
@inject Toasts Toasts
@inject NavigationManager Nav
<PageTitle>Recommendations · SeenIt</PageTitle>

<div class="page-head">
    <h1>Recommendations</h1>
    <div class="segmented">
        <button class="@(Sent ? "" : "on")" @onclick='() => Nav.NavigateTo("recommendations")'>To you@(NewCount is > 0 and var n ? $" {n}" : "")</button>
        <button class="@(Sent ? "on" : "")" @onclick='() => Nav.NavigateTo("recommendations?tab=sent")'>Sent</button>
    </div>
    <button class="btn btn-sm @(selecting ? "btn-on" : "")" @onclick="() => { selecting = !selecting; selected.Clear(); }" aria-pressed="@selecting"><Icon Name="check" Size="16" /> @(selecting ? "Done" : "Select")</button>
</div>
<p class="muted small">
    @if (Sent) { <span>What you've recommended, and whether they've watched it. Recommend something from any movie or show page.</span> }
    else { <span>Movies and shows friends sent you. Recommend something yourself from any movie or show page.</span> }
</p>

<ErrorBox Message="@error" OnRetry="Load" />
@if (data is null && error is null) { <Spinner /> }
else if (data is not null)
{
    var all = Sent ? data.Sent : data.Received.Where(r => showCleared || !r.Dismissed).ToList();
    var rows = (sort == "strength" ? all.Where(Matches).OrderByDescending(r => r.Weight ?? 0).ThenByDescending(r => r.At) : all.Where(Matches)).ToList();
    @if (all.Count > 0)
    {
        <div class="filter-row">
            <div class="searchbar">
                <Icon Name="search" Size="16" />
                <input type="search" @bind="find" @bind:event="oninput" placeholder="Find a title" aria-label="Find a recommendation" />
            </div>
            <div class="segmented segmented-sm">
                <button class="@(kind is null ? "on" : "")" @onclick="() => kind = null">All</button>
                <button class="@(kind == MediaType.Movie ? "on" : "")" @onclick="() => kind = MediaType.Movie">Movies</button>
                <button class="@(kind == MediaType.Show ? "on" : "")" @onclick="() => kind = MediaType.Show">Shows</button>
            </div>
            @{ var people = all.Select(r => r.Who).DistinctBy(w => w.UserName).OrderBy(w => w.Name).ToList(); }
            @if (people.Count > 1)
            {
                <label class="sort-pick">
                    <span class="muted small">@(Sent ? "To" : "From")</span>
                    <select value="@(who ?? "")" @onchange="e => who = e.Value as string is { Length: > 0 } w ? w : null">
                        <option value="">Anyone</option>
                        @foreach (var u in people) { <option value="@u.UserName">@u.Name</option> }
                    </select>
                </label>
            }
            @if (all.Any(r => r.Weight is not null))
            {
                <label class="sort-pick">
                    <span class="muted small">Sort</span>
                    <select value="@sort" @onchange='e => sort = e.Value as string ?? "newest"'>
                        <option value="newest">Newest</option>
                        <option value="strength">Strongest first</option>
                    </select>
                </label>
            }
            <label class="sort-pick">
                <span class="muted small">Show</span>
                <select value="@state" @onchange='e => state = e.Value as string ?? "all"'>
                    <option value="all">Everything</option>
                    <option value="unwatched">@(Sent ? "Not watched by them yet" : "Not watched yet")</option>
                    <option value="watched">@(Sent ? "Watched by them" : "Watched")</option>
                    @if (!Sent) { <option value="watchlist">On my watchlist</option> }
                </select>
            </label>
        </div>
    }
    @if (all.Count > 0 && rows.Count == 0) { <p class="muted">Nothing matches.</p> }
    @if (all.Count == 0)
    {
        <Empty Title="@(Sent ? "You haven't recommended anything yet." : "Nothing here yet.")">
            @if (Sent) { <span>Open a movie or show and tap <b>Recommend</b> to send it to people who follow you.</span> }
            else { <span>When someone you know recommends something, it shows up here and under the bell.</span> }
        </Empty>
    }
    <div class="rec-list">
        @foreach (var r in rows)
        {
            var m = r.Media;
            <div class="rec-item @(r.Dismissed ? "dismissed" : "") @(selecting && selected.Contains(r.Id) ? "picked" : "")" @key="r.Id">
                @if (selecting)
                {
                    <label class="pick-box" aria-label="@($"Select {r.Media.Title}")">
                        <input type="checkbox" checked="@selected.Contains(r.Id)" @onchange="() => { if (!selected.Remove(r.Id)) selected.Add(r.Id); }" />
                    </label>
                }
                <a href="@Fmt.Href(m.Type, m.TmdbId)"><img src="@Img.Poster(m.PosterPath, "w154")" alt="" loading="lazy" /></a>
                <div class="rec-body">
                    <a class="mini-title" href="@Fmt.Href(m.Type, m.TmdbId)">@m.Title</a>
                    <div class="muted small">@(m.Year?.ToString() ?? "")<span class="dot-sep">@(m.Type == MediaType.Movie ? "Movie" : "TV")</span></div>
                    <div class="rec-who small">
                        <Avatar Name="@r.Who.Name" Url="@r.Who.Avatar" Class="avatar-sm" />
                        <span>@(Sent ? "To " : "From ")<a href="@Fmt.UserHref(r.Who.UserName)"><b>@r.Who.Name</b></a> · <RelTime At="r.At" /></span>
                    </div>
                    @if (r.Weight is { } w) { <span class="pill pill-sm rec-weight" title="How strongly it's recommended">@w/10</span> }
                    @if (r.Note is { } note) { <q class="rec-note">@note</q> }
                    <div class="small rec-status">@Status(r)</div>
                </div>
                <div class="rec-actions">
                    @if (Sent)
                    {
                        <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Unsend(r)">Take back</button>
                    }
                    else
                    {
                        @if (r.Watched != true)
                        {
                            <button class="btn btn-sm @(r.OnWatchlist ? "btn-on" : "")" disabled="@(busy || r.OnWatchlist)" @onclick="() => AddToWatchlist(r)">
                                <Icon Name="bookmark" Size="14" /> @(r.OnWatchlist ? "On watchlist" : "Watchlist")
                            </button>
                        }
                        @if (r.Dismissed) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Dismiss(r, false)">Restore</button> }
                        else { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Dismiss(r, true)">Clear</button> }
                    }
                </div>
            </div>
        }
    </div>
    @if (selecting)
    {
        <div class="bulk-bar" role="toolbar" aria-label="Selected recommendations">
            <span><b>@selected.Count</b> selected</span>
            @if (rows.Count > 0)
            {
                @if (rows.All(r => selected.Contains(r.Id))) { <button class="btn btn-sm btn-ghost" @onclick="() => selected.Clear()">Unselect all</button> }
                else { <button class="btn btn-sm btn-ghost" @onclick="() => { foreach (var r in rows) selected.Add(r.Id); }">Select all @rows.Count</button> }
            }
            <span class="bulk-actions">
                <button class="btn btn-sm" disabled="@(selected.Count == 0)" @onclick="() => listOpen = true"><Icon Name="list" Size="16" /> Add to list…</button>
            </span>
        </div>
        <div class="bulk-spacer" aria-hidden="true"></div>
        <BulkAddToListDialog @bind-Open="listOpen" OnAdded="() => { selecting = false; selected.Clear(); }"
                             Items="@((Sent ? data.Sent : data.Received).Where(r => selected.Contains(r.Id)).Select(r => r.Media).DistinctBy(m => (m.Type, m.TmdbId)).ToList())" />
    }
    @if (!Sent && data.Received.Any(r => r.Dismissed))
    {
        <label class="check small"><input type="checkbox" @bind="showCleared" /> Show cleared ones too</label>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private bool Sent => Tab == "sent";
    private RecommendationsDto? data;
    private string? error;
    private bool busy, showCleared;
    // Filters (both tabs): title, movies or shows, from/to whom, and watched or not.
    private string find = "";
    private MediaType? kind;
    private string? who;
    private string state = "all";
    private string sort = "newest";
    // Select several to add to a list (one of yours, or a new one).
    private bool selecting, listOpen;
    private readonly HashSet<Guid> selected = [];
    private string? filtersFor;

    protected override void OnParametersSet()
    {
        // To you and Sent have different people and statuses: start each fresh.
        if (filtersFor == Tab) return;
        filtersFor = Tab;
        who = null; state = "all";
        selecting = false; selected.Clear();
    }

    private bool Matches(RecommendationDto r) =>
        (find.Trim() is not { Length: > 0 } f || r.Media.Title.Contains(f, StringComparison.OrdinalIgnoreCase))
        && (kind is null || r.Media.Type == kind)
        && (who is null || string.Equals(r.Who.UserName, who, StringComparison.OrdinalIgnoreCase))
        && state switch
        {
            "watched" => r.Watched == true,
            "unwatched" => r.Watched != true,
            "watchlist" => r.OnWatchlist,
            _ => true,
        };

    private int NewCount => data?.Received.Count(r => !r.Dismissed && r.Watched != true) ?? 0;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { data = await Api.FriendRecsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private string Status(RecommendationDto r)
    {
        var rating = r.Rating is { } v ? $" · rated {Fmt.RatingBadge(v)}" : "";
        if (Sent)
            return r.Watched switch
            {
                true => (r.WatchedAt is { } at ? $"Watched {at.ToLocalTime().ToString(Fmt.DateLong)}" : "Watched") + rating,
                false => "Not watched yet" + rating,
                null => r.Rating is not null ? rating.TrimStart(' ', '·', ' ') : "Their history is private",
            };
        return r.Watched == true
            ? (r.WatchedAt is { } w ? $"You watched it {w.ToLocalTime().ToString(Fmt.DateLong)}" : "You've watched it") + rating
            : r.OnWatchlist ? "On your watchlist" : "";
    }

    private async Task AddToWatchlist(RecommendationDto r)
    {
        busy = true;
        try
        {
            await Api.AddToWatchlistAsync(r.Media.Type, r.Media.TmdbId);
            Replace(r, r with { OnWatchlist = true });
            Toasts.Show($"Added {r.Media.Title} to your watchlist");
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private async Task Dismiss(RecommendationDto r, bool dismiss)
    {
        busy = true;
        try
        {
            await Api.DismissRecAsync(r.Id, undo: !dismiss);
            Replace(r, r with { Dismissed = dismiss });
            if (dismiss) Toasts.Offer($"Cleared {r.Media.Title}", "Undo", () => Dismiss(r with { Dismissed = true }, false));
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private async Task Unsend(RecommendationDto r)
    {
        busy = true;
        try
        {
            await Api.UnsendRecAsync(r.Id);
            data = data! with { Sent = data.Sent.Where(x => x.Id != r.Id).ToList() };
            Toasts.Show($"Took back {r.Media.Title} from {r.Who.Name}");
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private void Replace(RecommendationDto old, RecommendationDto updated)
    {
        if (data is null) return;
        data = data with
        {
            Received = data.Received.Select(x => x.Id == old.Id ? updated : x).ToList(),
            Sent = data.Sent.Select(x => x.Id == old.Id ? updated : x).ToList(),
        };
    }
}
