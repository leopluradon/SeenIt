@page "/pick"
@attribute [Authorize]
@inject ApiClient Api
<PageTitle>Pick for me · SeenIt</PageTitle>

<div class="page-head">
    <h1>Pick something for me</h1>
</div>

<div class="pick-filters">
    <div class="segmented">
        <button class="@(kind == PickKind.Any ? "on" : "")" @onclick="() => Set(() => kind = PickKind.Any)">Anything</button>
        <button class="@(kind == PickKind.Movie ? "on" : "")" @onclick="() => Set(() => kind = PickKind.Movie)">Movie</button>
        <button class="@(kind == PickKind.Show ? "on" : "")" @onclick="() => Set(() => kind = PickKind.Show)">Show</button>
    </div>
    <div class="chips pick-time" role="group" aria-label="How much time you have">
        <span class="muted small">I have</span>
        @foreach (var (mins, label) in Lengths)
        {
            <button class="chip @(maxMinutes == mins ? "on" : "")" @onclick="() => Set(() => maxMinutes = mins)" @key="label">@label</button>
        }
    </div>
    @if (friends is { Count: > 0 })
    {
        <div class="chips pick-who" role="group" aria-label="Who's watching">
            <span class="muted small">Who's watching</span>
            <button class="chip @(with.Count == 0 ? "on" : "")" aria-pressed="@(with.Count == 0)" @onclick="() => Set(() => with.Clear())">Just me</button>
            @foreach (var f in friends)
            {
                var on = with.Contains(f.UserName);
                <button class="chip @(on ? "on" : "")" aria-pressed="@on" @key="f.UserName" @onclick="() => Set(() => { if (!with.Remove(f.UserName)) with.Add(f.UserName); })">
                    <Avatar Name="@(f.DisplayName ?? f.UserName)" Url="@f.Avatar" Class="avatar-xs" /> @(f.DisplayName ?? f.UserName)
                </button>
            }
        </div>
    }
    @if (with.Count > 0)
    {
        <p class="muted small pick-group-note">From everyone's watchlists, leaving out anything any of you has seen or started. Titles more of you want come up more often.</p>
    }
    <div class="chips">
        @if (with.Count == 0)
        {
        <button class="chip @(source == PickSource.Both ? "on" : "")" @onclick="() => Set(() => source = PickSource.Both)">Watchlist + paused</button>
        <button class="chip @(source == PickSource.Watchlist ? "on" : "")" @onclick="() => Set(() => source = PickSource.Watchlist)">Watchlist</button>
        <button class="chip @(source == PickSource.Paused ? "on" : "")" @onclick="() => Set(() => source = PickSource.Paused)">Paused shows</button>
        }
        <label class="check small"><input type="checkbox" checked="@streaming" @onchange="e => Set(() => streaming = e.Value is true)" /> Streaming now</label>
    </div>
</div>

<ErrorBox Message="@error" OnRetry="Roll" />
@if (busy && pick is null) { <Spinner /> }
else if (nothing)
{
    <Empty Title="Nothing matches.">
        <span>@(with.Count > 0 ? "Nothing on your watchlists that none of you has seen fits. Loosen the filters, or add to your " : "Loosen the filters, or add things to your ")<a href="watchlist">watchlist</a>.</span>
    </Empty>
}
else if (pick is { } p)
{
    var m = p.Media;
    <article class="pick-card @(busy ? "rolling" : "")">
        <div class="pick-art bg-responsive" style="@Img.BackdropStyle(m.BackdropPath)"><div class="upnext-shade"></div></div>
        <div class="pick-body">
            <a class="pick-poster" href="@Fmt.Href(m.Type, m.TmdbId)">
                @if (Img.Poster(m.PosterPath) is { } src) { <img src="@src" srcset="@Img.PosterSet(m.PosterPath)" sizes="(max-width: 700px) 120px, 200px" alt="" /> }
            </a>
            <div class="pick-info">
                <span class="muted small">@p.Reason</span>
                <h2><a href="@Fmt.Href(m.Type, m.TmdbId)">@m.Title</a></h2>
                <div class="muted small">
                    @(m.Year?.ToString() ?? "")<span class="dot-sep">@(m.Type == MediaType.Movie ? "Movie" : "TV")</span>
                    @if (p.Minutes is > 0) { <span class="dot-sep">@(m.Type == MediaType.Show ? $"{Fmt.Runtime(p.Minutes)} episodes" : Fmt.Runtime(p.Minutes))</span> }
                </div>
                @if (p.NextEpisode is { } n)
                {
                    <div class="small">Up next: <a href="@Fmt.EpisodeHref(m.TmdbId, n.SeasonNumber, n.EpisodeNumber)"><b>@Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)</b> <Spoiler>@n.Name</Spoiler></a></div>
                }
                @if (FitLine(p) is { } fit) { <div class="pick-fit"><Icon Name="clock" Size="16" /> @fit</div> }
                @if (!string.IsNullOrWhiteSpace(m.Overview)) { <p class="pick-overview">@m.Overview</p> }
                @if (p.Streaming.Count > 0)
                {
                    <div class="provider-logos">
                        @foreach (var s in p.Streaming.Take(6))
                        {
                            <span title="@s.Name" @key="s.Id">
                                @if (s.LogoPath is not null) { <img src="@Img.Poster(s.LogoPath, "w92")" alt="@s.Name" /> }
                                else { <span class="chip">@s.Name</span> }
                            </span>
                        }
                    </div>
                }
                <div class="inline pick-actions">
                    <button class="btn btn-primary" disabled="@busy" @onclick="Roll"><Icon Name="shuffle" Size="16" /> Pick again</button>
                    <CheckInButton Request="@(m.Type == MediaType.Movie ? new CheckInRequest(MediaType.Movie, m.TmdbId)
                                              : p.NextEpisode is { } ne ? new CheckInRequest(MediaType.Episode, m.TmdbId, ne.SeasonNumber, ne.EpisodeNumber)
                                              : new CheckInRequest(MediaType.Movie, m.TmdbId))" />
                    <a class="btn btn-ghost" href="@Fmt.Href(m.Type, m.TmdbId)">Details</a>
                </div>
                <p class="muted tiny">Picked from @p.Candidates title@(p.Candidates == 1 ? "" : "s")@(streaming ? " (only ones streaming now count)" : "").</p>
            </div>
        </div>
    </article>
}

@code {
    private static readonly (int? Minutes, string Label)[] Lengths =
        [(null, "Any amount of time"), (30, "30 min"), (60, "1 hour"), (90, "1½ hours"), (120, "2 hours"), (150, "2½ hours"), (180, "3 hours"), (240, "4 hours")];

    /// <summary>"3 episodes (S01E04–S01E06) · 2h 10m · done by 11:40 PM", or for a movie "2h 10m · done by 11:40 PM".</summary>
    private static string? FitLine(PickDto p)
    {
        if (p.FitMinutes is not { } mins || mins <= 0) return null;
        var done = $"done by {DateTime.Now.AddMinutes(mins).ToString(Fmt.TimeOnly)} if you start now";
        if (p.Media.Type == MediaType.Movie) return $"{Fmt.Runtime(mins)} · {done}";
        if (p.FitEpisodes is not { } count || p.NextEpisode is not { } first) return null;
        var range = count == 1 || p.FitThrough is not { } last ? Fmt.Ep(first.SeasonNumber, first.EpisodeNumber)
            : $"{Fmt.Ep(first.SeasonNumber, first.EpisodeNumber)}–{Fmt.Ep(last.SeasonNumber, last.EpisodeNumber)}";
        return $"Time for {count} episode{(count == 1 ? "" : "s")} ({range}) · {Fmt.Runtime(mins)} · {done}";
    }

    private PickKind kind = PickKind.Any;
    private PickSource source = PickSource.Both;
    private int? maxMinutes;
    private bool streaming, busy, nothing;
    private PickDto? pick;
    private string? error;
    private readonly List<string> seen = [];
    // Watching together: people you follow (whose watchlists you can see) to pick for as well.
    private List<UserCard>? friends;
    private readonly List<string> with = [];

    protected override async Task OnInitializedAsync()
    {
        try { friends = (await Api.FollowingAsync()).Where(f => !f.Requested).OrderBy(f => f.DisplayName ?? f.UserName, StringComparer.OrdinalIgnoreCase).ToList(); }
        catch { friends = []; }   // the group option just doesn't show
        await Roll();
    }

    private Task Set(Action change)
    {
        change();
        seen.Clear();
        return Roll();
    }

    private async Task Roll()
    {
        busy = true;
        error = null;
        try
        {
            if (pick is not null) seen.Add($"{pick.Media.Type}:{pick.Media.TmdbId}");
            // Don't let the "already shown" list grow without end; old picks can come round again.
            if (seen.Count > 25) seen.RemoveAt(0);
            pick = await Api.PickAsync(kind, source, maxMinutes, streaming, seen, with);
            nothing = pick is null;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
