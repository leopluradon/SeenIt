@page "/more"
@attribute [Authorize]
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>More · SeenIt</PageTitle>
<h1>More</h1>
<nav class="more-list">
    @if (Session.Me is { } me) { <a href="@Fmt.UserHref(me.UserName)"><Icon Name="users" /> My profile</a> }
    <a href="friends"><Icon Name="users" /> Friends</a>
    <a href="watchlist"><Icon Name="bookmark" /> Watchlist</a>
    <a href="pick"><Icon Name="shuffle" /> Pick something for me</a>
    <a href="history"><Icon Name="history" /> History</a>
    <a href="lists"><Icon Name="list" /> Lists</a>
    <a href="ratings"><Icon Name="star" /> Ratings</a>
    <a href="stats"><Icon Name="chart" /> Stats</a>
    <a href="@($"review/{DateTime.Today.Year}/{DateTime.Today.Month}")"><Icon Name="chart" /> Month in review</a>
    <a href="@($"review/{DateTime.Today.Year}")"><Icon Name="chart" /> Year in review</a>
    <a href="progress"><Icon Name="progress" /> Progress</a>
    <a href="calendar"><Icon Name="calendar" /> Calendar</a>
    <a href="discover"><Icon Name="compass" /> Discover</a>
    <a href="search"><Icon Name="search" /> Search</a>
    <a href="settings"><Icon Name="settings" /> Settings</a>
    @if (Session.Me?.IsAdmin == true) { <a href="admin"><Icon Name="shield" /> Admin</a> }
    <a href="settings#layout"><Icon Name="menu" /> Customize tabs</a>
    <button @onclick="Logout"><Icon Name="logout" /> Sign out</button>
</nav>
@code {
    private async Task Logout()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("");
    }
}
