@page "/show/{Id:int}/season/{Number:int}"
@inject ApiClient Api
@inject Toasts Toasts
<PageTitle>@(season is null ? "Season" : $"{season.ShowName} · {season.Name}") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (season is null && error is null) { <Spinner /> }
else if (season is not null)
{
    <nav class="crumbs"><a href="@($"show/{Id}")"><Icon Name="chevron-left" Size="16" /> @season.ShowName</a></nav>
    <div class="page-head">
        <h1>@season.Name</h1>
        <AuthorizeView>
            <div class="inline">
                @if (season.Rewatch is { } rw) { <span class="pill rewatch-pill"><Icon Name="repeat" Size="14" /> @Show.RewatchLabel(rw)</span> }
                <span class="muted">@Watched/@Aired @(Rewatching ? "rewatched" : "watched")</span>
                @if (Watched < Aired)
                {
                    <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="() => watchAllOpen = true"><Icon Name="check" Size="16" /> Mark season @(Rewatching ? "rewatched" : "watched")</button>
                }
                else if (Watched > 0 && !Rewatching)
                {
                    <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="UnwatchSeason">Unwatch season</button>
                }
            </div>
        </AuthorizeView>
    </div>
    var eps = season.Episodes;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var runtimes = eps.Where(x => x.Runtime is > 0).ToList();
    var total = runtimes.Sum(x => (long)x.Runtime!.Value);
    var watchedMinutes = eps.Where(x => x.Plays > 0).Sum(x => (long)(x.Runtime ?? 0));
    var airedCount = eps.Count(x => x.AirDate is { } d && d <= today);
    var first = eps.Where(x => x.AirDate is not null).MinBy(x => x.AirDate)?.AirDate;
    var last = eps.Where(x => x.AirDate is not null).MaxBy(x => x.AirDate)?.AirDate;
    <DetailStats Items="@([
        ("Episodes", airedCount < eps.Count ? $"{airedCount} aired of {eps.Count}" : eps.Count.ToString()),
        ("Total runtime", total > 0 ? Fmt.Duration(total) : null),
        ("Per episode", runtimes.Count > 0 ? "~" + Fmt.Runtime((int)Math.Round(runtimes.Average(x => x.Runtime!.Value))) : null),
        ("Aired", first is { } f ? (last is { } l && l != f ? $"{f:d MMM yyyy} – {l:d MMM yyyy}" : $"{f:d MMM yyyy}") : null),
        ("You've watched", watchedMinutes > 0 ? Fmt.Duration(watchedMinutes) : null),
        ("Left to watch", watchedMinutes > 0 ? Fmt.Duration(eps.Where(x => x.Plays == 0 && x.AirDate is { } d && d <= today).Sum(x => (long)(x.Runtime ?? 0))) : null),
    ])" />
    @if (season.Overview is not null) { <p class="overview">@season.Overview</p> }

    <div class="episodes">
        @foreach (var e in season.Episodes)
        {
            var aired = e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today);
            <article class="episode @(Done(e) ? "watched" : "")" @key="e.EpisodeNumber">
                <a class="episode-still" href="@Fmt.EpisodeHref(Id, e.SeasonNumber, e.EpisodeNumber)">
                    @if (Img.Still(e.StillPath) is { } src) { <Spoiler Watched="e.Plays > 0" Image="true"><img src="@src" alt="" loading="lazy" /></Spoiler> }
                    <span class="episode-num">@e.EpisodeNumber</span>
                </a>
                <div class="episode-body">
                    <div class="episode-title">
                        <a href="@Fmt.EpisodeHref(Id, e.SeasonNumber, e.EpisodeNumber)"><b><Spoiler Watched="e.Plays > 0">@e.Name</Spoiler></b></a>
                        <span class="muted small">@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber) @if (e.AirDate is { } ad) { <span class="dot-sep">@ad.ToString("d MMM yyyy")</span> } @if (e.Runtime is > 0) { <span class="dot-sep">@Fmt.Runtime(e.Runtime)</span> }</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(e.Overview)) { <Spoiler Watched="e.Plays > 0" Block="true"><p class="episode-overview">@e.Overview</p></Spoiler> }
                    <AuthorizeView>
                        <div class="episode-actions">
                            @if (Rewatching && !e.Rewatched && aired)
                            {
                                <button class="btn btn-sm" disabled="@busy" @onclick="() => pending = e"><Icon Name="repeat" Size="14" /> Mark rewatched</button>
                                @if (e.Plays > 0) { <span class="muted small">@(e.Plays == 1 ? "Seen once" : $"Seen {e.Plays} times")</span> }
                            }
                            else if (e.Plays > 0)
                            {
                                <button class="btn btn-sm btn-watched" disabled="@busy" @onclick="() => pending = e" title="Watch again"><Icon Name="check" Size="14" /> @(e.Plays > 1 ? $"{e.Plays} plays" : "Watched")</button>
                                <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Unwatch(e)" aria-label="Remove plays"><Icon Name="x" Size="14" /></button>
                            }
                            else if (aired)
                            {
                                <button class="btn btn-sm" disabled="@busy" @onclick="() => pending = e"><Icon Name="check" Size="14" /> Mark watched</button>
                            }
                            else
                            {
                                <span class="pill">Not aired yet</span>
                            }
                            <RatingPicker Value="e.Rating" ValueChanged="v => Rate(e, v)" Compact="true" />
                        </div>
                    </AuthorizeView>
                </div>
            </article>
        }
    </div>
    <CastRow Cast="@(season.Cast ?? [])" Title="Cast this season" />

    <WatchDialog @bind-Open="watchAllOpen" What="@season.Name" Bulk="true" OnPick="WatchSeason" />
    <WatchDialog Open="pending is not null" OpenChanged="o => { if (!o) pending = null; }"
                 What="@(pending is { } pe ? Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber) : "")" ReleaseDate="pending?.AirDate" OnPick="Watch" />
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Number { get; set; }
    private SeasonDetail? season;
    private string? error;
    private bool busy, watchAllOpen;
    private EpisodeDto? pending;

    private int Aired => season?.Episodes.Count(e => e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today)) ?? 0;
    private int Watched => season?.Episodes.Count(Done) ?? 0;
    private bool Rewatching => season?.Rewatch is not null;
    /// <summary>Watched at all, or during a rewatch, watched again since it started.</summary>
    private bool Done(EpisodeDto e) => Rewatching ? e.Rewatched : e.Plays > 0;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        if (season is not null && (season.ShowTmdbId != Id || season.SeasonNumber != Number)) season = null;
        try { season = await Api.SeasonAsync(Id, Number); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Act(Func<Task> action, string? done = null)
    {
        busy = true;
        try
        {
            await action();
            if (done is not null) Toasts.Show(done);
            season = await Api.SeasonAsync(Id, Number);
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }

    private Task Watch(WatchChoice c)
    {
        if (pending is not { } e) return Task.CompletedTask;
        pending = null;
        return Act(() => Api.WatchAsync(Fmt.Watch(MediaType.Episode, Id, c, e.SeasonNumber, e.EpisodeNumber)), $"Watched {Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)}{Fmt.When(c)}");
    }
    private Task Unwatch(EpisodeDto e) => Act(() => Api.UnwatchAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber), "Removed from history");
    private Task WatchSeason(WatchChoice c) =>
        Act(() => Api.BulkWatchAsync(new BulkWatchRequest(Id, Number, c.At, When: c.When)), $"Marked {season!.Name} watched{Fmt.When(c)}");
    private Task UnwatchSeason() => Act(() => Api.UnwatchAsync(MediaType.Episode, Id, Number), "Season removed from history");
    private Task Rate(EpisodeDto e, int? v) => v is { } r
        ? Act(() => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, r, e.SeasonNumber, e.EpisodeNumber)), $"Rated {r}/10")
        : Act(() => Api.UnrateAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber), "Rating removed");
}
