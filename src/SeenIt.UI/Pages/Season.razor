@page "/show/{Id:int}/season/{Number:int}"
@inject ApiClient Api
@inject Toasts Toasts
<PageTitle>@(season is null ? "Season" : $"{season.ShowName} · {season.Name}") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (season is null && error is null) { <Spinner /> }
else if (season is not null)
{
    <nav class="crumbs season-crumbs">
        <a href="@($"show/{Id}")"><Icon Name="chevron-left" Size="16" /> @season.ShowName</a>
        <span class="season-step">
            @if (season.PreviousSeason is { } tp) { <a href="@($"show/{Id}/season/{tp}")" aria-label="@($"Previous: Season {tp}")"><Icon Name="chevron-left" Size="16" /> Season @tp</a> }
            @if (season.NextSeason is { } tn) { <a href="@($"show/{Id}/season/{tn}")" aria-label="@($"Next: Season {tn}")">Season @tn <Icon Name="chevron-right" Size="16" /></a> }
        </span>
    </nav>
    <div class="page-head">
        <h1>@season.Name</h1>
        <AuthorizeView>
            <div class="inline">
                @if (season.Rewatch is { } rw) { <span class="pill rewatch-pill"><Icon Name="repeat" Size="14" /> @Show.RewatchLabel(rw)</span> }
                <span class="muted">@Watched/@Aired @(Rewatching ? "rewatched" : "watched")</span>
                @if (Watched < Aired)
                {
                    <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="() => { seasonThrough = false; watchAllOpen = true; }"><Icon Name="check" Size="16" /> Mark season @(Rewatching ? "rewatched" : "watched")</button>
                    @if (Number > 1) { <button class="btn btn-sm" disabled="@busy" @onclick="() => { seasonThrough = true; watchAllOpen = true; }" title="Mark this season and every earlier one watched">Up to here</button> }
                }
                else if (Watched > 0 && !Rewatching)
                {
                    <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="UnwatchSeason">Unwatch season</button>
                }
            </div>
        </AuthorizeView>
    </div>
    var eps = season.Episodes;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var runtimes = eps.Where(x => x.Runtime is > 0).ToList();
    var total = runtimes.Sum(x => (long)x.Runtime!.Value);
    var watchedMinutes = eps.Where(x => x.Plays > 0).Sum(x => (long)(x.Runtime ?? 0));
    var airedCount = eps.Count(x => x.AirDate is { } d && d <= today);
    var first = eps.Where(x => x.AirDate is not null).MinBy(x => x.AirDate)?.AirDate;
    var last = eps.Where(x => x.AirDate is not null).MaxBy(x => x.AirDate)?.AirDate;
    var rated = eps.Where(x => x.Rating is not null).ToList();
    var tmdbEpisodes = eps.Where(x => x.VoteAverage is > 0).ToList();
    var tmdbScore = season.VoteAverage ?? (tmdbEpisodes.Count > 0 ? tmdbEpisodes.Average(x => x.VoteAverage!.Value) : (double?)null);
    var seasonSeen = Aired > 0 && Watched >= Aired;
    <div class="season-scores">
        <ScoreSpoiler Watched="seasonSeen" Block="true">
            @if (tmdbScore is { } ts && Fmt.ShowsScore("tmdb", MediaType.Show, season: true))
            {
                <div class="score season-score" title="@(season.VoteAverage is null ? "Average of TMDB's episode scores" : "TMDB's score for this season")">
                    <Icon Name="star" Size="16" /> <b>@ts.ToString("0.0")</b> <span class="muted small">TMDB@(season.VoteAverage is null ? " · episode average" : "")</span>
                </div>
            }
            <ExternalScores Type="MediaType.Show" TmdbId="Id" Season="Number" IsSeason="true" />
        </ScoreSpoiler>
    </div>
    <DetailStats Items="@([
        ("Episodes", airedCount < eps.Count ? $"{airedCount} aired of {eps.Count}" : eps.Count.ToString()),
        ("Total runtime", total > 0 ? Fmt.Duration(total) : null),
        ("Per episode", runtimes.Count > 0 ? "~" + Fmt.Runtime((int)Math.Round(runtimes.Average(x => x.Runtime!.Value))) : null),
        ("Aired", first is { } f ? (last is { } l && l != f ? $"{(f).ToString(Fmt.DateLong)} – {(l).ToString(Fmt.DateLong)}" : $"{(f).ToString(Fmt.DateLong)}") : null),
        ("You've watched", watchedMinutes > 0 ? Fmt.Duration(watchedMinutes) : null),
        ("Completed", season.CompletedAt is { } done ? done.ToLocalTime().ToString(Fmt.DateLong) : null),
        ("Left to watch", watchedMinutes > 0 && season.CompletedAt is null ? Fmt.Duration(eps.Where(x => x.Plays == 0 && x.AirDate is { } d && d <= today).Sum(x => (long)(x.Runtime ?? 0))) : null),
    ])" />
    <AuthorizeView>
        <div class="you-split">
            <div class="panel rate-panel season-rate">
                <span>Your rating for @season.Name</span>
                <RatingPicker Value="season.Rating" ValueChanged="RateSeason" />
                @if (rated.Count > 0)
                {
                    <span class="muted small season-ep-avg" title="@Fmt.Rating(rated.Average(x => x.Rating!.Value))">Your episode average: <b>@Fmt.Stars(Math.Round(rated.Average(x => x.Rating!.Value), 1))</b> from @rated.Count rated</span>
                }
            </div>
            <FriendsSeen Type="MediaType.Show" TmdbId="Id" Season="Number" Total="airedCount" Watched="seasonSeen" />
        </div>
    </AuthorizeView>
    @if (season.Overview is not null) { <p class="overview">@season.Overview</p> }

    <div class="episodes">
        @foreach (var e in season.Episodes)
        {
            var aired = e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today);
            <article class="episode @(Done(e) ? "watched" : "")" @key="e.EpisodeNumber">
                <a class="episode-still" href="@Fmt.EpisodeHref(Id, e.SeasonNumber, e.EpisodeNumber)">
                    @if (Img.Still(e.StillPath) is { } src) { <Spoiler Watched="e.Plays > 0" Image="true"><img src="@src" alt="" loading="lazy" /></Spoiler> }
                    <span class="episode-num">@e.EpisodeNumber</span>
                </a>
                <div class="episode-body">
                    <div class="episode-title">
                        <a href="@Fmt.EpisodeHref(Id, e.SeasonNumber, e.EpisodeNumber)"><b><Spoiler Watched="e.Plays > 0">@e.Name</Spoiler></b></a>
                        <span class="muted small">@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber) @if (e.AirDate is { } ad) { <span class="dot-sep">@ad.ToString(Fmt.DateLong)</span> } @if (e.Runtime is > 0) { <span class="dot-sep">@Fmt.Runtime(e.Runtime)</span> }</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(e.Overview)) { <Spoiler Watched="e.Plays > 0" Block="true"><p class="episode-overview">@e.Overview</p></Spoiler> }
                    <AuthorizeView>
                        <div class="episode-actions">
                            @if (Rewatching && !e.Rewatched && aired)
                            {
                                <button class="btn btn-sm" disabled="@busy" @onclick="() => Open(e, false)"><Icon Name="repeat" Size="14" /> Mark rewatched</button>
                                @if (Fmt.CanThrough(e.SeasonNumber, e.EpisodeNumber)) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Open(e, true)" title="Mark everything up to here rewatched">Up to here</button> }
                                @if (e.Plays > 0) { <span class="muted small">@(e.Plays == 1 ? "Seen once" : $"Seen {e.Plays} times")</span> }
                            }
                            else if (e.Plays > 0)
                            {
                                <button class="btn btn-sm btn-watched" disabled="@busy" @onclick="() => Open(e, false)" title="Watch again"><Icon Name="check" Size="14" /> @(e.Plays > 1 ? $"{e.Plays} plays" : "Watched")</button>
                                <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Unwatch(e)" aria-label="Remove plays"><Icon Name="x" Size="14" /></button>
                            }
                            else if (aired)
                            {
                                <button class="btn btn-sm" disabled="@busy" @onclick="() => Open(e, false)"><Icon Name="check" Size="14" /> Mark watched</button>
                                <WhenButton Small="true" Disabled="busy" What="@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)" OnClick="() => Open(e, false, true)" />
                                @if (Fmt.CanThrough(e.SeasonNumber, e.EpisodeNumber)) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Open(e, true)" title="Mark everything up to here watched">Up to here</button> }
                            }
                            else
                            {
                                <span class="pill">Not aired yet</span>
                            }
                            <RatingPicker Value="e.Rating" ValueChanged="v => Rate(e, v)" Compact="true" />
                        </div>
                    </AuthorizeView>
                </div>
            </article>
        }
    </div>
    <nav class="episode-nav">
        @if (season.PreviousSeason is { } ps)
        {
            <a class="episode-nav-link" href="@($"show/{Id}/season/{ps}")">
                <Icon Name="chevron-left" Size="18" />
                <span><span class="muted small">Previous</span><br />Season @ps</span>
            </a>
        }
        else { <span></span> }
        @if (season.NextSeason is { } ns)
        {
            <a class="episode-nav-link next" href="@($"show/{Id}/season/{ns}")">
                <span><span class="muted small">Next</span><br />Season @ns</span>
                <Icon Name="chevron-right" Size="18" />
            </a>
        }
    </nav>
    <CastRow Cast="@(season.Cast ?? [])" Title="Cast this season" />

    <WatchDialog @bind-Open="watchAllOpen" What="@season.Name" Bulk="true" OnPick="WatchSeason" Through="seasonThrough" ThroughNote=" in the earlier seasons" />
    <WatchDialog Open="pending is not null" OpenChanged="o => { if (!o) pending = null; }"
                 What="@(pending is { } pe ? Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber) : "")" ReleaseDate="pending?.AirDate" OnPick="Watch"
                 Through="pendingThrough" ThroughNote="@(Number == 0 ? " (specials only)" : ", in season order")" ScopeSeason="@ScopeFor(pending)"  AskWhen="askWhen" />
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Number { get; set; }
    private SeasonDetail? season;
    private string? error;
    private bool busy, watchAllOpen;
    private EpisodeDto? pending;
    private bool pendingThrough, seasonThrough;
    private void Open(EpisodeDto e, bool through, bool ask = false) { pending = e; pendingThrough = through; askWhen = ask; }
    private bool askWhen;
    private static int? ScopeFor(EpisodeDto? e) => e is { SeasonNumber: > 1, EpisodeNumber: > 1 } ? e.SeasonNumber : null;

    private int Aired => season?.Episodes.Count(e => e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today)) ?? 0;
    private int Watched => season?.Episodes.Count(Done) ?? 0;
    private bool Rewatching => season?.Rewatch is not null;
    /// <summary>Watched at all, or during a rewatch, watched again since it started.</summary>
    private bool Done(EpisodeDto e) => Rewatching ? e.Rewatched : e.Plays > 0;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        if (season is not null && (season.ShowTmdbId != Id || season.SeasonNumber != Number)) season = null;
        try { season = await Api.SeasonAsync(Id, Number); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Act(Func<Task> action, string? done = null)
    {
        busy = true;
        try
        {
            await action();
            if (done is not null) Toasts.Show(done, undo: TakeUndo());
            season = await Api.SeasonAsync(Id, Number);
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }

    private Task Watch(WatchChoice c)
    {
        if (pending is not { } e) return Task.CompletedTask;
        pending = null;
        if (c.Through)
            return Act(async () => Toasts.Show(Fmt.Through(await Api.WatchThroughAsync(Id, new WatchThroughRequest(e.SeasonNumber, e.EpisodeNumber, c.When, c.At, SeasonOnly: c.SeasonOnly)), c)));
        return Act(() => Api.WatchAsync(Fmt.Watch(MediaType.Episode, Id, c, e.SeasonNumber, e.EpisodeNumber)), $"Watched {Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)}{Fmt.When(c)}");
    }
    private Task Unwatch(EpisodeDto e) => Act(async () =>
    {
        var removed = await Api.UnwatchAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Removed from history");
    private Task WatchSeason(WatchChoice c) => c.Through
        ? Act(async () => Toasts.Show(Fmt.Through(await Api.WatchThroughAsync(Id, new WatchThroughRequest(Number, null, c.When, c.At)), c)))
        : Act(() => Api.BulkWatchAsync(new BulkWatchRequest(Id, Number, c.At, When: c.When)), $"Marked {season!.Name} watched{Fmt.When(c)}");
    private Task UnwatchSeason() => Act(async () =>
    {
        var removed = await Api.UnwatchAsync(MediaType.Episode, Id, Number);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Season removed from history");
    private Task Rate(EpisodeDto e, double? v) => v is { } r
        ? Act(() => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, r, e.SeasonNumber, e.EpisodeNumber)), $"Rated {Fmt.Rating(r)}")
        : Act(async () =>
        {
            var old = e.Rating;
            await Api.UnrateAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, o, e.SeasonNumber, e.EpisodeNumber));
        }, "Rating removed");

    private Task RateSeason(double? v) => v is { } r
        ? Act(() => Api.RateAsync(new RatingRequest(MediaType.Show, Id, r, Number)), $"Rated {season!.Name} {Fmt.Rating(r)}")
        : Act(async () =>
        {
            var old = season!.Rating;
            await Api.UnrateAsync(MediaType.Show, Id, Number);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Show, Id, o, Number));
        }, "Rating removed");

    // Set by an action that can be undone; the toast it shows gets an Undo button.
    private Func<Task>? undo;
    private Func<Task>? TakeUndo()
    {
        if (undo is not { } u) return null;
        undo = null;
        return async () => { await u(); await InvokeAsync(async () => { await Load(); StateHasChanged(); }); };
    }

}
