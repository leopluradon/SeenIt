@page "/show/{Id:int}/season/{Number:int}"
@inject ApiClient Api
@inject Toasts Toasts
@inject SessionState Session
@inject Confirm Confirmer
<PageTitle>@(season is null ? "Season" : $"{season.ShowName} · {season.Name}") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" NotFound="notFound" />
@if (season is null && error is null) { <Spinner /> }
else if (season is not null)
{
    <nav class="crumbs season-crumbs">
        <a href="@($"show/{Id}")"><Icon Name="chevron-left" Size="16" /> @season.ShowName</a>
        <span class="season-step">
            @if (season.PreviousSeason is { } tp) { <a href="@($"show/{Id}/season/{tp}")" aria-label="@($"Previous: Season {tp}")"><Icon Name="chevron-left" Size="16" /> Season @tp</a> }
            @if (season.NextSeason is { } tn) { <a href="@($"show/{Id}/season/{tn}")" aria-label="@($"Next: Season {tn}")">Season @tn <Icon Name="chevron-right" Size="16" /></a> }
        </span>
    </nav>
    <div class="page-head">
        <h1>@season.Name</h1>
        <AuthorizeView>
            <div class="inline">
                @if (season.Rewatch is { } rw) { <span class="pill rewatch-pill"><Icon Name="repeat" Size="14" /> @Show.RewatchLabel(rw)</span> }
                <span class="muted">@Watched/@Aired @(Rewatching ? "rewatched" : "watched")</span>
                @if (Watched < Aired)
                {
                    <SplitButton Class="btn-primary btn-sm" Disabled="busy" OnClick="() => { seasonThrough = false; watchAllOpen = true; }" Menu="@(Number > 1 || Watched > 0 ? SeasonMenu : null)">
                        <Icon Name="check" Size="16" /> Mark season @(Rewatching ? "rewatched" : "watched")
                    </SplitButton>
                }
                else if (Watched > 0 && !Rewatching)
                {
                    <SplitButton Class="btn-watched btn-sm" Disabled="busy" OpensMenu="true" Menu="SeasonMenu"><Icon Name="check" Size="16" /> Season watched</SplitButton>
                }
                <div class="hero-rate sm">
                    <span>Rate</span><RatingPicker Compact="true" Value="season.Rating" ValueChanged="RateSeason" />
                    @if (season.Episodes.Where(x => x.Rating is not null).Select(x => x.Rating!.Value).ToList() is { Count: > 0 } epRatings)
                    {
                        <span class="muted small" title="@Fmt.Rating(epRatings.Average())">episodes avg <b>@Fmt.Stars(Math.Round(epRatings.Average(), 1))</b></span>
                    }
                </div>
                <button class="btn btn-sm" @onclick="() => recommendOpen = true" title="Recommend the show to friends"><Icon Name="send" Size="16" /> Recommend</button>
                <RecommendDialog @bind-Open="recommendOpen" Type="MediaType.Show" TmdbId="Id" Title="@season.ShowName" />
            </div>
        </AuthorizeView>
    </div>
    var eps = season.Episodes;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var runtimes = eps.Where(x => x.Runtime is > 0).ToList();
    var total = runtimes.Sum(x => (long)x.Runtime!.Value);
    var watchedMinutes = eps.Where(x => x.Plays > 0).Sum(x => (long)(x.Runtime ?? 0));
    var airedCount = eps.Count(x => x.AirDate is { } d && d <= today);
    var first = eps.Where(x => x.AirDate is not null).MinBy(x => x.AirDate)?.AirDate;
    var last = eps.Where(x => x.AirDate is not null).MaxBy(x => x.AirDate)?.AirDate;
    var rated = eps.Where(x => x.Rating is not null).ToList();
    var tmdbEpisodes = eps.Where(x => x.VoteAverage is > 0).ToList();
    var tmdbScore = season.VoteAverage ?? (tmdbEpisodes.Count > 0 ? tmdbEpisodes.Average(x => x.VoteAverage!.Value) : (double?)null);
    var seasonSeen = Aired > 0 && Watched >= Aired;
    <div class="season-scores">
        <ScoreSpoiler Watched="seasonSeen" Block="true">
            <ExternalScores Type="MediaType.Show" TmdbId="Id" Season="Number" IsSeason="true"
                            TmdbScore="@(Fmt.ShowsScore("tmdb", MediaType.Show, season: true) ? tmdbScore : null)"
                            TmdbNote="@(season.VoteAverage is null ? "average of TMDB's episode scores" : null)" />
        </ScoreSpoiler>
    </div>
    <DetailStats Items="@([
        ("Episodes", airedCount < eps.Count ? $"{airedCount} aired of {eps.Count}" : eps.Count.ToString()),
        ("Total runtime", total > 0 ? Fmt.Duration(total) : null),
        ("Per episode", runtimes.Count > 0 ? "~" + Fmt.Runtime((int)Math.Round(runtimes.Average(x => x.Runtime!.Value))) : null),
        ("Aired", first is { } f ? (last is { } l && l != f ? $"{(f).ToString(Fmt.DateLong)} – {(l).ToString(Fmt.DateLong)}" : $"{(f).ToString(Fmt.DateLong)}") : null),
        ("You've watched", watchedMinutes > 0 ? Fmt.Duration(watchedMinutes) : null),
        ("Completed", season.CompletedAt is { } done ? done.ToLocalTime().ToString(Fmt.DateLong) : null),
        ("Left to watch", watchedMinutes > 0 && season.CompletedAt is null ? Fmt.Duration(eps.Where(x => x.Plays == 0 && x.AirDate is { } d && d <= today).Sum(x => (long)(x.Runtime ?? 0))) : null),
    ])" />
    <AuthorizeView>
        <div class="you-split">

            <FriendsSeen Type="MediaType.Show" TmdbId="Id" Season="Number" Total="airedCount" Watched="seasonSeen" />
        </div>
    </AuthorizeView>
    @if (season.Overview is not null) { <p class="overview">@season.Overview</p> }

    @if (orders is { Options.Count: > 0 })
    {
        <div class="panel season-order">
            <WatchOrderPicker Orders="orders" Disabled="busy" OnChange="SetOrder"
                              Hint="@(order is { } o ? $"This season's episodes are listed in {o.Name} order, numbered by their place in it. Changing it here changes it for the whole show." : "Changing it here changes it for the whole show.")" />
        </div>
    }

    <div class="episodes">
        @foreach (var e in Ordered)
        {
            var aired = e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today);
            <article class="episode @(Done(e) ? "watched" : "")" @key="e.EpisodeNumber" data-ctx="@Menu.Episode(Id, e.SeasonNumber, e.EpisodeNumber, season.ShowName, e.Name, season.PosterPath)">
                <a class="episode-still" href="@Fmt.EpisodeHref(Id, e.SeasonNumber, e.EpisodeNumber)">
                    @if (Img.Still(e.StillPath) is { } src) { <Spoiler Watched="e.Plays > 0" Image="true"><img src="@src" alt="" loading="lazy" /></Spoiler> }
                    <span class="episode-num">@e.EpisodeNumber</span>
                </a>
                <div class="episode-body">
                    <div class="episode-title">
                        <a href="@Fmt.EpisodeHref(Id, e.SeasonNumber, e.EpisodeNumber)"><b><Spoiler Watched="e.Plays > 0">@e.Name</Spoiler></b></a>
                        <span class="muted small">@if (Place(e) is { } pl) { <span class="order-pos" title="@($"Episode {pl.Position} of {order!.Name}{(pl.Part is { } pt ? $", in {pt}" : "")}")">#@pl.Position@(pl.Part is { } pn && order!.Parts.Count > 1 ? $" · {pn}" : "") · </span> }@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber) <EpisodeBadge Mark="e.Mark" /> @if (e.AirDate is { } ad) { <span class="dot-sep">@ad.ToString(Fmt.DateLong)</span> } @if (e.Runtime is > 0) { <span class="dot-sep">@Fmt.Runtime(e.Runtime)</span> }</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(e.Overview)) { <Spoiler Watched="e.Plays > 0" Block="true"><p class="episode-overview">@e.Overview</p></Spoiler> }
                    <AuthorizeView>
                        <div class="episode-actions">
                            @if (Rewatching && !e.Rewatched && aired)
                            {
                                <button class="btn btn-sm" disabled="@busy" @onclick="() => Open(e, false)"><Icon Name="repeat" Size="14" /> Mark rewatched</button>
                                @if (CanThrough(e)) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Open(e, true)" title="Mark everything up to here rewatched">Up to here</button> }
                                @if (e.Plays > 0) { <span class="muted small">@(e.Plays == 1 ? "Seen once" : $"Seen {e.Plays} times")</span> }
                            }
                            else if (e.Plays > 0)
                            {
                                <button class="btn btn-sm btn-watched" disabled="@busy" @onclick="() => Open(e, false)" title="Watch again"><Icon Name="check" Size="14" /> @(e.Plays > 1 ? $"{e.Plays} plays" : "Watched")</button>
                                <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Unwatch(e)" aria-label="Remove plays"><Icon Name="x" Size="14" /></button>
                            }
                            else if (aired)
                            {
                                <button class="btn btn-sm" disabled="@busy" @onclick="() => Open(e, false)"><Icon Name="check" Size="14" /> Mark watched</button>
                                <WhenButton Small="true" Disabled="busy" What="@Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)" OnClick="() => Open(e, false, true)" />
                                @if (CanThrough(e)) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => Open(e, true)" title="Mark everything up to here watched">Up to here</button> }
                            }
                            else
                            {
                                <span class="pill">Not aired yet</span>
                            }
                            <RatingPicker Value="e.Rating" ValueChanged="v => Rate(e, v)" Compact="true" />
                        </div>
                    </AuthorizeView>
                </div>
            </article>
        }
    </div>
    <nav class="episode-nav">
        @if (season.PreviousSeason is { } ps)
        {
            <a class="episode-nav-link" href="@($"show/{Id}/season/{ps}")">
                <Icon Name="chevron-left" Size="18" />
                <span><span class="muted small">Previous</span><br />Season @ps</span>
            </a>
        }
        else { <span></span> }
        @if (season.NextSeason is { } ns)
        {
            <a class="episode-nav-link next" href="@($"show/{Id}/season/{ns}")">
                <span><span class="muted small">Next</span><br />Season @ns</span>
                <Icon Name="chevron-right" Size="18" />
            </a>
        }
    </nav>
    <CastRow Cast="@(season.Cast ?? [])" Title="Cast this season" BlurEpisodeCounts="@Fmt.BlurCounts(Partway(season), Finished(season))" />

    <WatchDialog @bind-Open="watchAllOpen" What="@season.Name" Bulk="true" OnPick="WatchSeason" Through="seasonThrough" ThroughNote=" in the earlier seasons" />
    <WatchDialog Open="pending is not null" OpenChanged="o => { if (!o) pending = null; }"
                 What="@(pending is { } pe ? Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber) : "")" ReleaseDate="pending?.AirDate" OnPick="Watch"
                 Through="pendingThrough" ThroughNote="@(order is { } od && Place(pending) is not null ? $", in {od.Name} order" : Number == 0 ? " (specials only)" : ", in season order")" ScopeSeason="@(order is not null && Place(pending) is not null ? null : ScopeFor(pending))"  AskWhen="askWhen" />
}

<ReloadOnMenu OnChange="Load" />
@code {
    /// <summary>You've seen some of this season's aired episodes but not all: the spoiler setting blurs episode counts in its cast.</summary>
    /// <summary>You've seen every aired episode of this season.</summary>
    private static bool Finished(SeasonDetail s)
    {
        var aired = s.Episodes.Where(x => x.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today)).ToList();
        return aired.Count > 0 && aired.All(x => x.Plays > 0);
    }
    private static bool Partway(SeasonDetail s)
    {
        var aired = s.Episodes.Where(x => x.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today)).ToList();
        return aired.Any(x => x.Plays > 0) && aired.Any(x => x.Plays == 0);
    }
    [Parameter] public int Id { get; set; }
    [Parameter] public int Number { get; set; }
    private SeasonDetail? season;
    private string? error;
    private bool notFound;
    private bool busy, watchAllOpen, recommendOpen;

    /// <summary>The season's ▾: earlier seasons too, or taking it back.</summary>
    private RenderFragment SeasonMenu => __builder =>
    {
        @if (Number > 1 && Watched < Aired)
        {
            <button type="button" role="menuitem" @onclick="() => { seasonThrough = true; watchAllOpen = true; }"><Icon Name="check" Size="16" /> Mark seasons 1–@Number watched…</button>
        }
        @if (Watched > 0 && !Rewatching)
        {
            <button type="button" role="menuitem" @onclick="UnwatchSeason"><Icon Name="x" Size="16" /> Unwatch season</button>
        }
    };
    private EpisodeDto? pending;
    private bool pendingThrough, seasonThrough;
    private void Open(EpisodeDto e, bool through, bool ask = false) { pending = e; pendingThrough = through; askWhen = ask; }
    private WatchOrdersDto? orders;
    private WatchOrderDto? order;
    private int ordersFor;

    /// <summary>"Up to here" makes sense after the first episode: of the watch order if this one is in it, else of the show.</summary>
    private bool CanThrough(EpisodeDto e) => Place(e) is { } p ? p.Position > 1 : Fmt.CanThrough(e.SeasonNumber, e.EpisodeNumber);

    /// <summary>Where an episode sits in the watch order you follow (null: TMDB's seasons, or it isn't in the order).</summary>
    private (int Position, string? Part)? Place(EpisodeDto? e)
    {
        if (order is null || e is null) return null;
        foreach (var part in order.Parts)
            foreach (var x in part.Episodes)
                if (x.SeasonNumber == e.SeasonNumber && x.EpisodeNumber == e.EpisodeNumber) return (x.Position, part.Name);
        return null;
    }

    /// <summary>The season's episodes in your watch order; ones it leaves out go last, in TMDB's order.</summary>
    private IEnumerable<EpisodeDto> Ordered => order is null ? season!.Episodes
        : season!.Episodes.OrderBy(e => Place(e)?.Position ?? int.MaxValue).ThenBy(e => e.EpisodeNumber);

    private async Task LoadOrder()
    {
        try
        {
            orders = await Api.WatchOrdersAsync(Id);
            order = orders.SelectedId is null ? null : await Api.WatchOrderAsync(Id);
        }
        catch { orders = null; order = null; }   // signed out, or TMDB has no orders: the page works without
    }

    private async Task SetOrder(string? id)
    {
        busy = true;
        try
        {
            await Api.SetWatchOrderAsync(Id, id);
            Toasts.Show(id is null ? "Back to TMDB's seasons for the whole show" : $"Watching the whole show in {orders?.Options.FirstOrDefault(o => o.Id == id)?.Name ?? "that order"}");
            await LoadOrder();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }
    private bool askWhen;
    private static int? ScopeFor(EpisodeDto? e) => e is { SeasonNumber: > 1, EpisodeNumber: > 1 } ? e.SeasonNumber : null;

    private int Aired => season?.Episodes.Count(e => e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today)) ?? 0;
    private int Watched => season?.Episodes.Count(Done) ?? 0;
    private bool Rewatching => season?.Rewatch is not null;
    /// <summary>Watched at all, or during a rewatch, watched again since it started.</summary>
    private bool Done(EpisodeDto e) => Rewatching ? e.Rewatched : e.Plays > 0;

    protected override Task OnParametersSetAsync() => Load();

    /// <summary>Opening a season you're partway through goes straight to the next episode, once per visit.</summary>
    private (int, int)? scrolledFor;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (season is null || scrolledFor == (Id, Number)) return;
        scrolledFor = (Id, Number);
        var aired = season.Episodes.Where(e => e.AirDate is { } d && d <= DateOnly.FromDateTime(DateTime.Today)).ToList();
        if (Watched == 0 || aired.All(Done) || Ordered.FirstOrDefault(e => !Done(e)) is not { } next || next == Ordered.First()) return;
        try { await Js.InvokeVoidAsync("seenit.scrollToFirst", ".episodes .episode:not(.watched)"); } catch (JSException) { }
    }

    private async Task Load()
    {
        error = null;
        notFound = false;
        if (season is not null && (season.ShowTmdbId != Id || season.SeasonNumber != Number)) season = null;
        try { season = await Api.SeasonAsync(Id, Number); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { error = $"This show has no season {Number}."; notFound = true; }
        catch (Exception ex) { error = ex.Message; }
        if (season is not null && Session.Me is not null && ordersFor != Id) { ordersFor = Id; await LoadOrder(); }
    }

    private async Task Act(Func<Task> action, string? done = null)
    {
        busy = true;
        try
        {
            await action();
            if (done is not null) Toasts.Show(done, undo: TakeUndo());
            season = await Api.SeasonAsync(Id, Number);
            if (order is not null) await LoadOrder();   // its watched marks and up-next moved too
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }

    private Task Watch(WatchChoice c)
    {
        if (pending is not { } e) return Task.CompletedTask;
        pending = null;
        if (c.Through)
            return Act(async () => ThroughToast(await Api.WatchThroughAsync(Id, new WatchThroughRequest(e.SeasonNumber, e.EpisodeNumber, c.When, c.At,
                InOrder: order is not null && Place(e) is not null, SeasonOnly: c.SeasonOnly)), c));
        return Act(async () => undo = Api.UndoFor(await Api.WatchAsync(Fmt.Watch(MediaType.Episode, Id, c, e.SeasonNumber, e.EpisodeNumber)), MediaType.Show, Id), $"Watched {Fmt.Ep(e.SeasonNumber, e.EpisodeNumber)}{Fmt.When(c)}");
    }
    private Task Unwatch(EpisodeDto e) => Act(async () =>
    {
        var removed = await Api.UnwatchAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Removed from history");
    private Task WatchSeason(WatchChoice c) => c.Through
        ? Act(async () => ThroughToast(await Api.WatchThroughAsync(Id, new WatchThroughRequest(Number, null, c.When, c.At)), c))
        : Act(async () => undo = Api.UndoFor(await Api.BulkWatchAsync(new BulkWatchRequest(Id, Number, c.At, When: c.When)), MediaType.Show, Id), $"Marked {season!.Name} watched{Fmt.When(c)}");
    private async Task UnwatchSeason()
    {
        if (!await Confirmer.AskAsync($"Unwatch {season!.Name}?", $"This removes every play of its episodes from your history ({Watched} episode{(Watched == 1 ? "" : "s")}). Ratings stay. You can undo it straight after.", "Unwatch season", danger: true)) return;
        await UnwatchSeasonNow();
    }

    private Task UnwatchSeasonNow() => Act(async () =>
    {
        var removed = await Api.UnwatchAsync(MediaType.Episode, Id, Number);
        undo = () => Api.RestorePlaysAsync(removed.Plays);
    }, "Season removed from history");
    private Task Rate(EpisodeDto e, double? v) => v is { } r
        ? Act(async () => undo = await Rerate(e.Rating, x => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, x, e.SeasonNumber, e.EpisodeNumber)), () => Api.UnrateAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber), r), $"Rated {Fmt.Rating(r)}")
        : Act(async () =>
        {
            var old = e.Rating;
            await Api.UnrateAsync(MediaType.Episode, Id, e.SeasonNumber, e.EpisodeNumber);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Episode, Id, o, e.SeasonNumber, e.EpisodeNumber));
        }, "Rating removed");

    private Task RateSeason(double? v) => v is { } r
        ? Act(async () => undo = await Rerate(season!.Rating, x => Api.RateAsync(new RatingRequest(MediaType.Show, Id, x, Number)), () => Api.UnrateAsync(MediaType.Show, Id, Number), r), $"Rated {season!.Name} {Fmt.Rating(r)}")
        : Act(async () =>
        {
            var old = season!.Rating;
            await Api.UnrateAsync(MediaType.Show, Id, Number);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Show, Id, o, Number));
        }, "Rating removed");

    /// <summary>The toast after "up to here": how many were marked, with Undo.</summary>
    private void ThroughToast(WatchedResult r, WatchChoice c)
    {
        undo = Api.UndoFor(r, MediaType.Show, Id);
        Toasts.Show(Fmt.Through(r.Added, c), undo: TakeUndo());
    }

    /// <summary>Saves a rating and returns its Undo: back to the rating it had, or to none.</summary>
    private static async Task<Func<Task>> Rerate(double? old, Func<double, Task> rate, Func<Task> unrate, double value)
    {
        await rate(value);
        return old is { } o ? () => rate(o) : unrate;
    }

    // Set by an action that can be undone; the toast it shows gets an Undo button.
    private Func<Task>? undo;
    private Func<Task>? TakeUndo()
    {
        if (undo is not { } u) return null;
        undo = null;
        return async () => { await u(); await InvokeAsync(async () => { await Load(); StateHasChanged(); }); };
    }

}
