@page "/goals"
@page "/goals/{Year:int}"
@attribute [Authorize]
@inject ApiClient Api
@inject Toasts Toasts
@inject SessionState Session
<PageTitle>Goals · SeenIt</PageTitle>

<div class="page-head">
    <div>
        <h1>Goals</h1>
        <p class="muted small">Yearly targets, counted the way your year in review counts them.</p>
    </div>
    <div class="inline">
        <a class="icon-btn" href="@($"goals/{ShownYear - 1}")" aria-label="Previous year"><Icon Name="chevron-left" Size="18" /></a>
        <b>@ShownYear</b>
        <a class="icon-btn" href="@($"goals/{ShownYear + 1}")" aria-label="Next year"><Icon Name="chevron-right" Size="18" /></a>
    </div>
</div>

<ErrorBox Message="@error" OnRetry="Load" />
@if (goals is null && error is null) { <Spinner /> }
else if (goals is not null)
{
    @if (goals.Count == 0)
    {
        <Empty Title="@($"No goals for {ShownYear} yet.")">Set one below, like 100 movies or 500 hours.</Empty>
    }
    <div class="goal-grid">
        @foreach (var g in goals)
        {
            <GoalCard Goal="g" OnEdit="() => Edit(g)" OnDelete="() => Delete(g)" @key="g.Id" />
        }
    </div>

    <section class="panel goal-form">
        <h2>@(editing is null ? "Add a goal" : $"Change your {GoalKinds.Label(editing.Kind).ToLowerInvariant()} goal")</h2>
        <div class="inline">
            @if (editing is null)
            {
                <select @bind="kind" aria-label="Kind of goal">
                    @foreach (var k in Enum.GetValues<GoalKind>().Where(k => goals.All(g => g.Kind != k)))
                    {
                        <option value="@k">@GoalKinds.Label(k)</option>
                    }
                </select>
            }
            <input type="number" min="1" max="100000" inputmode="numeric" @bind="target" aria-label="Target" class="goal-target" />
            <span class="muted">@GoalKinds.Unit(editing?.Kind ?? kind, target) in @ShownYear</span>
            <button class="btn btn-primary btn-sm" disabled="@(busy || target < 1 || (editing is null && goals.Any(g => g.Kind == kind)))" @onclick="Save">Save</button>
            @if (editing is not null) { <button class="btn btn-sm btn-ghost" @onclick="Cancel">Cancel</button> }
        </div>
        <p class="muted small">@GoalKinds.Hint(editing?.Kind ?? kind)@(Suggestion is { } s ? $" Last year you got {s}." : "")</p>
    </section>
}

@* Yearly challenges: optional, taken on from the list below and ticked off by themselves from what you watch. *@
<section class="row-section challenges">
    <div class="section-head"><h2>Challenges <span class="muted small">@ShownYear</span></h2></div>
    @if (challenges is null) { <Spinner /> }
    else
    {
        var chosen = Fmt.Prefs.Challenges ?? [];
        var mine = challenges.Where(c => chosen.Contains(c.Key)).ToList();
        @if (mine.Count == 0) { <p class="muted small">Take one on below: they fill in from what you watch, no logging needed.</p> }
        <div class="challenge-grid">
            @foreach (var c in mine)
            {
                var done = c.Count >= c.Target;
                <div class="panel challenge @(done ? "done" : "")" @key="c.Key">
                    <div class="inline spread">
                        <b>@(done ? "✓ " : "")@c.Title</b>
                        <button class="icon-btn" @onclick="() => SetChallenge(c.Key, false)" aria-label="@($"Drop {c.Title}")" title="Drop this challenge"><Icon Name="x" Size="14" /></button>
                    </div>
                    <span class="muted small">@c.Description</span>
                    <div class="inline"><ProgressBar Value="Math.Min(c.Count, c.Target)" Max="c.Target" /><span class="small nowrap">@Math.Min(c.Count, c.Target)/@c.Target</span></div>
                    <div class="chips challenge-slots">
                        @foreach (var s in c.Slots)
                        {
                            @if (s.Item is { } m)
                            {
                                <a class="chip on" href="@Fmt.Href(m.Type, m.TmdbId)" title="@m.Title">@(s.Label == m.Title ? m.Title : $"{s.Label} · {m.Title}")</a>
                            }
                            else { <span class="chip muted">@s.Label</span> }
                        }
                    </div>
                </div>
            }
        </div>
        var rest = challenges.Where(c => !chosen.Contains(c.Key)).ToList();
        @if (rest.Count > 0)
        {
            <label class="sort-pick">
                <span class="muted small">Take on a challenge</span>
                <select value="" @onchange="e => { if (e.Value as string is { Length: > 0 } k) _ = SetChallenge(k, true); }">
                    <option value="">Pick one…</option>
                    @foreach (var c in rest) { <option value="@c.Key">@c.Title: @c.Description (@Math.Min(c.Count, c.Target)/@c.Target so far)</option> }
                </select>
            </label>
        }
    }
</section>

@code {
    [Parameter] public int? Year { get; set; }
    private int ShownYear => Year ?? DateTime.Today.Year;
    private List<GoalDto>? goals, lastYear;
    private List<ChallengeDto>? challenges;
    private string? error;
    private GoalDto? editing;
    private GoalKind kind = GoalKind.Movies;
    private int target = 100;
    private bool busy;

    protected override Task OnParametersSetAsync() => Load();

    private async Task SetChallenge(string key, bool on)
    {
        var keys = (Fmt.Prefs.Challenges ?? []).Where(k => k != key).ToList();
        if (on) keys.Add(key);
        await PagePrefs.SetChallengesAsync(Session, Api, keys);
        StateHasChanged();
    }

    private async Task Load()
    {
        error = null;
        editing = null;
        try
        {
            goals = await Api.GoalsAsync(ShownYear);
            try { lastYear = await Api.GoalsAsync(ShownYear - 1); } catch { lastYear = null; }
            kind = Enum.GetValues<GoalKind>().FirstOrDefault(k => goals.All(g => g.Kind != k));
        }
        catch (Exception ex) { error = ex.Message; }
        try { challenges = await Api.ChallengesAsync(ShownYear); } catch { challenges = []; }
    }

    private string? Suggestion =>
        lastYear?.FirstOrDefault(g => g.Kind == (editing?.Kind ?? kind)) is { } g
            ? $"{(g.Current % 1 == 0 ? g.Current.ToString("N0") : g.Current.ToString("N1"))} {GoalKinds.Unit(g.Kind, g.Current)}"
            : null;

    private void Edit(GoalDto g) { editing = g; target = g.Target; }
    private void Cancel() { editing = null; target = 100; }

    private async Task Save()
    {
        busy = true;
        try
        {
            await Api.SetGoalAsync(new GoalRequest(ShownYear, editing?.Kind ?? kind, target));
            Toasts.Show("Goal saved");
            await Load();
            target = 100;
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private async Task Delete(GoalDto g)
    {
        try
        {
            await Api.DeleteGoalAsync(g.Id);
            goals?.Remove(g);
            Toasts.Show("Goal deleted", undo: async () => { await Api.SetGoalAsync(new GoalRequest(g.Year, g.Kind, g.Target)); await Load(); });
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
