@page "/show/{Id:int}"
@inject ApiClient Api
@inject Toasts Toasts
<PageTitle>@(s?.Name ?? "Show") · SeenIt</PageTitle>

<ErrorBox Message="@error" OnRetry="Load" />
@if (s is null && error is null) { <Spinner /> }
else if (s is not null)
{
    <MediaHero Title="@s.Name" Year="s.FirstAirDate?.Year" Tagline="@s.Tagline" Poster="@s.PosterPath" Backdrop="@s.BackdropPath" Score="s.VoteAverage" Votes="s.VoteCount" ScoresFor="(MediaType.Show, Id)">
        <Facts>
            @if (s.Networks.Count > 0) { <span>@string.Join(", ", s.Networks)</span> }
            @if (s.Genres.Count > 0) { <span>@string.Join(", ", s.Genres)</span> }
            @if (s.Status is not null) { <span class="pill">@s.Status</span> }
        </Facts>
        <Actions>
            @if (s.User is { } u)
            {
                <button class="btn @(s.Progress?.Completed == true ? "btn-watched" : "btn-primary")" disabled="@busy" @onclick="() => watchAllOpen = true">
                    <Icon Name="check" Size="18" /> @(s.Progress?.Completed == true ? "All caught up" : "Mark all watched")
                </button>
                <button class="btn @(u.InWatchlist ? "btn-on" : "")" disabled="@busy" @onclick="ToggleWatchlist">
                    <Icon Name="bookmark" Size="18" /> @(u.InWatchlist ? "On watchlist" : "Watchlist")
                </button>
                <button class="btn @(u.IsFavorite ? "btn-on fav-on" : "")" disabled="@busy" @onclick="ToggleFavorite" aria-pressed="@u.IsFavorite">
                    <Icon Name="heart" Size="18" Class="@(u.IsFavorite ? "filled" : null)" /> Favorite
                </button>
                <button class="btn" @onclick="() => listOpen = true"><Icon Name="list" Size="18" /> Lists</button>
            }
            else
            {
                <a class="btn btn-primary" href="@($"login?returnUrl=show/{Id}")">Sign in to track</a>
            }
        </Actions>
    </MediaHero>

    <div class="detail-body">
        <div class="detail-main">
            <DetailStats Items="@([
                ("Seasons", s.Seasons.Count(x => x.SeasonNumber > 0).ToString()),
                ("Episodes", s.AiredEpisodes > 0 && s.AiredEpisodes < s.NumberOfEpisodes ? $"{s.AiredEpisodes} aired of {s.NumberOfEpisodes}" : s.NumberOfEpisodes.ToString()),
                ("Total runtime", s.TotalRuntime > 0 ? Fmt.Duration(s.TotalRuntime) : null),
                ("Per episode", s.EpisodeRuntime is > 0 ? "~" + Fmt.Runtime(s.EpisodeRuntime) : null),
                ("You've watched", s.WatchedMinutes > 0 ? Fmt.Duration(s.WatchedMinutes) : null),
                ("Left to watch", s.User is not null && s.WatchedMinutes > 0 ? Fmt.Duration(s.RemainingMinutes) : null),
                ("Aired", s.FirstAirDate is { } fa ? $"{fa.Year}–{(s.Status is "Ended" or "Canceled" ? s.LastAirDate?.Year.ToString() : "")}" : null),
            ])" />
            @if (s.User is { } u)
            {
                <div class="panel rate-panel">
                    <span>Your rating</span>
                    <RatingPicker Value="u.Rating" ValueChanged="Rate" />
                </div>
            }
            @* Nothing to pause or drop once an ended show is finished (unless it's mid-rewatch, or already paused/dropped and needs undoing). *@
            @if (s.User is not null && (s.Progress is not null || s.TrackStatus != ShowTrackStatus.Watching)
                 && !(s.Status is "Ended" or "Canceled" && s.Progress is { Completed: true, Rewatch: null } && s.TrackStatus == ShowTrackStatus.Watching))
            {
                <div class="panel status-panel">
                    <span>Status</span>
                    <div class="segmented">
                        @foreach (var (st, label) in StatusLabels)
                        {
                            <button class="@(s.TrackStatus == st ? "on" : "")" disabled="@busy" @onclick="() => SetStatus(st)">@label</button>
                        }
                    </div>
                    <span class="muted small">@StatusHint(s.TrackStatus)</span>
                </div>
            }
            @if (s.User is not null && orders is { Options.Count: > 0 } wo)
            {
                <div class="panel order-panel">
                    <label for="watch-order">Watch order</label>
                    <select id="watch-order" value="@(wo.SelectedId ?? "")" disabled="@busy" @onchange="SetOrder">
                        <option value="">TMDB's seasons</option>
                        @foreach (var o in wo.Options) { <option value="@o.Id" @key="o.Id">@o.Name (@o.Episodes)</option> }
                    </select>
                    <span class="muted small">@(wo.SelectedId is null ? "Watching chronologically or in story order? Pick it and Up next follows it." : "Up next, progress and next/previous follow this order. The episode list is below.")</span>
                </div>
            }
            @if (s.Progress is { } p)
            {
                <div class="panel progress-panel">
                    @if (p.Rewatch is { } rw)
                    {
                        <div class="inline spread rewatch-head">
                            <span class="pill rewatch-pill"><Icon Name="repeat" Size="14" /> @RewatchLabel(rw)</span>
                            <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="StopRewatch">Stop rewatch</button>
                        </div>
                    }
                    <div class="inline spread">
                        <b>@p.Watched of @p.Aired episodes @(p.Rewatch is null ? "watched" : "rewatched")</b>
                        <span class="muted small">@(p.Aired == 0 ? 0 : 100 * p.Watched / p.Aired)%</span>
                    </div>
                    <ProgressBar Value="p.Watched" Max="p.Aired" />
                    @if (p.Rewatch is null && (p.Completed || p.RewatchesCompleted > 0))
                    {
                        <div class="inline spread next-ep">
                            <span class="muted small">@(p.RewatchesCompleted > 0 ? $"You've been through it {p.RewatchesCompleted + 1} times." : "")</span>
                            <button class="btn btn-sm" disabled="@busy" @onclick="StartRewatch"><Icon Name="repeat" Size="14" /> Start a rewatch</button>
                        </div>
                    }
                    @if (p.NextEpisode is { } n)
                    {
                        <div class="inline spread next-ep">
                            <span>Next@(p.WatchOrder is { } won ? $" ({won})" : ""): <a href="@Fmt.EpisodeHref(Id, n.SeasonNumber, n.EpisodeNumber)"><b>@(n.SeasonNumber == 0 ? $"Special {n.EpisodeNumber}" : Fmt.Ep(n.SeasonNumber, n.EpisodeNumber))</b> <Spoiler>@n.Name</Spoiler></a></span>
                            <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => pendingEpisode = n"><Icon Name="check" Size="14" /> Watched</button>
                        </div>
                    }
                </div>
            }
            @if (s.User is not null) { <FriendsSeen Type="MediaType.Show" TmdbId="Id" Total="s.AiredEpisodes" /> }
            @if (s.NextEpisodeToAir is { } next)
            {
                <p class="muted">Next episode: <a href="@Fmt.EpisodeHref(Id, next.SeasonNumber, next.EpisodeNumber)"><b>@Fmt.Ep(next.SeasonNumber, next.EpisodeNumber)</b> <Spoiler>@next.Name</Spoiler></a> @if (next.AirDate is { } ad) { <span>· @Fmt.Day(ad)</span> }</p>
            }
            <WhereToWatch Type="MediaType.Show" TmdbId="Id" />
            @if (s.Overview is not null) { <p class="overview">@s.Overview</p> }
            <div class="links">
                <a href="@($"https://www.themoviedb.org/tv/{s.TmdbId}")" target="_blank" rel="noopener">TMDB</a>
                @if (s.User is { } mine && (mine.Plays > 0 || mine.Rating is not null || mine.InWatchlist || mine.ListIds.Count > 0))
                {
                    <button class="link-btn" @onclick="() => fixOpen = true">Wrong title?</button>
                }
            </div>
        </div>
    </div>

    @if (order is not null) { <WatchOrderList ShowId="Id" Order="order" OnChanged="Load" /> }

    <section class="row-section">
        <div class="section-head"><h2>Seasons</h2>@if (order is not null) { <span class="muted small">as TMDB numbers them</span> }</div>
        <div class="season-grid">
            @foreach (var season in s.Seasons)
            {
                <div class="season-cell" @key="season.SeasonNumber">
                <a class="season-card" href="@($"show/{Id}/season/{season.SeasonNumber}")">
                    <div class="poster">
                        @if (Img.Poster(season.PosterPath ?? s.PosterPath) is { } src) { <img src="@src" alt="" loading="lazy" /> }
                        @if (season.EpisodeCount > 0 && season.Watched >= season.EpisodeCount) { <span class="poster-badge done"><Icon Name="check" Size="14" /></span> }
                    </div>
                    <div class="poster-title">@season.Name</div>
                    <div class="poster-sub">@season.EpisodeCount episode@(season.EpisodeCount == 1 ? "" : "s") @if (season.Watched > 0 && season.CompletedAt is null) { <span>· @season.Watched watched</span> }</div>
                    @if (season.CompletedAt is { } done) { <div class="poster-sub ok">Finished @done.ToLocalTime().ToString("MMM d, yyyy")</div> }
                    @if (s.User is not null && season.EpisodeCount > 0) { <ProgressBar Value="season.Watched" Max="season.EpisodeCount" /> }
                </a>
                @if (s.User is not null && season.Watched < season.EpisodeCount && season.AirDate is { } sad && sad <= DateOnly.FromDateTime(DateTime.Today))
                {
                    <div class="season-mark">
                        <button class="btn btn-sm" disabled="@busy" @onclick="() => { seasonThrough = false; pendingSeason = season; }" title="Mark this season watched" aria-label="@($"Mark {season.Name} watched")"><Icon Name="check" Size="14" /></button>
                        @if (season.SeasonNumber > 1) { <button class="btn btn-sm btn-ghost" disabled="@busy" @onclick="() => { seasonThrough = true; pendingSeason = season; }" title="Mark this season and every earlier one watched">Up to here</button> }
                    </div>
                }
                </div>
            }
        </div>
    </section>

    <CastRow Cast="s.Cast" />
    <Trailers Videos="s.Videos" />
    <PosterRow Title="You might also like" Items="s.Recommendations" EmptyText="No recommendations yet." />

    @if (s.User is { } user)
    {
        <WatchDialog @bind-Open="watchAllOpen" What="every aired episode" Bulk="true" OnPick="WatchAll" />
        <WatchDialog Open="pendingEpisode is not null" OpenChanged="o => { if (!o) pendingEpisode = null; }"
                     What="@(pendingEpisode is { } pe ? Fmt.Ep(pe.SeasonNumber, pe.EpisodeNumber) : "")" ReleaseDate="pendingEpisode?.AirDate" OnPick="WatchEpisode" />
        <WatchDialog Open="pendingSeason is not null" OpenChanged="o => { if (!o) pendingSeason = null; }" What="@(pendingSeason?.Name ?? "")" Bulk="true" OnPick="WatchSeason"
                     Through="seasonThrough" ThroughNote=" in the earlier seasons" />
        <AddToListDialog @bind-Open="listOpen" Type="MediaType.Show" TmdbId="s.TmdbId" Selected="user.ListIds.ToList()" />
        <FixMatchDialog @bind-Open="fixOpen" Type="MediaType.Show" TmdbId="s.TmdbId" Title="@s.Name" />
    }
}

@code {
    private static readonly (ShowTrackStatus, string)[] StatusLabels =
        [(ShowTrackStatus.Watching, "Watching"), (ShowTrackStatus.Paused, "Paused"), (ShowTrackStatus.Dropped, "Dropped")];

    private static string StatusHint(ShowTrackStatus st) => st switch
    {
        ShowTrackStatus.Paused => "Hidden from Up next until you watch another episode.",
        ShowTrackStatus.Dropped => "Hidden from Up next and the calendar.",
        _ => "",
    };

    public static string RewatchLabel(int number) => number == 2 ? "Rewatching" : $"Rewatch #{number - 1}";

    private async Task StartRewatch()
    {
        busy = true;
        try
        {
            await Api.StartRewatchAsync(Id);
            Toasts.Show($"Rewatching {s?.Name}. Up next starts from the first episode.");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private async Task StopRewatch()
    {
        busy = true;
        try
        {
            await Api.StopRewatchAsync(Id);
            Toasts.Show("Rewatch stopped. Its plays stay in your history.");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private async Task SetStatus(ShowTrackStatus st)
    {
        if (s is null || s.TrackStatus == st) return;
        busy = true;
        try
        {
            await Api.SetShowStatusAsync(Id, st);
            s = s with { TrackStatus = st };
            Toasts.Show(st switch { ShowTrackStatus.Paused => $"Paused {s.Name}", ShowTrackStatus.Dropped => $"Dropped {s.Name}", _ => $"Watching {s.Name} again" });
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    [Parameter] public int Id { get; set; }
    private ShowDetail? s;
    private string? error;
    private bool busy, watchAllOpen, listOpen, fixOpen;
    private EpisodeRef? pendingEpisode;
    private SeasonSummary? pendingSeason;
    private bool seasonThrough;
    private WatchOrdersDto? orders;
    private WatchOrderDto? order;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        error = null;
        if (s?.TmdbId != Id) { s = null; orders = null; order = null; }
        try { s = await Api.ShowAsync(Id); }
        catch (Exception ex) { error = ex.Message; }
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        if (s?.User is null) return;
        try
        {
            orders ??= await Api.WatchOrdersAsync(Id);
            order = orders.SelectedId is null ? null : await Api.WatchOrderAsync(Id);
        }
        catch { orders ??= new WatchOrdersDto([], null); }
    }

    private async Task SetOrder(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() is { Length: > 0 } v ? v : null;
        busy = true;
        try
        {
            await Api.SetWatchOrderAsync(Id, id);
            orders = orders! with { SelectedId = id };
            Toasts.Show(id is null ? "Back to TMDB's seasons" : $"Watching in {orders.Options.First(o => o.Id == id).Name}");
            s = await Api.ShowAsync(Id);
            await LoadOrder();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { busy = false; }
    }

    private async Task Act(Func<Task> action, string? done = null)
    {
        busy = true;
        try
        {
            await action();
            if (done is not null) Toasts.Show(done, undo: TakeUndo());
            s = await Api.ShowAsync(Id);
            if (orders?.SelectedId is not null) await LoadOrder();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }

    private Task WatchAll(WatchChoice c) =>
        Act(() => Api.BulkWatchAsync(new BulkWatchRequest(Id, null, c.At, When: c.When)), $"Marked all aired episodes watched{Fmt.When(c)}");

    private Task WatchSeason(WatchChoice c)
    {
        if (pendingSeason is not { } season) return Task.CompletedTask;
        pendingSeason = null;
        return c.Through
            ? Act(async () => Toasts.Show(Fmt.Through(await Api.WatchThroughAsync(Id, new WatchThroughRequest(season.SeasonNumber, null, c.When, c.At)), c)))
            : Act(() => Api.BulkWatchAsync(new BulkWatchRequest(Id, season.SeasonNumber, c.At, When: c.When)), $"Marked {season.Name} watched{Fmt.When(c)}");
    }

    private Task WatchEpisode(WatchChoice c)
    {
        if (pendingEpisode is not { } n) return Task.CompletedTask;
        pendingEpisode = null;
        return Act(() => Api.WatchAsync(Fmt.Watch(MediaType.Episode, Id, c, n.SeasonNumber, n.EpisodeNumber)), $"Watched {Fmt.Ep(n.SeasonNumber, n.EpisodeNumber)}{Fmt.When(c)}");
    }

    private Task ToggleFavorite() => s!.User!.IsFavorite
        ? Act(async () =>
        {
            await Api.RemoveFavoriteAsync(MediaType.Show, Id);
            undo = () => Api.AddFavoriteAsync(MediaType.Show, Id);
        }, "Removed from favorites")
        : Act(() => Api.AddFavoriteAsync(MediaType.Show, Id), "Added to favorites");

    private Task ToggleWatchlist() => s!.User!.InWatchlist
        ? Act(async () =>
        {
            await Api.RemoveFromWatchlistAsync(MediaType.Show, Id);
            undo = () => Api.AddToWatchlistAsync(MediaType.Show, Id);
        }, "Removed from watchlist")
        : Act(() => Api.AddToWatchlistAsync(MediaType.Show, Id), "Added to watchlist");

    private Task Rate(int? value) => value is { } v
        ? Act(() => Api.RateAsync(new RatingRequest(MediaType.Show, Id, v)), $"Rated {Fmt.Rating(v)}")
        : Act(async () =>
        {
            var old = s!.User!.Rating;
            await Api.UnrateAsync(MediaType.Show, Id);
            if (old is { } o) undo = () => Api.RateAsync(new RatingRequest(MediaType.Show, Id, o));
        }, "Rating removed");

    // Set by an action that can be undone; the toast it shows gets an Undo button.
    private Func<Task>? undo;
    private Func<Task>? TakeUndo()
    {
        if (undo is not { } u) return null;
        undo = null;
        return async () => { await u(); await InvokeAsync(async () => { await Load(); StateHasChanged(); }); };
    }

}
