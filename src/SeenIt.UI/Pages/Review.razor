@page "/review/{Year:int}"
@page "/review/{Year:int}/{Month:int}"
@page "/u/{UserName}/review/{Year:int}"
@page "/u/{UserName}/review/{Year:int}/{Month:int}"
@* No [Authorize]: someone's shared review follows their Stats privacy; your own needs signing in. *@
@inject ApiClient Api
@inject NavigationManager Nav
@inject SessionState Session
@inject IJSRuntime Js
<PageTitle>@(Other is { } on ? $"{on}'s " : "")@(r?.Label ?? "Review") in review · SeenIt</PageTitle>
@if (Other is { } owner) { <nav class="crumbs"><a href="@Fmt.UserHref(owner)"><Icon Name="chevron-left" Size="16" /> @owner</a></nav> }

<div class="review-head">
    <button class="icon-btn" @onclick="() => Go(-1)" disabled="@AtTrackingStart" aria-label="Previous @(Month is null ? "year" : "month")"><Icon Name="chevron-left" /></button>
    <div class="review-title">
        <span class="review-kicker">@(Other is { } ok ? $"{ok}'s " : "")@(Month is null ? "year" : "month") in review</span>
        <h1>@Label</h1>
    </div>
    <button class="icon-btn" @onclick="() => Go(1)" disabled="@IsCurrentOrFuture" aria-label="Next @(Month is null ? "year" : "month")"><Icon Name="chevron-right" /></button>
</div>
<div class="chips center-chips">
    @if (Month is not null) { <a class="chip" href="@($"{ReviewBase}/{Year}{Keep}")">See all of @Year</a> }
    else if (periods?.FirstOrDefault(p => p.Year == Year) is { } py)
    {
        @foreach (var m in py.Months)
        {
            <a class="chip" href="@($"{ReviewBase}/{Year}/{m.Month}{Keep}")" @key="m.Month">@(new DateTime(Year, m.Month, 1).ToString("MMM"))</a>
        }
    }
    <a class="chip" href="@($"{StatsBase}{(MediaFilter.Key(Kind) is { } sk ? $"?type={sk}" : "")}")">All-time stats</a>
    @if (Mine && r is { Totals.Plays: > 0 }) { <button class="chip" @onclick="OpenShare"><Icon Name="share" Size="14" /> Share image</button> }
</div>
@* The whole page from everything, from first-time watches of movies and episodes (a show started earlier still
   counts for its new episodes), or from just the movies and shows first watched in this period. *@
<div class="center review-new">
    <MediaFilterSwitch Value="Kind" />
    <select class="fit-select" aria-label="What to count" value="@Mode" @onchange="e => SetMode(e.Value as string)">
        <option value="@ReviewNew.All">@(Mine ? "Everything I watched" : "Everything watched")</option>
        <option value="@ReviewNew.Firsts">First watches (no rewatches)</option>
        <option value="@ReviewNew.Titles">@(Mine ? "Only titles new to me" : "Only titles new to them")</option>
    </select>
    @if (Mode != ReviewNew.All)
    {
        <span class="muted small">@(Mode == ReviewNew.Firsts ? "Movies and episodes I saw for the first time" : $"Movies and shows I first watched in {Label}")</span>
    }
</div>
<ShareCardDialog @bind-Open="shareOpen" Title="@($"{Label} in review")" FileName="@($"seenit-{Year}{(Month is { } sm ? $"-{sm:00}" : "")}.png")"
                 Load="() => Api.ReviewCardAsync(Year, Month, card)" Version="@CardVersion">
    <Options>
        <div class="card-options">
            <h4>Numbers <span class="muted small">up to 4, in the order you pick them</span></h4>
            <div class="chips">
                @foreach (var (key, label) in ReviewCardChoices.Tiles)
                {
                    var on = card.TileKeys().Contains(key);
                    <button class="chip @(on ? "on" : "")" aria-pressed="@on" disabled="@(!on && card.TileKeys().Count >= 4)" @onclick="() => ToggleCard(key, true)" @key="key">
                        @if (on) { <b>@(card.TileKeys().ToList().IndexOf(key) + 1)</b> } @label
                    </button>
                }
            </div>
            <div class="pref-rows">
                <span>Top shows</span>
                <select value="@card.Shows" @onchange="e => SetCard(o => o.Shows = int.Parse(e.Value!.ToString()!))">@for (var i = 0; i <= 5; i++) { <option value="@i">@(i == 0 ? "None" : i)</option> }</select>
                <span>Top movies</span>
                <select value="@card.Movies" @onchange="e => SetCard(o => o.Movies = int.Parse(e.Value!.ToString()!))">@for (var i = 0; i <= 5; i++) { <option value="@i">@(i == 0 ? "None" : i)</option> }</select>
                <span>Colors</span>
                <span class="inline">
                    <select value="@(card.Theme ?? "")" @onchange='e => SetCard(o => o.Theme = e.Value?.ToString() is { Length: > 0 } t ? t : null)' aria-label="Theme">
                        <option value="">My theme</option>
                        @foreach (var t in UiPrefs.Themes) { <option value="@t.Key">@t.Name</option> }
                    </select>
                    <select value="@(card.Accent ?? "")" @onchange='e => SetCard(o => o.Accent = e.Value?.ToString() is { Length: > 0 } a ? a : null)' aria-label="Accent color">
                        <option value="">Theme's accent</option>
                        @foreach (var a in UiPrefs.Accents) { <option value="@a.Key">@a.Name</option> }
                    </select>
                </span>
            </div>
            <label class="check small"><input type="checkbox" checked="@card.Ratings" @onchange="e => SetCard(o => o.Ratings = e.Value is true)" /> My ratings under the posters</label>
            <label class="check small"><input type="checkbox" checked="@card.Name" @onchange="e => SetCard(o => o.Name = e.Value is true)" /> My @@username at the top</label>
            <label class="small">Count
                <select class="fit-select" value="@card.New" @onchange="e => SetCard(o => o.New = Enum.TryParse<ReviewNew>(e.Value as string, out var m) ? m : ReviewNew.All)">
                    <option value="@ReviewNew.All">everything</option>
                    <option value="@ReviewNew.Firsts">first watches</option>
                    <option value="@ReviewNew.Titles">only titles new to me</option>
                </select>
            </label>
            <h4>Lines at the bottom <span class="muted small">as many as fit</span></h4>
            <div class="chips">
                @foreach (var (key, label) in ReviewCardChoices.Facts)
                {
                    var on = card.FactKeys().Contains(key);
                    <button class="chip @(on ? "on" : "")" aria-pressed="@on" @onclick="() => ToggleCard(key, false)" @key="key">@if (on) { <Icon Name="check" Size="12" /> }@label</button>
                }
            </div>
            <button class="btn btn-sm btn-ghost" @onclick="ResetCard">Back to the usual</button>
        </div>
    </Options>
</ShareCardDialog>

<ErrorBox Message="@error" OnRetry="Load" />
@if (r is null && error is null) { <Spinner /> }
else if (r is not null)
{
    @if (r.TrackingSince is { } since && PeriodEnd <= since)
    {
        <Empty Title="@($"Reviews start from {(since).ToString(Fmt.DateFull)}.")">
            <span>That's when you started tracking; plays before it were back-filled, so they aren't reviewed.</span>
            <a class="btn btn-sm" href="@($"{ReviewBase}/{since.Year}" + (Month is null ? "" : $"/{since.Month}"))">Go to @(Month is null ? since.Year.ToString() : since.ToString("MMMM yyyy"))</a>
        </Empty>
    }
    else if (r.Totals.Plays == 0)
    {
        <Empty Title="@($"Nothing watched in {r.Label}.")">
            @if (periods is { Count: > 0 }) { <span>Try another period:</span> <PeriodLinks Periods="periods" Base="@ReviewBase" /> }
        </Empty>
    }
    else
    {
        var t = r.Totals;
        var p = r.Previous;
        <section class="stat-tiles review-tiles">
            <div class="stat big"><span class="stat-value"><Dur Minutes="t.Minutes" /></span><span class="stat-label">watched <Delta Now="t.Minutes" Then="p.Minutes" /></span></div>
            <div class="stat"><span class="stat-value">@t.Plays.ToString("N0")</span><span class="stat-label">plays <Delta Now="t.Plays" Then="p.Plays" /></span></div>
            @if (Kind != MediaType.Show) {
            <div class="stat"><span class="stat-value">@t.Movies.ToString("N0")</span><span class="stat-label">movies@(t.MoviePlays > t.Movies ? $" · {t.MoviePlays} plays" : "") <Delta Now="t.Movies" Then="p.Movies" /></span></div>
            }
            @if (Kind != MediaType.Movie) {
            <div class="stat"><span class="stat-value">@t.Episodes.ToString("N0")</span><span class="stat-label">episodes of @t.Shows show@(t.Shows == 1 ? "" : "s") <Delta Now="t.Episodes" Then="p.Episodes" /></span></div>
            }
            <div class="stat"><span class="stat-value">@t.Ratings.ToString("N0")</span><span class="stat-label">ratings@(r.AverageRating is { } avg ? $" · avg {Fmt.Avg(avg)}" : "")</span></div>
        </section>
        <p class="muted small center-text">Compared with @r.PreviousLabel · times in @r.TimeZone</p>
        @if (r.TrackingSince is { } ts && PeriodStart <= ts) { <TrackingNote Center="true" /> }

        @if (goals is { Count: > 0 })
        {
            <section class="row-section">
                <div class="section-head"><h2>@Year goals</h2><div class="section-tools"><a href="@($"goals/{Year}")" class="section-more">Goals <Icon Name="chevron-right" Size="16" /></a></div></div>
                <div class="home-goals">@foreach (var g in goals) { <GoalCard Goal="g" @key="g.Id" /> }</div>
            </section>
        }

        <section class="review-facts">
            <div class="fact"><b>@r.DaysActive</b><span>of @r.DaysInPeriod days with something watched</span></div>
            <div class="fact"><b>@r.LongestStreak.Days day@(r.LongestStreak.Days == 1 ? "" : "s")</b><span>longest streak@(r.LongestStreak.Start is { } ss && r.LongestStreak.Days > 1 ? $" ({(ss).ToString(Fmt.DateShort)} – {r.LongestStreak.End?.ToString(Fmt.DateShort)})" : "")</span></div>
            @if (r.BusiestDay is { } bd) { <div class="fact"><b>@bd.Date.ToString(Fmt.DayShort)</b><span>busiest day: <Dur Minutes="bd.Minutes" />, @bd.Plays play@(bd.Plays == 1 ? "" : "s")</span></div> }
            <div class="fact"><b>@r.AveragePlaysPerActiveDay</b><span>plays per active day</span></div>
            @if (r.FavoriteWeekday is { } fw) { <div class="fact"><b>@(fw)s</b><span>favorite day to watch</span></div> }
            @if (r.PeakHour is { } ph) { <div class="fact"><b>@HourLabel(ph)</b><span>peak viewing hour</span></div> }
            @if (Kind != MediaType.Movie)
            {
                <div class="fact"><b>@r.ShowsStarted</b><span>new show@(r.ShowsStarted == 1 ? "" : "s") started</span></div>
                <div class="fact"><b>@r.ShowsCompleted</b><span>show@(r.ShowsCompleted == 1 ? "" : "s") caught up on</span></div>
            }
            <div class="fact"><b>@r.FirstTimeWatches</b><span>first-time watches</span></div>
            <div class="fact"><b>@r.Rewatches</b><span>rewatches</span></div>
        </section>

        <section class="panel">
            <h2>@(Month is null ? "Plays by month" : "Plays by day")</h2>
            <BarChart Data="r.Timeline" Vertical="true" LabelEvery="@(Month is null ? 1 : 5)" Label="@(Month is null ? "Plays per month" : "Plays per day")" />
        </section>

        @if (r.TopShows.Count > 0)
        {
            var allShows = (r.AllShows ?? r.TopShows).Where(x => !newShows || x.New).ToList();
            var topShows = allShows.Take(10).ToList();
            <section class="row-section">
                <div class="section-head">
                    <h2>@(showAllShows ? $"All shows · {allShows.Count}" : "Top shows")</h2>
                    @if (r.New != ReviewNew.Titles) { <label class="check small review-new-filter"><input type="checkbox" checked="@newShows" @onchange="e => newShows = e.Value is true" /> New this @Period</label> }
                    @if (allShows.Count > topShows.Count)
                    {
                        <button class="section-more link-btn" @onclick="() => showAllShows = !showAllShows">@(showAllShows ? "Show top 10" : $"See all {allShows.Count}") <Icon Name="@(showAllShows ? "chevron-up" : "chevron-down")" Size="16" /></button>
                    }
                </div>
                <div class="@(showAllShows ? "poster-grid" : "poster-scroller")">
                    @{ var rank = 0; }
                    @if (allShows.Count == 0) { <p class="muted small">No shows new to you this @Period.</p> }
                    @foreach (var s in showAllShows ? allShows : topShows)
                    {
                        rank++;
                        <PosterCard Media="@(new MediaSummary(MediaType.Show, s.TmdbId, s.Title, null, s.PosterPath, null, null, null))"
                                    Badge="@($"#{rank}")" ShowScore="false" Sub="@($"{s.Detail} · {Fmt.Duration(s.Minutes)}")" SubTitle="@Fmt.HoursTip(s.Minutes)" @key="s.TmdbId" />
                    }
                </div>
            </section>
        }
        @if (r.TopMovies.Count > 0)
        {
            var allMovies = (r.AllMovies ?? r.TopMovies).Where(x => !newMovies || x.New).ToList();
            var topMovies = allMovies.Take(10).ToList();
            <section class="row-section">
                <div class="section-head">
                    <h2>@(showAllMovies ? $"All movies · {allMovies.Count}" : "Movies")</h2>
                    @if (r.New != ReviewNew.Titles) { <label class="check small review-new-filter"><input type="checkbox" checked="@newMovies" @onchange="e => newMovies = e.Value is true" /> New this @Period</label> }
                    @if (allMovies.Count > topMovies.Count)
                    {
                        <button class="section-more link-btn" @onclick="() => showAllMovies = !showAllMovies">@(showAllMovies ? "Show top 10" : $"See all {allMovies.Count}") <Icon Name="@(showAllMovies ? "chevron-up" : "chevron-down")" Size="16" /></button>
                    }
                </div>
                <div class="@(showAllMovies ? "poster-grid" : "poster-scroller")">
                    @if (allMovies.Count == 0) { <p class="muted small">No movies new to you this @Period.</p> }
                    @foreach (var m in showAllMovies ? allMovies : topMovies)
                    {
                        <PosterCard Media="@(new MediaSummary(MediaType.Movie, m.TmdbId, m.Title, null, m.PosterPath, null, null, null))"
                                    Badge="@(m.Rating is { } mr ? Fmt.RatingBadge(mr) : null)" ShowScore="false"
                                    Sub="@(m.Plays > 1 ? $"{m.Detail} · {m.Plays}×" : m.Detail)" @key="m.TmdbId" />
                    }
                </div>
            </section>
        }

        @if (r.TopActors.Count > 0) { <PeopleRow Title="Actors you watched most" People="r.TopActors" /> }
        @if (r.TopDirectors.Count > 0) { <PeopleRow Title="Directors & creators" People="r.TopDirectors" /> }

        <div class="stat-panels">
            @if (r.Genres.Count > 0) { <section class="panel"><h2>Genres</h2><BarChart Data="r.Genres" Label="Plays by genre" /></section> }
            @if (r.Networks.Count > 0) { <section class="panel"><h2>Networks</h2><BarChart Data="r.Networks" Label="Episodes by network" /></section> }
            <section class="panel"><h2>Day of week</h2><BarChart Data="Fmt.WeekOrder(r.Weekdays)" Vertical="true" Label="Plays by weekday" /></section>
            <section class="panel"><h2>Time of day</h2><BarChart Data="r.Hours" Vertical="true" LabelEvery="3" Label="Plays by hour" /></section>
            @if (r.Languages.Count > 0) { <section class="panel"><h2>Languages</h2><BarChart Data="r.Languages" Label="Plays by original language" /></section> }
            @if (r.Countries.Count > 0) { <section class="panel"><h2>Countries</h2><BarChart Data="r.Countries" Label="Plays by country of origin" /></section> }
            @if (r.Decades.Count > 0) { <section class="panel"><h2>Movies by decade</h2><BarChart Data="r.Decades" Vertical="true" Label="Movie plays by release decade" /></section> }
            @if (r.RatingDistribution.Any(b => b.Count > 0)) { <section class="panel"><h2>Ratings given</h2><BarChart Data="Fmt.RatingBuckets(r.RatingDistribution)" Vertical="true" Label="Ratings given by score" /></section> }
            @if (r.Sources.Count > 0) { <section class="panel"><h2>How it was tracked</h2><BarChart Data="r.Sources" Label="Plays by source" /></section> }
        </div>

        @if (r.HighestRated.Count > 0)
        {
            <section class="row-section">
                <div class="section-head"><h2>Highest rated</h2></div>
                <div class="poster-scroller">
                    @foreach (var h in r.HighestRated)
                    {
                        <PosterCard Media="@(new MediaSummary(h.Type, h.TmdbId, h.Title, null, h.PosterPath, null, null, null))" Badge="@(h.Rating is { } hr ? Fmt.RatingBadge(hr) : null)" ShowScore="false" @key="(h.Type, h.TmdbId)" />
                    }
                </div>
            </section>
        }

        <section class="row-section">
            <div class="section-head"><h2>Highlights</h2></div>
            <div class="highlights">
                @if (r.FirstPlay is { } fp) { <Highlight Label="First watch" Entry="fp" /> }
                @if (r.LastPlay is { } lp && lp.Id != r.FirstPlay?.Id) { <Highlight Label="Most recent" Entry="lp" /> }
                @if (r.MostRewatched is { } mr2) { <HighlightItem Label="Most rewatched" Item="mr2" Extra="@($"{mr2.Plays} times")" /> }
                @if (r.LongestMovie is { } lm) { <HighlightItem Label="Longest movie" Item="lm" Extra="@lm.Detail" /> }
                @if (r.OldestMovie is { } om) { <HighlightItem Label="Oldest movie" Item="om" Extra="@om.Detail" /> }
                @if (r.NewestMovie is { } nm && nm.TmdbId != r.OldestMovie?.TmdbId) { <HighlightItem Label="Newest movie" Item="nm" Extra="@nm.Detail" /> }
            </div>
        </section>
    }
}

@code {
    private bool showAllShows, showAllMovies;
    // "New this year" on the two lists, and what the whole page counts (in the address: ?new=firsts or ?new=titles;
    // ?new=1 from before the dropdown means titles).
    private bool newShows, newMovies;
    [SupplyParameterFromQuery(Name = "new")] public string? NewParam { get; set; }
    private ReviewNew Mode => NewParam?.ToLowerInvariant() switch { "firsts" => ReviewNew.Firsts, "titles" or "1" => ReviewNew.Titles, _ => ReviewNew.All };
    private static string? ModeKey(ReviewNew m) => m == ReviewNew.All ? null : m.ToString().ToLowerInvariant();
    private string Period => Month is null ? "year" : "month";
    private void SetMode(string? value) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("new", ModeKey(Enum.TryParse<ReviewNew>(value, out var m) ? m : ReviewNew.All)));
    // Just movies or just TV (?type=movie / ?type=tv).
    [SupplyParameterFromQuery(Name = "type")] public string? TypeParam { get; set; }
    private MediaType? Kind => MediaFilter.Parse(TypeParam);
    /// <summary>The filters, carried to the previous/next period and the month links.</summary>
    private string Keep => string.Join('&', new[] { MediaFilter.Key(Kind) is { } k ? $"type={k}" : null, ModeKey(Mode) is { } nk ? $"new={nk}" : null }.OfType<string>()) is { Length: > 0 } q ? "?" + q : "";

    // The share image's choices, remembered on this device.
    private const string CardKey = "seenit.reviewCard";
    private ReviewCardOptions card = new();
    private bool cardLoaded;
    private string CardVersion => System.Text.Json.JsonSerializer.Serialize(card);

    private async Task OpenShare()
    {
        if (!cardLoaded)
        {
            cardLoaded = true;
            try
            {
                if (await Js.InvokeAsync<string?>("localStorage.getItem", CardKey) is { Length: > 0 } json)
                    card = System.Text.Json.JsonSerializer.Deserialize<ReviewCardOptions>(json) ?? new();
            }
            catch { card = new(); }
        }
        card.New = Mode;   // starts the way the page is
        card.Type = MediaFilter.Key(Kind);
        shareOpen = true;
    }

    private async Task SetCard(Action<ReviewCardOptions> change)
    {
        var next = System.Text.Json.JsonSerializer.Deserialize<ReviewCardOptions>(CardVersion)!;   // a copy, so the version changes
        change(next);
        card = next;
        try { await Js.InvokeVoidAsync("localStorage.setItem", CardKey, CardVersion); } catch { }
    }

    private Task ToggleCard(string key, bool tile) => SetCard(o =>
    {
        var keys = (tile ? o.TileKeys() : o.FactKeys()).ToList();
        if (!keys.Remove(key)) keys.Add(key);
        if (tile) o.Tiles = string.Join(',', keys); else o.Facts = string.Join(',', keys);
    });

    private Task ResetCard() => SetCard(o =>
    {
        var d = new ReviewCardOptions();
        (o.Tiles, o.Shows, o.Movies, o.Ratings, o.Facts, o.Name, o.Theme, o.Accent) = (d.Tiles, d.Shows, d.Movies, d.Ratings, d.Facts, d.Name, d.Theme, d.Accent);
    });
    [Parameter] public int Year { get; set; }
    [Parameter] public int? Month { get; set; }
    private ReviewDto? r;
    private List<ReviewYear>? periods;
    private string? error;
    private bool shareOpen;
    private List<GoalDto>? goals;

    private string Label => Month is { } m ? new DateTime(Year, m, 1).ToString("MMMM yyyy") : Year.ToString();
    private DateOnly PeriodStart => new(Year, Month ?? 1, 1);
    private DateOnly PeriodEnd => Month is null ? PeriodStart.AddYears(1) : PeriodStart.AddMonths(1);
    /// <summary>Nothing to review before the "started tracking" day, so don't offer to go back past it.</summary>
    private bool AtTrackingStart => (Mine ? Session.Me?.TrackingSince : r?.TrackingSince) is { } s && PeriodStart <= s;

    /// <summary>Someone else's review (read-only), shared at u/{name}/review/….</summary>
    [Parameter] public string? UserName { get; set; }
    private string? Other => UserName is { Length: > 0 } n && !string.Equals(n, Session.Me?.UserName, StringComparison.OrdinalIgnoreCase) ? n : null;
    private bool Mine => Other is null;
    private string ReviewBase => Other is { } n ? $"u/{Uri.EscapeDataString(n)}/review" : "review";
    private string StatsBase => Other is { } n ? $"u/{Uri.EscapeDataString(n)}/stats" : "stats";
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? periodsFor = "\0";

    private bool IsCurrentOrFuture => Month is { } m
        ? new DateTime(Year, m, 1) >= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
        : Year >= DateTime.Today.Year;

    protected override async Task OnParametersSetAsync()
    {
        if (Mine && AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login?returnUrl=" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
            return;
        }
        r = null;
        showAllShows = showAllMovies = false;   // a new year or month starts collapsed
        await Load();
        if (periods is null || periodsFor != Other)
        {
            periodsFor = Other;
            try { periods = await Api.ReviewPeriodsAsync(Other); } catch { periods = []; }
        }
    }

    private async Task Load()
    {
        error = null;
        try { r = await Api.ReviewAsync(Year, Month, Mode, Kind, Other); }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && Other is not null) { error = $"{Other}'s stats are private, or there's no such member."; }
        catch (Exception ex) { error = ex.Message; }
        goals = null;
        if (Mine && Month is null) { try { goals = await Api.GoalsAsync(Year); } catch { } }
    }

    private void Go(int step)
    {
        if (Month is { } m)
        {
            var d = new DateTime(Year, m, 1).AddMonths(step);
            Nav.NavigateTo($"{ReviewBase}/{d.Year}/{d.Month}{Keep}");
        }
        else Nav.NavigateTo($"{ReviewBase}/{Year + step}{Keep}");
    }

    private static string HourLabel(int h) => Fmt.Prefs.Clock24 ? $"{h:00}:00" : new DateTime(2000, 1, 1, h, 0, 0).ToString("h tt").ToLowerInvariant();
}
