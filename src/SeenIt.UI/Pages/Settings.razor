@page "/settings"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject Toasts Toasts
@inject SessionState Session
@inject IServerConfig Server
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject ThemeService Theme
<PageTitle>Settings · SeenIt</PageTitle>

<h1>Settings</h1>
@if (Welcome)
{
    <div class="panel welcome">
        <b>Welcome to SeenIt!</b> Bring your history over from Trakt or Letterboxd below, or connect Jellyfin so everything you watch there is tracked automatically.
    </div>
}

<div class="settings">
    <nav class="settings-nav">
        <a href="settings#imports">Import</a>
        <a href="settings#tracking">Stats</a>
        <a href="settings#jellyfin">Media servers</a>
        <a href="settings#spoilers">Spoilers</a>
        <a href="settings#appearance">Appearance</a>
        <a href="settings#layout">Layout</a>
        <a href="settings#invites">Invite friends</a>
        <a href="settings#privacy">Privacy</a>
        <a href="settings#region">Where to watch</a>
        <a href="settings#export">Export</a>
        <a href="settings#profile">Profile</a>
        <a href="settings#account">Account</a>
    </nav>
    <div class="settings-body">

        <section class="panel" id="imports">
            <h2>Import</h2>
            <p class="muted small">Re-importing is safe: a play you already have (logged here, by Jellyfin or by another import, within a day of the same date) is skipped, while separate viewings are all kept. Ratings are updated; watchlist and list entries aren't doubled.</p>
            <PartsPicker @bind-Value="importParts" Label="What to import" />
            <div class="import-grid">
                <div class="import-card">
                    <h3>Trakt</h3>
                    <ol class="small">
                        <li>On trakt.tv open <b>Settings → Data</b> and export your data.</li>
                        <li>Upload the <code>.zip</code> you get (or individual <code>.json</code> files from it).</li>
                    </ol>
                    <p class="muted small">Imports watch history, ratings, watchlist, favorites and custom lists.</p>
                    <label class="btn @(uploading ? "disabled" : "")"><Icon Name="upload" Size="16" /> Upload Trakt export
                        <InputFile OnChange="e => Upload(ImportKind.Trakt, e)" accept=".zip,.json,application/zip,application/x-zip-compressed,application/json" class="visually-hidden" disabled="@uploading" />
                    </label>
                </div>
                <div class="import-card">
                    <h3>Letterboxd</h3>
                    <ol class="small">
                        <li>On letterboxd.com open <b>Settings → Data → Export your data</b>.</li>
                        <li>Upload the <code>.zip</code> as-is.</li>
                    </ol>
                    <p class="muted small">Imports your diary, watched films, ratings (★ × 2), watchlist, lists, favorite films and likes. Films are matched by title and year, or through Letterboxd's own link to TMDB. TV series logged on Letterboxd can't be imported.</p>
                    <label class="btn @(uploading ? "disabled" : "")"><Icon Name="upload" Size="16" /> Upload Letterboxd export
                        <InputFile OnChange="e => Upload(ImportKind.Letterboxd, e)" accept=".zip,.csv,application/zip,application/x-zip-compressed,text/csv,text/comma-separated-values" class="visually-hidden" disabled="@uploading" />
                    </label>
                </div>
                <div class="import-card">
                    <h3>IMDb</h3>
                    <ol class="small">
                        <li>On imdb.com open <b>Your ratings</b>, your <b>Watchlist</b> or any list, then <b>⋯ → Export</b>.</li>
                        <li>Upload the <code>.csv</code> files (one at a time, or zipped together). Keep the watchlist's file name containing “watchlist”.</li>
                    </ol>
                    <p class="muted small">Imports ratings, the watchlist and lists, matched exactly by IMDb id. Rated movies count as watched (dated when you rated them) unless you untick History.</p>
                    <label class="btn @(uploading ? "disabled" : "")"><Icon Name="upload" Size="16" /> Upload IMDb export
                        <InputFile OnChange="e => Upload(ImportKind.Imdb, e)" accept=".zip,.csv,application/zip,application/x-zip-compressed,text/csv,text/comma-separated-values" class="visually-hidden" disabled="@uploading" />
                    </label>
                </div>
                <div class="import-card">
                    <h3>TV Time</h3>
                    <ol class="small">
                        <li>Find the data export zip you downloaded from TV Time (its GDPR export).</li>
                        <li>Upload the whole <code>.zip</code>.</li>
                    </ol>
                    <p class="muted small">Imports every episode you marked watched, with its date, and shows saved “for later” as your watchlist. Shows are matched through TheTVDB ids where the export has them. TV Time's movies can't be imported.</p>
                    <label class="btn @(uploading ? "disabled" : "")"><Icon Name="upload" Size="16" /> Upload TV Time export
                        <InputFile OnChange="e => Upload(ImportKind.TvTime, e)" accept=".zip,.csv,application/zip,application/x-zip-compressed,text/csv" class="visually-hidden" disabled="@uploading" />
                    </label>
                </div>
                <div class="import-card">
                    <h3>Simkl</h3>
                    <ol class="small">
                        <li>On simkl.com open <b>Settings → Backup &amp; Export</b> and download a backup.</li>
                        <li>Upload the <code>.zip</code>, <code>.json</code> or <code>.csv</code>.</li>
                    </ol>
                    <p class="muted small">Imports movies, shows and anime (as shows), ratings and plan-to-watch. The JSON backup has every episode's date; the CSV only says how far you got, so those episodes come in without dates.</p>
                    <label class="btn @(uploading ? "disabled" : "")"><Icon Name="upload" Size="16" /> Upload Simkl backup
                        <InputFile OnChange="e => Upload(ImportKind.Simkl, e)" accept=".zip,.json,.csv,application/zip,application/x-zip-compressed,application/json,text/csv" class="visually-hidden" disabled="@uploading" />
                    </label>
                </div>
            </div>

            <MatchImportDialog JobId="matchJob" @bind-Item="matching" OnMatched="LoadImports" />

            <h3 id="letterboxd-sync">Letterboxd auto-sync</h3>
            <p class="muted small">Brings in new diary entries, ratings and likes from your public Letterboxd feed every few hours, so you can keep logging on Letterboxd. It reads the latest 50 entries, so import your full export once first for older ones. Entries you delete here aren't brought back.</p>
            @if (lb is { Username: { } lbUser })
            {
                <div class="inline">
                    <span>Syncing <a href="@($"https://letterboxd.com/{lbUser}/")" target="_blank" rel="noopener"><b>@lbUser</b></a></span>
                    <button class="btn btn-sm" disabled="@lbBusy" @onclick="SyncLetterboxdNow">Check now</button>
                    <button class="btn btn-sm btn-ghost" disabled="@lbBusy" @onclick="StopLetterboxd">Stop syncing</button>
                </div>
                <p class="small @(lb.LastFailed ? "error" : "muted")">
                    @if (lb.LastCheckedAt is { } checkedAt) { <span>Checked <RelTime At="checkedAt" />: @lb.LastResult</span> } else { <span>Not checked yet.</span> }
                    @if (lb.LastAddedAt is { } added) { <span> Last added something <RelTime At="added" />.</span> }
                </p>
            }
            else
            {
                <form class="inline" @onsubmit="StartLetterboxd">
                    <input type="text" @bind="lbName" @bind:event="oninput" placeholder="Letterboxd username" aria-label="Letterboxd username" autocapitalize="off" autocomplete="off" spellcheck="false" />
                    <button class="btn btn-sm btn-primary" type="submit" disabled="@(lbBusy || string.IsNullOrWhiteSpace(lbName))">@(lbBusy ? "Checking…" : "Start syncing")</button>
                </form>
            }
            @if (imports is { Count: > 0 })
            {
                <h3>Recent imports</h3>
                <div class="imports">
                    @foreach (var j in imports)
                    {
                        <div class="import-job" @key="j.Id">
                            <div class="inline spread">
                                <b>@WatchSources.Name(j.Kind) · @j.FileName</b>
                                @if (j.Parts != ImportParts.All) { <span class="muted small">@PartsPicker.Describe(j.Parts)</span> }
                                <span class="pill @StatusClass(j.Status)">@j.Status</span>
                            </div>
                            @if (j.Status == ImportStatus.Running && j.Total > 0)
                            {
                                <ProgressBar Value="j.Processed" Max="j.Total" />
                                <span class="muted small">@j.Processed.ToString("N0") of @j.Total.ToString("N0") · matching titles on TMDB can take a few minutes</span>
                            }
                            else if (j.Status == ImportStatus.Queued) { <span class="muted small">Waiting to start…</span> }
                            @if (j.Message is not null) { <div class="small">@j.Message</div> }
                            @if (j.Pending is { Count: > 0 } pend)
                            {
                                <details class="small" open="@(pend.Count <= 5)">
                                    <summary>Couldn't be matched (@pend.Count): find them yourself</summary>
                                    <ul class="pending-list">
                                        @foreach (var u in pend)
                                        {
                                            <li @key="u.Key">
                                                <span><b>@u.Label</b> <span class="muted">@(u.Type == MediaType.Movie ? "movie" : "show")@(u.Summary.Length > 0 ? " · " + u.Summary : "")</span></span>
                                                <button class="btn btn-sm" @onclick="() => { matchJob = j.Id; matching = u; }">Find</button>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                            else if (j.Unmatched.Count > 0)
                            {
                                <details class="small"><summary>Which couldn't be matched (@j.Unmatched.Count)</summary><ul>@foreach (var u in j.Unmatched) { <li>@u</li> }</ul></details>
                            }
                            <div class="inline spread">
                                <span class="muted small">@j.CreatedAt.ToLocalTime().ToString("MMM d, yyyy, h:mm tt")@(j.UndoneAt is { } undone ? $" · undone {undone.ToLocalTime():MMM d, yyyy}" : "")</span>
                                @if (j.CanUndo) { <button class="btn btn-sm btn-ghost" disabled="@undoing" @onclick="() => UndoImport(j)">Undo this import</button> }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel" id="tracking">
            <h2>Stats</h2>
            <p class="muted small">If you back-filled your history before logging things as you watch them, those plays are dated the day you entered them and skew habits like your favorite day of the week. Set the day you started tracking for real: plays per month, day-of-week, and month and year reviews only count plays from then on (earlier years get no review). Totals still count everything.</p>
            <div class="field inline">
                <label for="tracking-since">Started tracking</label>
                <input id="tracking-since" type="date" value="@trackingSince" @onchange="SaveTrackingSince" />
                @if (!string.IsNullOrEmpty(trackingSince)) { <button class="btn btn-sm btn-ghost" @onclick="ClearTrackingSince">Clear</button> }
            </div>
            <div class="field inline">
                <label for="timezone">Time zone</label>
                <select id="timezone" value="@(timeZone ?? "")" @onchange="SaveTimeZone">
                    @if (timeZone is null) { <option value="">Choose…</option> }
                    @foreach (var z in timeZones ?? []) { <option value="@z.Id" @key="z.Id">@z.Label</option> }
                </select>
            </div>
            <p class="muted small">Days, months, times of day and "on this day" are worked out in this time zone on every device.@(TimeZoneInfo.Local.Id != timeZone && timeZone is not null ? $" This device is on {TimeZoneInfo.Local.Id}." : "")</p>
        </section>

        <section class="panel" id="jellyfin">
            <h2>Media servers</h2>
            @if (jf is null) { <Spinner /> }
            else
            {
                <p class="muted small">SeenIt can mark what you watch on your media server automatically, and show it as “Watching now” while it plays.</p>
                <div class="segmented server-tabs">
                    @foreach (var s in new[] { "Jellyfin", "Plex", "Kodi" })
                    {
                        <button class="@(serverTab == s ? "on" : "")" @onclick="() => serverTab = s" @key="s">@s</button>
                    }
                </div>
                @if (serverTab == "Plex")
                {
                    <ol class="steps">
                        <li>Webhooks need <b>Plex Pass</b>. In Plex open <b>Settings → Webhooks</b> (your account settings, not the server's) and click <b>Add Webhook</b>.</li>
                        <li>Paste your personal URL and save:
                            <div class="copy-field">
                                <code>@PlexUrl</code>
                                <button class="icon-btn" @onclick="() => Copy(PlexUrl)" aria-label="Copy Plex webhook URL"><Icon Name="copy" Size="16" /></button>
                            </div>
                            <span class="muted small">Keep it private: anyone with it can add plays to your history.</span>
                        </li>
                        <li>If other people use your Plex server, enter your Plex username so only your plays count:
                            <form class="inline" @onsubmit="SavePlexUser">
                                <input type="text" @bind="plexUser" placeholder="Plex username (optional)" aria-label="Plex username" autocapitalize="off" autocomplete="off" spellcheck="false" />
                                <button class="btn btn-sm" type="submit">Save</button>
                            </form>
                        </li>
                    </ol>
                    <p class="muted small">Plex says something's watched at 90%. Stopping earlier counts once you pass the percentage below.</p>
                }
                else if (serverTab == "Kodi")
                {
                    <ol class="steps">
                        <li>Download the SeenIt add-on. It has this server's address and your token filled in.
                            <div><button class="btn btn-sm" disabled="@kodiBusy" @onclick="DownloadKodi"><Icon Name="download" Size="16" /> Download SeenIt for Kodi</button></div>
                        </li>
                        <li>Copy it to the device running Kodi. In Kodi open <b>Settings → System → Add-ons</b> and turn on <b>Unknown sources</b>.</li>
                        <li>Go to <b>Add-ons → Install from zip file</b> and pick <code>service.seenit.zip</code>.</li>
                    </ol>
                    <p class="muted small">Works with movies and episodes in your Kodi library on Kodi 19 or later. If you generate a new URL here, download the add-on again (or change the token in its settings).</p>
                }
                else
                {
                <p>Uses Jellyfin's <b>Webhook</b> plugin.</p>
                <ol class="steps">
                    <li>In Jellyfin go to <b>Dashboard → Plugins → Catalog</b>, install <b>Webhook</b> and restart Jellyfin.</li>
                    <li>Open the Webhook plugin settings and click <b>Add Generic Destination</b>.</li>
                    <li>Set <b>Webhook Url</b> to your personal URL:
                        <div class="copy-field">
                            <code>@WebhookUrl</code>
                            <button class="icon-btn" @onclick="() => Copy(WebhookUrl)" aria-label="Copy webhook URL"><Icon Name="copy" Size="16" /></button>
                        </div>
                        <span class="muted small">Keep it private: anyone with it can add plays to your history.</span>
                    </li>
                    <li>Under <b>Notification Type</b> tick <b>Playback Stop</b> (and <b>User Data Saved</b> if you want "mark played" in Jellyfin to count). Also tick <b>Playback Start</b> and <b>Playback Progress</b> to show what you're watching live as “Watching now”.</li>
                    <li>Under <b>User Filter</b> tick only your own Jellyfin user.</li>
                    <li>Under <b>Item Type</b> tick <b>Movies</b> and <b>Episodes</b>, and turn on <b>Send All Properties</b>. If your plugin version doesn't have that option, paste this into <b>Template</b> instead:
                        <div class="copy-field block">
                            <pre>@Template</pre>
                            <button class="icon-btn" @onclick="() => Copy(Template)" aria-label="Copy template"><Icon Name="copy" Size="16" /></button>
                        </div>
                    </li>
                    <li>Add a request header <b>Content-Type</b> = <code>application/json</code>, then save.</li>
                </ol>
                }
                <div class="field inline">
                    <label for="jf-threshold">Count as watched after</label>
                    <select id="jf-threshold" value="@jf.WatchedThresholdPercent" @onchange="SetThreshold">
                        @foreach (var p in new[] { 70, 75, 80, 85, 90, 95 }) { <option value="@p">@p%</option> }
                    </select>
                </div>
                <div class="inline">
                    <button class="btn btn-sm" @onclick="LoadJellyfin">Refresh activity</button>
                    <button class="btn btn-sm btn-ghost" @onclick="Regenerate">Generate a new URL</button>
                </div>
                <h3>Recent activity</h3>
                @if (jf.RecentEvents.Count == 0) { <p class="muted small">Nothing received yet. Finish watching something, then refresh.</p> }
                else
                {
                    <table class="table small">
                        <tbody>
                            @foreach (var e in jf.RecentEvents)
                            {
                                <tr><td class="nowrap muted"><RelTime At="e.ReceivedAt" /></td><td>@e.ItemName</td><td>@e.Outcome</td></tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </section>

        <section class="panel" id="spoilers">
            <h2>Spoilers</h2>
            <p class="muted small">Applies everywhere you're signed in. Tap anything hidden to reveal it; episodes you've watched are never hidden.</p>
            <div class="stack">
                <label class="check">
                    <input type="checkbox" checked="@hideSpoilers" @onchange="e => SavePreferences((bool)e.Value!, blurImages)" />
                    Hide titles and descriptions of episodes I haven't watched
                </label>
                <label class="check @(hideSpoilers ? "" : "disabled")">
                    <input type="checkbox" checked="@blurImages" disabled="@(!hideSpoilers)" @onchange="e => SavePreferences(hideSpoilers, (bool)e.Value!)" />
                    Also blur their images
                </label>
            </div>
        </section>

        <section class="panel" id="appearance">
            <h2>Appearance</h2>
            <p class="muted small">Color theme, saved to your account so it follows you to every device.</p>
            <div class="theme-grid">
                @foreach (var t in UiPrefs.Themes)
                {
                    <button class="theme-option @(Theme.Current == t.Key ? "on" : "")" @key="t.Key" @onclick="() => SetTheme(t.Key)"
                            style="--sw-bg:@t.Bg; --sw-surface:@t.Surface; --sw-accent:@t.Accent" aria-pressed="@(Theme.Current == t.Key)">
                        <span class="theme-swatch"><span></span><span></span><span></span></span>
                        <span>@t.Name</span>
                    </button>
                }
            </div>
        </section>

        <section class="panel" id="layout">
            <h2>Layout</h2>
            <h3>Tabs at the bottom of the app</h3>
            <p class="muted small">Pick up to @UiPrefs.MaxTabs, in order. “More” is always last and links to everything else. These tabs appear on phones and narrow windows.</p>
            <div class="tab-editor">
                @for (var i = 0; i < tabs.Count; i++)
                {
                    var index = i;
                    var t = UiPrefs.Tabs.First(x => x.Key == tabs[index]);
                    <div class="tab-row" @key="t.Key">
                        <Icon Name="@t.Icon" Size="18" />
                        <span>@t.Label</span>
                        <button class="icon-btn" disabled="@(index == 0)" @onclick="() => MoveTab(index, -1)" aria-label="Move @t.Label left"><Icon Name="chevron-left" Size="16" /></button>
                        <button class="icon-btn" disabled="@(index == tabs.Count - 1)" @onclick="() => MoveTab(index, 1)" aria-label="Move @t.Label right"><Icon Name="chevron-right" Size="16" /></button>
                        <button class="icon-btn" disabled="@(tabs.Count == 1)" @onclick="() => RemoveTab(index)" aria-label="Remove @t.Label"><Icon Name="x" Size="16" /></button>
                    </div>
                }
                <div class="tab-row fixed"><Icon Name="menu" Size="18" /><span>More</span><span class="muted small">always shown</span></div>
            </div>
            @if (tabs.Count < UiPrefs.MaxTabs)
            {
                <div class="chips">
                    @foreach (var t in UiPrefs.Tabs.Where(x => !tabs.Contains(x.Key)))
                    {
                        <button class="chip" @onclick="() => AddTab(t.Key)" @key="t.Key"><Icon Name="plus" Size="14" /> @t.Label</button>
                    }
                </div>
            }
            else { <p class="muted small">Remove a tab to add a different one.</p> }
            <button class="btn btn-sm btn-ghost" @onclick="ResetTabs">Reset to default</button>

            <h3>Home page sections</h3>
            <p class="muted small">What shows on your home page, top to bottom.</p>
            <HomeSectionsEditor />
        </section>

        <section class="panel" id="invites">
            <h2>Invite friends</h2>
            <p class="muted small">SeenIt is invite-only@(features?.OpenRegistration == true ? " (sign-ups are currently open too)" : ""). Each link works once and expires after 14 days. You and whoever joins with it will follow each other.</p>
            <button class="btn" @onclick="CreateInvite" disabled="@creatingInvite"><Icon Name="plus" Size="16" /> @(creatingInvite ? "Creating…" : "Create invite link")</button>
            @if (invites is { Count: > 0 })
            {
                <ul class="invite-list">
                    @foreach (var i in invites)
                    {
                        var expired = i.UsedAt is null && i.ExpiresAt <= DateTimeOffset.UtcNow;
                        <li @key="i.Code" class="@(i.UsedAt is not null || expired ? "done" : "")">
                            <code>@i.Code</code>
                            <span class="muted small">
                                @if (i.UsedBy is { } joined) { <text>Joined: <a href="@Fmt.UserHref(joined)">@joined</a></text> }
                                else if (i.UsedAt is not null) { <text>Used</text> }
                                else if (expired) { <text>Expired</text> }
                                else { <text>Unused · expires @i.ExpiresAt.ToLocalTime().ToString("MMM d")</text> }
                            </span>
                            @if (i.UsedAt is null && !expired)
                            {
                                <span class="invite-actions">
                                    <button class="icon-btn" title="Share link" aria-label="Share invite link" @onclick="() => ShareInvite(i.Code)"><Icon Name="share" Size="16" /></button>
                                    <button class="icon-btn" title="Delete" aria-label="Delete invite" @onclick="() => DeleteInvite(i.Code)"><Icon Name="trash" Size="16" /></button>
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="panel" id="privacy">
            <h2>Privacy</h2>
            <p class="muted small">Who can see your profile, history, ratings, stats and what you're watching now. Lists have their own public/private setting.</p>
            <div class="stack">
                @foreach (var (v, label, hint) in VisibilityOptions)
                {
                    <label class="check" @key="v">
                        <input type="radio" name="visibility" checked="@(visibility == v)" @onchange="() => SaveVisibility(v)" />
                        <span><b>@label</b> <span class="muted small">@hint</span></span>
                    </label>
                }
            </div>
            @if (Session.Me is { } who) { <p class="small"><a href="@Fmt.UserHref(who.UserName)">View your profile</a> · <a href="friends">Friends</a></p> }
        </section>

        <section class="panel" id="region">
            <h2>Where to watch</h2>
            <p class="muted small">Streaming, rental and purchase options on movie and show pages are for this country.</p>
            <div class="field inline">
                <label for="region">Country</label>
                <select id="region" value="@(region ?? "")" @onchange="SaveRegion">
                    <option value="">Automatic (@ApiClient.DeviceRegion)</option>
                    @foreach (var r in regions ?? []) { <option value="@r.Code" @key="r.Code">@r.Name</option> }
                </select>
            </div>
        </section>

        <section class="panel" id="export">
            <h2>Export your data</h2>
            <p class="muted small">Download everything you've put into SeenIt (history, ratings, watchlist, lists, show status and settings) as a .zip of JSON and CSV files.</p>
            <button class="btn" @onclick="Export" disabled="@exporting"><Icon Name="download" Size="16" /> @(exporting ? "Preparing…" : "Download my data")</button>
        </section>

        <section class="panel" id="profile">
            <h2>Profile</h2>
            @if (Session.Me is { } me)
            {
                <p class="muted small">Signed in as <b>@me.UserName</b> (@me.Email) · member since @me.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</p>
                <form class="inline" @onsubmit="SaveProfile">
                    <input placeholder="Display name" @bind="displayName" maxlength="64" aria-label="Display name" />
                    <button class="btn" type="submit">Save</button>
                </form>
            }
            @if (Server.Configurable)
            {
                <p class="muted small">Server: @Server.Url</p>
            }
            @if (features?.Version is { } version)
            {
                <p class="muted small">SeenIt v@(version)@(Platform.AppVersion is { } av ? $" · app v{av}" : "")</p>
            }
            @if (Platform.AppVersion is null && android is { } apk)
            {
                <p class="small"><a href="@apk.Url" download>Get the Android app</a> <span class="muted">(v@(apk.Version), @(apk.Size / 1024 / 1024) MB)</span></p>
            }
        </section>

        <section class="panel" id="account">
            <h2>Account</h2>
            <h3>Change password</h3>
            <form class="stack narrow" @onsubmit="ChangePassword">
                <input type="password" placeholder="Current password" @bind="currentPassword" @bind:event="oninput" autocomplete="current-password" aria-label="Current password" />
                <input type="password" placeholder="New password" @bind="newPassword" @bind:event="oninput" autocomplete="new-password" minlength="8" aria-label="New password" />
                <button class="btn" type="submit" disabled="@(string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))">Change password</button>
            </form>
            @if (features?.Email == true)
            {
                <h3>Email</h3>
                <p class="muted small">Password reset emails go to @(Session.Me?.Email). Send yourself a test to check they arrive.</p>
                <button class="btn" @onclick="TestEmail" disabled="@testingEmail">@(testingEmail ? "Sending…" : "Send test email")</button>
            }
            <h3>Clear data</h3>
            <p class="muted small">Delete some or all of what you've tracked, for a fresh start or before re-importing. Your account, settings and friends stay.</p>
            <PartsPicker @bind-Value="clearParts" Label="What to clear" />
            <form class="stack narrow" @onsubmit="ClearData">
                <input type="password" placeholder="Password to confirm" @bind="clearPassword" @bind:event="oninput" autocomplete="current-password" aria-label="Password to confirm clearing data" />
                <button class="btn btn-danger" type="submit" disabled="@(string.IsNullOrEmpty(clearPassword) || clearing)">@(clearing ? "Clearing…" : "Clear data")</button>
            </form>
            <h3>Delete account</h3>
            <p class="muted small">Permanently deletes your account, history, ratings, watchlist and lists.</p>
            <form class="stack narrow" @onsubmit="DeleteAccount">
                <input type="password" placeholder="Password to confirm" @bind="deletePassword" @bind:event="oninput" autocomplete="current-password" aria-label="Password to confirm deletion" />
                <button class="btn btn-danger" type="submit" disabled="@string.IsNullOrEmpty(deletePassword)">Delete my account</button>
            </form>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "welcome")] public int? WelcomeParam { get; set; }
    private bool Welcome => WelcomeParam == 1;

    private const long MaxUpload = 50 * 1024 * 1024;
    private const string Template = """
        {
          "NotificationType": "{{NotificationType}}",
          "ItemType": "{{ItemType}}",
          "Name": "{{Name}}",
          "Year": "{{Year}}",
          "SeriesName": "{{SeriesName}}",
          "SeasonNumber": "{{SeasonNumber}}",
          "EpisodeNumber": "{{EpisodeNumber}}",
          "Provider_tmdb": "{{Provider_tmdb}}",
          "Provider_imdb": "{{Provider_imdb}}",
          "Provider_tvdb": "{{Provider_tvdb}}",
          "PlaybackPositionTicks": "{{PlaybackPositionTicks}}",
          "RunTimeTicks": "{{RunTimeTicks}}",
          "PlayedToCompletion": "{{PlayedToCompletion}}",
          "SaveReason": "{{SaveReason}}",
          "Played": "{{Played}}",
          "UtcTimestamp": "{{UtcTimestamp}}",
          "IsPaused": "{{IsPaused}}"
        }
        """;

    private JellyfinSettingsDto? jf;
    private List<ImportJobDto>? imports;
    private bool uploading;
    private string? displayName, currentPassword, newPassword, deletePassword, clearPassword, trackingSince;
    private ImportParts importParts = ImportParts.All, clearParts = ImportParts.All;
    private string? timeZone;
    private AppRelease? android;
    private List<TimeZoneOption>? timeZones;
    private bool clearing;
    private bool hideSpoilers, blurImages;
    private List<string> tabs = [];
    private CancellationTokenSource? poll;
    private ProfileVisibility visibility;
    private string? region;
    private List<RegionDto>? regions;
    private bool exporting;
    [Inject] private IPlatform Platform { get; set; } = default!;

    private static readonly (ProfileVisibility, string, string)[] VisibilityOptions =
    [
        (ProfileVisibility.Public, "Everyone", "anyone with your profile link"),
        (ProfileVisibility.Friends, "Friends", "people you follow who also follow you"),
        (ProfileVisibility.Private, "Only me", "nobody else, though they can still follow you"),
    ];

    private async Task SaveVisibility(ProfileVisibility v)
    {
        visibility = v;
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(Visibility: v));
            Session.Update(me => me with { Visibility = v });
            Toasts.Show("Privacy updated");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task LoadRegions()
    {
        try { regions = await Api.RegionsAsync(); } catch { regions = []; }
    }

    private async Task SaveRegion(ChangeEventArgs e)
    {
        region = e.Value as string is { Length: 2 } r ? r : null;
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(Region: region ?? ""));
            Session.Update(me => me with { Region = region });
            Toasts.Show("Country saved");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Export()
    {
        exporting = true;
        try
        {
            var data = await Api.ExportAsync();
            await Platform.SaveFileAsync($"seenit-export-{DateTime.Today:yyyy-MM-dd}.zip", "application/zip", data);
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { exporting = false; }
    }

    private string WebhookUrl => jf is null ? "" : new Uri(new Uri(Server.Url), jf.WebhookUrlPath.TrimStart('/')).ToString();
    private string PlexUrl => jf is null ? "" : new Uri(new Uri(Server.Url), jf.PlexUrlPath.TrimStart('/')).ToString();
    private string serverTab = "Jellyfin";
    private string? plexUser;
    private bool kodiBusy;
    private LetterboxdSyncDto? lb;
    private Guid matchJob;
    private PendingTitle? matching;
    private bool undoing;

    private async Task UndoImport(ImportJobDto j)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Undo the {WatchSources.Name(j.Kind)} import of {j.FileName}? Everything it added is removed, and ratings it changed go back to what they were. Plays you logged yourself aren't touched.")) return;
        undoing = true;
        try
        {
            var r = await Api.UndoImportAsync(j.Id);
            Toasts.Show(r is null ? "Import undone" : $"Import undone: removed {r.Plays:N0} plays, {r.Ratings:N0} ratings, {r.Watchlist + r.ListItems + r.Favorites:N0} watchlist, list and favorite entries");
            await LoadImports();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { undoing = false; }
    }
    private string? lbName;
    private bool lbBusy;

    private async Task LoadLetterboxd()
    {
        try { lb = await Api.LetterboxdSyncAsync(); } catch { }
    }

    private async Task StartLetterboxd()
    {
        lbBusy = true;
        try
        {
            lb = await Api.SetLetterboxdSyncAsync(lbName ?? "");
            Toasts.Show(lb.LastResult is { } r ? $"Syncing {lb.Username}. {r}" : $"Syncing {lb.Username}");
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { lbBusy = false; }
    }

    private async Task SyncLetterboxdNow()
    {
        lbBusy = true;
        try { lb = await Api.LetterboxdSyncNowAsync(); Toasts.Show(lb.LastResult ?? "Checked"); }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { lbBusy = false; }
    }

    private async Task StopLetterboxd()
    {
        lbBusy = true;
        try { await Api.StopLetterboxdSyncAsync(); lbName = lb?.Username; lb = await Api.LetterboxdSyncAsync(); Toasts.Show("Letterboxd sync stopped"); }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { lbBusy = false; }
    }

    private async Task SavePlexUser()
    {
        try { await Api.SetPlexUserAsync(plexUser); Toasts.Show(string.IsNullOrWhiteSpace(plexUser) ? "Every Plex account counts" : $"Only {plexUser.Trim()}'s plays count"); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task DownloadKodi()
    {
        kodiBusy = true;
        try { await Platform.SaveFileAsync("service.seenit.zip", "application/zip", await Api.KodiAddonAsync()); }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { kodiBusy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        displayName = Session.Me?.DisplayName;
        hideSpoilers = Session.Me?.HideSpoilers ?? false;
        blurImages = Session.Me?.BlurSpoilerImages ?? false;
        tabs = UiLayout.Tabs(Session.Me).Select(t => t.Key).ToList();
        visibility = Session.Me?.Visibility ?? ProfileVisibility.Friends;
        trackingSince = Session.Me?.TrackingSince?.ToString("yyyy-MM-dd");
        timeZone = Session.Me?.TimeZone;
        region = Session.Me?.Region;
        _ = LoadFeatures();
        _ = LoadInvites();
        await Task.WhenAll(LoadJellyfin(), LoadImports(), LoadRegions(), LoadTimeZones(), LoadAndroid(), LoadLetterboxd());
        StartPolling();
    }

    private async Task LoadJellyfin()
    {
        try { jf = await Api.JellyfinAsync(); plexUser ??= jf.PlexUserName; }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task LoadImports()
    {
        try { imports = await Api.ImportsAsync(); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    /// <summary>Refresh import progress while anything is still running.</summary>
    private void StartPolling()
    {
        poll?.Cancel();
        poll = new CancellationTokenSource();
        var ct = poll.Token;
        _ = Task.Run(async () =>
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(3000, ct);
                if (imports?.Any(j => j.Status is ImportStatus.Queued or ImportStatus.Running) != true) continue;
                await LoadImports();
                await InvokeAsync(StateHasChanged);
            }
        }, ct);
    }

    private async Task Upload(ImportKind kind, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxUpload) { Toasts.Show("Exports over 50 MB aren't supported.", error: true); return; }
        uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxUpload);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            await Api.UploadImportAsync(kind, importParts, file.Name, buffer);
            Toasts.Show($"{WatchSources.Name(kind)} import started");
            await LoadImports();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        uploading = false;
    }

    private async Task SetThreshold(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var pct)) return;
        try { await Api.SetJellyfinThresholdAsync(pct); Toasts.Show($"Watched at {pct}%"); await LoadJellyfin(); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Regenerate()
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Generate a new webhook URL? The old one stops working, so you'll need to update Jellyfin, Plex or the Kodi add-on.")) return;
        try { await Api.RegenerateJellyfinTokenAsync(); await LoadJellyfin(); Toasts.Show("New URL generated"); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Copy(string text)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", text); Toasts.Show("Copied"); }
        catch { Toasts.Show("Couldn't copy; select and copy it manually.", error: true); }
    }

    private async Task SavePreferences(bool hide, bool blur)
    {
        (hideSpoilers, blurImages) = (hide, blur);
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(HideSpoilers: hide, BlurSpoilerImages: blur));
            Session.Update(me => me with { HideSpoilers = hide, BlurSpoilerImages = blur });
            Toasts.Show(hide ? "Spoilers hidden" : "Spoilers shown");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private Task MoveTab(int i, int step)
    {
        (tabs[i], tabs[i + step]) = (tabs[i + step], tabs[i]);
        return SaveTabs();
    }

    private Task RemoveTab(int i) { tabs.RemoveAt(i); return SaveTabs(); }
    private Task AddTab(string key) { tabs.Add(key); return SaveTabs(); }
    private Task ResetTabs() { tabs = UiPrefs.DefaultTabs.ToList(); return SaveTabs(); }

    private async Task SaveTabs()
    {
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(Tabs: tabs));
            var saved = tabs.ToList();
            Session.Update(me => me with { Tabs = saved });
            Toasts.Show("Tabs updated");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task SaveProfile()
    {
        try { await Api.UpdateProfileAsync(new UpdateProfileRequest(displayName)); Session.Refresh(); Toasts.Show("Saved"); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private ServerFeatures? features;
    private bool testingEmail, creatingInvite;
    private List<InviteDto>? invites;

    private async Task LoadInvites()
    {
        try { invites = await Api.InvitesAsync(); StateHasChanged(); } catch { }
    }

    private async Task CreateInvite()
    {
        creatingInvite = true;
        try
        {
            var i = await Api.CreateInviteAsync();
            if (i is not null) { (invites ??= []).Insert(0, i); await ShareInvite(i.Code); }
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { creatingInvite = false; }
    }

    private async Task ShareInvite(string code)
    {
        var result = await Platform.ShareLinkAsync("Join me on SeenIt", Platform.PublicUrl($"invite/{code}"));
        if (result == "copied") Toasts.Show("Invite link copied");
        else if (result == "failed") Toasts.Show("Couldn't share the link.", error: true);
    }

    private async Task DeleteInvite(string code)
    {
        try { await Api.DeleteInviteAsync(code); invites?.RemoveAll(i => i.Code == code); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task LoadFeatures()
    {
        try { features = await Api.FeaturesAsync(); StateHasChanged(); } catch { }
    }

    private async Task TestEmail()
    {
        testingEmail = true;
        try { await Api.SendTestEmailAsync(); Toasts.Show($"Sent to {Session.Me?.Email}."); }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { testingEmail = false; }
    }

    private async Task ChangePassword()
    {
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest(currentPassword!, newPassword!));
            currentPassword = newPassword = null;
            Toasts.Show("Password changed. Other devices will need to sign in again.");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task SaveTrackingSince(ChangeEventArgs e)
    {
        var value = e.Value as string ?? "";
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(TrackingSince: value));
            trackingSince = value;
            Session.Update(m => m with { TrackingSince = DateOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null });
            Toasts.Show(value.Length == 0 ? "Cleared" : "Saved");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task SetTheme(string key)
    {
        await Theme.ApplyAsync(key);   // straight away; saving follows
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(Theme: key));
            Session.Update(m => m with { Theme = key == "seenit" ? null : key });
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task LoadAndroid()
    {
        try { android = await Api.AndroidReleaseAsync(); } catch { android = null; }
    }

    private async Task LoadTimeZones()
    {
        try { timeZones = await Api.TimeZonesAsync(); }
        catch { timeZones = []; }
        if (timeZone is not null && timeZones.All(z => z.Id != timeZone)) timeZones.Insert(0, new TimeZoneOption(timeZone, timeZone));
    }

    private async Task SaveTimeZone(ChangeEventArgs e)
    {
        if (e.Value is not string { Length: > 0 } id) return;
        try
        {
            await Api.SetPreferencesAsync(new PreferencesRequest(TimeZone: id));
            timeZone = id;
            Session.Update(m => m with { TimeZone = id });
            Toasts.Show("Time zone saved");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private Task ClearTrackingSince() => SaveTrackingSince(new ChangeEventArgs { Value = "" });

    private async Task ClearData()
    {
        var what = PartsPicker.Describe(clearParts);
        if (!await Js.InvokeAsync<bool>("confirm", $"Permanently delete {what}? This can't be undone. (Download your data first if you might want it back.)")) return;
        clearing = true;
        try
        {
            var r = await Api.ClearDataAsync(new ClearDataRequest(clearPassword!, clearParts));
            clearPassword = null;
            Toasts.Show(r is null ? "Cleared" : $"Cleared {r.Plays:N0} plays, {r.Ratings:N0} ratings, {r.Watchlist:N0} watchlist entries and {r.Lists:N0} list{(clearParts.HasFlag(ImportParts.Movies) && clearParts.HasFlag(ImportParts.Shows) ? "s" : " entries")}");
            await LoadImports();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        clearing = false;
    }

    private async Task DeleteAccount()
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Really delete your SeenIt account and all your data? This can't be undone.")) return;
        try
        {
            await Api.DeleteAccountAsync(new DeleteAccountRequest(deletePassword!));
            await Session.LogoutAsync();
            Nav.NavigateTo("");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private static string StatusClass(ImportStatus s) => s switch
    {
        ImportStatus.Completed => "pill-ok",
        ImportStatus.Failed => "pill-bad",
        _ => "",
    };

    public void Dispose() => poll?.Cancel();
}
