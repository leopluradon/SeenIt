@* Says that a chart or review only counts plays from the user's "started tracking" day, with a link to change it. *@
@inject SessionState Session
@if (Session.Me?.TrackingSince is { } since)
{
    <p class="muted small @(Center ? "center-text" : "")">Counting from @since.ToString(Fmt.DateLong), when you started tracking · <a href="settings#tracking">change</a></p>
}
@code {
    [Parameter] public bool Center { get; set; }
}
