@* Scores from IMDb, Rotten Tomatoes, Metacritic, Letterboxd... loaded after the page itself. *@
@inject ApiClient Api
@if (Shown is { Count: > 0 } || TmdbScore is > 0)
{
    var shown = Shown ?? [];
    <div class="ext-scores">
        @if (TmdbScore is > 0 and var tmdb)
        {
            @* TMDB first, as one of the chips (it's always there, so it never waits for the others to load). *@
            <a class="ext-score src-tmdb" href="@TmdbUrl" target="_blank" rel="noopener noreferrer"
               title="@($"TMDB: {tmdb:0.0} out of 10{(TmdbVotes is > 0 and var v ? $" · {v:N0} votes" : "")}{(TmdbNote is { } note ? $" · {note}" : "")}")"><b>@tmdb.ToString("0.0")</b> <span>TMDB</span></a>
        }
        @foreach (var s in shown)
        {
            var text = s.Percent ? $"{s.Value:0}%" : s.Max == 100 ? $"{s.Value:0}" : $"{s.Value:0.0#}";
            var title = $"{s.Name}: {text}{(s.Percent ? "" : $" out of {s.Max:0}")}{(s.Votes is { } v ? $" · {v:N0} votes" : "")}";
            @if (s.Url is { } url)
            {
                <a class="ext-score src-@s.Source" href="@url" target="_blank" rel="noopener noreferrer" title="@title"><b>@text</b> <span>@s.Name</span></a>
            }
            else
            {
                <span class="ext-score src-@s.Source" title="@title"><b>@text</b> <span>@s.Name</span></span>
            }
        }
    </div>
}
@code {
    [Parameter, EditorRequired] public MediaType Type { get; set; }
    [Parameter, EditorRequired] public int TmdbId { get; set; }
    /// <summary>For an episode (Type = Episode, TmdbId = the show).</summary>
    [Parameter] public int Season { get; set; }
    [Parameter] public int Episode { get; set; }
    /// <summary>A season's scores (Type = Show, TmdbId = the show, Season = its number).</summary>
    [Parameter] public bool IsSeason { get; set; }
    private List<ExternalScore>? scores;
    /// <summary>TMDB's own score, shown as the first chip (null or 0 leaves it out).</summary>
    [Parameter] public double? TmdbScore { get; set; }
    [Parameter] public int? TmdbVotes { get; set; }
    /// <summary>Extra words on hover ("average of the episodes").</summary>
    [Parameter] public string? TmdbNote { get; set; }
    private string TmdbUrl => Type == MediaType.Movie ? $"https://www.themoviedb.org/movie/{TmdbId}"
        : IsSeason ? $"https://www.themoviedb.org/tv/{TmdbId}/season/{Season}"
        : Type == MediaType.Episode ? $"https://www.themoviedb.org/tv/{TmdbId}/season/{Season}/episode/{Episode}"
        : $"https://www.themoviedb.org/tv/{TmdbId}";

    /// <summary>The sites you chose for this kind of title, in your order (Settings → Display → Scores); all of them by default.</summary>
    private List<ExternalScore>? Shown => scores?.Where(s => Fmt.ShowsScore(s.Source, Type, IsSeason))
        .OrderBy(s => Fmt.Prefs.Scores is { } pick ? pick.ToList().IndexOf(s.Source) : 0).ToList();
    private (MediaType, int, int, int) loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (Type, TmdbId, Season, IsSeason ? -1 : Episode)) return;
        loadedFor = (Type, TmdbId, Season, IsSeason ? -1 : Episode);
        scores = null;
        try { scores = IsSeason ? await Api.SeasonScoresAsync(TmdbId, Season)
                : Type == MediaType.Episode ? await Api.EpisodeScoresAsync(TmdbId, Season, Episode) : await Api.ScoresAsync(Type, TmdbId); }
        catch { scores = null; }   // extra scores are a nicety; the page is fine without them
    }
}
