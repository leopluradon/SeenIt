@* Scores from IMDb, Rotten Tomatoes, Metacritic, Letterboxd... loaded after the page itself. *@
@inject ApiClient Api
@if (Shown is { Count: > 0 } shown)
{
    <div class="ext-scores">
        @foreach (var s in shown)
        {
            var text = s.Percent ? $"{s.Value:0}%" : s.Max == 100 ? $"{s.Value:0}" : $"{s.Value:0.0#}";
            var title = $"{s.Name}: {text}{(s.Percent ? "" : $" out of {s.Max:0}")}{(s.Votes is { } v ? $" · {v:N0} votes" : "")}";
            @if (s.Url is { } url)
            {
                <a class="ext-score src-@s.Source" href="@url" target="_blank" rel="noopener noreferrer" title="@title"><b>@text</b> <span>@s.Name</span></a>
            }
            else
            {
                <span class="ext-score src-@s.Source" title="@title"><b>@text</b> <span>@s.Name</span></span>
            }
        }
    </div>
}
@code {
    [Parameter, EditorRequired] public MediaType Type { get; set; }
    [Parameter, EditorRequired] public int TmdbId { get; set; }
    /// <summary>For an episode (Type = Episode, TmdbId = the show).</summary>
    [Parameter] public int Season { get; set; }
    [Parameter] public int Episode { get; set; }
    private List<ExternalScore>? scores;

    /// <summary>The sites you chose, in your order (Settings → Display → Scores); all of them by default.</summary>
    private List<ExternalScore>? Shown => scores is null ? null
        : Fmt.Prefs.Scores is { } pick ? scores.Where(s => pick.Contains(s.Source)).OrderBy(s => pick.ToList().IndexOf(s.Source)).ToList()
        : scores;
    private (MediaType, int, int, int) loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (Type, TmdbId, Season, Episode)) return;
        loadedFor = (Type, TmdbId, Season, Episode);
        scores = null;
        try { scores = Type == MediaType.Episode ? await Api.EpisodeScoresAsync(TmdbId, Season, Episode) : await Api.ScoresAsync(Type, TmdbId); }
        catch { scores = null; }   // extra scores are a nicety; the page is fine without them
    }
}
