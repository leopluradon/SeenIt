<section class="row-section">
    <div class="section-head">
        <h2>@Title</h2>
        @if (MoreHref is not null) { <a href="@MoreHref" class="section-more">See all <Icon Name="chevron-right" Size="16" /></a> }
    </div>
    @if (Items is null) { <div class="poster-scroller"><div class="poster-card skeleton"></div><div class="poster-card skeleton"></div><div class="poster-card skeleton"></div><div class="poster-card skeleton"></div></div> }
    else if (Items.Count == 0) { <p class="muted">@EmptyText</p> }
    else
    {
        <div class="poster-scroller">
            @foreach (var m in Items) { <PosterCard Media="m" @key="(m.Type, m.TmdbId)" /> }
        </div>
    }
</section>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<MediaSummary>? Items { get; set; }
    [Parameter] public string? MoreHref { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Nothing here yet.";
}
