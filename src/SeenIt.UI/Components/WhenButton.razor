@* "Pick a date": when ✓ records straight away (Settings → Tracking), this still opens the full "when did you watch" choices. *@
@if (Fmt.Prefs.WatchDefault != WatchDefault.Ask)
{
    <button type="button" class="btn @(Small ? "btn-sm" : "") @(Class ?? "btn-ghost") when-btn" disabled="@Disabled" @onclick="OnClick"
            title="Watched at another time? Pick the date" aria-label="@($"Pick when you watched {What}")"><Icon Name="calendar" Size="@(Small ? 14 : 18)" /></button>
}
@code {
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string What { get; set; } = "it";
    /// <summary>Its look (default: a ghost button). As the right half of a Mark watched split button, the same class as that.</summary>
    [Parameter] public string? Class { get; set; }
}
