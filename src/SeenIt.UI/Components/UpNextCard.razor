@inject ApiClient Api
@inject Toasts Toasts
<div class="upnext-card" data-ctx="@Menu.Title(MediaType.Show, Progress.ShowTmdbId, Progress.Name, Progress.PosterPath)">
    <a href="@(Progress.NextEpisode is { } ne ? Fmt.EpisodeHref(Progress.ShowTmdbId, ne.SeasonNumber, ne.EpisodeNumber) : $"show/{Progress.ShowTmdbId}")" class="upnext-art" style="@(Img.Backdrop(Progress.BackdropPath, "w780") is { } b ? $"background-image:url('{b}')" : "")">
        <div class="upnext-shade"></div>
        <div class="upnext-text">
            <div class="upnext-show"><TitleLink Href="@($"show/{Progress.ShowTmdbId}")">@Progress.Name</TitleLink> @if (Progress.Rewatch is { } rw) { <span class="rewatch-tag" title="@SeenIt.UI.Pages.Show.RewatchLabel(rw)"><Icon Name="repeat" Size="12" /></span> }</div>
            @if (Progress.NextEpisode is { } n)
            {
                <div class="upnext-ep">@Fmt.Ep(n.SeasonNumber, n.EpisodeNumber) · <Spoiler>@n.Name</Spoiler></div>
                <EpisodeBadge Mark="n.Mark" />
            }
        </div>
    </a>
    <div class="upnext-foot">
        <ProgressBar Value="Progress.Watched" Max="Progress.Aired" />
        <span class="muted small">@Progress.Watched/@Progress.Aired</span>
        @if (Progress.NextEpisode is { } next)
        {
            <WhenButton Small="true" Disabled="busy" What="@Fmt.Ep(next.SeasonNumber, next.EpisodeNumber)" OnClick="() => { askWhen = true; dialogOpen = true; }" />
            <button class="btn btn-sm btn-check" disabled="@busy" @onclick="() => Quick(next)" aria-label="Mark @Fmt.Ep(next.SeasonNumber, next.EpisodeNumber) watched">
                <Icon Name="check" Size="16" />
            </button>
        }
    </div>
</div>
@if (Progress.NextEpisode is { } pending)
{
    <WatchDialog @bind-Open="dialogOpen" What="@($"{Progress.Name} {Fmt.Ep(pending.SeasonNumber, pending.EpisodeNumber)}")" ReleaseDate="pending.AirDate" OnPick="c => Watch(pending, c)" AskWhen="askWhen" />
}
@code {
    private bool askWhen;
    [Parameter, EditorRequired] public ShowProgressDto Progress { get; set; } = default!;
    [Parameter] public EventCallback OnWatched { get; set; }
    /// <summary>Where you are in the show now, straight from marking it: the page can update this card before reloading the rest.</summary>
    [Parameter] public EventCallback<ShowProgressDto> OnProgress { get; set; }
    private bool busy, dialogOpen;

    /// <summary>The check: straight to recording when your setting doesn't ask, else the dialog.</summary>
    private Task Quick(EpisodeRef next)
    {
        askWhen = false;
        if (Fmt.InstantWatch(next.AirDate) is { } c) return Watch(next, c);
        dialogOpen = true;
        return Task.CompletedTask;
    }

    private async Task Watch(EpisodeRef ep, WatchChoice c)
    {
        busy = true;
        try
        {
            var r = await Api.WatchAsync(Fmt.Watch(MediaType.Episode, Progress.ShowTmdbId, c, ep.SeasonNumber, ep.EpisodeNumber));
            var undo = Api.UndoFor(r, MediaType.Show, Progress.ShowTmdbId);
            var onWatched = OnWatched;   // this card may be gone (the next show moved up) by the time Undo is tapped
            Toasts.Show($"Watched {Progress.Name} {Fmt.Ep(ep.SeasonNumber, ep.EpisodeNumber)}{Fmt.When(c)}",
                undo: undo is null ? null : async () => { await undo(); await onWatched.InvokeAsync(); });
            if (r?.Progress is { } fresh) await OnProgress.InvokeAsync(fresh);
            await OnWatched.InvokeAsync();
        }
        catch (Exception ex) { Toasts.Error(ex); }
        busy = false;
    }
}
