@inject BadgeScores Badges
<a class="poster-card" href="@(Href ?? Fmt.Href(Media.Type, Media.TmdbId))" title="@Media.Title">
    <div class="poster">
        @if (Img.Poster(Media.PosterPath) is { } src)
        {
            @* Cards are ~112px wide on phones and ~150–180px on wider screens. *@
            <img src="@src" srcset="@Img.PosterSet(Media.PosterPath)" sizes="(max-width: 700px) 120px, 180px" alt="" loading="lazy" decoding="async" />
        }
        else
        {
            <div class="poster-fallback"><Icon Name="@(Media.Type == MediaType.Movie ? "film" : "tv")" Size="32" /><span>@Media.Title</span></div>
        }
        @if (Badge is not null) { <span class="poster-badge">@Badge</span> }
        @if (ShowScore && ScoreText is { } score) { <span class="poster-score" title="@ScoreSource"><ScoreSpoiler>@score</ScoreSpoiler></span> }
        @if (OnDismiss.HasDelegate && Fmt.Prefs.DismissButtons)
        {
            <button type="button" class="poster-dismiss" title="Not interested" aria-label="@($"Not interested in {Media.Title}")"
                    @onclick="() => OnDismiss.InvokeAsync(Media)" @onclick:preventDefault @onclick:stopPropagation><Icon Name="x" Size="14" /></button>
        }
    </div>
    <div class="poster-title">@Media.Title</div>
    @if (!string.IsNullOrWhiteSpace(Detail)) { <div class="poster-detail" title="@Detail">@Detail</div> }
    <div class="poster-sub" title="@SubTitle">
        @if (Sub is not null) { @Sub }
        else { @(Media.Year?.ToString() ?? "")<span class="dot-sep">@(Media.Type == MediaType.Movie ? "Movie" : "TV")</span> }
    </div>
</a>
@code {
    /// <summary>Which site's score the badge shows (Settings → Display → Scores → On posters).</summary>
    private string Source => Media.Type == MediaType.Movie ? Fmt.Prefs.PosterScoreMovies : Fmt.Prefs.PosterScoreShows;
    private string ScoreSource => UserPrefs.PosterScoreChoices(Media.Type == MediaType.Movie).FirstOrDefault(c => c.Key == Source).Name ?? "TMDB";
    private string? ScoreText => Source switch
    {
        "none" => null,
        "tmdb" => Media.VoteAverage is > 0 ? Media.VoteAverage.Value.ToString("0.0") : null,
        var other => Badges.Get(other, Media.Type, Media.TmdbId) is { } b ? BadgeScores.Format(b) : null,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (ShowScore && Source is not ("tmdb" or "none") && Badges.Get(Source, Media.Type, Media.TmdbId) is null)
            await Badges.LoadAsync(Source, Media.Type, Media.TmdbId);
    }

    [Parameter, EditorRequired] public MediaSummary Media { get; set; } = default!;
    [Parameter] public string? Badge { get; set; }
    [Parameter] public string? Sub { get; set; }
    /// <summary>An extra line under the title, cut to one line (e.g. the episode's name).</summary>
    [Parameter] public string? Detail { get; set; }
    /// <summary>Hover text for the line under the title (e.g. the exact date behind "3d ago").</summary>
    [Parameter] public string? SubTitle { get; set; }
    [Parameter] public bool ShowScore { get; set; } = true;
    [Parameter] public string? Href { get; set; }
    /// <summary>Shows a small × for "not interested".</summary>
    [Parameter] public EventCallback<MediaSummary> OnDismiss { get; set; }
}
