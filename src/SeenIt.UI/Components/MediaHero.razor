@* Backdrop banner with poster, title and facts. Shared by movie and show pages. *@
<div class="hero-detail">
    @if (Img.Backdrop(Backdrop) is { } bd)
    {
        <div class="hero-bg bg-responsive" style="@Img.BackdropStyle(Backdrop)"></div>
    }
    <div class="hero-shade"></div>
    <div class="hero-content">
        <div class="hero-poster">
            @if (Img.Poster(Poster, "w500") is { } p) { <img src="@p" srcset="@Img.PosterSet(Poster, 342, 500, 780)" sizes="(max-width: 700px) 120px, 230px" alt="" /> }
        </div>
        <div class="hero-info">
            <h1>@Title @if (Year is not null) { <span class="hero-year">(@Year)</span> }</h1>
            @if (Tagline is not null) { <p class="tagline">@Tagline</p> }
            <div class="facts">@Facts</div>
            @{ var kind = ScoresFor?.Type ?? MediaType.Movie; var tmdb = Score is > 0 && Fmt.ShowsScore("tmdb", kind); }
            @if (tmdb || ScoresFor is not null)
            {
                <ScoreSpoiler Watched="Watched" Block="true">
                    @if (tmdb) { <div class="score"><Icon Name="star" Size="16" /> <b>@Score!.Value.ToString("0.0")</b> <span class="muted small">TMDB@(Votes is > 0 ? $" · {Votes:N0} votes" : "")</span></div> }
                    @if (ScoresFor is { } sf) { <ExternalScores Type="sf.Type" TmdbId="sf.Id" /> }
                </ScoreSpoiler>
            }
            <div class="actions">@Actions</div>
        </div>
    </div>
</div>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int? Year { get; set; }
    [Parameter] public string? Tagline { get; set; }
    [Parameter] public string? Poster { get; set; }
    [Parameter] public string? Backdrop { get; set; }
    [Parameter] public double? Score { get; set; }
    [Parameter] public int? Votes { get; set; }
    /// <summary>Also show other sites' scores for this title.</summary>
    [Parameter] public (MediaType Type, int Id)? ScoresFor { get; set; }
    /// <summary>You've seen it (for "hide scores of things I haven't watched").</summary>
    [Parameter] public bool Watched { get; set; }
    [Parameter] public RenderFragment? Facts { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
