@* Blurs scores until tapped when Settings → Display → Scores says so (always, or for things you haven't watched).
   One tap reveals everything inside. *@
@if (Fmt.HideScores(Watched) && !revealed)
{
    @if (Block)
    {
        <div class="score-spoiler is-hidden" role="button" tabindex="0" aria-label="Scores hidden. Tap to reveal." title="Scores hidden. Tap to reveal."
             @onclick="() => revealed = true" @onclick:preventDefault @onclick:stopPropagation @onkeydown="Key">
            <div class="score-spoiler-content" aria-hidden="true">@ChildContent</div>
            <span class="spoiler-hint"><Icon Name="eye" Size="14" /> Tap to show scores</span>
        </div>
    }
    else
    {
        <span class="score-spoiler is-hidden" role="button" tabindex="0" aria-label="Score hidden. Tap to reveal." title="Score hidden. Tap to reveal."
              @onclick="() => revealed = true" @onclick:preventDefault @onclick:stopPropagation @onkeydown="Key"><span class="score-spoiler-content" aria-hidden="true">@ChildContent</span></span>
    }
}
else
{
    @ChildContent
}
@code {
    [Parameter] public bool Watched { get; set; }
    /// <summary>Several scores in a block: shows a "tap to show scores" label over the blur.</summary>
    [Parameter] public bool Block { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool revealed;
    private void Key(KeyboardEventArgs e) { if (e.Key is "Enter" or " ") revealed = true; }
}
