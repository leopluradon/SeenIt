@* Filters and sorting saved as quick chips on a page. Tap one to apply it; the star makes it the page's default,
   which it opens with whenever you go to it (not when you come back with Back, and not once the address already has
   filters in it, like a shared link). On a list, a view can be saved for every list or just this one. *@
@inject SessionState Session
@inject ApiClient Api
@inject Toasts Toasts
@inject NavigationManager Nav
@inject IJSRuntime Js
@{ var views = Shown; }
@if (Session.Me is not null && (views.Count > 0 || CanSave))
{
    <div class="saved-views" aria-label="Saved views">
        @foreach (var v in views)
        {
            <span class="chip saved-view @(Same(v.Query, Current) ? "on" : "")" @key="(v.Page, v.Name)">
                <button type="button" class="saved-view-star @(v.Default ? "is-default" : "")" @onclick="() => ToggleDefault(v)" aria-pressed="@v.Default"
                        title="@(v.Default ? $"The default view for {Where(v)}. Tap to stop." : $"Make this the default view for {Where(v)}")"
                        aria-label="@(v.Default ? $"Stop using {v.Name} as the default" : $"Make {v.Name} the default view")"><Icon Name="star" Size="12" /></button>
                <a href="@Href(v)">@v.Name</a>
                @if (Scope is not null && v.Page == Scope) { <span class="muted tiny" title="Saved for this list only">this list</span> }
                <button type="button" @onclick="() => Remove(v)" aria-label="@($"Remove saved view {v.Name}")"><Icon Name="x" Size="12" /></button>
            </span>
        }
        @if (naming)
        {
            <form class="saved-view-name" @onsubmit="Save">
                <input class="saved-view-input" @ref="nameBox" @bind="name" @bind:event="oninput" maxlength="40" placeholder="Name this view" aria-label="Name this view" />
                <div class="saved-view-options">
                    <label class="check small saved-view-check"><input type="checkbox" @bind="asDefault" /><span>Make it the default<span class="muted saved-view-hint">@(scoped ? "This list" : Scope is not null ? "Every list" : "This page") opens with these filters</span></span></label>
                    @if (Scope is not null) { <label class="check small"><input type="checkbox" @bind="scoped" /> @(ScopeLabel ?? "Only here")</label> }
                </div>
                <div class="saved-view-actions">
                    <button class="btn btn-sm btn-primary" type="submit" disabled="@string.IsNullOrWhiteSpace(name)">Save</button>
                    <button class="btn btn-sm btn-ghost" type="button" @onclick="() => naming = false">Cancel</button>
                </div>
            </form>
        }
        else if (CanSave)
        {
            <button type="button" class="chip chip-add" @onclick="StartNaming"><Icon Name="plus" Size="12" /> Save view</button>
        }
    </div>
}
@code {
    /// <summary>Which page's views (UiPrefs.ViewPages).</summary>
    [Parameter, EditorRequired] public string Page { get; set; } = "";
    /// <summary>The page's current filters as a query string (no "?"); empty when nothing is filtered.</summary>
    [Parameter] public string Current { get; set; } = "";
    /// <summary>Where a view's link goes (default: the page key). May carry its own query, e.g. "recommendations?tab=sent".</summary>
    [Parameter] public string? Path { get; set; }
    /// <summary>A narrower set of views shown as well, e.g. "list:{id}" for one list's own.</summary>
    [Parameter] public string? Scope { get; set; }
    [Parameter] public string? ScopeLabel { get; set; }
    /// <summary>Address keys that aren't filters (a tab, the page number): they don't stop the default from applying.</summary>
    [Parameter] public string[] Keep { get; set; } = [];

    private bool naming, asDefault, scoped;
    private string name = "";
    private ElementReference nameBox;

    private List<SavedView> Shown => [.. Scope is null ? [] : PagePrefs.Views(Scope), .. PagePrefs.Views(Page)];

    // Something to save: filters are set and no saved view already has them.
    private bool CanSave => Current.Length > 0 && !Shown.Any(v => Same(v.Query, Current));

    private static bool Same(string a, string b) => Normalize(a) == Normalize(b);
    private static string Normalize(string q) => string.Join('&', q.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries).Order(StringComparer.Ordinal));

    private string Base => Path ?? Page;
    private string Href(SavedView v) => v.Query.Length == 0 ? Base : Base + (Base.Contains('?') ? "&" : "?") + v.Query;
    private string Where(SavedView v) => Scope is not null && v.Page == Scope ? "this list" : Scope is not null ? "every list" : "this page";

    private string? checkedFor;

    protected override async Task OnParametersSetAsync()
    {
        // Once per page (a tab that's a page of its own, like Recommendations → Sent, counts as arriving).
        if (checkedFor == Page + "|" + Scope) return;
        checkedFor = Page + "|" + Scope;
        // Going to the page with nothing filtered in the address: open it with the default view, if there is one.
        if (Session.Me is null || PagePrefs.DefaultView(Page, Scope) is not { } view || view.Query.Length == 0) return;
        if (Parse(new Uri(Nav.Uri).Query).Keys.Any(k => !Keep.Contains(k))) return;
        try { if (await Js.InvokeAsync<bool>("seenit.cameBack")) return; } catch (JSException) { }
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(Parse(view.Query).ToDictionary(kv => kv.Key, kv => (object?)kv.Value)), replace: true);
    }

    private static Dictionary<string, string> Parse(string query) => query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Split('=', 2)).Where(p => p[0].Length > 0)
        .GroupBy(p => Uri.UnescapeDataString(p[0])).ToDictionary(g => g.Key, g => Uri.UnescapeDataString(g.First().ElementAtOrDefault(1) ?? ""));

    private async Task StartNaming()
    {
        naming = true;
        name = "";
        asDefault = false;
        scoped = false;
        StateHasChanged();
        await Task.Yield();
        try { await nameBox.FocusAsync(); } catch (JSException) { }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        if ((Fmt.Prefs.SavedViews?.Count ?? 0) >= UiPrefs.MaxSavedViews) { Toasts.Show("That's the most saved views you can have. Remove one first.", error: true); return; }
        naming = false;
        var view = new SavedView(scoped && Scope is not null ? Scope : Page, name.Trim(), Current);
        await PagePrefs.AddViewAsync(Session, Api, view);
        if (asDefault) await PagePrefs.SetDefaultAsync(Session, Api, view, true);
        Toasts.Show(asDefault ? $"Saved “{view.Name}” as the default for {Where(view)}" : $"Saved “{view.Name}”");
    }

    private async Task ToggleDefault(SavedView v)
    {
        await PagePrefs.SetDefaultAsync(Session, Api, v, !v.Default);
        Toasts.Show(v.Default ? $"No default view for {Where(v)} now" : $"“{v.Name}” is the default for {Where(v)} now");
    }


    private Task Remove(SavedView v) => PagePrefs.RemoveViewAsync(Session, Api, v);
}
