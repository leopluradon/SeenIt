@* A live "watching now" item with how far through it is. *@
@implements IDisposable
<div class="now-card" data-ctx="@(Item.Type == MediaType.Episode && Item.SeasonNumber is { } cs && Item.EpisodeNumber is { } ce ? Menu.Episode(Item.TmdbId, cs, ce, Item.Title, Item.EpisodeTitle, Item.PosterPath) : Menu.Title(MediaType.Movie, Item.TmdbId, Item.Title, Item.PosterPath))">
    <a href="@Href"><img src="@Img.Poster(Item.PosterPath, "w154")" alt="" /></a>
    <div class="now-body">
        <span class="now-kicker"><Icon Name="radio" Size="14" /> @if (Who is null) { <span>Watching now</span> } else { @if (WhoUser is { } wu) { <a href="@Fmt.UserHref(wu)">@Who</a> } else { @Who } <span> is watching</span> }@(WatchSources.IsScrobbler(Item.Source) ? $" on {WatchSources.Name(Item.Source)}" : "")</span>
        <a href="@(Item.Type == MediaType.Episode ? $"show/{Item.TmdbId}" : Href)" class="mini-title">@Item.Title</a>
        @if (Item.Type == MediaType.Episode)
        {
            <div class="small">@Fmt.Ep(Item.SeasonNumber, Item.EpisodeNumber)@if (Item.EpisodeTitle is not null) { <span class="dot-sep"></span><Spoiler Watched="Item.YouWatched ?? false">@Item.EpisodeTitle</Spoiler> }</div>
        }
        <div class="inline">
            <ProgressBar Value="@((int)Elapsed.TotalMinutes)" Max="@((int)Math.Max(1, (Item.EndsAt - Item.StartedAt).TotalMinutes))" />
            <span class="muted small nowrap">@Left</span>
        </div>
        @if (Ends is { } ends) { <div class="muted small">@ends</div> }
    </div>
    @if (OnCancel.HasDelegate)
    {
        <button class="icon-btn" @onclick="OnCancel" aria-label="Cancel check-in" title="Cancel check-in"><Icon Name="x" Size="18" /></button>
    }
</div>
@code {
    [Parameter, EditorRequired] public NowWatchingDto Item { get; set; } = default!;
    /// <summary>Whose check-in this is, for friends'; null for your own.</summary>
    [Parameter] public string? Who { get; set; }
    /// <summary>Their username, so their name links to their profile.</summary>
    [Parameter] public string? WhoUser { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private Timer? timer;

    private string Href => Item.Type == MediaType.Movie ? Fmt.Href(MediaType.Movie, Item.TmdbId) : Fmt.EpisodeHref(Item.TmdbId, Item.SeasonNumber, Item.EpisodeNumber);
    /// <summary>The moment progress is measured at: now, or when the player was paused (it holds there).</summary>
    private DateTimeOffset At => Item.PausedAt ?? DateTimeOffset.UtcNow;
    private TimeSpan Elapsed => At - Item.StartedAt;
    private string Left
    {
        get
        {
            var left = Item.EndsAt - At;
            var text = left.TotalMinutes < 1 ? "finishing" : $"{Fmt.Runtime((int)Math.Ceiling(left.TotalMinutes))} left";
            return Item.PausedAt is null ? text : $"Paused · {text}";
        }
    }

    /// <summary>When it'll be over, in local time: "Ends 9:40 PM"; while paused, if it were resumed now ("~").</summary>
    private string? Ends
    {
        get
        {
            var left = Item.EndsAt - At;
            if (left.TotalMinutes < 1) return null;
            // Playing: the end as the player last reported it. Paused: what's left, from now.
            return Item.PausedAt is null ? $"Ends {Fmt.EndTime(Item.EndsAt)}" : $"Ends ~{Fmt.EndTime(DateTimeOffset.Now + left)} if you resume now";
        }
    }

    protected override void OnInitialized() =>
        timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

    public void Dispose() => timer?.Dispose();
}
