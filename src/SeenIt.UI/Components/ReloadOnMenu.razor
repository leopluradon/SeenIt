@* Put on a page to reload it after something changes: from the right-click / long-press menu, or pushed by the
   server (LiveConnection) when an episode finishes, a check-in ends, or another device changes something. *@
@implements IDisposable
@inject ContextMenu CtxMenu
@code {
    [Parameter] public EventCallback OnChange { get; set; }

    protected override void OnInitialized() => CtxMenu.Changed += Fire;
    private Task Fire() => InvokeAsync(() => OnChange.InvokeAsync());
    public void Dispose() => CtxMenu.Changed -= Fire;
}
