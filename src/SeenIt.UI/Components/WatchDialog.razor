@* "When did you watch it?" Right now, on release, another date, or unknown. *@
<Modal Open="Open" OpenChanged="OpenChanged" Title="@($"When did you watch {What}?")">
    <div class="stack">
        <button class="btn btn-primary btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.Now))"><Icon Name="check" Size="16" /> Right now</button>
        @if (Bulk)
        {
            <button class="btn btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.ReleaseDate))">Release dates <span class="muted small">(each episode's air date)</span></button>
        }
        else if (ReleaseDate is { } rd && rd <= DateOnly.FromDateTime(DateTime.Today))
        {
            <button class="btn btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.ReleaseDate))">Release date <span class="muted small">(@rd.ToString("MMM d, yyyy"))</span></button>
        }
        <button class="btn btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.Unknown))">Unknown date</button>
        <div class="field">
            <label for="watch-when">Other date</label>
            <div class="inline">
                @* Not @bind: Blazor hands datetime-local values over with seconds added, which a
                   "yyyy-MM-ddTHH:mm" format then fails to parse, silently keeping the old value. *@
                <input id="watch-when" type="datetime-local" value="@custom" @onchange="SetCustom" />
                <button class="btn" @onclick="SaveCustom">Save</button>
            </div>
            @if (badDate) { <p class="error small">Enter a date and time.</p> }
        </div>
    </div>
</Modal>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string What { get; set; } = "this";
    [Parameter] public DateOnly? ReleaseDate { get; set; }
    /// <summary>Marking a whole show/season: "release date" means each episode's own air date.</summary>
    [Parameter] public bool Bulk { get; set; }
    [Parameter] public EventCallback<WatchChoice> OnPick { get; set; }
    private string custom = "";
    private bool badDate, wasOpen;

    protected override void OnParametersSet()
    {
        // Start from "now" each time the dialog opens, not when the page first loaded.
        if (Open && !wasOpen) { custom = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"); badDate = false; }
        wasOpen = Open;
    }

    private void SetCustom(ChangeEventArgs e) { custom = e.Value as string ?? ""; badDate = false; }

    private Task SaveCustom()
    {
        if (!DateTime.TryParse(custom, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var at))
        {
            badDate = true;
            return Task.CompletedTask;
        }
        return Pick(new WatchChoice(WatchTime.Custom, new DateTimeOffset(DateTime.SpecifyKind(at, DateTimeKind.Unspecified))));
    }

    private async Task Pick(WatchChoice choice)
    {
        // Start the pick before closing: handlers read which item was pending synchronously,
        // and the parent may clear that when the dialog closes.
        var picked = OnPick.InvokeAsync(choice);
        await OpenChanged.InvokeAsync(false);
        await picked;
    }
}
