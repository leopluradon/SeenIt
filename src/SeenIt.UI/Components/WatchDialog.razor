@* "When did you watch it?" Right now, on release, another date, or unknown. *@
<Modal Open="Open && !instant" OpenChanged="OpenChanged" Title="@(Heading ?? (Through ? $"When did you watch everything up to {What}?" : $"When did you watch {What}?"))">
    <div class="stack">
        @ChildContent
        @if (Through && ScopeSeason is > 1 and var sn)
        {
            <div class="segmented watch-scope" role="radiogroup" aria-label="How far back">
                <button type="button" role="radio" aria-checked="@seasonOnly" class="@(seasonOnly ? "on" : "")" @onclick="() => seasonOnly = true">Season @sn only</button>
                <button type="button" role="radio" aria-checked="@(!seasonOnly)" class="@(seasonOnly ? "" : "on")" @onclick="() => seasonOnly = false">Seasons 1–@sn</button>
            </div>
            <p class="muted small">Also marks the earlier episodes you haven't watched @(seasonOnly ? $"in season {sn}" : $"in seasons 1–{sn}").</p>
        }
        else if (Through) { <p class="muted small">Also marks every earlier episode you haven't watched@(ThroughNote).</p> }
        <button class="btn btn-primary btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.Now))"><Icon Name="check" Size="16" /> Right now</button>
        @if (Bulk || Through)
        {
            <button class="btn btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.ReleaseDate))">Release dates <span class="muted small">(each episode's air date)</span></button>
        }
        else if (ReleaseDate is { } rd && rd <= DateOnly.FromDateTime(DateTime.Today))
        {
            <button class="btn btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.ReleaseDate))">Release date <span class="muted small">(@rd.ToString(Fmt.DateLong))</span></button>
        }
        <button class="btn btn-block" @onclick="() => Pick(new WatchChoice(WatchTime.Unknown))">Unknown date</button>
        <div class="field">
            <label for="watch-when">Other date</label>
            <div class="inline">
                @* Not @bind: Blazor hands datetime-local values over with seconds added, which a
                   "yyyy-MM-ddTHH:mm" format then fails to parse, silently keeping the old value. *@
                <input id="watch-when" type="datetime-local" value="@custom" @onchange="SetCustom" />
                <button class="btn" @onclick="SaveCustom">Save</button>
            </div>
            @if (badDate) { <p class="error small">Enter a date and time.</p> }
        </div>
    </div>
</Modal>
@code {
    [Parameter] public bool Open { get; set; }
    /// <summary>Extra controls above the choices (the watch order, when marking a whole show).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string What { get; set; } = "this";
    [Parameter] public DateOnly? ReleaseDate { get; set; }
    /// <summary>Marking a whole show/season: "release date" means each episode's own air date.</summary>
    [Parameter] public bool Bulk { get; set; }
    [Parameter] public EventCallback<WatchChoice> OnPick { get; set; }
    /// <summary>Where "Other date" starts (editing a play); otherwise now.</summary>
    [Parameter] public DateTimeOffset? Initial { get; set; }
    [Parameter] public string? Heading { get; set; }
    /// <summary>"Up to here": marks everything before it too; the choice comes back with Through set.</summary>
    [Parameter] public bool Through { get; set; }
    /// <summary>Appended to the "Also marks every earlier episode" line, e.g. " in season order".</summary>
    [Parameter] public string ThroughNote { get; set; } = ", in season order";
    /// <summary>With Through: the episode's season. Above 1 it offers "Season N only" or "Seasons 1–N".</summary>
    [Parameter] public int? ScopeSeason { get; set; }
    /// <summary>Always show the choices, even when the user set ✓ to record straight away (the "pick a date" buttons).</summary>
    [Parameter] public bool AskWhen { get; set; }
    private bool instant;
    private string custom = "";
    private bool badDate, wasOpen, seasonOnly = true;

    protected override async Task OnParametersSetAsync()
    {
        // Start from "now" each time the dialog opens, not when the page first loaded.
        if (Open && !wasOpen)
        {
            // "When you mark something watched: right now / release date" (Settings → Tracking) records it
            // without asking, for single items. Bulk marking, "up to here" and edits always ask.
            instant = !AskWhen && !Bulk && !Through && Initial is null && Heading is null && Fmt.Prefs.WatchDefault != WatchDefault.Ask;
            if (instant)
            {
                wasOpen = true;
                var released = ReleaseDate is { } rd && rd <= DateOnly.FromDateTime(DateTime.Today);
                await Pick(new WatchChoice(Fmt.Prefs.WatchDefault == WatchDefault.ReleaseDate && released ? WatchTime.ReleaseDate : WatchTime.Now));
                instant = false;
                return;
            }
            var start = Initial is { } i && !WatchDates.IsUnknown(i) ? i.LocalDateTime : DateTime.Now;
            custom = start.ToString("yyyy-MM-ddTHH:mm");
            badDate = false;
            seasonOnly = true;   // the narrower choice: marking too much is the harder mistake to undo
        }
        wasOpen = Open;
    }

    private void SetCustom(ChangeEventArgs e) { custom = e.Value as string ?? ""; badDate = false; }

    private Task SaveCustom()
    {
        if (!DateTime.TryParse(custom, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var at))
        {
            badDate = true;
            return Task.CompletedTask;
        }
        return Pick(new WatchChoice(WatchTime.Custom, new DateTimeOffset(DateTime.SpecifyKind(at, DateTimeKind.Unspecified))));
    }

    private async Task Pick(WatchChoice choice)
    {
        // Start the pick before closing: handlers read which item was pending synchronously,
        // and the parent may clear that when the dialog closes.
        var picked = OnPick.InvokeAsync(choice with { Through = Through, SeasonOnly = Through && ScopeSeason is > 1 && seasonOnly });
        await OpenChanged.InvokeAsync(false);
        await picked;
    }
}
