@* Your private note on a movie or show. Saves when you leave the box. *@
@inject ApiClient Api
@inject Toasts Toasts
@* Collapsed to a link until there's a note (or you go to write one): a panel of empty box on every title is clutter. *@
@if (string.IsNullOrEmpty(text) && !writing)
{
    <button type="button" class="link-btn note-add" @onclick="Write"><Icon Name="edit" Size="14" /> Add a private note</button>
}
else
{
    <div class="panel note-panel">
        <label for="title-note">Private note <span class="muted small">only you can see it</span></label>
        <textarea id="title-note" @ref="box" rows="3" maxlength="2000" placeholder="e.g. Recommended by Sam"
                  value="@text" @onchange="Save" @onblur="() => { if (string.IsNullOrEmpty(text)) writing = false; }"></textarea>
    </div>
}
@code {
    [Parameter, EditorRequired] public MediaType Type { get; set; }
    [Parameter, EditorRequired] public int TmdbId { get; set; }
    [Parameter] public string? Note { get; set; }
    private string? text;
    private (MediaType, int)? loadedFor;
    private bool writing;
    private ElementReference box;

    private async Task Write()
    {
        writing = true;
        StateHasChanged();
        await Task.Yield();
        try { await box.FocusAsync(); } catch (Exception) { }
    }

    protected override void OnParametersSet()
    {
        if (loadedFor == (Type, TmdbId)) return;
        loadedFor = (Type, TmdbId);
        text = Note;
        writing = false;
    }

    private async Task Save(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.Trim();
        if (value == (text ?? "").Trim()) return;
        var before = text;
        text = value;
        try
        {
            await Api.SaveNoteAsync(Type, TmdbId, value);
            Toasts.Show(string.IsNullOrEmpty(value) ? "Note removed" : "Note saved");
        }
        catch (Exception ex) { text = before; Toasts.Error(ex); }
    }
}
