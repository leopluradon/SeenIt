@* Your private note on a movie or show. Saves when you leave the box. *@
@inject ApiClient Api
@inject Toasts Toasts
<div class="panel note-panel">
    <label for="title-note">Private note <span class="muted small">only you can see it</span></label>
    <textarea id="title-note" rows="@(string.IsNullOrEmpty(text) ? 1 : 3)" maxlength="2000" placeholder="e.g. Recommended by Sam · Watch the director's cut"
              value="@text" @onchange="Save"></textarea>
</div>
@code {
    [Parameter, EditorRequired] public MediaType Type { get; set; }
    [Parameter, EditorRequired] public int TmdbId { get; set; }
    [Parameter] public string? Note { get; set; }
    private string? text;
    private (MediaType, int)? loadedFor;

    protected override void OnParametersSet()
    {
        if (loadedFor == (Type, TmdbId)) return;
        loadedFor = (Type, TmdbId);
        text = Note;
    }

    private async Task Save(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.Trim();
        if (value == (text ?? "").Trim()) return;
        var before = text;
        text = value;
        try
        {
            await Api.SaveNoteAsync(Type, TmdbId, value);
            Toasts.Show(string.IsNullOrEmpty(value) ? "Note removed" : "Note saved");
        }
        catch (Exception ex) { text = before; Toasts.Error(ex); }
    }
}
