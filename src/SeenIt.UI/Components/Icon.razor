@* Inline SVG icons (Lucide-style strokes) so there's no icon font to load. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "home": <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /> break;
        case "compass": <circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" /> break;
        case "progress": <path d="M3 12h4l3-8 4 16 3-8h4" /> break;
        case "calendar": <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /> break;
        case "bookmark": <path d="M6 3h12v18l-6-4-6 4z" /> break;
        case "repeat": <path d="m17 2 4 4-4 4" /><path d="M3 11V10a4 4 0 0 1 4-4h14M7 22l-4-4 4-4" /><path d="M21 13v1a4 4 0 0 1-4 4H3" /> break;
        case "shuffle": <path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /> break;
        case "history": <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5M12 7v5l3 2" /> break;
        case "list": <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /> break;
        case "chart": <path d="M3 3v18h18" /><path d="M7 15v3M12 10v8M17 6v12" /> break;
        case "star": <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z" /> break;
        case "settings": <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /> break;
        case "bell": <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /> break;
        case "grid": <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /> break;
        case "send": <path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4z" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /> break;
        case "check": <path d="M20 6 9 17l-5-5" /> break;
        case "edit": <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /> break;
        case "heart": <path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6.1a5 5 0 0 1 7.5 6.5z" /> break;
        case "shield": <path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z" /><path d="m9 12 2 2 4-4" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "x": <path d="M18 6 6 18M6 6l12 12" /> break;
        case "refresh": <path d="M21 12a9 9 0 1 1-2.64-6.36L21 8" /><path d="M21 3v5h-5" /> break;
        case "trash": <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" /> break;
        case "play": <path d="m7 4 13 8-13 8z" /> break;
        case "eye-off": <path d="M9.9 4.2A10 10 0 0 1 12 4c6 0 10 8 10 8a17 17 0 0 1-3.2 4.2M6.6 6.6C3.9 8.4 2 12 2 12s4 8 10 8a9.7 9.7 0 0 0 5.4-1.6" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M2 2l20 20" /> break;
        case "link": <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /> break;
        case "external": <path d="M15 3h6v6M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /> break;
        case "user": <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /> break;
        case "menu": <path d="M4 6h16M4 12h16M4 18h16" /> break;
        case "logout": <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /> break;
        case "eye": <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /> break;
        case "chevron-left": <path d="m15 18-6-6 6-6" /> break;
        case "chevron-right": <path d="m9 18 6-6-6-6" /> break;
        case "chevron-up": <path d="m18 15-6-6-6 6" /> break;
        case "arrow-up": <path d="M12 19V5M5 12l7-7 7 7" /> break;
        case "arrow-down": <path d="M12 5v14M19 12l-7 7-7-7" /> break;
        case "grip": <path d="M9 5h.01M9 12h.01M9 19h.01M15 5h.01M15 12h.01M15 19h.01" stroke-width="3" /> break;
        case "chevron-down": <path d="m6 9 6 6 6-6" /> break;
        case "upload": <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" /> break;
        case "copy": <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /> break;
        case "more": <circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /> break;
        case "film": <rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7 3v18M17 3v18M3 7.5h4M3 12h18M3 16.5h4M17 7.5h4M17 16.5h4" /> break;
        case "users": <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" /> break;
        case "user-plus": <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /> break;
        case "pause": <path d="M8 5v14M16 5v14" /> break;
        case "stop": <rect x="5" y="5" width="14" height="14" rx="2" /> break;
        case "share": <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" /> break;
        case "download": <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /> break;
        case "cloud-off": <path d="m2 2 20 20M5.8 5.8A7 7 0 0 0 7 19h10.5M21.6 15.5A4.5 4.5 0 0 0 17.5 9h-1.3A7 7 0 0 0 9.2 4.6" /> break;
        case "radio": <circle cx="12" cy="12" r="2" /><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19.1 4.9a10 10 0 0 1 0 14.2M4.9 19.1a10 10 0 0 1 0-14.2" /> break;
        case "target": <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /> break;
        case "tv": <rect x="2" y="7" width="20" height="14" rx="2" /><path d="m17 2-5 5-5-5" /> break;
    }
</svg>
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
}
