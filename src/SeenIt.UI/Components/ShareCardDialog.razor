@* Shows a generated share image, then shares or saves it. *@
@inject IPlatform Platform
@inject Toasts Toasts

<Modal Open="Open" OpenChanged="OpenChanged" Title="@Title">
    @if (Options is not null)
    {
        <details class="share-options">
            <summary><Icon Name="edit" Size="14" /> Customize</summary>
            @Options
        </details>
    }
    <div class="share-card">
        @if (error is not null) { <ErrorBox Message="@error" OnRetry="Generate" /> }
        else if (image is null) { <div class="share-wait"><Spinner /><span class="muted small">Drawing your image…</span></div> }
        else
        {
            <img src="@($"data:image/png;base64,{Convert.ToBase64String(image)}")" alt="@Title" />
            <div class="inline center">
                @* Share only where it opens a share sheet; a browser that can't share files would just download it too. *@
                @if (canShare) { <button class="btn btn-primary" @onclick="Share"><Icon Name="share" Size="16" /> Share</button> }
                <button class="btn @(canShare ? "" : "btn-primary")" @onclick="Save"><Icon Name="download" Size="16" /> Save image</button>
            </div>
        }
    </div>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string FileName { get; set; } = "seenit.png";
    [Parameter, EditorRequired] public Func<Task<byte[]>> Load { get; set; } = default!;
    /// <summary>Controls for what's on the image, shown under "Customize".</summary>
    [Parameter] public RenderFragment? Options { get; set; }
    /// <summary>Changes when the options do, so the image is drawn again.</summary>
    [Parameter] public string? Version { get; set; }
    private string Drawn => FileName + "|" + Version;

    private byte[]? image;
    private string? error;
    private bool wasOpen;
    private bool canShare;
    private bool shareChecked;
    private string? loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        // Draw when opened (and again if it's opened for something else).
        if (Open && !shareChecked) { shareChecked = true; canShare = await Platform.CanShareFilesAsync("image/png"); }
        if (Open && (!wasOpen || loadedFor != Drawn)) { wasOpen = true; await Generate(); }
        if (!Open) wasOpen = false;
    }

    private async Task Generate()
    {
        error = null;
        if (loadedFor?.Split('|')[0] != FileName) image = null;   // a different image: blank it; new options: keep the old one until the new one's drawn
        var drawing = Drawn;
        try { var png = await Load(); if (drawing == Drawn) { image = png; loadedFor = drawing; } }
        catch (Exception ex) { error = ex is ApiException ? ex.Message : "Couldn't draw the image."; }
    }

    private async Task Share()
    {
        try
        {
            var result = await Platform.ShareFileAsync(FileName, "image/png", image!, Title);
            if (result == "downloaded") Toasts.Show("Image saved");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Save()
    {
        try { if (await Platform.SaveFileAsync(FileName, "image/png", image!) is { } where) Toasts.Show(where); }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
