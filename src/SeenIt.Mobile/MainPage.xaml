<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:SeenIt.UI;assembly=SeenIt.UI"
             xmlns:local="clr-namespace:SeenIt.Mobile"
             x:Class="SeenIt.Mobile.MainPage"
             BackgroundColor="#0E1014">
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="#0E1014">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
            <RootComponent Selector="#deeplinks" ComponentType="{x:Type local:DeepLinkListener}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
