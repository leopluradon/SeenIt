# Copy to .env on the server and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# TMDB → Settings → API → "API Read Access Token" (the long eyJ… one)
TMDB_READ_ACCESS_TOKEN=
# Address used in links inside emails.
PUBLIC_URL=https://seenit.vohiyo.com/
# Usernames (comma-separated) that can open the admin page at /admin.
ADMINS=leopluradon
# Optional: free API key from mdblist.com (sign in → Preferences → API key). Adds Rotten Tomatoes,
# Metacritic, Letterboxd and Trakt scores to movie and show pages. IMDb's score needs no key.
MDBLIST_API_KEY=
# Optional: client ID of a Trakt API app (trakt.tv/oauth/applications) for Trakt season and episode ratings.
TRAKT_CLIENT_ID=
# Optional SMTP for password reset emails. Leave SMTP_HOST empty to disable.
# Gmail: smtp.gmail.com, port 587, your address, and a 16-character App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. SeenIt <you@gmail.com>. Defaults to SMTP_USER.
SMTP_FROM=
# Auto, StartTls, SslOnConnect (port 465) or None
SMTP_SECURITY=Auto
# Weekly off-site backup copy over ssh/rsync, e.g. seenit-backup@45.77.152.122:seenit-backups
# Needs ./offsite/id_ed25519 and ./offsite/known_hosts on the server (see README).
OFFSITE_TARGET=
OFFSITE_KEEP=8

# Optional: push notifications for alerts (browsers, and iPhone Home Screen apps on iOS 16.4+). A VAPID key
# pair, base64url: generate once (e.g. `npx web-push generate-vapid-keys`) and never change it, or every
# device has to turn notifications on again. Leave empty to turn push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
